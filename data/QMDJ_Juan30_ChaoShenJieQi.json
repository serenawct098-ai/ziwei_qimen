{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "超神接氣",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L000",
      "original_quote": "超神接氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L001",
      "original_quote": "如遇冬至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L002",
      "original_quote": "夏至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L003",
      "original_quote": "以甲日換順逆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L004",
      "original_quote": "如甲在冬至前七日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L005",
      "original_quote": "仍依夏至後逆行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L006",
      "original_quote": "冬至後三日亦必逆行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L007",
      "original_quote": "須到第四逢之甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L008",
      "original_quote": "方用冬至後順行之例",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L009",
      "original_quote": "名曰「超神」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L010",
      "original_quote": "謂中氣已到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L011",
      "original_quote": "六甲一旬十日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L012",
      "original_quote": "超過中氣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L013",
      "original_quote": "如甲子日在冬至前四日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L014",
      "original_quote": "即依冬至後順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L015",
      "original_quote": "名曰「接氣」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L016",
      "original_quote": "謂中氣未到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L017",
      "original_quote": "六甲旬頭先到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L018",
      "original_quote": "迎接中氣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L019",
      "original_quote": "每見布圖局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L020",
      "original_quote": "看以六十花甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L021",
      "original_quote": "一日繪一圖局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L022",
      "original_quote": "填注八門九星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L023",
      "original_quote": "陽順陰逆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L024",
      "original_quote": "按圖索之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L025",
      "original_quote": "一目了然",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L026",
      "original_quote": "未免繁絮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L027",
      "original_quote": "餘在軍營總以二至陰陽二周順逆一百二十圖局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L028",
      "original_quote": "會歸於兩儀之中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L029",
      "original_quote": "按三日移門九星遁甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L030",
      "original_quote": "陰逆陽順",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L031",
      "original_quote": "朱圈別之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L032",
      "original_quote": "魚珠不混",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L033",
      "original_quote": "繪圖小折",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L034",
      "original_quote": "隨處可佩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L035",
      "original_quote": "所謂短衣匹馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L036",
      "original_quote": "便捷之至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_ChaoShenJieQi_L037",
      "original_quote": "故附編末聊助同志者便覽云",
      "tag": []
    }
  ],
  "_source": {
