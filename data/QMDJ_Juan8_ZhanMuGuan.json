      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L001",
      "original_quote": "以天輔為求幕館之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L002",
      "original_quote": "以甲子戊為開門官長",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L003",
      "original_quote": "若開門乘三奇吉格來生天輔之宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L004",
      "original_quote": "主顯官來聘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L005",
      "original_quote": "若甲子戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L006",
