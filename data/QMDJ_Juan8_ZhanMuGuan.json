    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L018",
      "original_quote": "開門入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L019",
      "original_quote": "東主凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L020",
      "original_quote": "落空亡者",
      "tag": []
