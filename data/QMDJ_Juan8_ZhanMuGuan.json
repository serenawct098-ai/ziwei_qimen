      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L007",
      "original_quote": "天輔之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L008",
      "original_quote": "主貴人舉薦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L009",
      "original_quote": "若開門不乘旺相三奇者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L010",
      "original_quote": "主微官來聘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L011",
      "original_quote": "相比和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L012",
      "original_quote": "主賓投契",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L013",
      "original_quote": "相剋制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L014",
      "original_quote": "返吟者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L015",
      "original_quote": "主賓不和",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L016",
      "original_quote": "若天輔入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanMuGuan_L017",
      "original_quote": "賓凶",
      "tag": []
