{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "增補太微賦",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L001",
      "original_quote": "前後兩凶神為兩鄰，加會尚可撐持，同室與謀最難隄防。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L002",
      "original_quote": "片火焚天馬，重羊逐祿存。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L003",
      "original_quote": "劫空親戚無常，權祿行藏靡定。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L004",
      "original_quote": "君子哉魁鉞，小人哉羊鈴。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L005",
      "original_quote": "凶不皆凶，吉無純吉。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L006",
      "original_quote": "主強賓弱可保無虞，主弱賓強兇危立見。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L007",
      "original_quote": "主賓得失兩相宜，運限命身當互見。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L008",
      "original_quote": "身命最嫌羊陀七殺，遇之未免為凶。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L009",
      "original_quote": "二限甚忌貪破巨廉，逢之定然作禍。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L010",
      "original_quote": "命運魁昌常得貴，限逢紫府定財多。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L011",
      "original_quote": "凡觀女人之命，先觀夫子二宮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L012",
      "original_quote": "若值殺星定三嫁而心不足，或逢羊孛雖啼哭而淚不乾。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L012",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L013",
      "original_quote": "若觀男命始以福財為主，再審遷移何如。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L013",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L014",
      "original_quote": "二限相因，吉凶同斷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L014",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L015",
      "original_quote": "限逢吉曜平生動用和諧，命坐凶鄉一世求謀齟齬。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L015",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L016",
      "original_quote": "廉祿臨身女得純陰貞潔之德，同梁守命男得陽純中正之心。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L016",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L017",
      "original_quote": "君子命中亦有羊陀火鈴，小人命內豈無科祿權星。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L017",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L018",
      "original_quote": "要看得垣失垣，專論入廟失廟。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L018",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L019",
      "original_quote": "若論小兒，詳推童限。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L019",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L020",
      "original_quote": "小兒命坐凶鄉，二五歲必然殀折，更有限逢惡殺，五七歲必主災亡。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L020",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L021",
      "original_quote": "文昌文曲天魁秀，不讀詩書也可人。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L021",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L022",
      "original_quote": "多學少成只為擎羊逢劫殺，為人好訟蓋因太歲遇官符。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L022",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L023",
      "original_quote": "命之理微熟察星辰之變化，數之理遠細詳格局之興衰。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L023",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L024",
      "original_quote": "北極加凶殺為道為僧，羊陀遇惡星為奴為僕。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L024",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L025",
      "original_quote": "如武破廉貪固深謀而貴顯，加羊陀空劫反小志以孤寒。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L025",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L026",
      "original_quote": "限輔星旺限雖弱而不弱，命臨吉地命雖凶而不凶。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L026",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L027",
      "original_quote": "斷橋截路大小難行，卯西二空聰明發福。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L027",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L028",
      "original_quote": "命身遇紫府疊積金銀，二主逢劫空衣食不足。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L028",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L029",
      "original_quote": "謀而不遂，命限遇入擎羊，東作西成，限身遭逢輔相。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L029",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L030",
      "original_quote": "科權祿拱，定為扳桂之高人，空劫羊鈴，作九流之術士。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L030",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L031",
      "original_quote": "情懷暢舒昌曲命身，詭詐浮虛羊陀陷地。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L031",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L032",
      "original_quote": "天機天梁擎羊會，早有刑而晚見孤。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L032",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L033",
      "original_quote": "貪狼武曲廉貞逢，少受貧而後享福。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L033",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L034",
      "original_quote": "此皆斗數之奧妙，學者宜熟思之。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L034",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "增補太微賦全文完成，已根據語義斷句"
}