      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L001",
      "original_quote": "前後兩凶神為兩鄰,加會尚可撐持,同室與謀最難隄防｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第170行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L002",
      "original_quote": "⽚火焚天⾺,重⽺逐祿存｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第171行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L003",
      "original_quote": "劫空親戚無常,權祿⾏藏靡定｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第172行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L004",
      "original_quote": "君⼦哉魁鉞,⼩⼈哉⽺鈴｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第173行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L005",
      "original_quote": "凶不皆凶,吉無純吉｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第174行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L006",
      "original_quote": "主強賓弱可保無虞主賓得失兩相宜,主弱賓強兇危立⾒｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第175行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L007",
      "original_quote": ",運限命⾝當互⾒｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第176行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L008",
      "original_quote": "⾝命最嫌⽺陀七殺,遇之未免為凶｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第177行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L009",
      "original_quote": "⼆限甚忌貪破巨廉,逢之定然作禍｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第178行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L010",
      "original_quote": "命運魁昌常得貴,限逢紫府定財多｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第179行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L011",
      "original_quote": "凡觀女⼈之命,先觀夫⼦⼆宮｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第180行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L012",
      "original_quote": "若值殺星定三嫁⽽⼼不⾜若觀男命始以福財為主,或逢⽺孛雖啼哭⽽淚不乾｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第181行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L013",
      "original_quote": ",再審遷移何如｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第182行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L014",
      "original_quote": "⼆限相因,吉凶同斷｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第183行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L015",
      "original_quote": "限逢吉曜平⽣動⽤和諧,命坐凶鄉⼀世求謀齟齬｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第184行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L016",
      "original_quote": "廉祿臨⾝女得純陰貞潔之德,同梁守命男得陽純中正之⼼｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第185行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L017",
      "original_quote": "君⼦命中亦有⽺陀火鈴,⼩⼈命內豈無科祿權星｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第186行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L018",
      "original_quote": "要看得垣失垣,專論入廟失廟｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第187行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L019",
      "original_quote": "若論⼩兒,詳推童限｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第188行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L020",
      "original_quote": "⼩兒命坐凶鄉,⼆五歲必然殀折,更有限逢惡殺,五七歲必主災亡｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第189行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L021",
      "original_quote": "⽂昌⽂曲天魁秀,不讀詩書也可⼈｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第190行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L022",
      "original_quote": "多學少成只為擎⽺逢劫殺,為⼈好訟蓋因太歲遇官符｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第191行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L023",
      "original_quote": "命之理微熟察星辰之變化,數之理遠細詳格局之興衰｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第192行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L024",
      "original_quote": "北極加凶殺為道為僧,⽺陀遇惡星為奴為僕｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第193行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L025",
      "original_quote": "如武破廉貪固深謀⽽貴顯,加⽺陀空劫反⼩志以孤寒｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第194行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L026",
      "original_quote": "限輔星旺限雖弱⽽不弱,命臨吉地命雖凶⽽不凶｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第195行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L027",
      "original_quote": "斷橋截路⼤⼩難⾏,卯⻄⼆空聰明發福｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第196行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L028",
      "original_quote": "命⾝遇紫府疊積⾦銀,⼆主逢劫空衣食不⾜｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第197行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L029",
      "original_quote": "謀⽽不遂,命限遇入擎⽺,東作⻄成,限⾝遭逢輔相",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第198行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L030",
      "original_quote": "科權祿拱,定為扳桂之⾼⼈,空劫⽺鈴,作九流之術⼠｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第199行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L031",
      "original_quote": "情懷暢舒昌曲命⾝,詭詐浮虛⽺陀陷地｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第200行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L032",
      "original_quote": "天機天梁擎⽺會,早有刑⽽晚⾒孤｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第201行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L033",
      "original_quote": "貪狼武曲廉貞逢,少受貧⽽後享福｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第202行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_ZengbuTaiweiFu_L034",
      "original_quote": "此皆⽃數之奧妙,學者宜熟思之｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "增補太微賦",
        "line_ref": "第203行"
      }
    }
