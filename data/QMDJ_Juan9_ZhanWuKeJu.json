{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan9",
  "section": "占武科舉",
  "entries": [
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L000",
      "original_quote": "占武科舉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L001",
      "original_quote": "以天衝星為監試官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L002",
      "original_quote": "以日乾為試士",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L003",
      "original_quote": "甲戌己為弓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L004",
      "original_quote": "甲申庚為矢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L005",
      "original_quote": "景門為策論",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L006",
      "original_quote": "傷門為馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L007",
      "original_quote": "甲戌己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L008",
      "original_quote": "甲申庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L009",
      "original_quote": "傷門各乘旺相之宮與日乾相生者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L010",
      "original_quote": "主外場合式",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L011",
      "original_quote": "剋者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L012",
      "original_quote": "主外場阻隔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L013",
      "original_quote": "又以甲午辛為紅心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L014",
      "original_quote": "庚加辛宮主矢中紅心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L015",
      "original_quote": "庚落艮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L016",
      "original_quote": "乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L017",
      "original_quote": "矢落四角",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L018",
      "original_quote": "巽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L019",
      "original_quote": "震",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L020",
      "original_quote": "坤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L021",
      "original_quote": "兌矢落兩旁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L022",
      "original_quote": "落空亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L023",
      "original_quote": "矢不中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L024",
      "original_quote": "庚落幾宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L025",
      "original_quote": "計中幾矢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L026",
      "original_quote": "落年命日乾宮得天衝來生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L027",
      "original_quote": "更兼景門奇儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L028",
      "original_quote": "有吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L029",
      "original_quote": "必中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L030",
      "original_quote": "反此不中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanWuKeJu_L031",
      "original_quote": "武童仿此",
      "tag": []
    }
