{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan16",
  "section": "論天門地戶",
  "entries": [
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L000",
      "original_quote": "論天門地戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L001",
      "original_quote": "入式歌云：「天乙會合女陰私」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L002",
      "original_quote": "所謂天乙會合女陰私之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L003",
      "original_quote": "要在三奇臨六儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L004",
      "original_quote": "與三奇吉門合太衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L005",
      "original_quote": "小吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L006",
      "original_quote": "從魁天三門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L007",
      "original_quote": "加除",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L008",
      "original_quote": "危",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L009",
      "original_quote": "定",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L010",
      "original_quote": "開地四戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L011",
      "original_quote": "是謂福食",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L012",
      "original_quote": "遠行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L013",
      "original_quote": "出入皆吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L014",
      "original_quote": "歌云：「本月將名加時支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L015",
      "original_quote": "十二月將順數去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L016",
      "original_quote": "太衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L017",
      "original_quote": "小吉與從魁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L018",
      "original_quote": "三方避禍天門是",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L019",
      "original_quote": "便以月將加時支順數也」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L020",
      "original_quote": "假如正月雨水後用午時出行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L021",
      "original_quote": "則以登明將加於午宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L022",
      "original_quote": "登明在午",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L023",
      "original_quote": "神後在未",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L024",
      "original_quote": "大吉在申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L025",
      "original_quote": "功曹在酉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L026",
      "original_quote": "太衝在戌為天門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L027",
      "original_quote": "天罡在亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L028",
      "original_quote": "太乙在子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L029",
      "original_quote": "勝光在丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L030",
      "original_quote": "小吉在寅為天門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L031",
      "original_quote": "傳送在卯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L032",
      "original_quote": "從魁在辰為天門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L033",
      "original_quote": "河魁在巳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L034",
      "original_quote": "以時憲書審訂太陽過宮方要選用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L035",
      "original_quote": "如去年大寒後某日時刻日躔元枵之次",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L036",
      "original_quote": "太陽在子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L037",
      "original_quote": "以神後出將加用時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L038",
      "original_quote": "世俗但知登明為正月將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L039",
      "original_quote": "卻不知雨水後某日時刻日躔娵訾之次",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L040",
      "original_quote": "太陽始過亥宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L041",
      "original_quote": "始可用登明將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L042",
      "original_quote": "以次輪去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L043",
      "original_quote": "如遇從魁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L044",
      "original_quote": "小吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L045",
      "original_quote": "太衝即是天三門也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L046",
      "original_quote": "倘得本日貴神到乾亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L047",
      "original_quote": "就是貴神登天門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_TianMenDiHu_L048",
      "original_quote": "大吉",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan16",
