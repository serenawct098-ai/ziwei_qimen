      "line_id": "QMDJ_Juan20_RiJiaGe_L000",
      "original_quote": "日家奇門歌訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L001",
      "original_quote": "甲戊壬子起坎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L002",
      "original_quote": "丁辛乙卯坤裁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L003",
      "original_quote": "庚甲戊午震宮求",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L004",
      "original_quote": "巽到癸丁辛酉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L005",
      "original_quote": "庚丙鼠行干上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L006",
      "original_quote": "己癸兔走西疇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L007",
      "original_quote": "壬丙騎馬艮山頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L008",
      "original_quote": "乙己雞飛離九",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L009",
      "original_quote": "其法一卦管三日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L010",
      "original_quote": "如甲子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L011",
      "original_quote": "乙丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L012",
      "original_quote": "丙寅三日於坎宮起休門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L013",
      "original_quote": "丁卯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L014",
      "original_quote": "戊辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L015",
      "original_quote": "己巳三日於坤起休門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L016",
      "original_quote": "依九宮次序",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L017",
      "original_quote": "三日一換",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L018",
      "original_quote": "局去中五不用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L019",
      "original_quote": "待休門既定",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_RiJiaGe_L020",
      "original_quote": "然後從八卦定方位也",
      "tag": []
    }
  ],
