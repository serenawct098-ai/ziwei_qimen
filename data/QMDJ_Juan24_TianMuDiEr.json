  "entries": [
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L000",
      "original_quote": "天目地耳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L001",
      "original_quote": "經曰：「天目為客地目主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L002",
      "original_quote": "六甲推兮無差理",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L003",
      "original_quote": "勸君莫求此元機",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L004",
      "original_quote": "洞澈九宮扶英主」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L005",
      "original_quote": "卯為天目",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L006",
      "original_quote": "酉為地耳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L007",
      "original_quote": "又六甲為青龍位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L008",
      "original_quote": "六丁為天目位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L009",
      "original_quote": "六癸為地耳位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L010",
      "original_quote": "又為華蓋位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L011",
      "original_quote": "六戊為天門位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L012",
      "original_quote": "六己為地戶位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L013",
      "original_quote": "甲子者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L014",
      "original_quote": "六甲旬中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L015",
      "original_quote": "庚為天目",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L016",
      "original_quote": "戊為地耳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L017",
      "original_quote": "丙為三刑位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L018",
      "original_quote": "主戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L019",
      "original_quote": "如甲子旬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L020",
      "original_quote": "卯方入營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L021",
      "original_quote": "六丁之位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L022",
      "original_quote": "凡劫賊營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L023",
      "original_quote": "令人鬼不知",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L024",
      "original_quote": "從六丁位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L025",
      "original_quote": "或太陰位下入營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L026",
      "original_quote": "或從天目",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L027",
      "original_quote": "地耳入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L028",
      "original_quote": "又欲入劫營者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L029",
      "original_quote": "從天目",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L030",
      "original_quote": "地耳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L031",
      "original_quote": "天門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L032",
      "original_quote": "地戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L033",
      "original_quote": "青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L034",
      "original_quote": "華蓋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L035",
      "original_quote": "九天位上入劫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_TianMuDiEr_L036",
      "original_quote": "即吉",
      "tag": []
    }
