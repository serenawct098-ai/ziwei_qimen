{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan8",
  "section": "占信息虛實",
  "entries": [
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L000",
      "original_quote": "占信息虛實",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L001",
      "original_quote": "以景門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L002",
      "original_quote": "朱雀信息決之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L003",
      "original_quote": "若景門乘旺相氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L004",
      "original_quote": "又得三奇者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L005",
      "original_quote": "的信",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L006",
      "original_quote": "景門休囚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L007",
      "original_quote": "不得三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L008",
      "original_quote": "而乘朱雀者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L009",
      "original_quote": "為詐信",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L010",
      "original_quote": "不可聽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L011",
      "original_quote": "景門落空亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L012",
      "original_quote": "入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L013",
      "original_quote": "而帶朱雀者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L014",
      "original_quote": "乃道路之言",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L015",
      "original_quote": "或忤悖架勾之詞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanXinXiXuShi_L016",
      "original_quote": "更不可信",
      "tag": []
    }
  ],
