{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan4",
  "section": "休門剋應",
  "entries": [
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L000",
      "original_quote": "休門剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L001",
      "original_quote": "六辛禽鳥並鴉飛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L002",
      "original_quote": "名「天庭」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L003",
      "original_quote": "陽日陽星為白衣人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L004",
      "original_quote": "陰日陰星為飛鳥應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L005",
      "original_quote": "年內因口舌作牙得財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L006",
      "original_quote": "六壬雷霆及雨雪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L007",
      "original_quote": "名「天牢」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L008",
      "original_quote": "主千里雷霆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L009",
      "original_quote": "陽日陽星皂衣人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L010",
      "original_quote": "陰日陰星白衣人應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L011",
      "original_quote": "年內進人口",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L012",
      "original_quote": "六癸孕婦喜欣歸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L013",
      "original_quote": "名「天藏」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L014",
      "original_quote": "「天網」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L015",
      "original_quote": "陽日陽星為漁獵人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L016",
      "original_quote": "陰日陰星為孕婦應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L017",
      "original_quote": "六十日得銅鏡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L018",
      "original_quote": "八門剋應訣總目",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L019",
      "original_quote": "開門剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L020",
      "original_quote": "開門欲得照臨來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L021",
      "original_quote": "奴婢牛羊百日廻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L022",
      "original_quote": "財源婚姻田地入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L023",
      "original_quote": "興隆宅舍有資財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L024",
      "original_quote": "產業招得商音送",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L025",
      "original_quote": "巳酉丑年必人來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L026",
      "original_quote": "蔭襲子孫多拜授",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L027",
      "original_quote": "紫衣金帶沐恩回",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L028",
      "original_quote": "問曰：開門屬金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L029",
      "original_quote": "以天地肅殺之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L030",
      "original_quote": "萬物俱盡之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L031",
      "original_quote": "何以謂吉?",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L032",
      "original_quote": "衢仙答曰：「開門之金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L033",
      "original_quote": "固是萬物殺盡之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L034",
      "original_quote": "卻不知萬物殺盡而有複生」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L035",
      "original_quote": "開門屬乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L036",
      "original_quote": "干中有亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L037",
      "original_quote": "乾納甲壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L038",
      "original_quote": "金動水生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L039",
      "original_quote": "水生而生萬物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L040",
      "original_quote": "故為滋生萬物之初",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L041",
      "original_quote": "又為天門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L042",
      "original_quote": "所以吉也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L043",
      "original_quote": "若得乙奇相合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L044",
      "original_quote": "名為天遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L045",
      "original_quote": "得日精所蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L046",
      "original_quote": "與丙奇合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L047",
      "original_quote": "得月精所蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L048",
      "original_quote": "與丁奇合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L049",
      "original_quote": "得太陰所蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L050",
      "original_quote": "凡有謀為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L051",
      "original_quote": "宜名正言順",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L052",
      "original_quote": "公事從之而百吉百泰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L053",
      "original_quote": "若為陰私之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L054",
      "original_quote": "必被他人洩漏反遭凶咎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L055",
      "original_quote": "喜幹兌之宮為相氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L056",
      "original_quote": "入坎宮為旺氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L057",
      "original_quote": "金水相生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L058",
      "original_quote": "如母顧子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L059",
      "original_quote": "所以為吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L060",
      "original_quote": "出行四里或四十里見豬鼠等物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L061",
      "original_quote": "六十里見貴人車馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L062",
      "original_quote": "逢酒食事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L063",
      "original_quote": "艮宮入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L064",
      "original_quote": "震宮為迫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L065",
      "original_quote": "又為四氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L066",
      "original_quote": "巽宮反吟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L067",
      "original_quote": "離宮金被火剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L068",
      "original_quote": "不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L069",
      "original_quote": "開門出者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L070",
      "original_quote": "三十里見貴人騎馬吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L071",
      "original_quote": "四十里見豬馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L072",
      "original_quote": "有酒食吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L073",
      "original_quote": "乙奇臨見貴人著紅衣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L074",
      "original_quote": "丙奇臨見老人持杖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L075",
      "original_quote": "丁奇臨見人執竹木等物為應吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L076",
      "original_quote": "靜應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L077",
      "original_quote": "開門加開：主貴人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L078",
      "original_quote": "寶物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L079",
      "original_quote": "財喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L080",
      "original_quote": "加休：主見貴人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L081",
      "original_quote": "財喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L082",
      "original_quote": "更主開張鋪店",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L083",
      "original_quote": "貿易大利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L084",
      "original_quote": "加生：主見貴人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L085",
      "original_quote": "謀望",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_XiuMenKeYing_L086",
      "original_quote": "所求皆遂",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan4",
