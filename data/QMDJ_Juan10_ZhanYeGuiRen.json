{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan10",
  "section": "占謁貴人",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L000",
      "original_quote": "占謁貴人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L001",
      "original_quote": "現任官以天盤開門落宮主之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L002",
      "original_quote": "未任致仕官以天盤甲子戊主之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L003",
      "original_quote": "以日乾為求謁之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L004",
      "original_quote": "開門甲子戊乘旺相氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L005",
      "original_quote": "再得奇門吉格來生日幹落宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L006",
      "original_quote": "去謁必見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L007",
      "original_quote": "見且有益",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L008",
      "original_quote": "所求如意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L009",
      "original_quote": "開門甲子戊與日幹比和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L010",
      "original_quote": "但求謁主少遲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L011",
      "original_quote": "開門甲子戊同宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L012",
      "original_quote": "主貴人有客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L013",
      "original_quote": "宜稍待",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L014",
      "original_quote": "若開門甲子戊返吟者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L015",
      "original_quote": "主貴人他在",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L016",
      "original_quote": "不得見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L017",
      "original_quote": "開門甲子戊入庫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L018",
      "original_quote": "不能見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L019",
      "original_quote": "開門甲子戊受制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L020",
      "original_quote": "貴人有憂事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L021",
      "original_quote": "不見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L022",
      "original_quote": "見亦無益",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L023",
      "original_quote": "開門甲子戊落宮衝剋日乾宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L024",
      "original_quote": "貴人不喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L025",
      "original_quote": "枉惹羞辱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L026",
      "original_quote": "若謁武官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L027",
      "original_quote": "看杜門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYeGuiRen_L028",
      "original_quote": "亦仿此",
      "tag": []
    }
  ],
  "_source": {
