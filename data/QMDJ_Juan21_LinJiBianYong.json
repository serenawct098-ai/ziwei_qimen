{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan21",
  "section": "臨機變用",
  "entries": [
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L000",
      "original_quote": "臨機變用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L001",
      "original_quote": "人為萬物之靈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L002",
      "original_quote": "感通諸事之應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L003",
      "original_quote": "在我一時之動靜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L004",
      "original_quote": "取其人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L005",
      "original_quote": "事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L006",
      "original_quote": "器",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L007",
      "original_quote": "物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L008",
      "original_quote": "以推兵家勝負",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L009",
      "original_quote": "人生得失",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L010",
      "original_quote": "物之成敗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L011",
      "original_quote": "就於出師",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L012",
      "original_quote": "或以動眾發馬立營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L013",
      "original_quote": "或為人事之得失離合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L014",
      "original_quote": "或器物之所得之日時為始",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L015",
      "original_quote": "逐日查算",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L016",
      "original_quote": "利於何日時交鋒得勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L017",
      "original_quote": "何日時賊來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L018",
      "original_quote": "何方日時埋伏於何處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L019",
      "original_quote": "何日時成功奏凱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L020",
      "original_quote": "如欲知人之壽夭窮通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L021",
      "original_quote": "則取本命年月日時演布",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L022",
      "original_quote": "而妻財子祿從可知矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L023",
      "original_quote": "凡物之破損",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L024",
      "original_quote": "成敗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L025",
      "original_quote": "久暫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L026",
      "original_quote": "以所得之日時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L027",
      "original_quote": "或方見之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L028",
      "original_quote": "以及物長短",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L029",
      "original_quote": "方圓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L030",
      "original_quote": "按五行所屬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L031",
      "original_quote": "配合遁甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L032",
      "original_quote": "則物器破損",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L033",
      "original_quote": "被盜可預知矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L034",
      "original_quote": "如軍營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L035",
      "original_quote": "凡有一見一聞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L036",
      "original_quote": "或遇移倒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L037",
      "original_quote": "斜蹲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L038",
      "original_quote": "錯落",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L039",
      "original_quote": "金鼓等項",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L040",
      "original_quote": "或聽言語善惡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L041",
      "original_quote": "或見旗鼓破損",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L042",
      "original_quote": "或鳥獸來從何方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L043",
      "original_quote": "但一見一聞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L044",
      "original_quote": "怪異之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L045",
      "original_quote": "俱可為吉凶之兆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L046",
      "original_quote": "或聽人言語幾聲幾字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L047",
      "original_quote": "或金皷不時亂鳴幾聲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L048",
      "original_quote": "或樂器不時遠近響動幾聲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L049",
      "original_quote": "凡事物遇目一見皆可取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L050",
      "original_quote": "占卜之應在吾心一動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L051",
      "original_quote": "活潑變通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L052",
      "original_quote": "切記不可取其一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L053",
      "original_quote": "又取其二",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L054",
      "original_quote": "以致吉凶無所定也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L055",
      "original_quote": "如取某件",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L056",
      "original_quote": "或吉凶不准",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L057",
      "original_quote": "再取別物占之又不准",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L058",
      "original_quote": "是心未定",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L059",
      "original_quote": "所以吉凶無驗也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L060",
      "original_quote": "如遇一字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L061",
      "original_quote": "一點",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L062",
      "original_quote": "一物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L063",
      "original_quote": "一聲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L064",
      "original_quote": "一人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L065",
      "original_quote": "一獸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L066",
      "original_quote": "即為子時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L067",
      "original_quote": "二為醜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L068",
      "original_quote": "三為寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L069",
      "original_quote": "如甲己日遁起甲子時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L070",
      "original_quote": "若數有十三即作第一次丙子時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L071",
      "original_quote": "若數多皆逢子時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L072",
      "original_quote": "即為第三次",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L073",
      "original_quote": "第四次",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L074",
      "original_quote": "五次",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L075",
      "original_quote": "戊子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L076",
      "original_quote": "庚子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L077",
      "original_quote": "壬子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L078",
      "original_quote": "再數過多",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L079",
      "original_quote": "五子用盡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L080",
      "original_quote": "即作為乙丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L081",
      "original_quote": "丁丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L082",
      "original_quote": "己丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L083",
      "original_quote": "辛丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L084",
      "original_quote": "癸丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L085",
      "original_quote": "如此千時萬時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L086",
      "original_quote": "皆仿此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L087",
      "original_quote": "若出師須詳看領軍官及大小頭目本命",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L088",
      "original_quote": "天子合吉凶等格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L089",
      "original_quote": "或可於征伐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L090",
      "original_quote": "或利於埋伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L091",
      "original_quote": "或利於衝鋒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L092",
      "original_quote": "或利於接應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L093",
      "original_quote": "總視其人利於行事者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L094",
      "original_quote": "斟酌行之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LinJiBianYong_L095",
      "original_quote": "則大小三軍皆無悟矣",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan21",
    "section": "臨機變用",
