{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan10",
  "section": "占脫貨求財",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L000",
      "original_quote": "占脫貨求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L001",
      "original_quote": "以值符甲子戊為我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L002",
      "original_quote": "以天乙為脫貨之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L003",
      "original_quote": "以六合為經紀牙人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L004",
      "original_quote": "若天乙落宮乘奇門吉格來生值符之宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L005",
      "original_quote": "其貨可脫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L006",
      "original_quote": "比和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L007",
      "original_quote": "脫亦無礙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L008",
      "original_quote": "反此必不可脫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L009",
      "original_quote": "必有失",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L010",
      "original_quote": "又看六合落宮生天乙落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L011",
      "original_quote": "主經紀以脫貨之人相生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L012",
      "original_quote": "吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L013",
      "original_quote": "值符與甲子戊之宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L014",
      "original_quote": "主經紀與貨主同心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L015",
      "original_quote": "倘六合入墓或落空亡之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L016",
      "original_quote": "必有奸詐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L017",
      "original_quote": "欺騙之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L018",
      "original_quote": "斷不可脫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L019",
      "original_quote": "占脫貨求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L020",
      "original_quote": "以日幹落宮為貨主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L021",
      "original_quote": "時幹落宮為貨物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L022",
      "original_quote": "以甲子戊落宮為資本",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L023",
      "original_quote": "生門落宮為利息",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L024",
      "original_quote": "看日乾之落宮生時幹之落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L025",
      "original_quote": "主人戀貨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L026",
      "original_quote": "不肯脫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L027",
      "original_quote": "若時幹之落宮生日乾之落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L028",
      "original_quote": "主貨戀人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L029",
      "original_quote": "不能脫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L030",
      "original_quote": "再看時幹之落宮生甲子戊與生門之落宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L031",
      "original_quote": "有利息",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L032",
      "original_quote": "反此無利息",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L033",
      "original_quote": "倘時幹落宮乘凶神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L034",
      "original_quote": "凶格來衝剋日乾宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L035",
      "original_quote": "主折耗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L036",
      "original_quote": "惟日幹落宮剋時幹落宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L037",
      "original_quote": "雖欲急脫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L038",
      "original_quote": "而貨之甚遲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L039",
      "original_quote": "時幹落宮剋日乾之落宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTuoHuo_L040",
      "original_quote": "售之必速",
      "tag": []
    }
  ],
  "_source": {
