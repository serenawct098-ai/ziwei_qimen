{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "奇門地盤圖",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L000",
      "original_quote": "奇門地盤圖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L001",
      "original_quote": "此陽遁一局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L002",
      "original_quote": "先以左邊掌訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L003",
      "original_quote": "甲子戊起一坎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L004",
      "original_quote": "順飛六儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L005",
      "original_quote": "逆布三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L006",
      "original_quote": "即知某為值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L007",
      "original_quote": "某為值使矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L008",
      "original_quote": "諸照此而推之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L009",
      "original_quote": "其圖如左：",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L010",
      "original_quote": "甲寅癸丁丙乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L011",
      "original_quote": "乾六兌七艮八離九",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L012",
      "original_quote": "天心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L013",
      "original_quote": "開天柱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L014",
      "original_quote": "驚天任",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L015",
      "original_quote": "生天英",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L016",
      "original_quote": "景",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L017",
      "original_quote": "天禽星寄於",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L018",
      "original_quote": "坤宮甲辰壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L019",
      "original_quote": "甲午辛甲申庚甲戌己甲子戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L020",
      "original_quote": "巽四震三坤二坎一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L021",
      "original_quote": "天輔杜天衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L022",
      "original_quote": "傷天芮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L023",
      "original_quote": "死天蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanTu_L024",
      "original_quote": "休",
      "tag": []
    }
  ],
