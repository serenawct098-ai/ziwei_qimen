{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan2",
  "section": "天芮星",
  "entries": [
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L000",
      "original_quote": "天芮星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L001",
      "original_quote": "天芮授道結交宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L002",
      "original_quote": "行方值之最不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L003",
      "original_quote": "出行用事皆宜退",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L004",
      "original_quote": "修造安塋禍難測",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L005",
      "original_quote": "賊盜驚惶憂小口",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L006",
      "original_quote": "更有官事被官責",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L007",
      "original_quote": "縱得奇門從此位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L008",
      "original_quote": "求其吉事皆虛為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L009",
      "original_quote": "天芮值子時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L010",
      "original_quote": "秋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L011",
      "original_quote": "冬用吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L012",
      "original_quote": "春",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L013",
      "original_quote": "夏用凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L014",
      "original_quote": "有飛禽戰驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L015",
      "original_quote": "西南方上火光",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L016",
      "original_quote": "二人相逐為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L017",
      "original_quote": "作用後主貓犬瘋癩傷人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L018",
      "original_quote": "惹官事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L019",
      "original_quote": "六十日內有女人自縊死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L020",
      "original_quote": "秋冬用之當進羽音財產發旺及婦人喜事吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L021",
      "original_quote": "值醜時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L022",
      "original_quote": "有鼓聲自西北至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L023",
      "original_quote": "七日內主龜鱉自林中來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L024",
      "original_quote": "六十日主盜賊官司破財凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L025",
      "original_quote": "值寅時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L026",
      "original_quote": "主瘦婦懷孕至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L027",
      "original_quote": "夏秋主披蓑衣人至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L028",
      "original_quote": "春著皮衣人來為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L029",
      "original_quote": "作用後如得奇門旺相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L030",
      "original_quote": "六十日內牛入屋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L031",
      "original_quote": "進血財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L032",
      "original_quote": "財官祿至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L033",
      "original_quote": "子孫興旺大發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L034",
      "original_quote": "值卯時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L035",
      "original_quote": "主女人著色衣送物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L036",
      "original_quote": "及貴人騎馬來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L037",
      "original_quote": "二犬相咬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L038",
      "original_quote": "牛鳴為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L039",
      "original_quote": "作用後六十日進東方人財產",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L040",
      "original_quote": "犬傷小兒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L041",
      "original_quote": "進血產",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L042",
      "original_quote": "三年內婦人產難凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L043",
      "original_quote": "值辰時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L044",
      "original_quote": "有東北方樹倒傷人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L045",
      "original_quote": "鼓樂鳴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L046",
      "original_quote": "女人著紅衣至為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L047",
      "original_quote": "鵲繞屋飛鳴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L048",
      "original_quote": "因賊破財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L049",
      "original_quote": "作用後六十日有瘋腳人上門賴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L050",
      "original_quote": "婚後生貴子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L051",
      "original_quote": "發旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L052",
      "original_quote": "值巳時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L053",
