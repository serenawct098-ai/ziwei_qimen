      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L075",
      "original_quote": "野鳥進宅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L076",
      "original_quote": "家主疾病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L077",
      "original_quote": "值酉時",
