      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L072",
      "original_quote": "犬咬人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianRuiStar_L073",
      "original_quote": "作用後一百日內進羽音人產業",
