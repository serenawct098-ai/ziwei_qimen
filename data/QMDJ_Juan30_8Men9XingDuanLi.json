{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "八門遇九星斷例",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L000",
      "original_quote": "八門遇九星斷例",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L001",
      "original_quote": "休門若獲遇青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L002",
      "original_quote": "凡事謀為盡亨通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L003",
      "original_quote": "覓利求財興百倍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L004",
      "original_quote": "出軍排陣定摧鋒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L005",
      "original_quote": "休門太乙百事興",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L006",
      "original_quote": "相爭戰鬪旺雄兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L007",
      "original_quote": "起營立寨終須勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L008",
      "original_quote": "見貴參官喜相逢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L009",
      "original_quote": "休門若遇天乙星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L010",
      "original_quote": "出入求財大快亨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L011",
      "original_quote": "多遇貴人憐憂喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L012",
      "original_quote": "邀迎酒食得人欽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L013",
      "original_quote": "生門最喜見青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L014",
      "original_quote": "謁貴謀為百事通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L015",
      "original_quote": "經商定獲千倍利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L016",
      "original_quote": "出入無憂展笑容",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L017",
      "original_quote": "生門太乙福德多",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L018",
      "original_quote": "所求稱意任張羅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L019",
      "original_quote": "覓利求財期百倍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L020",
      "original_quote": "出入行軍無滯過",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L021",
      "original_quote": "生門若遇天乙星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L022",
      "original_quote": "出入定無鬪爭迎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L023",
      "original_quote": "布陣排兵皆得勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L024",
      "original_quote": "萬事從心大亨貞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L025",
      "original_quote": "開門若得遇青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L026",
      "original_quote": "覓利重逢得裕豐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L027",
      "original_quote": "謁貴參官多見愛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L028",
      "original_quote": "求謀出入定無空",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L029",
      "original_quote": "開門若合太乙星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L030",
      "original_quote": "雖時劫寨好偷營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L031",
      "original_quote": "出戰行兵無不勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L032",
      "original_quote": "只有開門用安寧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L033",
      "original_quote": "開門如遇天乙星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L034",
      "original_quote": "出軍行陣莫懷猜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L035",
      "original_quote": "求望經營多得利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L036",
      "original_quote": "參官偏得貴人財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L037",
      "original_quote": "八門吉凶隨事行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L038",
      "original_quote": "不但生休與開門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L039",
      "original_quote": "節氣若排十干上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8Men9XingDuanLi_L040",
      "original_quote": "悉心詳究自分明",
      "tag": []
    }
  ],
