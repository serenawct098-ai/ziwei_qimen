{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan27",
  "section": "城有不可剋者",
  "entries": [
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L000",
      "original_quote": "城有不可剋者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L001",
      "original_quote": "凡赤氣在城上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L002",
      "original_quote": "而黃氣四面繞之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L003",
      "original_quote": "將死城降",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L004",
      "original_quote": "城中氣聚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L005",
      "original_quote": "如樓而出見於外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L006",
      "original_quote": "又赤虹從外入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L007",
      "original_quote": "三日可瘏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L008",
      "original_quote": "日重暈而白虹貫之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L009",
      "original_quote": "及蒙霧入城",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L010",
      "original_quote": "白氣繞而入後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L011",
      "original_quote": "所入攻之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L012",
      "original_quote": "赤黑氣如狐狸皮經及正赤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L013",
      "original_quote": "或如雄雌臨城",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L014",
      "original_quote": "或赤氣如眾人頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L015",
      "original_quote": "如飛鳥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L016",
      "original_quote": "如敗車",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L017",
      "original_quote": "氣出向東南者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L018",
      "original_quote": "不可攻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L019",
      "original_quote": "氣向西北",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L020",
      "original_quote": "或云如式人五",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L021",
      "original_quote": "如三牛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L022",
      "original_quote": "如白蛇指城",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L023",
      "original_quote": "或青氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L024",
      "original_quote": "及氣上赤下白",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L025",
      "original_quote": "及日無光明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L026",
      "original_quote": "日有西南風至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L027",
      "original_quote": "必剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L028",
      "original_quote": "城中氣出複入者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L029",
      "original_quote": "人欲逃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L030",
      "original_quote": "凡兩軍相當之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L031",
      "original_quote": "以我西賊東為例",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L032",
      "original_quote": "西厚東薄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L033",
      "original_quote": "西長東短",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L034",
      "original_quote": "西高東下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L035",
      "original_quote": "西澤東枯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L036",
      "original_quote": "我軍勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L037",
      "original_quote": "反之敗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L038",
      "original_quote": "氣安則軍安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L039",
      "original_quote": "氣散則軍亂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L040",
      "original_quote": "氣南軍亦南",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L041",
      "original_quote": "氣北軍亦北",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L042",
      "original_quote": "對敵有火來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L043",
      "original_quote": "甚早",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L044",
      "original_quote": "蔭覆人掩溝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L045",
      "original_quote": "盜大賊將至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L046",
      "original_quote": "雲如蛟蛇者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L047",
      "original_quote": "勝氣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L048",
      "original_quote": "如兔雄者亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L049",
      "original_quote": "甲乙日東方青氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L050",
      "original_quote": "盛氣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L051",
      "original_quote": "黃氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L052",
      "original_quote": "死氣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L053",
      "original_quote": "初出軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L054",
      "original_quote": "赤氣相隨日出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L055",
      "original_quote": "居有憂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L056",
      "original_quote": "隨日沒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L057",
      "original_quote": "外告急",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeKe_L058",
      "original_quote": "收兵勿行",
      "tag": []
    }
  ],
  "_source": {
