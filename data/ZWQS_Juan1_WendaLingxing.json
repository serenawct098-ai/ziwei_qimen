  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaLingxing_L001",
      "original_quote": "問鈴星所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLingxing_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLingxing_L002",
      "original_quote": "答曰：鈴星乃南斗助星也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLingxing_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLingxing_L003",
      "original_quote": "希夷先生歌曰",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLingxing_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLingxing_L004",
      "original_quote": "大殺鈴星將，南斗為從神，值人身命者，性格亦沉吟，形貌多異類，威勢有聲名，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLingxing_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLingxing_L005",
      "original_quote": "若與貪狼會，指日立邊庭，廟地財官貴，陷地主孤貧，羊陀若湊合，其刑大不清，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLingxing_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLingxing_L006",
      "original_quote": "孤單并棄祖，殘傷帶疾人，僧道多飄蕩，還俗定無疑，女人無吉曜，刑剋少六親，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLingxing_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLingxing_L007",
      "original_quote": "終身不貞潔，壽天仍困貧，此星大殺將，其惡不可禁，一生有凶禍，聚實為虛情，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLingxing_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLingxing_L008",
      "original_quote": "七殺主陣亡，破軍財屋傾，廉宿羊刑會，劫空主刀兵，或遇貪狼宿，官祿亦不寧，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLingxing_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLingxing_L009",
      "original_quote": "若逢居旺地，富貴不可論。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLingxing_L009",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
