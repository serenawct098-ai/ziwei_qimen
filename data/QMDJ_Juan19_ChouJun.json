{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan19",
  "section": "抽軍避寇",
  "entries": [
    {
      "line_id": "QMDJ_Juan19_ChouJun_L000",
      "original_quote": "抽軍避寇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L001",
      "original_quote": "賊勢平凌我未強途逢兵賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L002",
      "original_quote": "他強我弱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L003",
      "original_quote": "抽軍回避看天罡以月將加時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L004",
      "original_quote": "看天罡落在何宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L005",
      "original_quote": "以避其強猛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L006",
      "original_quote": "系孟直須從右隱辰為天罡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L007",
      "original_quote": "如加寅申巳亥之孟神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L008",
      "original_quote": "從右道而避之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L009",
      "original_quote": "仲季還宜向左藏子午卯酉為四仲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L010",
      "original_quote": "辰戌丑未為四季",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L011",
      "original_quote": "天罡如此向左藏之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L012",
      "original_quote": "無咎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L013",
      "original_quote": "從魁小吉太衝地酉為從魁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L014",
      "original_quote": "未為小吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L015",
      "original_quote": "卯為太衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L016",
      "original_quote": "此三神為天三門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L017",
      "original_quote": "再得除危開定",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L018",
      "original_quote": "是天門地戶庇佑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L019",
      "original_quote": "天上加臨為好方以月將加時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L020",
      "original_quote": "看天盤卯酉未落在何宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L021",
      "original_quote": "可以避難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L022",
      "original_quote": "如遇旺方不可往",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L023",
      "original_quote": "春不東去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L024",
      "original_quote": "餘仿此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L025",
      "original_quote": "大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L026",
      "original_quote": "神后",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L027",
      "original_quote": "紫房",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L028",
      "original_quote": "華蓋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L029",
      "original_quote": "能藏萬物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L030",
      "original_quote": "即行無害大吉為紫房",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L031",
      "original_quote": "神後為華蓋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L032",
      "original_quote": "凡有急難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L033",
      "original_quote": "避藏之下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ChouJun_L034",
      "original_quote": "人不能掩藏也",
      "tag": []
    }
  ],
  "_source": {
