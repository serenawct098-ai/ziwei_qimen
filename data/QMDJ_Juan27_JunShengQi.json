{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan27",
  "section": "軍勝氣",
  "entries": [
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L000",
      "original_quote": "軍勝氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L001",
      "original_quote": "軍勝之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L002",
      "original_quote": "前赤後白",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L003",
      "original_quote": "雲如旌旗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L004",
      "original_quote": "揚揮指敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L005",
      "original_quote": "或氣如堤阪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L006",
      "original_quote": "前後摩地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L007",
      "original_quote": "或如日月暈狀光芒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L008",
      "original_quote": "如飛鳥來而高",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L009",
      "original_quote": "或赤白相隨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L010",
      "original_quote": "如鬪雞在雲霧中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L011",
      "original_quote": "或如三疋帛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L012",
      "original_quote": "前廣後大",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L013",
      "original_quote": "或如一疋帛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L014",
      "original_quote": "皆不可勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L015",
      "original_quote": "又如五頭馬低尾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L016",
      "original_quote": "而又赤如鳥在氣中如赤杵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L017",
      "original_quote": "在白雲中如人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L018",
      "original_quote": "在烏氣中如人持斧向之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L019",
      "original_quote": "如蛇舉首向之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L020",
      "original_quote": "如人牽牛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L021",
      "original_quote": "如覆舟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L022",
      "original_quote": "如小提",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L023",
      "original_quote": "如山林木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L024",
      "original_quote": "如乳虎伏豹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L025",
      "original_quote": "如樸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L026",
      "original_quote": "如樓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L027",
      "original_quote": "如赤繞之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L028",
      "original_quote": "或赤黃連之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L029",
      "original_quote": "天如華蓋獨立",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L030",
      "original_quote": "或五色雲氣如引絲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L031",
      "original_quote": "如陣前銳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_JunShengQi_L032",
      "original_quote": "皆盛氣也",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan27",
    "section": "軍勝氣",
