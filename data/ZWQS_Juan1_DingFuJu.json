  "entries": [
    {
      "line_id": "ZWQS_Juan1_DingFuJu_L000",
      "original_quote": "定富局",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingFuJu_L001",
      "original_quote": "定富局財蔭夾印相守命武梁來夾是也,⽥宅宮亦然｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingFuJu_L002",
      "original_quote": "⽇⽉夾財武守命⽇⽉來夾是也,財帛宮亦然｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingFuJu_L003",
      "original_quote": "財祿夾⾺⾺守命武祿來夾是也,逢⽣旺尤妙｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingFuJu_L004",
      "original_quote": "蔭印拱⾝⾝臨⽥宅梁相拱沖是也,勿坐空亡｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingFuJu_L005",
      "original_quote": "⽇⽉照璧⽇⽉臨⽥宅宮是也,喜居墓庫｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingFuJu_L006",
      "original_quote": "⾦燦光輝太陽單守,命在午宮是也｡",
      "tag": []
    }
  ],
