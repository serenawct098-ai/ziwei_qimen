{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan24",
  "section": "出三奇吉門咒",
  "entries": [
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L000",
      "original_quote": "出三奇吉門咒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L001",
      "original_quote": "經曰：出六乙門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L002",
      "original_quote": "禹步三咒曰：「白虎白虎除道路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L003",
      "original_quote": "當前尊路慎勿悞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L004",
      "original_quote": "有德之士來相助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L005",
      "original_quote": "出幽冥冥交相助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L006",
      "original_quote": "急急如九天玄女元君律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L007",
      "original_quote": "出六丙門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L008",
      "original_quote": "禹步三咒曰：「前有天罡揚威武",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L009",
      "original_quote": "當從青龍與白虎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L010",
      "original_quote": "行誅天賊及天魔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L011",
      "original_quote": "敢有不從伏天斧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L012",
      "original_quote": "急急如九天玄女元君律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L013",
      "original_quote": "出六丙門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L014",
      "original_quote": "禹步三咒曰：「玉女玉女名神母",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L015",
      "original_quote": "呼而問之道吾所",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L016",
      "original_quote": "常從斗杓入斗里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L017",
      "original_quote": "清冷之淵多神草",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L018",
      "original_quote": "折以自障勿驚悞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L019",
      "original_quote": "急急如九天玄女元君律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L020",
      "original_quote": "經曰：「出三奇吉門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L021",
      "original_quote": "倘事急不及咒亦可去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L022",
      "original_quote": "但須志心信之必驗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L023",
      "original_quote": "慎勿回顧」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L024",
      "original_quote": "凡念咒須禹步",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L025",
      "original_quote": "右手畫四縱五橫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L026",
      "original_quote": "即曰：「四縱五橫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L027",
      "original_quote": "六甲六丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L028",
      "original_quote": "玄武載道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L029",
      "original_quote": "蚩尤避兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L030",
      "original_quote": "左懸南斗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L031",
      "original_quote": "右佩七星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L032",
      "original_quote": "邪魔滅跡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L033",
      "original_quote": "鬼祟潛形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L034",
      "original_quote": "乾不敢犯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L035",
      "original_quote": "支不敢侵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L036",
      "original_quote": "太上有敕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L037",
      "original_quote": "吾令指行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L038",
      "original_quote": "入水不溺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L039",
      "original_quote": "入火不焚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L040",
      "original_quote": "逆吾者死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L041",
      "original_quote": "順吾者生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L042",
      "original_quote": "當吾者死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L043",
      "original_quote": "視吾者盲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L044",
      "original_quote": "急急太上道祖鐵師上帝律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L045",
      "original_quote": "念畢即前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L046",
      "original_quote": "或乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L047",
      "original_quote": "或丙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L048",
      "original_quote": "或丁三奇神咒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L049",
      "original_quote": "隨念隨行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L050",
      "original_quote": "慎勿反顧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L051",
      "original_quote": "單日東西五橫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L052",
      "original_quote": "南北四直",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L053",
      "original_quote": "雙日南北五橫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L054",
      "original_quote": "東西四直",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L055",
      "original_quote": "咒曰：「禹王滅道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L056",
      "original_quote": "吾令出行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L057",
      "original_quote": "四縱五橫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L058",
      "original_quote": "蚩尤備兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L059",
      "original_quote": "撞吾者死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L060",
      "original_quote": "避吾者生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L061",
      "original_quote": "吾游天下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L062",
      "original_quote": "還歸故鄉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L063",
      "original_quote": "敬請南斗六郎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L064",
      "original_quote": "北斗七星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L065",
      "original_quote": "吾奉太上老君",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L066",
      "original_quote": "急急如律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L067",
      "original_quote": "左手捏本日字當是本日支辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L068",
      "original_quote": "佐右手子文畫橫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L069",
      "original_quote": "二咒大同小異",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_3QiZhou_L070",
      "original_quote": "隨意用之",
      "tag": []
    }
  ],
