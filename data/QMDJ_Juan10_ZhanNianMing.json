  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L000",
      "original_quote": "占人年命吉凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L001",
      "original_quote": "以來人所乘之方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L002",
      "original_quote": "合天地正時與其年命所坐之方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L003",
      "original_quote": "合而推之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L004",
      "original_quote": "來方得奇門吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L005",
      "original_quote": "其年命必吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L006",
      "original_quote": "年命落宮合奇門吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L007",
      "original_quote": "亦吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L008",
      "original_quote": "年命坐方俱合奇門吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L009",
      "original_quote": "再乘旺相之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L010",
      "original_quote": "必有奇遇橫發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L011",
      "original_quote": "入如地盤墓庫者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L012",
      "original_quote": "主昏晦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L013",
      "original_quote": "落空亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L014",
      "original_quote": "百事不成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNianMing_L015",
