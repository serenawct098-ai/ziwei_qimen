{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "九星起飛宮訣",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L000",
      "original_quote": "九星起飛宮訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L001",
      "original_quote": "如冬至後陽遁順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L002",
      "original_quote": "甲子為頭起艮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L003",
      "original_quote": "從艮八上起太乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L004",
      "original_quote": "順行離九攝提",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L005",
      "original_quote": "轉坎一上軒轅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L006",
      "original_quote": "坤二招搖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L007",
      "original_quote": "震三天符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L008",
      "original_quote": "巽四青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L009",
      "original_quote": "中五咸池",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L010",
      "original_quote": "乾六太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L011",
      "original_quote": "兌七天乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L012",
      "original_quote": "此九星順行也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L013",
      "original_quote": "一日一換",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L014",
      "original_quote": "如甲子日太乙在艮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L015",
      "original_quote": "乙丑日太乙在離九",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L016",
      "original_quote": "丙寅日太乙在坎一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L017",
      "original_quote": "丁卯日太乙在坤二",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L018",
      "original_quote": "餘類推",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L019",
      "original_quote": "如夏至後陰遁逆行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L020",
      "original_quote": "甲子為頭起坤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingFeiGong_L021",
      "original_quote": "是從坤二上起太乙逆行坎一是也",
      "tag": []
    }
  ],
