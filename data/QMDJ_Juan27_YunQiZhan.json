{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan27",
  "section": "雲氣占",
  "entries": [
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L000",
      "original_quote": "雲氣占",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L001",
      "original_quote": "凡風起正日時方位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L002",
      "original_quote": "徵多為火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L003",
      "original_quote": "羽多為水",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L004",
      "original_quote": "商多為兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L005",
      "original_quote": "為粟貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L006",
      "original_quote": "角多為疾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L007",
      "original_quote": "宮多為吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L008",
      "original_quote": "鳴條落葉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L009",
      "original_quote": "揚塵吹砍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L010",
      "original_quote": "乃占豈君月相日辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L011",
      "original_quote": "占分期以干支合數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L012",
      "original_quote": "宮為十數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L013",
      "original_quote": "徵為三十",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L014",
      "original_quote": "羽五十",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L015",
      "original_quote": "商七十",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L016",
      "original_quote": "角九十",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L017",
      "original_quote": "干支令數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L018",
      "original_quote": "如甲子十八數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L019",
      "original_quote": "乙丑十六數之類",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L020",
      "original_quote": "又日為令長",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L021",
      "original_quote": "時為民",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L022",
      "original_quote": "如德刑俱臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L023",
      "original_quote": "以風之吉凶占",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L024",
      "original_quote": "常以正月二十日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L025",
      "original_quote": "五月",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L026",
      "original_quote": "十一月十四日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L027",
      "original_quote": "候天門有雲氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L028",
      "original_quote": "或蒼黑赤白",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L029",
      "original_quote": "皆為中外不通心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L030",
      "original_quote": "凡雲氣紫赤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L031",
      "original_quote": "如煙非煙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L032",
      "original_quote": "如云非雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L033",
      "original_quote": "鬱鬱紛紛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L034",
      "original_quote": "蕭索輪困",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L035",
      "original_quote": "是曰夏雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L036",
      "original_quote": "喜氣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L037",
      "original_quote": "雲含五色",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L038",
      "original_quote": "潤澤和緩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L039",
      "original_quote": "見城上為景雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L040",
      "original_quote": "太平之應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L041",
      "original_quote": "一曰卿云",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L042",
      "original_quote": "大風將至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L043",
      "original_quote": "雲如亂穰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L044",
      "original_quote": "大雨將至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L045",
      "original_quote": "雲甚重潤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L046",
      "original_quote": "日入而青雲東西極天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L047",
      "original_quote": "無雨則三年將有喪軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L048",
      "original_quote": "有喪則白雲南北如陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L049",
      "original_quote": "赤雲如血則血流",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L050",
      "original_quote": "黑氣如道則有赦雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L051",
      "original_quote": "如龍行則大水入流",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L052",
      "original_quote": "赤氣如人影",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L053",
      "original_quote": "三日臣叛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L054",
      "original_quote": "雲俱五色不下雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L055",
      "original_quote": "有隱賢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L056",
      "original_quote": "赤黃四塞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L057",
      "original_quote": "連日夜光此照地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L058",
      "original_quote": "大臣縱恣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L059",
      "original_quote": "赤色覆日如血",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L060",
      "original_quote": "大旱民飢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L061",
      "original_quote": "黑氣變化更移",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L062",
      "original_quote": "夷欺中國",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L063",
      "original_quote": "雲如疋布",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L064",
      "original_quote": "東西南北在邑上者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L065",
      "original_quote": "羊變",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L066",
      "original_quote": "黑氣如牛頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L067",
      "original_quote": "龍蛇變化",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L068",
      "original_quote": "主病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L069",
      "original_quote": "流亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L070",
      "original_quote": "不宜新婦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L071",
      "original_quote": "亦為狄侵華",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L072",
      "original_quote": "凡戰氣赤雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L073",
      "original_quote": "如傘蓋覆羊上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L074",
      "original_quote": "千里內戰吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L075",
      "original_quote": "外憂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L076",
      "original_quote": "赤雲如狗入營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L077",
      "original_quote": "大戰流血",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L078",
      "original_quote": "赤雲旋而不動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L079",
      "original_quote": "或如丹蛇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L080",
      "original_quote": "如覆舟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L081",
      "original_quote": "如耕襲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L082",
      "original_quote": "或白氣如車入北斗中轉移者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L083",
      "original_quote": "下流血將死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L084",
      "original_quote": "或云上白氣如虹而交",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L085",
      "original_quote": "或日旁有玦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L086",
      "original_quote": "五色白虹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L087",
      "original_quote": "皆戰氣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L088",
      "original_quote": "凡出軍之日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L089",
      "original_quote": "天氣昏漠",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L090",
      "original_quote": "雲氣陰沉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L091",
      "original_quote": "必戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L092",
      "original_quote": "若青陽溫和",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L093",
      "original_quote": "風塵不動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L094",
      "original_quote": "不見敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YunQiZhan_L095",
      "original_quote": "亦不戰也",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan27",
    "section": "雲氣占",
