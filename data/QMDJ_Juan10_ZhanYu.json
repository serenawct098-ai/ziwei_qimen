{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan10",
  "section": "占雨",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L000",
      "original_quote": "占雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L001",
      "original_quote": "以天禽星為司命之主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L002",
      "original_quote": "天柱為雨師",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L003",
      "original_quote": "天衝為雷神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L004",
      "original_quote": "天輔為風伯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L005",
      "original_quote": "螣蛇為雷光",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L006",
      "original_quote": "天蓬為水神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L007",
      "original_quote": "甲辰壬為為龍神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L008",
      "original_quote": "天禽臨旺相之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L009",
      "original_quote": "天柱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L010",
      "original_quote": "甲辰壬游於一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L011",
      "original_quote": "三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L012",
      "original_quote": "七宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L013",
      "original_quote": "或下臨甲辰壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L014",
      "original_quote": "主大雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L015",
      "original_quote": "帶甲寅癸下臨甲寅癸於一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L016",
      "original_quote": "三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L017",
      "original_quote": "七宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L018",
      "original_quote": "主小雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L019",
      "original_quote": "甲辰壬加臨震宮為龍登雷門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L020",
      "original_quote": "主雷雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L021",
      "original_quote": "丁臨地盤螣蛇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L022",
      "original_quote": "主閃電",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L023",
      "original_quote": "乘凶門臨地盤螣蛇為龍雷發蛟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L024",
      "original_quote": "震怪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L025",
      "original_quote": "落空亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L026",
      "original_quote": "墓庫宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L027",
      "original_quote": "主陰霧不雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L028",
      "original_quote": "冬月看天心星及天任土宿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L029",
      "original_quote": "帶壬癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L030",
      "original_quote": "下臨壬癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L031",
      "original_quote": "或乘元武",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L032",
      "original_quote": "白虎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L033",
      "original_quote": "主水土凝結而為雪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L034",
      "original_quote": "空亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L035",
      "original_quote": "入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L036",
      "original_quote": "主陰寒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L037",
      "original_quote": "更看白虎猖狂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L038",
      "original_quote": "主大風",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L039",
      "original_quote": "青龍逃走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L040",
      "original_quote": "主風起雲散",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L041",
      "original_quote": "無雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L042",
      "original_quote": "白入熒主冰雹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L043",
      "original_quote": "熒入白主晴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L044",
      "original_quote": "若天柱游於一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L045",
      "original_quote": "三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L046",
      "original_quote": "七宮下帶壬癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L047",
      "original_quote": "或下臨壬癸之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L048",
      "original_quote": "不見壬癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L049",
      "original_quote": "而見螣蛇者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L050",
      "original_quote": "主現虹霓不雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L051",
      "original_quote": "如落宮下臨朱雀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L052",
      "original_quote": "或落空亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L053",
      "original_quote": "主亢旱不雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYu_L054",
      "original_quote": "強求反有火災",
      "tag": []
    }
  ],
