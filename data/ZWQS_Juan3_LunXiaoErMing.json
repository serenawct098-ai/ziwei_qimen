{
  "text": "紫微斗數全書",
  "juan": "卷三",
  "section": "論小兒命",
  "entries": [
    {
      "line_id": "ZWQS_Juan3_LunXiaoErMing_L000",
      "original_quote": "論小兒命",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunXiaoErMing_L001",
      "original_quote": "論小兒命小兒博士力士上短下長，青龍將軍腮小頭圓。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunXiaoErMing_L002",
      "original_quote": "大耗鼻仰唇縮，死符病符聲高性雄。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunXiaoErMing_L003",
      "original_quote": "官府奏書逢惡曜落地無聲，白虎太歲遇七殺幼弱遭傷。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunXiaoErMing_L004",
      "original_quote": "須分生剋制化之垣，更看時祿衰敗之地，後觀關殺方知壽夭窮通。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunXiaoErMing_L005",
      "original_quote": "小兒初生，命中星辰廟旺，大小二限未行，斷其災少，易養，父母無剋。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunXiaoErMing_L006",
      "original_quote": "若命坐惡殺及纏陷弱之地，大小二限未行，斷其災多，難養，刑剋父母。",
      "tag": []
    }
  ],
