      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L168",
      "original_quote": "乙庚時在辛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L169",
      "original_quote": "丙辛時在乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L170",
      "original_quote": "丁壬時在己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L171",
      "original_quote": "戊癸時在壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L172",
      "original_quote": "一云：兌宮有丁辛者吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L173",
      "original_quote": "「交泰格」乙奇加丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L174",
      "original_quote": "乙奇加丙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L175",
      "original_quote": "遇之大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L176",
