      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L187",
      "original_quote": "參謁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L188",
      "original_quote": "求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L189",
      "original_quote": "遠行皆吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L190",
      "original_quote": "有罪者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L191",
      "original_quote": "皆逢宥釋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L192",
