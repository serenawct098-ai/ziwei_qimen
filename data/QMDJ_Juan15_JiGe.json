{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan15",
  "section": "奇門吉格",
  "entries": [
    {
      "line_id": "QMDJ_Juan15_JiGe_L000",
      "original_quote": "奇門吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L001",
      "original_quote": "「天遁」者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L002",
      "original_quote": "生門主興隆合丙奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L003",
      "original_quote": "臨下六丁是也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L004",
      "original_quote": "此遁得月華之蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L005",
      "original_quote": "宜行兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L006",
      "original_quote": "獻策",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L007",
      "original_quote": "攝王侯之權",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L008",
      "original_quote": "百事生旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L009",
      "original_quote": "又開門與六丙亦相同",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L010",
      "original_quote": "宜祭禱天神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L011",
      "original_quote": "「地遁」者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L012",
      "original_quote": "開門合乙奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L013",
      "original_quote": "臨地下六己是也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L014",
      "original_quote": "此遁得日精之蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L015",
      "original_quote": "宜安葬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L016",
      "original_quote": "埋伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L017",
      "original_quote": "出門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L018",
      "original_quote": "造屋一切皆吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L019",
      "original_quote": "「人遁」者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L020",
      "original_quote": "休門與丁奇合太陰是也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L021",
      "original_quote": "此遁得星精之蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L022",
      "original_quote": "宜密探賊營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L023",
      "original_quote": "隱跡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L024",
      "original_quote": "謁貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L025",
      "original_quote": "招賢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L026",
      "original_quote": "求親",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L027",
      "original_quote": "經營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L028",
      "original_quote": "求將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L029",
      "original_quote": "對敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L030",
      "original_quote": "盟誓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L031",
      "original_quote": "吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L032",
      "original_quote": "百事和集",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L033",
      "original_quote": "「風遁」者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L034",
      "original_quote": "乙奇合休開生臨巽是也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L035",
      "original_quote": "又開丙臨巽亦是",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L036",
      "original_quote": "此時風從西北方來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L037",
      "original_quote": "名「天罡風」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L038",
      "original_quote": "宜順風擊賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L039",
      "original_quote": "以嘿吸風氣噴噀旌旄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L040",
      "original_quote": "或托異香令士卒沉聽音樂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L041",
      "original_quote": "得靈風順音爽帆之蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L042",
      "original_quote": "順風所助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L043",
      "original_quote": "如風從東來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L044",
      "original_quote": "名「雷門風」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L045",
      "original_quote": "若賊在東方不可與戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L046",
      "original_quote": "風從東南來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L047",
      "original_quote": "名「大門風」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L048",
      "original_quote": "如賊在南方亦不可與戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L049",
      "original_quote": "《參籌秘書》云：「開門乙奇臨巽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L050",
      "original_quote": "宜祭風伯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L051",
      "original_quote": "以火攻敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L052",
      "original_quote": "戰立旌旗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L053",
      "original_quote": "以候風應」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L054",
      "original_quote": "「云遁」者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L055",
      "original_quote": "乙合開休生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L056",
      "original_quote": "下臨六辛宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L057",
      "original_quote": "又乙開臨坤亦是此遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L058",
      "original_quote": "得雲精之蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L059",
      "original_quote": "宜藏形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L060",
      "original_quote": "蔽敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L061",
      "original_quote": "如雲氣形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L062",
      "original_quote": "如婦人雙手雙足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L063",
      "original_quote": "主三日有喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L064",
      "original_quote": "所臨處吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L065",
      "original_quote": "白雲在外中有黑云",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L066",
      "original_quote": "主有伏兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L067",
      "original_quote": "形似雁行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L068",
      "original_quote": "主有大將出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L069",
      "original_quote": "所臨處吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L070",
      "original_quote": "形如坐狗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L071",
      "original_quote": "有奇兵埋伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L072",
      "original_quote": "云震片片",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L073",
      "original_quote": "被風吹斷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L074",
      "original_quote": "主大敗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L075",
      "original_quote": "一云：乙休臨坤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L076",
      "original_quote": "利求雨澤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L077",
      "original_quote": "建立雲寨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L078",
      "original_quote": "制造軍器",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L079",
      "original_quote": "以候雲應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L080",
      "original_quote": "「龍遁」者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L081",
      "original_quote": "休門與乙奇臨六甲於坎宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L082",
      "original_quote": "臨六癸亦是",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L083",
      "original_quote": "此時宜祭龍神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L084",
      "original_quote": "祈求雨澤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L085",
      "original_quote": "掩捕賊人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L086",
      "original_quote": "密計渡河",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L087",
      "original_quote": "把守水口",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L088",
      "original_quote": "設機伏謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L089",
      "original_quote": "攻敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L090",
      "original_quote": "量水面",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L091",
      "original_quote": "得龍神助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L092",
      "original_quote": "又利水戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L093",
      "original_quote": "「虎遁」者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L094",
      "original_quote": "乙奇合辛臨休門於艮宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L095",
      "original_quote": "又辛儀合生臨艮亦是",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L096",
      "original_quote": "此時宜招安亡命及戰用急攻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L097",
      "original_quote": "必勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L098",
      "original_quote": "設伏游擊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L099",
      "original_quote": "藏兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L100",
      "original_quote": "計渡要害",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L101",
      "original_quote": "道路量險",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L102",
      "original_quote": "用謀得虎之威",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L103",
      "original_quote": "一云：生門丙奇合辛亦是",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L104",
      "original_quote": "利守御",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L105",
      "original_quote": "宜建立山寨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L106",
      "original_quote": "以候虎應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L107",
      "original_quote": "「神遁」者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L108",
      "original_quote": "丙奇合九天臨生門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L109",
      "original_quote": "此時宜禱神靈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L110",
      "original_quote": "行神術",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L111",
      "original_quote": "畫地布籌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L112",
      "original_quote": "禹罡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L113",
      "original_quote": "造壇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L114",
      "original_quote": "驅邪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L115",
      "original_quote": "命將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L116",
      "original_quote": "呼風召雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L117",
      "original_quote": "及制伏鬼神魔魅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L118",
      "original_quote": "得天靈百神之蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L119",
      "original_quote": "一云：「修塑神像",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L120",
      "original_quote": "神靈佑之」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L121",
      "original_quote": "「鬼遁」者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L122",
      "original_quote": "生門與丁奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L123",
      "original_quote": "九地臨艮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L124",
      "original_quote": "又乙奇合九地於杜門亦是",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L125",
      "original_quote": "此時宜哨探賊機",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L126",
      "original_quote": "偷營劫寨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L127",
      "original_quote": "設偽為伏虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L128",
      "original_quote": "驅神役鬼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L129",
      "original_quote": "得鬼神之蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L130",
      "original_quote": "一云：「開門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L131",
      "original_quote": "丁奇合九地亦是鬼遁」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L132",
      "original_quote": "三奇貴人升殿格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L133",
      "original_quote": "乙奇臨震為「日出扶桑」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L134",
      "original_quote": "有祿之鄉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L135",
      "original_quote": "是貴人升於乙卯正殿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L136",
      "original_quote": "丙奇到離為「月照端門」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L137",
      "original_quote": "火旺之地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L138",
      "original_quote": "是貴人升於丙午正殿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L139",
      "original_quote": "丁奇臨兌為「丁見西方」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L140",
      "original_quote": "天之神位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L141",
      "original_quote": "是貴人升於丁酉本殿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L142",
      "original_quote": "「三奇上吉門格」乙丙丁三奇到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L143",
      "original_quote": "而無開休生三吉門者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L144",
      "original_quote": "不可用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L145",
      "original_quote": "如三吉門到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L146",
      "original_quote": "而無三奇者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L147",
      "original_quote": "尚可用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L148",
      "original_quote": "經云：「背生向死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L149",
      "original_quote": "百戰百勝」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L150",
      "original_quote": "總之三奇吉星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L151",
      "original_quote": "吉門俱到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L152",
      "original_quote": "又不犯格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L153",
      "original_quote": "方為萬全",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L154",
      "original_quote": "若事在危急",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L155",
      "original_quote": "諸星不到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L156",
      "original_quote": "須用背生向死之法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L157",
      "original_quote": "如敵勢尚緩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L158",
      "original_quote": "候三奇吉門俱到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L159",
      "original_quote": "斯為全美矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L160",
      "original_quote": "「三奇專使格」甲己日乙奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L161",
      "original_quote": "丙辛日丙奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L162",
      "original_quote": "乙庚日丁奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L163",
      "original_quote": "丁壬日乙奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L164",
      "original_quote": "戊癸日丁奇也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L165",
      "original_quote": "以上皆吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L166",
      "original_quote": "陰陽二遁同",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_JiGe_L167",
