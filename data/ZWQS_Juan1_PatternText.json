      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定富局",
        "line_ref": "第1002行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_DingFuJu_L002",
      "original_quote": "⽇⽉夾財武守命⽇⽉來夾是也,財帛宮亦然｡",
