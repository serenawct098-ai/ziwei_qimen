      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定富局",
        "line_ref": "第1005行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_DingFuJu_L005",
      "original_quote": "⽇⽉照璧⽇⽉臨⽥宅宮是也,喜居墓庫｡",
