{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan25",
  "section": "真人閉六戊法",
  "entries": [
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L000",
      "original_quote": "真人閉六戊法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L001",
      "original_quote": "凡出軍止宿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L002",
      "original_quote": "要安營下寨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L003",
      "original_quote": "避禍逃難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L004",
      "original_quote": "當用此法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L005",
      "original_quote": "鬼神不敢近也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L006",
      "original_quote": "其法於旬中六戊土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L007",
      "original_quote": "用刀從鬼門起左行畫地一周",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L008",
      "original_quote": "次取中央土一斗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L009",
      "original_quote": "分置六戊之上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L010",
      "original_quote": "六處各置一升餘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L011",
      "original_quote": "乃置刀於原取土處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L012",
      "original_quote": "入中央咒曰：：「泰山之陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L013",
      "original_quote": "恆山之陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L014",
      "original_quote": "盜賊不起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L015",
      "original_quote": "虎狼不侵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L016",
      "original_quote": "城郭不完",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L017",
      "original_quote": "閉以金關",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L018",
      "original_quote": "千凶萬惡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L019",
      "original_quote": "莫之敢干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L020",
      "original_quote": "急急如律令敕」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L021",
      "original_quote": "咒畢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L022",
      "original_quote": "仍在中宿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L023",
      "original_quote": "勿令出入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L024",
      "original_quote": "明日啟行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L025",
      "original_quote": "拔刀散土而去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L026",
      "original_quote": "若不散土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L027",
      "original_quote": "其神不敢去也六戊即罡神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L028",
      "original_quote": "欲驗六戊之法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L029",
      "original_quote": "置犢牸於外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L030",
      "original_quote": "系母牛於內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L031",
      "original_quote": "終不敢入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L032",
      "original_quote": "欲令其神去一戊土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L033",
      "original_quote": "犢便從空上入矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L034",
      "original_quote": "甲子旬戊辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L035",
      "original_quote": "甲戌旬戊寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L036",
      "original_quote": "甲申旬戊在子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L037",
      "original_quote": "甲午旬戊在戌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L038",
      "original_quote": "甲辰旬戊在申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_Bi6WuFa_L039",
      "original_quote": "甲寅旬戊在午",
      "tag": []
    }
  ],
  "_source": {
