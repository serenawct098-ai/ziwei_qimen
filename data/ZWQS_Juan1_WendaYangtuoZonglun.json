  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L001",
      "original_quote": "羊陀二星總論",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L002",
      "original_quote": "玉蟾先生曰：擎羊陀羅二星屬火金，乃北斗浮星，在斗司奏，在數凶厄。羊化氣日刑，陀化氣日忌。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L003",
      "original_quote": "怕臨兄弟、田宅、父母三宮。忌三合臨身命，合昌曲、左右有暗痣、眼痣。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L004",
      "original_quote": "見日月女剋夫，而夫剋婦，為諸宮之凶神。忌同日月則傷親損目；刑併桃花則風流惹禍；忌貪狼合因花酒以忘身；刑與暗同行招暗疾而壞目；忌與殺暗同度招凌辱而生暗疾；與火鈴為凶伴只宜僧道；貪耗流年面上刺痕。二限更遇此，災害不時而生也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L005",
      "original_quote": "權刑合殺疾病官厄不免；",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L006",
      "original_quote": "歌曰",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L007",
      "original_quote": "刑與暗同行，暗疾刑六親，火鈴遇凶伴，只宜道與僧，權刑囚合殺，疾病災厄侵，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L008",
      "original_quote": "貪耗流年聚，面上刺痕新，限運若逢此，橫禍血刃生。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L009",
      "original_quote": "羊陀天壽殺，人遇為掃星，君子防恐懼，小人遭凌刑，遇耗決乞求，只宜林泉人，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L010",
      "original_quote": "二限倘來犯，不時災禍侵。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYangtuoZonglun_L010",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
