      "original_quote": "傷門剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L001",
      "original_quote": "加癸：陰人失財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L002",
      "original_quote": "小凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L003",
      "original_quote": "動應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L004",
      "original_quote": "開門加開：六里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L005",
      "original_quote": "十六里見貴人及鬪打者為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L006",
      "original_quote": "加休：一里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L007",
      "original_quote": "十一里逢四足畜物相鬪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L008",
      "original_quote": "婦人著皂衣及文人言功名事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L009",
      "original_quote": "加生：八里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L010",
      "original_quote": "十八里逢陰人並四足物或陽人言爭產財帛事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L011",
      "original_quote": "加傷：三里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L012",
      "original_quote": "十三里逢婦人車馬隨人弄火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L013",
      "original_quote": "加杜：四里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L014",
      "original_quote": "十四里逢陽人急唱或僧道為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L015",
      "original_quote": "加景：九里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L016",
      "original_quote": "十九里逢貴人騎馬或抱文書為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L017",
      "original_quote": "加死：二里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L018",
      "original_quote": "十二里逢老人啼哭或開土埋葬為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L019",
      "original_quote": "加驚：七里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L020",
      "original_quote": "十七里逢兄妹同行為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L021",
      "original_quote": "占身命：金水命者吉利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L022",
      "original_quote": "土命平穩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L023",
      "original_quote": "火木二命主官司",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L024",
      "original_quote": "疾病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L025",
      "original_quote": "破財不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L026",
      "original_quote": "又歌云：「見官得理",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L027",
      "original_quote": "作事欣然",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L028",
      "original_quote": "覓人得見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L029",
      "original_quote": "大利上官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L030",
      "original_quote": "求財必遂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L031",
      "original_quote": "病人易安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L032",
      "original_quote": "出行合伴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L033",
      "original_quote": "行人將還",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L034",
      "original_quote": "貿易開張",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L035",
      "original_quote": "移徙欣然",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L036",
      "original_quote": "謁貴利濟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L037",
      "original_quote": "造作獲安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L038",
      "original_quote": "百事悉吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_ShangMenKeYing_L039",
      "original_quote": "無不洞然」",
      "tag": []
