{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan21",
  "section": "天遁",
  "entries": [
    {
      "line_id": "QMDJ_Juan21_TianDun_L000",
      "original_quote": "天遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L001",
      "original_quote": "凡丙奇臨生門下合六丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L002",
      "original_quote": "不犯奇墓刑者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L003",
      "original_quote": "得月精所蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L004",
      "original_quote": "內應其心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L005",
      "original_quote": "外主其身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L006",
      "original_quote": "其氣上升於首",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L007",
      "original_quote": "其質下注於心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L008",
      "original_quote": "名曰「元珠」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L009",
      "original_quote": "能聽而修者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L010",
      "original_quote": "升天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L011",
      "original_quote": "若有事時呼玉女神名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L012",
      "original_quote": "曰丁卯而岀之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L013",
      "original_quote": "其神護之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L014",
      "original_quote": "咒曰：「丁卯玉女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L015",
      "original_quote": "護我佑我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L016",
      "original_quote": "毋令有鬼傷我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L017",
      "original_quote": "視我者瞽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L018",
      "original_quote": "惡我者反受其殃」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L019",
      "original_quote": "咒畢行之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L020",
      "original_quote": "慎勿反顧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L021",
      "original_quote": "其方可以稱王侯之權",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L022",
      "original_quote": "利朝君王",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L023",
      "original_quote": "謝蒼穹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L024",
      "original_quote": "禮求福",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L025",
      "original_quote": "及利征戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L026",
      "original_quote": "使敵自伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L027",
      "original_quote": "上書獻策",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L028",
      "original_quote": "求官進職",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L029",
      "original_quote": "修身隱跡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L030",
      "original_quote": "剪惡除凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L031",
      "original_quote": "市賈岀行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L032",
      "original_quote": "百事俱吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L033",
      "original_quote": "婚姻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L034",
      "original_quote": "入宅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L035",
      "original_quote": "來往此方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_TianDun_L036",
      "original_quote": "大吉",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
