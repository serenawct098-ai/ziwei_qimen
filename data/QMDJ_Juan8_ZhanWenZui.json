      "original_quote": "占問罪輕重",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanWenZui_L001",
      "original_quote": "以甲午辛為罪人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanWenZui_L002",
      "original_quote": "開門為問官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanWenZui_L003",
      "original_quote": "如開門落宮生甲午辛之落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanWenZui_L004",
      "original_quote": "問官憐憫不加罪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanWenZui_L005",
      "original_quote": "相比者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanWenZui_L006",
      "original_quote": "罪必輕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanWenZui_L007",
      "original_quote": "相衝剋及凶格相乘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanWenZui_L008",
      "original_quote": "罪必重",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanWenZui_L009",
      "original_quote": "若甲午辛落空亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanWenZui_L010",
      "original_quote": "得奇門吉格相救者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanWenZui_L011",
      "original_quote": "罪必赦宥",
      "tag": []
    }
