{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan7",
  "section": "占勝敗",
  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L000",
      "original_quote": "占勝敗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L001",
      "original_quote": "凡戰陣以景",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L002",
      "original_quote": "驚二門主之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L003",
      "original_quote": "經曰：景門宜破陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L004",
      "original_quote": "又治亂之法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L005",
      "original_quote": "要視驚門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L006",
      "original_quote": "當以值符所落之宮為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L007",
      "original_quote": "六庚所落之宮為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L008",
      "original_quote": "值符宮剋六庚之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L009",
      "original_quote": "主勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L010",
      "original_quote": "六庚宮剋值符之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L011",
      "original_quote": "客勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L012",
      "original_quote": "又論旺相為勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L013",
      "original_quote": "休囚為負",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L014",
      "original_quote": "如主得驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L015",
      "original_quote": "景二門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L016",
      "original_quote": "或二門宮與客宮相生則客勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L017",
      "original_quote": "如主客宮相生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L018",
      "original_quote": "來必講和",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L019",
      "original_quote": "如主客所乘皆旺相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L020",
      "original_quote": "俱得二門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L021",
      "original_quote": "不相刑剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L022",
      "original_quote": "其力相等",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L023",
      "original_quote": "則兩相恐懼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L024",
      "original_quote": "不戰而退",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L025",
      "original_quote": "如六庚為值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L026",
      "original_quote": "是主客同宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L027",
      "original_quote": "二家不分勝負",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L028",
      "original_quote": "又日干加庚主勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L029",
      "original_quote": "庚加日干客勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L030",
      "original_quote": "如榖雨上元陰遁五局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L031",
      "original_quote": "丙辛日壬辰時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L032",
      "original_quote": "天柱為值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L033",
      "original_quote": "上帶六庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L034",
      "original_quote": "主二家不相勝負",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengBai_L035",
      "original_quote": "自相退避",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan7",
    "section": "占勝敗",
