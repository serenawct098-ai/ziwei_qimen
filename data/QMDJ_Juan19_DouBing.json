{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan19",
  "section": "斗柄所指",
  "entries": [
    {
      "line_id": "QMDJ_Juan19_DouBing_L000",
      "original_quote": "斗柄所指",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L001",
      "original_quote": "天罡指巳天地門以月將加時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L002",
      "original_quote": "尋天罡至巳為天地初開",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L003",
      "original_quote": "出軍行師任徘徊用兵大勝開地千里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L004",
      "original_quote": "指午坐帳宜彈琴指午為天地縱橫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L005",
      "original_quote": "不宜出軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L006",
      "original_quote": "坐帳彈琴吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L007",
      "original_quote": "指未小通亦可裁天地小通出軍亦吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L008",
      "original_quote": "指申迫爭君須忌天地爭史之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L009",
      "original_quote": "用兵須忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L010",
      "original_quote": "指酉人馬受驚骸天地閉塞之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L011",
      "original_quote": "車傷馬死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L012",
      "original_quote": "戰主大凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L013",
      "original_quote": "返來戌上指乖隔出軍主士卒乖隔傷和",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L014",
      "original_quote": "加亥天窄不稱懐用軍主損傷驚恐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L015",
      "original_quote": "指子半路魂魄散行至半路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L016",
      "original_quote": "魂魄不安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L017",
      "original_quote": "指醜途宿待明來為小通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L018",
      "original_quote": "出軍三十里待來朝任意而行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L019",
      "original_quote": "必獲大勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L020",
      "original_quote": "臨寅有喜戰獲勝行者有喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L021",
      "original_quote": "戰必大捷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L022",
      "original_quote": "到卯閉塞宜埋葬為天地閉塞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L023",
      "original_quote": "宜藏匿避之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L024",
      "original_quote": "凡事不宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L025",
      "original_quote": "複臨辰地關梁塞關梁閉塞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L026",
      "original_quote": "只可安營下寨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L027",
      "original_quote": "不可妄動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DouBing_L028",
      "original_quote": "掌上兵機仔細排",
      "tag": []
    }
  ],
  "_source": {
