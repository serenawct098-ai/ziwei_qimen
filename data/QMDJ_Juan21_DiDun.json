{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan21",
  "section": "地遁",
  "entries": [
    {
      "line_id": "QMDJ_Juan21_DiDun_L000",
      "original_quote": "地遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L001",
      "original_quote": "凡乙奇與開門合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L002",
      "original_quote": "下臨六己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L003",
      "original_quote": "得日精所蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L004",
      "original_quote": "其氣黃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L005",
      "original_quote": "內應其脾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L006",
      "original_quote": "外應其形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L007",
      "original_quote": "任呼應用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L008",
      "original_quote": "又名黃婆金公",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L009",
      "original_quote": "能修之者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L010",
      "original_quote": "南宮列仙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L011",
      "original_quote": "有事時呼本旬玉女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L012",
      "original_quote": "依前法咒之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L013",
      "original_quote": "大護其驗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L014",
      "original_quote": "出紫庭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L015",
      "original_quote": "蓋己為地戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L016",
      "original_quote": "得日精蓋之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L017",
      "original_quote": "其方可以藏兵伏將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L018",
      "original_quote": "扎寨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L019",
      "original_quote": "安營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L020",
      "original_quote": "建府",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L021",
      "original_quote": "造倉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L022",
      "original_quote": "築垣牆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L023",
      "original_quote": "安墳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L024",
      "original_quote": "開壙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L025",
      "original_quote": "修道求仙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L026",
      "original_quote": "逃亡絕跡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L027",
      "original_quote": "出陣攻城",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L028",
      "original_quote": "全師捷勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_DiDun_L029",
      "original_quote": "百事大吉",
      "tag": []
    }
  ],
