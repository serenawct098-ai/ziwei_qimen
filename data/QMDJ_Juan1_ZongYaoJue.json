{
  "text": "奇門遁甲秘笈大全",
  "juan": "卷一",
  "section": "奇門總要訣",
  "entries": [
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L000",
      "original_quote": "奇門總要訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L001",
      "original_quote": "陰陽順逆妙難窮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L002",
      "original_quote": "二至還歸一九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L003",
      "original_quote": "若能了達陰陽理",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L004",
      "original_quote": "天地都來一掌中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L005",
      "original_quote": "三才變化作三元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L006",
      "original_quote": "八卦分為八遁門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L007",
      "original_quote": "星符每逐十干轉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L008",
      "original_quote": "值使常從天乙奔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L009",
      "original_quote": "六儀六甲本同名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L010",
      "original_quote": "三奇即是乙丙丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L011",
      "original_quote": "三奇若合開休生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L012",
      "original_quote": "便是吉門利出行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L013",
      "original_quote": "萬事從之無不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L014",
      "original_quote": "能知玄妙得其靈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L015",
      "original_quote": "值符前三六合位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L016",
      "original_quote": "前二太陰須切記",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L017",
      "original_quote": "值符後一為九天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L018",
      "original_quote": "後二之宮為九地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L019",
      "original_quote": "地可伏匿天揚兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L020",
      "original_quote": "六合太陰可藏避",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L021",
      "original_quote": "急從神兮緩從門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L022",
      "original_quote": "三五反複天道利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L023",
      "original_quote": "以上雖得三奇妙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L024",
      "original_quote": "不如更得三奇使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L025",
      "original_quote": "得使猶來未為精",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L026",
      "original_quote": "五不遇時損光明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L027",
      "original_quote": "用事須憂時剋日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L028",
      "original_quote": "反伏吟格猶不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L029",
      "original_quote": "掩捕逃亡須格時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L030",
      "original_quote": "占稽行人信豈失",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L031",
      "original_quote": "斗中三奇游六儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L032",
      "original_quote": "天乙會合主陰私",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L033",
      "original_quote": "討捕須用時下剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L034",
      "original_quote": "行人信息遇三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L035",
      "original_quote": "三奇上見游六儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L036",
      "original_quote": "六儀更見五陽時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L037",
      "original_quote": "兼向八門尋吉位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L038",
      "original_quote": "萬事開三萬事宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L039",
      "original_quote": "五陽在前五陰後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L040",
      "original_quote": "主客須知有盛衰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L041",
      "original_quote": "陰後五干君須記",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L042",
      "original_quote": "六儀加著更無利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L043",
      "original_quote": "六儀忽然加三宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L044",
      "original_quote": "便為擊刑先須記",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L045",
      "original_quote": "六儀擊刑三奇墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L046",
      "original_quote": "此時舉動可憚懼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L047",
      "original_quote": "太白入熒賊即來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L048",
      "original_quote": "熒入太白賊即去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L049",
      "original_quote": "丙為悖兮庚為格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L050",
      "original_quote": "格則不通悖亂逆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L051",
      "original_quote": "庚加日乾為伏乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L052",
      "original_quote": "日乾加庚飛幹格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L053",
      "original_quote": "庚加值符天乙伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L054",
      "original_quote": "值符加庚天乙飛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L055",
      "original_quote": "加己為刑遁上格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L056",
      "original_quote": "加癸路中見疑格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L057",
      "original_quote": "加壬之時為小格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L058",
      "original_quote": "又嫌年月日時逢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L059",
      "original_quote": "當此之時最不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L060",
      "original_quote": "舉動行師皆不宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L061",
      "original_quote": "丙為甲兮鳥跌穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L062",
      "original_quote": "甲加丙兮龍返首",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L063",
      "original_quote": "辛加乙兮虎猖狂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L064",
      "original_quote": "乙加辛兮龍逃走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L065",
      "original_quote": "丁加癸兮鳥投江",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L066",
      "original_quote": "癸加丁兮蛇夭矯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L067",
      "original_quote": "符加丙兮為相佐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L068",
      "original_quote": "時加六丁為守星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L069",
      "original_quote": "丙合戊開為天遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L070",
      "original_quote": "地遁乙合入開宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L071",
      "original_quote": "休承丁乙太陰人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L072",
      "original_quote": "天網四張時加癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L073",
      "original_quote": "蓬加英上為返吟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L074",
      "original_quote": "伏吟之時蓬加蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L075",
      "original_quote": "吉宿逢之事不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L076",
      "original_quote": "凶宿逢之事愈凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L077",
      "original_quote": "天輔衝任禽心吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L078",
      "original_quote": "天蓬天芮英柱凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L079",
      "original_quote": "陰宿天心英柱芮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L080",
      "original_quote": "陽星衝輔禽任蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L081",
      "original_quote": "天網四張無走路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L082",
      "original_quote": "陰陽順逆妙無窮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L083",
      "original_quote": "節氣推移時候定",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L084",
      "original_quote": "二至還鄉一九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L085",
      "original_quote": "三元超接游六儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L086",
      "original_quote": "八卦周流遍九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L087",
      "original_quote": "若能了達陰陽理",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_ZongYaoJue_L088",
      "original_quote": "天地消詳一掌中",
      "tag": []
    }
  ],
