      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_3DeJiFang_L009",
      "original_quote": "諸方事出陰德方入陽德方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_3DeJiFang_L010",
