      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_3DeJiFang_L003",
      "original_quote": "陰德方乙乙庚丁丁壬辛辛甲癸癸丙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_3DeJiFang_L004",
      "original_quote": "人德方庚辛干壬癸艮甲乙巽丙丁坤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_3DeJiFang_L005",
      "original_quote": "凡為百事",
