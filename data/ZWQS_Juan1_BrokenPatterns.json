      }
    },
    {
      "line_id": "ZWQS_Juan1_BrokenPatterns_L001",
      "original_quote": "⼗⼆宮諸星失陷破格訣⼦丑安命⼦午天機丑巨鈴,此星落陷果為真,縱然化吉更為美,任他富貴不清寧｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星失陷破格訣",
        "line_ref": "未知"
      }
    },
    {
      "line_id": "ZWQS_Juan1_BrokenPatterns_L002",
      "original_quote": "寅安命寅上機昌曲⽉逢,雖然吉拱不豐隆,男為伴僕女娼婢,若非夭折即貧窮｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星失陷破格訣",
        "line_ref": "未知"
      }
    },
    {
      "line_id": "ZWQS_Juan1_BrokenPatterns_L003",
      "original_quote": "卯辰安命卯上太陰擎⽺逢,辰宮巨宿紫微同,縱然化吉非全美,若非加殺到頭凶｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星失陷破格訣",
        "line_ref": "未知"
      }
    },
    {
      "line_id": "ZWQS_Juan1_BrokenPatterns_L004",
      "original_quote": "已安命已宮武⽉天梁巨,貪宿廉貞共到蛇,三⽅吉曜皆不貴,下賤貧窮度歲華｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星失陷破格訣",
        "line_ref": "未知"
      }
    },
    {
      "line_id": "ZWQS_Juan1_BrokenPatterns_L005",
      "original_quote": "午安命午宮貪巨⽉昌從,⽺刃三合最嫌沖,雖然化吉居仕路,橫破橫成到老窮｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星失陷破格訣",
        "line_ref": "未知"
      }
    },
    {
      "line_id": "ZWQS_Juan1_BrokenPatterns_L006",
      "original_quote": "未安命未宮巨宿太陽嫌,縱少災危有剋傷,勞碌奔波官事⾄,隨緣下賤度時光｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星失陷破格訣",
        "line_ref": "未知"
      }
    },
    {
      "line_id": "ZWQS_Juan1_BrokenPatterns_L007",
      "original_quote": "申⻄安命申宮機巨為破格,男⼈浪蕩女⼈貧,⼆宮若然桃花⾒,男女逢之總不榮｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星失陷破格訣",
        "line_ref": "未知"
      }
    },
    {
      "line_id": "ZWQS_Juan1_BrokenPatterns_L008",
      "original_quote": "戍安命戌上紫破若相逢,天同太陽皆主凶,若還孤寒更殀折,隨緣勤苦免貧窮｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星失陷破格訣",
        "line_ref": "未知"
      }
    },
    {
      "line_id": "ZWQS_Juan1_BrokenPatterns_L009",
      "original_quote": "亥安命亥宮貪火天梁同,飄蕩浪⼦走⻄東,若還富貴也年促,不然隸僕與貧窮｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星失陷破格訣",
        "line_ref": "未知"
      }
    }
  ],
