{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan27",
  "section": "敗氣",
  "entries": [
    {
      "line_id": "QMDJ_Juan27_BaiQi_L000",
      "original_quote": "敗氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L001",
      "original_quote": "營上氣囚廢枯散",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L002",
      "original_quote": "或如馬肝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L003",
      "original_quote": "如死灰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L004",
      "original_quote": "如敗車不起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L005",
      "original_quote": "如臥牛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L006",
      "original_quote": "如敗屋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L007",
      "original_quote": "皆敗氣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L008",
      "original_quote": "或蓋道敝蒙盡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L009",
      "original_quote": "暝飯不及食",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L010",
      "original_quote": "炊不及熟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L011",
      "original_quote": "即急去之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L012",
      "original_quote": "或黑如壤山墮軍壘營頭星也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L013",
      "original_quote": "或白雲如群鳥起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L014",
      "original_quote": "趨入屯營結連",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L015",
      "original_quote": "百里不絕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L016",
      "original_quote": "須臾不見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L017",
      "original_quote": "主他國來降",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L018",
      "original_quote": "氣如群鳥亂飛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L019",
      "original_quote": "如粉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L020",
      "original_quote": "如塵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L021",
      "original_quote": "如煙燔生草",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L022",
      "original_quote": "前銳後敗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L023",
      "original_quote": "如枯蓬轉者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L024",
      "original_quote": "急擊之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L025",
      "original_quote": "雲如偃蓋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L026",
      "original_quote": "如偃魚臨於軍上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L027",
      "original_quote": "如群羊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L028",
      "original_quote": "群豬在氣中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L029",
      "original_quote": "在十里以外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L030",
      "original_quote": "望念軍上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L031",
      "original_quote": "氣多而前白後青",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L032",
      "original_quote": "或基兒臨營上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L033",
      "original_quote": "如馬在氣中漸漸入營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L034",
      "original_quote": "如只蛇委曲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L035",
      "original_quote": "如群狐驚奔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L036",
      "original_quote": "或赤光從天流下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L037",
      "original_quote": "如氣發連夜照人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L038",
      "original_quote": "或如卷席",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L039",
      "original_quote": "如灰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L040",
      "original_quote": "如人臥無手無足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L041",
      "original_quote": "如飛鳥亂飛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L042",
      "original_quote": "如覆船車蓋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L043",
      "original_quote": "如敗提",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L044",
      "original_quote": "如霧始起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L045",
      "original_quote": "聚散出沒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L046",
      "original_quote": "如十十五五妙手相向",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L047",
      "original_quote": "又氣出而半絕將敗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L048",
      "original_quote": "氣漸盡將走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_BaiQi_L049",
      "original_quote": "皆敗走逃奔之象",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan27",
    "section": "敗氣",
    "line_id_start": "QMDJ_Juan27_BaiQi_L000",
    "line_id_end": "QMDJ_Juan27_BaiQi_L049"
