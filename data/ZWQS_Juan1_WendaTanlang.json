{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "星垣問答論_Tanlang",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L001",
      "original_quote": "問貪狼所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L002",
      "original_quote": "答曰：貪狼北斗解厄之神，第一星也。屬水，化氣為桃花，為標準，乃主禍福之神。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L003",
      "original_quote": "受善惡定奸詐瞞人，授學神仙之術。又好高吟浮蕩，作巧成拙。入廟樂之宮，可為祥可為禍。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L004",
      "original_quote": "會破軍迷花戀酒而喪命，同祿存可吉。遇耗因以虛花，遇廉貞也不潔，見七殺或配以遭刑。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L005",
      "original_quote": "遇羊陀主疾，逢刑忌有斑痕，二限為禍非輕。與七殺同守身命，男有穿窬之體，女有偷香之態。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L006",
      "original_quote": "諸吉壓不能為福，眾凶聚愈藏其奸。以事藏機，虛花無實。與人交厚者薄，而薄者又厚。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L007",
      "original_quote": "故云：七殺守身終是天，貪狼入廟必為娼。若身命與破軍同居，更居三合之鄉生旺之地，男好飲而賭博游蕩，好女無媒而自嫁，淫奔私竊，輕則隨客奔馳，重則遊於歌妓。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L008",
      "original_quote": "喜見空亡，返主端正。若與武曲同度，為人諂佞奸貪，每存肥己之心，並無濟人之意。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L009",
      "original_quote": "與貞同，公庭必定遭刑。四殺同，定為屠宰。羊陀交併，必作風流之鬼。昌曲同度，必多虛而少實。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L010",
      "original_quote": "與七殺同纏，男女淫邪虛花。巨門交戰，口舌是非常有。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L011",
      "original_quote": "若犯帝座，無制便為無益之人。得輔弼昌曲夾制，則無此論。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L012",
      "original_quote": "陷地逢生又生祥瑞，雖家顛也發一時之財。惟會火鈴能富貴，美在財帛與武曲太陰同，終非所自發，則為淫佚。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L012",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L013",
      "original_quote": "在兄弟子女，俱為陷地。在田宅則破蕩祖業，先富後貧。奴僕居於廟旺，必因奴僕所破。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L013",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L014",
      "original_quote": "夫妻宮男女俱不得美，疾厄與羊陀暗殺交併，酒色之病。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L014",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L015",
      "original_quote": "遷移若坐火鄉，破軍暗殺併，流年歲殺疊併，則主遭兵火賊盜相侵。總而言之，男女非得地之星，不見尤妙。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L015",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L016",
      "original_quote": "希夷先生曰：貪狼為北斗解厄之神，陟明之星，其氣屬木，體屬水，故化氣為桃花。乃主禍福之神，在數則樂為放蕩之事。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L016",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L017",
      "original_quote": "遇吉則主富貴，遇凶則主虛浮。主人矮小，性剛猛威，機深謀遠，隨波逐浪，愛憎難定。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L017",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTanlang_L018",
      "original_quote": "居廟旺遇火星武職權貴，戊己生人合局。遇天相延壽，會廉武巧藝，得祿存僧道宜之。破殺相沖，飄蓬度日。女人刑剋不潔，遇太陰則主淫佚。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTanlang_L018",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "星垣問答論-Tanlang星部分完成"
}