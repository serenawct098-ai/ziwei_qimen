      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianPengStar_L001",
      "original_quote": "訟庭爭競遇天蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianPengStar_L002",
      "original_quote": "勝捷名威萬里同",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianPengStar_L003",
      "original_quote": "春夏用之皆大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianPengStar_L004",
      "original_quote": "秋冬用之半為凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianPengStar_L005",
      "original_quote": "嫁娶遠行皆不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianPengStar_L006",
      "original_quote": "修造埋葬亦閒空",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianPengStar_L007",
      "original_quote": "須得生門同丙乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan2_TianPengStar_L008",
      "original_quote": "用之萬事得昌隆",
      "tag": []
    },
    {
