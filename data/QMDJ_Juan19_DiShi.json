  "entries": [
    {
      "line_id": "QMDJ_Juan19_DiShi_L000",
      "original_quote": "敵使虛實",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DiShi_L001",
      "original_quote": "敵有使來看日辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DiShi_L002",
      "original_quote": "日上為客辰主人辰實時也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DiShi_L003",
      "original_quote": "日乾上神辰剋辰上日剋時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DiShi_L004",
      "original_quote": "其言虛謬不可聞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DiShi_L005",
      "original_quote": "若是辰上剋日上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DiShi_L006",
      "original_quote": "彼必畏我言詞真",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DiShi_L007",
      "original_quote": "朱空太陰日辰上乘日上主彼詐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DiShi_L008",
      "original_quote": "乘辰上主我詐",
      "tag": []
    }
  ],
