    {
      "line_id": "QMDJ_Juan9_ZhanLiuXu_L004",
      "original_quote": "船以傷門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanLiuXu_L005",
      "original_quote": "天衝主之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanLiuXu_L006",
      "original_quote": "牛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanLiuXu_L007",
      "original_quote": "羊以死門主之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanLiuXu_L008",
      "original_quote": "看落天盤何宮?即往何方尋之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanLiuXu_L009",
      "original_quote": "馬以干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanLiuXu_L010",
      "original_quote": "兌宮所得之星主之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanLiuXu_L011",
      "original_quote": "若得天蓬星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanLiuXu_L012",
      "original_quote": "當於近水處尋之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanLiuXu_L013",
      "original_quote": "如乘元武為人盜去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanLiuXu_L014",
      "original_quote": "再看得之之日必逢庚格",
      "tag": []
    }
