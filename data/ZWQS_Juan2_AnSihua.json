      }
    },
    {
      "line_id": "ZWQS_Juan2_AnSihua_L003",
      "original_quote": "壬梁紫府武宿是，癸破巨陰貪狼停。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
