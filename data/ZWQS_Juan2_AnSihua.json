{
  "text": "紫微斗數全書",
  "juan": "卷二",
  "section": "安祿權科忌訣",
  "entries": [
    {
      "line_id": "ZWQS_Juan2_AnSihua_L001",
      "original_quote": "甲廉破武陽為伴，乙機梁紫月交侵，丙同機昌廉貞位，丁月同機巨門尋，",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_AnSihua_L002",
      "original_quote": "戊貪月弼機為主，己武貪梁曲最平，庚日武陰同為首，辛巨陽曲昌至臨，",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_AnSihua_L003",
      "original_quote": "壬梁紫府武宿是，癸破巨陰貪狼停。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_AnSihua_L004",
      "original_quote": "如甲生人廉貞化祿、破軍化權、武曲化科、太陽化忌是也，餘倣此。",
      "tag": []
    }
  ],
  "_extraction_status": "安祿權科忌訣完成"
}