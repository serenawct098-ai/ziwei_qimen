{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan21",
  "section": "遁甲神機賦",
  "entries": [
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L000",
      "original_quote": "遁甲神機賦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L001",
      "original_quote": "兩儀主使三才攸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L002",
      "original_quote": "分步咒攝乎鬼神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L003",
      "original_quote": "存局通乎妙旨前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L004",
      "original_quote": "修刪簡靈文",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L005",
      "original_quote": "裁整諸經要理原",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L006",
      "original_quote": "夫甲加丙兮龍回首",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L007",
      "original_quote": "丙加甲兮鳥跌穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L008",
      "original_quote": "回首則喜悅易遂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L009",
      "original_quote": "跌穴則顯灼易成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L010",
      "original_quote": "身殘毀兮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L011",
      "original_quote": "乙遇辛而龍逃走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L012",
      "original_quote": "財虛耗兮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L013",
      "original_quote": "辛遇乙而虎猖狂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L014",
      "original_quote": "癸見丁兮螣蛇躍蹻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L015",
      "original_quote": "丁見癸兮朱雀投江",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L016",
      "original_quote": "生臨丙戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L017",
      "original_quote": "天遁用兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L018",
      "original_quote": "開乙臨己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L019",
      "original_quote": "地遁安墳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L020",
      "original_quote": "休丁遇太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L021",
      "original_quote": "人遁安營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L022",
      "original_quote": "伏乾格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L023",
      "original_quote": "庚臨日乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L024",
      "original_quote": "飛幹格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L025",
      "original_quote": "日乾臨庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L026",
      "original_quote": "庚臨直符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L027",
      "original_quote": "伏乾格之名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L028",
      "original_quote": "直符臨庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L029",
      "original_quote": "飛宮格之說",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L030",
      "original_quote": "大格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L031",
      "original_quote": "庚臨六癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L032",
      "original_quote": "刑格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L033",
      "original_quote": "庚臨六己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L034",
      "original_quote": "按格所向既凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L035",
      "original_quote": "百事營為不善",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L036",
      "original_quote": "時剋日乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L037",
      "original_quote": "乃五不遇而災生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L038",
      "original_quote": "丙奇臨時幹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L039",
      "original_quote": "名為悖逆而禍起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L040",
      "original_quote": "三奇得使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L041",
      "original_quote": "衆善皆臻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L042",
      "original_quote": "六儀擊刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L043",
      "original_quote": "百凶俱集",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L044",
      "original_quote": "太白入熒賊即來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L045",
      "original_quote": "火入金鄉賊即去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L046",
      "original_quote": "地羅遮障不宜前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L047",
      "original_quote": "天網四張無走路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L048",
      "original_quote": "直符宮同天乙位而取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L049",
      "original_quote": "如逢急難宜從直符方而行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L050",
      "original_quote": "二至順逆妙理玄微",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L051",
      "original_quote": "陽符左為前數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L052",
      "original_quote": "陰符右為前尋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L053",
      "original_quote": "陽遁從冬至前一十二氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L054",
      "original_quote": "直符後一為九天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L055",
      "original_quote": "後二為九地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L056",
      "original_quote": "前三為六合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L057",
      "original_quote": "前二為太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L058",
      "original_quote": "陰遁從夏至前一十二氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L059",
      "original_quote": "直符前一為九天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L060",
      "original_quote": "前二為九地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L061",
      "original_quote": "前五為六合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L062",
      "original_quote": "前七為太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L063",
      "original_quote": "太陰潛形而隱遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L064",
      "original_quote": "六合遁身而謀議",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L065",
      "original_quote": "九天之上揚威武",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L066",
      "original_quote": "九地之下匿兵馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L067",
      "original_quote": "天地備兮難量",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L068",
      "original_quote": "神機妙兮莫測",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L069",
      "original_quote": "學者欲臨事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L070",
      "original_quote": "有謀存心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ShenJiFu_L071",
      "original_quote": "斯賦無惑",
      "tag": []
    }
  ],
