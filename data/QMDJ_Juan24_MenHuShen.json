{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan24",
  "section": "遁甲門戶神名",
  "entries": [
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L000",
      "original_quote": "遁甲門戶神名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L001",
      "original_quote": "遁甲門戶神名出軍行事並宜用之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L002",
      "original_quote": "甲子旬門名徐儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L003",
      "original_quote": "戶名公孫齊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L004",
      "original_quote": "解衣去吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L005",
      "original_quote": "甲戌旬門名天可",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L006",
      "original_quote": "戶名徐可",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L007",
      "original_quote": "仰天大呼吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L008",
      "original_quote": "甲申旬門名司馬光",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L009",
      "original_quote": "戶名石戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L010",
      "original_quote": "解衣去吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L011",
      "original_quote": "甲午旬門名石家",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L012",
      "original_quote": "戶名子可",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L013",
      "original_quote": "解衣振迅而去吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L014",
      "original_quote": "甲辰旬門名公孫錯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L015",
      "original_quote": "戶名司馬勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L016",
      "original_quote": "解發更結而去吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L017",
      "original_quote": "甲寅旬門名公孫光",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L018",
      "original_quote": "戶名司馬強",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L019",
      "original_quote": "解帶而去吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L020",
      "original_quote": "大將出入及行兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L021",
      "original_quote": "無問多少",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L022",
      "original_quote": "往止之方必有法度也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L023",
      "original_quote": "以六為法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L024",
      "original_quote": "大將列士卒左旋入太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L025",
      "original_quote": "呼門戶神名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L026",
      "original_quote": "咒曰：「某甲有急",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L027",
      "original_quote": "請神佐我佑我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L028",
      "original_quote": "匿我藏我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L029",
      "original_quote": "毋使敵傷我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L030",
      "original_quote": "覆我蓋我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L031",
      "original_quote": "五兵推折",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L032",
      "original_quote": "毋令至我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L033",
      "original_quote": "當我者死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L034",
      "original_quote": "視我者亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L035",
      "original_quote": "使敵人冥冥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L036",
      "original_quote": "默默視我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L037",
      "original_quote": "迷惑為我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L038",
      "original_quote": "亂其魂魄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L039",
      "original_quote": "使敵人不敢起」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L040",
      "original_quote": "念咒訖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L041",
      "original_quote": "令士卒左旋直去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L042",
      "original_quote": "勿反顧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L043",
      "original_quote": "藏於六癸之下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L044",
      "original_quote": "如甲子六癸在酉之類",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_MenHuShen_L045",
      "original_quote": "餘仿此",
      "tag": []
    }
  ],
