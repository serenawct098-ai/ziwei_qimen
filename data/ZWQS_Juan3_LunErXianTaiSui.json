  "section": "論二限太歲吉凶",
  "entries": [
    {
      "line_id": "ZWQS_Juan3_LunErXianTaiSui_L000",
      "original_quote": "論二限太歲吉凶",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論二限太歲吉凶",
        "line_ref": "第84行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunErXianTaiSui_L001",
      "original_quote": "論二限太歲吉凶須詳大限獨守吉凶何如，小限獨守吉凶何如，太歲獨守吉凶何如。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論二限太歲吉凶",
        "line_ref": "未知"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunErXianTaiSui_L002",
      "original_quote": "如歲限俱凶則凶。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論二限太歲吉凶",
        "line_ref": "第85行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunErXianTaiSui_L003",
      "original_quote": "又看大限與小限相逢吉凶何如，大限逢太歲吉凶何如，小限逢太歲吉凶何如，禍福所定。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論二限太歲吉凶",
        "line_ref": "第85行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunErXianTaiSui_L004",
      "original_quote": "又看太歲沖大限小限，太歲沖羊陀七殺，然後可斷吉凶。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論二限太歲吉凶",
        "line_ref": "第85行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunErXianTaiSui_L005",
      "original_quote": "論行限分南北斗陽男陰女南斗為福。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論二限太歲吉凶",
        "line_ref": "未知"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunErXianTaiSui_L006",
      "original_quote": "陰男陽女北斗為福。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論二限太歲吉凶",
        "line_ref": "第88行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunErXianTaiSui_L007",
      "original_quote": "北斗諸星吉凶，大限斷上五年應•小限斷上半年應。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論二限太歲吉凶",
        "line_ref": "第89行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunErXianTaiSui_L008",
      "original_quote": "南斗諸星吉凶，大限斷下五年應，小限斷下半年應。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論二限太歲吉凶",
        "line_ref": "第90行"
      }
    }
