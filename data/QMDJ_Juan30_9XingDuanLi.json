{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "九星飛宮斷例",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L000",
      "original_quote": "九星飛宮斷例",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L001",
      "original_quote": "太乙雖名凶惡星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L002",
      "original_quote": "兵亡將敗至憂驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L003",
      "original_quote": "札寨安營須大忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L004",
      "original_quote": "倘逢吉曜轉凶星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L005",
      "original_quote": "青龍臨處利求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L006",
      "original_quote": "出入逢之事必諧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L007",
      "original_quote": "布陣行軍百勝吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L008",
      "original_quote": "修營嫁娶福齊來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L009",
      "original_quote": "太陰本是水之精",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L010",
      "original_quote": "出入無阻坦蕩行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L011",
      "original_quote": "若遇陰人尤大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L012",
      "original_quote": "行兵百事盡歡欣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L013",
      "original_quote": "天乙偏宜見貴人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L014",
      "original_quote": "用事求謀總遂心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L015",
      "original_quote": "更出此方無所慮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L016",
      "original_quote": "身名必定得天恩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L017",
      "original_quote": "招搖如遇入中宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L018",
      "original_quote": "知者將軍莫交鋒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L019",
      "original_quote": "無論王侯共宰相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L020",
      "original_quote": "徒勞心力不成功",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L021",
      "original_quote": "天符方上恐邅迍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L022",
      "original_quote": "避忌此宮大不寧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L023",
      "original_quote": "倘能用力禳酧過",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L024",
      "original_quote": "不然五鬼不容情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L025",
      "original_quote": "軒轅遇著最艱難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L026",
      "original_quote": "百事謀為遂傷殘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L027",
      "original_quote": "出入定當防有火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L028",
      "original_quote": "暗損明傷定不還",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L029",
      "original_quote": "咸池惡煞凶神隨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L030",
      "original_quote": "蛇虎重重遭困圍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L031",
      "original_quote": "此方遠近宜穿井",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L032",
      "original_quote": "其它用事恐傷悲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L033",
      "original_quote": "攝提方上主多災",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L034",
      "original_quote": "腳腿多憂坎坷災",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L035",
      "original_quote": "若此行路定無吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingDuanLi_L036",
      "original_quote": "兵家切忌去艱來",
      "tag": []
    }
  ],
