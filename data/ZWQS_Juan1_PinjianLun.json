{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "十二宮諸星失陷貧賤論",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L000",
      "original_quote": "⼗⼆宮諸星失陷貧賤論",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L001",
      "original_quote": "丑未巨機為值福,失陷此⽉福須輕,卯⻄不喜逢⽺刃,辰戌紫破朝",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L002",
      "original_quote": "羅網,",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L003",
      "original_quote": "辰休戌囚貪貞陷,午宮陰巨不堪稱,申宮合武為下格,⻄逢機巨⽇",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L004",
      "original_quote": "無精,",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L005",
      "original_quote": "卯辰⺒午逢陰宿,戌亥逢陽亦不容為清,",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L006",
      "original_quote": "加殺遇劫為奸盜,此是刑邪不必論中平,",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L007",
      "original_quote": "命纏弱地休逢忌,空劫擎⽺加火鈴,貪殺已亥居陷地,貪狼化祿居四墓,若非天折主下賤,破軍卯酉不",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L008",
      "original_quote": ",縱然遇吉亦",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L009",
      "original_quote": ",六畜之命不",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L010",
      "original_quote": "可平,",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L011",
      "original_quote": "得明｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_PinjianLun_L012",
      "original_quote": "旺地發福終遠⼤,陷地崢嶸到底傾,⼆論不過五百字,富貴貧賤別",
      "tag": []
    }
  ],
  "_extraction_status": "十二宮諸星失陷貧賤論完成"
}