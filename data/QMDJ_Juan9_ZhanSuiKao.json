    {
      "line_id": "QMDJ_Juan9_ZhanSuiKao_L010",
      "original_quote": "主二等",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanSuiKao_L011",
      "original_quote": "得門不得奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanSuiKao_L012",
      "original_quote": "得奇不得門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanSuiKao_L013",
      "original_quote": "或與天輔比和者",
      "tag": []
    },
    {
