{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan21",
  "section": "都天撼龍經",
  "entries": [
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L000",
      "original_quote": "都天撼龍經",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L001",
      "original_quote": "是書謂之選宅三白之法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L002",
      "original_quote": "出自都天撼龍經八十一論",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L003",
      "original_quote": "太乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L004",
      "original_quote": "紫微",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L005",
      "original_quote": "九總",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L006",
      "original_quote": "八卦者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L007",
      "original_quote": "天地之骨髓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L008",
      "original_quote": "星斗之樞機",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L009",
      "original_quote": "八卦互變而及乎無窮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L010",
      "original_quote": "五行推移而應乎無盡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L011",
      "original_quote": "以九星為之九總",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L012",
      "original_quote": "以八門為之八卦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L013",
      "original_quote": "上可以補天地不全之化",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L014",
      "original_quote": "下可以助君王不及之功",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L015",
      "original_quote": "扶危助吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L016",
      "original_quote": "發瑞生祥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L017",
      "original_quote": "同游一十二分之經圖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L018",
      "original_quote": "又殊配二十八宿之格局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L019",
      "original_quote": "是此書者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L020",
      "original_quote": "正天地之紀綱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L021",
      "original_quote": "明陰陽之經緯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L022",
      "original_quote": "幽探賾隱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L023",
      "original_quote": "顯達通玄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L024",
      "original_quote": "試看八卦門庭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L025",
      "original_quote": "配列九宮蹊向",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L026",
      "original_quote": "推遷六甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L027",
      "original_quote": "驅使六儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L028",
      "original_quote": "天乙值符俾之運局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L029",
      "original_quote": "太乙值使使之指揮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L030",
      "original_quote": "奇以六儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L031",
      "original_quote": "遇以八節",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L032",
      "original_quote": "上下招搖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L033",
      "original_quote": "內外表應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L034",
      "original_quote": "三盤運局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L035",
      "original_quote": "八卦皆通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L036",
      "original_quote": "值其吉則萬事堪為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L037",
      "original_quote": "值其凶則一分莫舉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L038",
      "original_quote": "其一曰「都天九卦」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L039",
      "original_quote": "其二曰「入地三元」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L040",
      "original_quote": "其三曰「行軍三奇」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L041",
      "original_quote": "其四曰「選宅三白」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L042",
      "original_quote": "其五曰「遁形太白之書」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L043",
      "original_quote": "其六曰「八山撼龍之訣」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L044",
      "original_quote": "其七曰「轉山移水九字符經」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L045",
      "original_quote": "其八曰「建國安邦萬年金鏡」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L046",
      "original_quote": "其九曰「元宮」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L047",
      "original_quote": "獲福救貧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L048",
      "original_quote": "生仙產聖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L049",
      "original_quote": "變禍福如反掌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L050",
      "original_quote": "使貧富似等閒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L051",
      "original_quote": "倘三迭之遇奇門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L052",
      "original_quote": "若蛟龍之得雲雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L053",
      "original_quote": "見六合之逢格局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L054",
      "original_quote": "如狼虎之產羽翼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L055",
      "original_quote": "忌取休囚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L056",
      "original_quote": "防其刑擊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L057",
      "original_quote": "如得奇星來到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L058",
      "original_quote": "必須吉位開門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L059",
      "original_quote": "位位皆宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L060",
      "original_quote": "門門皆吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L061",
      "original_quote": "只要合得其要",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L062",
      "original_quote": "仍須各論其時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L063",
      "original_quote": "干神不囚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L064",
      "original_quote": "支神不剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L065",
      "original_quote": "神藏煞沒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L066",
      "original_quote": "方知萬事皆和",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L067",
      "original_quote": "反吟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L068",
      "original_quote": "伏吟定是千殃數集",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L069",
      "original_quote": "奇逢旺相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L070",
      "original_quote": "是為富貴之謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L071",
      "original_quote": "門逢開休",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L072",
      "original_quote": "方協英雄之應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L073",
      "original_quote": "遇青龍返首",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L074",
      "original_quote": "為甲乙之妙詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L075",
      "original_quote": "值白虎猖狂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L076",
      "original_quote": "見庚辛之凶禍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L077",
      "original_quote": "若值螣蛇妖蹻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L078",
      "original_quote": "知壬癸之崢嶸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L079",
      "original_quote": "倘逢朱雀投江",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L080",
      "original_quote": "管丙丁之妖怪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L081",
      "original_quote": "飛鳥跌穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L082",
      "original_quote": "便云百事皆祥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L083",
      "original_quote": "貴人登壇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L084",
      "original_quote": "管取九宮皆慶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L085",
      "original_quote": "通元機而天地皆轉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L086",
      "original_quote": "得妙用則觸事咸亨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L087",
      "original_quote": "若為文武官僚修造",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L088",
      "original_quote": "職位皆增",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L089",
      "original_quote": "或與良民庶士遷塋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L090",
      "original_quote": "扶危作福",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L091",
      "original_quote": "建州府而民安物泰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L092",
      "original_quote": "興縣鎮而富足租平",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L093",
      "original_quote": "立宮室而福集人依",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L094",
      "original_quote": "作廟宇而鬼安神妥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L095",
      "original_quote": "橋梁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L096",
      "original_quote": "船驛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L097",
      "original_quote": "井",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L098",
      "original_quote": "竈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L099",
      "original_quote": "路途",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L100",
      "original_quote": "或諸餘行事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L101",
      "original_quote": "在選擇周詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L102",
      "original_quote": "或有太歲將軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L103",
      "original_quote": "盡在拱手",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L104",
      "original_quote": "任是九良七煞莫敢當頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L105",
      "original_quote": "不問諸家運氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L106",
      "original_quote": "不超不開",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L107",
      "original_quote": "犯著空亡禁殺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L108",
      "original_quote": "但求此局卻要有奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L109",
      "original_quote": "可保千年",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L110",
      "original_quote": "皆招百福",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L111",
      "original_quote": "最堪動土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L112",
      "original_quote": "破土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L113",
      "original_quote": "埋宗葬祖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L114",
      "original_quote": "務有奇星到坐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L115",
      "original_quote": "門戶得開",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L116",
      "original_quote": "有青龍山者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L117",
      "original_quote": "必求反首青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L118",
      "original_quote": "有白虎者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L119",
      "original_quote": "大忌其猖狂之白虎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L120",
      "original_quote": "有元武者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L121",
      "original_quote": "遠其妖矯螣蛇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L122",
      "original_quote": "有朱雀者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L123",
      "original_quote": "怕其投江朱雀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L124",
      "original_quote": "如斯迎避",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L125",
      "original_quote": "用意配求",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L126",
      "original_quote": "值飛鳥跌穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L127",
      "original_quote": "則有異鳥遺雕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L128",
      "original_quote": "彩禽墜羽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L129",
      "original_quote": "棄其亡鳥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L130",
      "original_quote": "鶴鷺返以鱔魚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L131",
      "original_quote": "仙鶴來鳴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L132",
      "original_quote": "彩鸞下集",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L133",
      "original_quote": "四仲俱吉者吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L134",
      "original_quote": "兩頭破壞者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L135",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L136",
      "original_quote": "貴人登壇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L137",
      "original_quote": "必有旌旗相乘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L138",
      "original_quote": "雷電風雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L139",
      "original_quote": "印蠻文書",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L140",
      "original_quote": "金章紫綬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L141",
      "original_quote": "得青龍返首之日時者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L142",
      "original_quote": "當有玉鱗伏藏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L143",
      "original_quote": "金魚落穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L144",
      "original_quote": "螣蛇蜃化",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L145",
      "original_quote": "馬驟雷轟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L146",
      "original_quote": "火焰金銀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L147",
      "original_quote": "旛花結彩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L148",
      "original_quote": "來應其時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L149",
      "original_quote": "在助其吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L150",
      "original_quote": "各有剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L151",
      "original_quote": "合取山頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L152",
      "original_quote": "萬無一失之虞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L153",
      "original_quote": "動有十全之吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L154",
      "original_quote": "分其頭緒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L155",
      "original_quote": "布其提綱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L156",
      "original_quote": "俱列千端",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L157",
      "original_quote": "俢明萬事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L158",
      "original_quote": "非但謀猷之逢吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L159",
      "original_quote": "乃天地之獻祥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L160",
      "original_quote": "助國安邦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L161",
      "original_quote": "濟民利物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L162",
      "original_quote": "得之者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L163",
      "original_quote": "宜什襲於玉匱金縢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_HanLongJing_L164",
      "original_quote": "真所謂至聖皇家之重寶也",
