{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan24",
  "section": "出行呼神字入太陰中",
  "entries": [
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L000",
      "original_quote": "出行呼神字入太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L001",
      "original_quote": "凡出行者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L002",
      "original_quote": "於其所向之方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L003",
      "original_quote": "呼其神之字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L004",
      "original_quote": "而行六十步左轉入太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L005",
      "original_quote": "陽遁值前二為太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L006",
      "original_quote": "陰遁值後二為太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L007",
      "original_quote": "又六丁亦為太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L008",
      "original_quote": "呼其神字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L009",
      "original_quote": "謂所用之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L010",
      "original_quote": "天盤上所得星之字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L011",
      "original_quote": "天蓬字子禽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L012",
      "original_quote": "天芮字子成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L013",
      "original_quote": "天衝字子翹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L014",
      "original_quote": "天輔字子卿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L015",
      "original_quote": "天禽字子公",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L016",
      "original_quote": "天柱字子申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L017",
      "original_quote": "天任字子韋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L018",
      "original_quote": "天英字子威",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L019",
      "original_quote": "假如冬至上元陽遁之局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L020",
      "original_quote": "甲己之日平旦丙寅時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L021",
      "original_quote": "此時六丙在八宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L022",
      "original_quote": "以天上甲子戊天蓬加八宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L023",
      "original_quote": "欲出東北者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L024",
      "original_quote": "呼其神字曰子禽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L025",
      "original_quote": "行六十步入太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L026",
      "original_quote": "此時回二太陰臨四宮按九宮排法當在坎一宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_ChuXingHuShen_L027",
      "original_quote": "即左向入東南之類",
      "tag": []
    }
  ],
