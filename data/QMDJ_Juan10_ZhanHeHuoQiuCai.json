{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan10",
  "section": "占合伙求財",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L000",
      "original_quote": "占合伙求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L001",
      "original_quote": "以日幹落宮為我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L002",
      "original_quote": "時幹落宮為伙計",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L003",
      "original_quote": "時幹乘奇門吉格來生日乾者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L004",
      "original_quote": "則合伙有益於我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L005",
      "original_quote": "日干乘奇門吉格而生時幹者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L006",
      "original_quote": "則有益於他",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L007",
      "original_quote": "二宮相比和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L008",
      "original_quote": "主合伙公平",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L009",
      "original_quote": "各無猜忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L010",
      "original_quote": "若時干所落之宮乘凶神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L011",
      "original_quote": "凶格來剋日乾宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L012",
      "original_quote": "不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L013",
      "original_quote": "再以生門之生我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L014",
      "original_quote": "不生我詳之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHeHuoQiuCai_L015",
      "original_quote": "百無一失",
      "tag": []
    }
  ],
