      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DuHe_L003",
      "original_quote": "月將加時看三河",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DuHe_L004",
      "original_quote": "一河臨井必覆舟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DuHe_L005",
      "original_quote": "又曰：「太衝加日辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_DuHe_L006",
