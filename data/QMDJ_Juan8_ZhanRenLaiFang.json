  "entries": [
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L000",
      "original_quote": "占人來訪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L001",
      "original_quote": "以來人所來之方天盤之星為來人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L002",
      "original_quote": "為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L003",
      "original_quote": "地盤所乘之星為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L004",
      "original_quote": "為我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L005",
      "original_quote": "天盤星得奇門來生地盤之星者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L006",
      "original_quote": "為貴客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L007",
      "original_quote": "有益於我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L008",
      "original_quote": "可見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L009",
      "original_quote": "若天盤之星剋地盤星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L010",
      "original_quote": "再有凶門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L011",
      "original_quote": "凶格相乘者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L012",
      "original_quote": "必損我之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanRenLaiFang_L013",
      "original_quote": "不可見",
      "tag": []
    }
