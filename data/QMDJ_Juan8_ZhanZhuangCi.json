      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L001",
      "original_quote": "以景門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L002",
      "original_quote": "朱雀為狀詞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L003",
      "original_quote": "開門為官長",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L004",
      "original_quote": "如景",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L005",
      "original_quote": "驚二門乘旺相氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L006",
      "original_quote": "再有三奇吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L007",
      "original_quote": "主情詞懇切",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L008",
      "original_quote": "不被開門衝剋者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L009",
      "original_quote": "必准",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L010",
      "original_quote": "驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L011",
      "original_quote": "景二門不得奇儀吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L012",
      "original_quote": "再與開門衝剋者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L013",
      "original_quote": "主官嗔怒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L014",
      "original_quote": "不准",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L015",
      "original_quote": "即准",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L016",
      "original_quote": "反招罪責",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L017",
      "original_quote": "若驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L018",
      "original_quote": "景二門入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L019",
      "original_quote": "主情詞不明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L020",
      "original_quote": "不准",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L021",
      "original_quote": "驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L022",
      "original_quote": "景二門落空亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L023",
      "original_quote": "主平空捏詞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L024",
      "original_quote": "不准",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanZhuangCi_L025",
      "original_quote": "開門入墓及落空亡者",
      "tag": []
    },
    {
