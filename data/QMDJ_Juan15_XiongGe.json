{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan15",
  "section": "凶格",
  "entries": [
    {
      "line_id": "QMDJ_Juan15_XiongGe_L000",
      "original_quote": "凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L001",
      "original_quote": "「悖格」丙加值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L002",
      "original_quote": "加丙及丙加歲月日時之上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L003",
      "original_quote": "俱為悖格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L004",
      "original_quote": "主蒞政綱紀紊亂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L005",
      "original_quote": "丙加丙亦為悖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L006",
      "original_quote": "主見亂臣賊子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L007",
      "original_quote": "「天網四張」歌曰：「天網四張無路走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L008",
      "original_quote": "一二網低有路通」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L009",
      "original_quote": "如壬戌年九月癸未日癸丑時陰六局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L010",
      "original_quote": "休門與值符加時干癸於坎宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L011",
      "original_quote": "日時二干俱加離宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L012",
      "original_quote": "是為網高九尺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L013",
      "original_quote": "又曰：「天網四張不可當」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L014",
      "original_quote": "此時用事有災殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L015",
      "original_quote": "若是有人強出者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L016",
      "original_quote": "立便身眠見血光",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L017",
      "original_quote": "「地網遮格」六壬加時干六癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L018",
      "original_quote": "二網俱不宜出兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L019",
      "original_quote": "出行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L020",
      "original_quote": "大凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L021",
      "original_quote": "「高格」即「天網四張」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L022",
      "original_quote": "天上六癸加五六七八九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L023",
      "original_quote": "大凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L024",
      "original_quote": "不可用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L025",
      "original_quote": "「低格」天盤六癸加一二三四宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L026",
      "original_quote": "即匍匐而出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L027",
      "original_quote": "經曰：「天網四張",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L028",
      "original_quote": "百物自傷」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L029",
      "original_quote": "此時可舉百事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L030",
      "original_quote": "又神有高下必須知之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L031",
      "original_quote": "「伏宮格」天盤六庚加值符及地盤戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L032",
      "original_quote": "主客俱不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L033",
      "original_quote": "戰鬪兩傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L034",
      "original_quote": "「飛宮格」直符加六庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L035",
      "original_quote": "主客俱凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L036",
      "original_quote": "「時墓格」丙戌墓干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L037",
      "original_quote": "壬辰墓巽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L038",
      "original_quote": "辛丑墓艮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L039",
      "original_quote": "乙未墓坤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L040",
      "original_quote": "戊戌墓干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L041",
      "original_quote": "「迫制和義格」門剋宮為迫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L042",
      "original_quote": "宮剋門為制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L043",
      "original_quote": "門生宮為和",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L044",
      "original_quote": "宮生門為義",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L045",
      "original_quote": "「二龍相比格」六甲加六乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L046",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L047",
      "original_quote": "「青龍受困格」六甲加六戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L048",
      "original_quote": "危",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L049",
      "original_quote": "「火披水地」丙丁入乙宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L050",
      "original_quote": "萬事莫舉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L051",
      "original_quote": "「木入金鄉」乙奇臨六",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L052",
      "original_quote": "七宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L053",
      "original_quote": "萬事莫舉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L054",
      "original_quote": "「火臨金位」丙丁加干兌宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L055",
      "original_quote": "「金劈木林」庚辛臨震巽宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L056",
      "original_quote": "「木來剋土」乙奇臨坤艮宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L057",
      "original_quote": "「伏干格」庚加日干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L058",
      "original_quote": "「飛干格」日干加庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L059",
      "original_quote": "「伏吟格」本星伏本宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L060",
      "original_quote": "「反吟格」星臨對宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L061",
      "original_quote": "「奇墓格」乙到臨坤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L062",
      "original_quote": "丙奇臨干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L063",
      "original_quote": "丁奇臨艮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L064",
      "original_quote": "「六儀刑擊格」甲子戊直符加三宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L065",
      "original_quote": "甲戌己值符加二宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L066",
      "original_quote": "甲申庚加八宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L067",
      "original_quote": "甲午辛加九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L068",
      "original_quote": "甲辰壬加四宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L069",
      "original_quote": "甲寅癸值符加四宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L070",
      "original_quote": "「六儀受制」休加離",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L071",
      "original_quote": "傷杜加艮坤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L072",
      "original_quote": "景加干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L073",
      "original_quote": "兌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L074",
      "original_quote": "生死加坎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L075",
      "original_quote": "開",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L076",
      "original_quote": "驚加震",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L077",
      "original_quote": "巽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L078",
      "original_quote": "「五不遇時格」時干剋日干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L079",
      "original_quote": "「地羅占葬格」天盤壬加地盤壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L080",
      "original_quote": "「歲格」庚臨歲干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L081",
      "original_quote": "「月格」庚臨月干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L082",
      "original_quote": "「日格」庚臨日干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L083",
      "original_quote": "「時格」庚臨時干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L084",
      "original_quote": "即庚年庚月庚日庚時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L085",
      "original_quote": "「大格」庚臨六癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L086",
      "original_quote": "「小格」庚臨六壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L087",
      "original_quote": "「刑格」庚臨六己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L088",
      "original_quote": "「悖格」丙加時干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L089",
      "original_quote": "「青龍逃走」乙加辛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L090",
      "original_quote": "「白虎猖狂」辛加乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L091",
      "original_quote": "「螣蛇妖矯」癸加丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L092",
      "original_quote": "「朱雀投江」丁加癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L093",
      "original_quote": "「熒惑入太白」丙加庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan15_XiongGe_L094",
      "original_quote": "「太白入熒惑」庚加丙",
      "tag": []
    }
  ],
