      }
    },
    {
      "line_id": "QMDJ_Juan25_P002_S000",
      "original_quote": "出兵攻敵常須游門。",
      "paragraph_index": 2,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "下卷·卷二十五",
