  "section": "星垣問答論_Jumen",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaJumen_L001",
      "original_quote": "問巨門所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaJumen_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaJumen_L002",
      "original_quote": "答曰：巨門屬水、金。北斗第二星也，為陰精之星，化氣為暗。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaJumen_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaJumen_L003",
      "original_quote": "在身命一生招口舌之非；在兄弟則骨肉參商；在夫妻主於隔角，生離死別，縱夫妻有對，不免污名失節；",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaJumen_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaJumen_L004",
      "original_quote": "在子女損後方招，雖有而無；在財帛有爭競之意；在疾厄遇刑忌，眼目之災，殺臨主殘疾；",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaJumen_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaJumen_L005",
      "original_quote": "在遷移則招是非；在奴僕則多怨逆；在官祿主招刑杖；在田宅則破蕩祖業；在福德其禍稍輕；在父母則遭棄擲。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaJumen_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaJumen_L006",
      "original_quote": "希夷先生曰：巨門在天，司品萬物。在數則掌執是非，主於暗昧，疑是多非，欺瞞天地，進退兩難。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaJumen_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaJumen_L007",
      "original_quote": "其性則面是背非，六親寡合，交人初善終惡。十二宮中若無廟樂照臨，到處為災，奔波勞碌。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaJumen_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaJumen_L008",
      "original_quote": "至亥寅巳申，雖富貴亦不耐久。會太陽則吉凶相半，逢七殺則主殺傷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaJumen_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaJumen_L009",
      "original_quote": "貪耗同行，因好徒配。遇帝座則制其強。逢祿存則解其厄，值羊陀男盜女娼。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaJumen_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaJumen_L010",
      "original_quote": "對宮遇火鈴、白虎，無帝壓制，決配千里。三合殺湊，必遭火厄，此乃孤獨之數，刻剝之神。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaJumen_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaJumen_L011",
      "original_quote": "除為僧道九流，方免勞神偃蹇，限逢凶曜災難不輕。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaJumen_L011",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "星垣問答論-Jumen星部分完成"
}