{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "斗數準繩",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L001",
      "original_quote": "命居生旺定富貴，各有所宜。身坐空亡論榮枯，專求其要。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L002",
      "original_quote": "紫微帝座在南極不能施功，天府令星在南地專能為福。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L003",
      "original_quote": "天機七殺同宮也善三分，太陰火鈴同位反成十惡。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L004",
      "original_quote": "貪狼為善宿入廟不凶，巨門為惡曜得垣尤美。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L005",
      "original_quote": "諸凶在緊要之鄉最宜制剋，若在身命之位卻受孤單。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L006",
      "original_quote": "若見殺星倒限最凶大抵在人之機變，福蔭臨之庶幾可解，更加作意之推詳。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L007",
      "original_quote": "辨生剋制化以定窮通，看好惡正偏以言禍福。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L008",
      "original_quote": "官星居於福地近貴榮財，福星居於官宮卻成無用。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L009",
      "original_quote": "身命得星為要，限度遇吉為榮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L010",
      "original_quote": "若言子媳有無，專在擎羊耗殺。逢之則害妻妾亦然。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L011",
      "original_quote": "相貌逢凶必帶破相，疾厄逢忌定有尪贏。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L012",
      "original_quote": "須言定數以求玄，更在同年之相合，總為綱領用作準繩。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數準繩",
        "line_id": "ZWQS_Juan1_Zhunsheng_L012",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "斗數準繩全文完成，已根據語義斷句"
}