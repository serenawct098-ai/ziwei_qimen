      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L001",
      "original_quote": "⽃數準繩命居⽣旺定富貴,各有所宜｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第113行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L002",
      "original_quote": "⾝坐空亡論榮枯,專求其要｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第114行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L003",
      "original_quote": "紫微帝座在南極不能施功,天府令星在南地專能為福｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第115行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L004",
      "original_quote": "天機七殺同宮也善三分,太陰火鈴同位反成⼗惡｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第116行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L005",
      "original_quote": "貪狼為善宿入廟不凶,巨⾨為惡曜得垣尤美｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第117行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L006",
      "original_quote": "諸凶在緊要之鄉最宜制剋,若在⾝命之位卻受孤單｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第118行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L007",
      "original_quote": "若⾒殺星倒限最凶⼤抵在⼈之機變,福蔭臨之庶幾可解｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第119行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L008",
      "original_quote": ",更加作意之推詳｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第120行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L009",
      "original_quote": "辨⽣剋制化以定窮通,看好惡正偏以⾔禍福｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第121行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L010",
      "original_quote": "官星居於福地近貴榮財,福星居於官宮卻成無⽤｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第122行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L011",
      "original_quote": "⾝命得星為要,限度遇吉為榮｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第123行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L012",
      "original_quote": "若⾔⼦媳有無,專在擎⽺耗殺｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第124行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L013",
      "original_quote": "逢之則害妻妾亦然｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第124行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L014",
      "original_quote": "相貌逢凶必帶破相,疾厄逢忌定有尪贏｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第125行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Zhunsheng_L015",
      "original_quote": "須⾔定數以求⽞,更在同年之相合,總為綱領⽤作準繩｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數準繩",
        "line_ref": "第126行"
      }
    }
