{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan27",
  "section": "猛將氣",
  "entries": [
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L000",
      "original_quote": "猛將氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L001",
      "original_quote": "凡氣上與天連",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L002",
      "original_quote": "下有名將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L003",
      "original_quote": "抱樸子曰：猛將之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L004",
      "original_quote": "如火勢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L005",
      "original_quote": "如張弓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L006",
      "original_quote": "或白如粉絮囷倉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L007",
      "original_quote": "黑如山林竹木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L008",
      "original_quote": "或紫黑如門上樓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L009",
      "original_quote": "或上或下赤如旌旗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L010",
      "original_quote": "或氣發漸漸如雲而變作山形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L011",
      "original_quote": "或云氣如蛟蛇形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L012",
      "original_quote": "或如龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L013",
      "original_quote": "如虎在殺氣中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L014",
      "original_quote": "或內白而赤氣外繞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L015",
      "original_quote": "或中黑而赤氣在前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L016",
      "original_quote": "或勃勃然如火煙之狀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L017",
      "original_quote": "皆為悍猛謀深",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L018",
      "original_quote": "不可當在我軍上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_MengJiangQi_L019",
      "original_quote": "四速戰也",
      "tag": []
    }
  ],
  "_source": {
