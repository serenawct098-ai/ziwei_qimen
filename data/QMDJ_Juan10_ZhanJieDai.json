{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan10",
  "section": "占借貸",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L000",
      "original_quote": "占借貸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L001",
      "original_quote": "其占法以所往之方天盤所得之星為求借之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L002",
      "original_quote": "又以天盤之星所落地盤之星為借貸之家",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L003",
      "original_quote": "地盤所乘之星生天盤星者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L004",
      "original_quote": "必得借",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L005",
      "original_quote": "比和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L006",
      "original_quote": "雖借主遲疑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L007",
      "original_quote": "相剋主不借",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L008",
      "original_quote": "反惹羞辱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L009",
      "original_quote": "若天盤所得之幹入地盤墓庫者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L010",
      "original_quote": "彼寔吝嗇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L011",
      "original_quote": "不肯借入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L012",
      "original_quote": "臨空亡宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L013",
      "original_quote": "彼寔無",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanJieDai_L014",
      "original_quote": "不必去借",
      "tag": []
    }
  ],
