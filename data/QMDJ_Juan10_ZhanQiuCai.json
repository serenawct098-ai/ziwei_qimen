{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan10",
  "section": "占求財",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L000",
      "original_quote": "占求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L001",
      "original_quote": "以甲子戊為財神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L002",
      "original_quote": "生門為財方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L003",
      "original_quote": "看二宮天盤落於何方?以二方生剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L004",
      "original_quote": "比和驗其得失",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L005",
      "original_quote": "天盤甲子戊與生門落於坎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L006",
      "original_quote": "艮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L007",
      "original_quote": "震",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L008",
      "original_quote": "巽四宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L009",
      "original_quote": "陽遁為內為近",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L010",
      "original_quote": "又為速",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L011",
      "original_quote": "再得奇門吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L012",
      "original_quote": "得之必多",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L013",
      "original_quote": "若得門不得奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L014",
      "original_quote": "得奇不得門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L015",
      "original_quote": "得之不多",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L016",
      "original_quote": "門奇俱不得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L017",
      "original_quote": "不落空亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L018",
      "original_quote": "墓絕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L019",
      "original_quote": "不受地盤剋制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L020",
      "original_quote": "得之必少",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L021",
      "original_quote": "或甲子戊與生門落於一內一外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L022",
      "original_quote": "得之必遲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L023",
      "original_quote": "二宮俱在外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L024",
      "original_quote": "必求千里之財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L025",
      "original_quote": "二宮落空亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L026",
      "original_quote": "返吟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L027",
      "original_quote": "墓絕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L028",
      "original_quote": "再以凶神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L029",
      "original_quote": "凶格相並者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L030",
      "original_quote": "必不得財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanQiuCai_L031",
      "original_quote": "反遭是非",
      "tag": []
    }
  ],
