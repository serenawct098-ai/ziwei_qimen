{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan26",
  "section": "天文曆法",
  "entries": [
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L000",
      "original_quote": "天文曆法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L001",
      "original_quote": "天頂名嵩高",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L002",
      "original_quote": "夏至日道下直衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L003",
      "original_quote": "岳晷無影",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L004",
      "original_quote": "北距嵩高九度餘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L005",
      "original_quote": "陽城中距衡約二千五百里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L006",
      "original_quote": "古以二分卯酉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L007",
      "original_quote": "晷影相直",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L008",
      "original_quote": "以定東西之地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L009",
      "original_quote": "中又取夏至午中晷影與夜半窺筒北極相直",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L010",
      "original_quote": "以定南北之地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L011",
      "original_quote": "故嵩與陽城相直也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L012",
      "original_quote": "然春分前二日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L013",
      "original_quote": "太陽已纏於春分赤道度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L014",
      "original_quote": "秋分後二日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L015",
      "original_quote": "太陽方纏於赤道度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L016",
      "original_quote": "此陽常有餘也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L017",
      "original_quote": "或以陽城偏南二度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L018",
      "original_quote": "是知有數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L019",
      "original_quote": "而不知有理也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L020",
      "original_quote": "地上極天際六十一度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L021",
      "original_quote": "下五十九度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L022",
      "original_quote": "亦此意也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L023",
      "original_quote": "但知之者絕少",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L024",
      "original_quote": "故赤道橫束天中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L025",
      "original_quote": "萬古不易",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L026",
      "original_quote": "而黃道或出入者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L027",
      "original_quote": "日行之差也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L028",
      "original_quote": "春分日東至角",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L029",
      "original_quote": "秋分日西至婁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L030",
      "original_quote": "南北極各九十一度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L031",
      "original_quote": "此天之赤道分定東西南北者也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L032",
      "original_quote": "故春分日出奎婁之黃道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L033",
      "original_quote": "其道出卯入酉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L034",
      "original_quote": "秋分日出軫角之黃道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L035",
      "original_quote": "其道亦出卯入酉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L036",
      "original_quote": "至冬至在箕斗之黃道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L037",
      "original_quote": "其道出辰入申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L038",
      "original_quote": "去赤道二十四度之南",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L039",
      "original_quote": "夏至在井鬼之黃道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L040",
      "original_quote": "其道出寅入戌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L041",
      "original_quote": "去黃道二十四度之北",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L042",
      "original_quote": "此日行黃道赤道之所以分",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L043",
      "original_quote": "而二十八宿之度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L044",
      "original_quote": "皆以赤道為法也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L045",
      "original_quote": "然午令以後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L046",
      "original_quote": "日常主減",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L047",
      "original_quote": "而中天之盛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L048",
      "original_quote": "其減不覺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L049",
      "original_quote": "漢洛下閔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L050",
      "original_quote": "太初歷始有八千年差一度之說",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L051",
      "original_quote": "晉虞喜何承天阿劉准",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L052",
      "original_quote": "各定歲差之法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L053",
      "original_quote": "然未定准者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L054",
      "original_quote": "以陰漸深而氣漸促",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L055",
      "original_quote": "而差漸多也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L056",
      "original_quote": "堯典冬至日在虛七度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L057",
      "original_quote": "莊襄王元年在斗二十二度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L058",
      "original_quote": "太初年在斗二十度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L059",
      "original_quote": "開元甲子在斗十度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L060",
      "original_quote": "慶歷甲申在斗五度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L061",
      "original_quote": "開禧古測日在箕宿四度矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L062",
      "original_quote": "然冬至子半則不可移",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L063",
      "original_quote": "故天竺之法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L064",
      "original_quote": "宮分無系於宿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L065",
      "original_quote": "宿不屬於宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L066",
      "original_quote": "以其宮定",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L067",
      "original_quote": "而宿不定也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L068",
      "original_quote": "周天三百六十五度四分度之一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L069",
      "original_quote": "歲日行而天行日過分為四限",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L070",
      "original_quote": "每限九十一日三十一分",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L071",
      "original_quote": "一限為進差",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L072",
      "original_quote": "二限為退差",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L073",
      "original_quote": "二至合為四象",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L074",
      "original_quote": "曰盈初",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L075",
      "original_quote": "盈末",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L076",
      "original_quote": "縮初未也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L077",
      "original_quote": "角南星距極九十七度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L078",
      "original_quote": "亢南第二星距九十六度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L079",
      "original_quote": "氐西南星距百四度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L080",
      "original_quote": "房南第二星距百十四度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L081",
      "original_quote": "心前星距百十四度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L082",
      "original_quote": "尾星距百二十七度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L083",
      "original_quote": "箕西北星距一百二十一度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L084",
      "original_quote": "斗西三星距極一百十九度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L085",
      "original_quote": "中星距百八十度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L086",
      "original_quote": "女西南距百四度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L087",
      "original_quote": "虛南星距百度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L088",
      "original_quote": "危南星距極九十六度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L089",
      "original_quote": "室南星距八十度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L090",
      "original_quote": "壁南星距八十度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L091",
      "original_quote": "奎西南大星距極七十二度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L092",
      "original_quote": "婁中星距七十五度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L093",
      "original_quote": "胃西星距六十七度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L094",
      "original_quote": "昴西南星距七十度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L095",
      "original_quote": "畢右股一星距七十五度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L096",
      "original_quote": "參西星及西第一星距極九十二度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L097",
      "original_quote": "井西扇北一星距極六十九度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L098",
      "original_quote": "鬼西南星距六十九度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L099",
      "original_quote": "柳西第三星距八十二度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L100",
      "original_quote": "星大星距九十六度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L101",
      "original_quote": "張西第二星距百二十度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L102",
      "original_quote": "翼中央西第二星距百四度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L103",
      "original_quote": "軫西北星距百三十度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L104",
      "original_quote": "補觜西南星八十三度半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L105",
      "original_quote": "黃帝作蓋天曰：天如蓋笠",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L106",
      "original_quote": "宣夜則曰：天了無質",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L107",
      "original_quote": "顯帝渾天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L108",
      "original_quote": "以形圓里黃為喻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L109",
      "original_quote": "方天則以大光遠轉為北",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L110",
      "original_quote": "昕天曰：天如人形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L111",
      "original_quote": "而北則偏高",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L112",
      "original_quote": "安天言",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L113",
      "original_quote": "天形常安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L114",
      "original_quote": "而星辰不麗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_TianWenLiFa_L115",
      "original_quote": "惟渾天則親而且密",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan26",
