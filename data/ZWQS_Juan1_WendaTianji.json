{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "星垣問答論_Tianji",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L001",
      "original_quote": "問天機所主如何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L002",
      "original_quote": "答曰：天機屬木，南斗第三益算之善星也。後化氣曰善，又得地合之行事，解諸星之順逆。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L003",
      "original_quote": "定數於人命，逢諸吉咸集，則萬事皆善。勤於禮佛，敬乎六親，利於林泉，宜於僧道。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L004",
      "original_quote": "無惡虐不仁之心，有靈機應變之志。淵魚察見，作事有方。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L005",
      "original_quote": "女命遇之為福，逢吉為吉，遇凶為凶。或守於身，更逢天梁，必有高藝隨身。習者宜詳玩之。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L006",
      "original_quote": "希夷先生曰：天機益壽之星，若守身命，主人異常。與天梁、左右、昌曲交會，文為清顯，武為忠良。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L007",
      "original_quote": "若居陷地，四殺沖破，是為下局，當為僧道之清閑。凡入二限逢之，興家創業更改。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L008",
      "original_quote": "女人吉星拱照，主旺夫益子。有權祿則為貴婦。落局羊陀火忌沖破，主下賤殘疾刑剋。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L009",
      "original_quote": "歌曰",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L010",
      "original_quote": "天機兄弟主，南斗正曜星，作事有操略，稟性最高明，所為最好尚，亦可作群英",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L011",
      "original_quote": "會吉主享福，入格居翰林，巨門同一位，武職壓邊庭，亦要權逢殺，方可立功名",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L012",
      "original_quote": "天梁星同位，定作道與僧，女人若逢此，性巧必淫奔，天同與昌曲，聚拱主華榮",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L012",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L013",
      "original_quote": "辰戌子午地，入廟有功名，若在寅卯位，四殺并破軍，羊陀及火玲，若與諸殺會，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L013",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L014",
      "original_quote": "災患有虛驚，武暗廉破會，兩目少光明，二限臨此宿，事必有變更。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L014",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L015",
      "original_quote": "玉蟾先生曰：天機南斗善星，故化氣曰善。佐帝令以行事，解諸凶之逆節。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L015",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L016",
      "original_quote": "定數於人命之中，若逢吉聚則為富貴，若逢沖殺亦必好善。孝義六親，勤於禮佛，無不仁不義之為，有靈通變達之志。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L016",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianji_L017",
      "original_quote": "女命逢之，多主福壽。其在廟旺有力，陷地無力。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianji_L017",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "星垣問答論-Tianji星部分完成"
}