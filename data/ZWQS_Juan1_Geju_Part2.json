{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "格局論_續",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_TenClasses_L001",
      "original_quote": "福壽論：如南人天同天梁坐命廟旺主福壽雙全，如北人紫微武曲破軍貪狼坐命旺宮主福壽。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十等論",
        "line_id": "ZWQS_Juan1_TenClasses_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_TenClasses_L002",
      "original_quote": "聰明論：如文昌文曲天相天府武曲破軍三台八座左輔右弼三合拱照主人極聰明。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十等論",
        "line_id": "ZWQS_Juan1_TenClasses_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_TenClasses_L003",
      "original_quote": "威勇論：如武曲文昌擎羊七殺坐命宮得權祿三方又得紫微天府左右拱照主人威勇。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十等論",
        "line_id": "ZWQS_Juan1_TenClasses_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_TenClasses_L004",
      "original_quote": "文職論：如文昌文曲左輔右弼天魁天鉞坐命旺宮又得三方四正科權祿拱主為文官。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十等論",
        "line_id": "ZWQS_Juan1_TenClasses_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_TenClasses_L005",
      "original_quote": "武職論：如武曲七殺坐命廟旺宮又得三台八座加化權權及天魁天鉞並拱主為武職。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十等論",
        "line_id": "ZWQS_Juan1_TenClasses_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_TenClasses_L006",
      "original_quote": "刑名論：如擎羊陀羅火鈴星武曲破軍帶殺上吉湊合三方四正無凶不陷主刑名。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十等論",
        "line_id": "ZWQS_Juan1_TenClasses_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_TenClasses_L007",
      "original_quote": "富貴論：如紫微天府天相祿權科太陰太陽文昌文曲左輔右弼天魁天鉞守照拱沖主大富貴。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十等論",
        "line_id": "ZWQS_Juan1_TenClasses_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_TenClasses_L008",
      "original_quote": "貧賤論：如擎羊陀羅廉貞七殺武曲破軍天空地劫忌星三方四正守照拱沖諸凶併犯陷地主貧賤。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十等論",
        "line_id": "ZWQS_Juan1_TenClasses_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_TenClasses_L009",
      "original_quote": "疾殀論：如貪狼廉貞擎羊陀羅天空地劫火鈴忌星三方守照主疾殀或疾厄相貌宮亦然。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十等論",
        "line_id": "ZWQS_Juan1_TenClasses_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_TenClasses_L010",
      "original_quote": "僧道論：如天機天梁七殺破軍天空地劫併犯帝座紫微又或耗殺加臨主為僧道。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十等論",
        "line_id": "ZWQS_Juan1_TenClasses_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L001",
      "original_quote": "子安命：子宮貪狼殺陰星，機梁相拱福興隆，庚辛乙癸生人美，一生富貴足豐榮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L002",
      "original_quote": "丑安命：丑宮立命日月朝，丙成生人福祿饒，正坐平常中局論，對照富貴禍皆消。為官女受封。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L003",
      "original_quote": "寅安命：寅宮巨日足豐隆，七殺天梁百事通，申巳庚人皆為吉，男子為官女受封。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L004",
      "original_quote": "卯安命：卯宮機巨武曲逢，辛乙生人福氣隆，男子為當縻廩祿，女人享福受褒封。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L005",
      "original_quote": "辰安命：辰位機梁坐命宮，天府戍地最盈豐，腰金衣紫真榮顯，富華貴輝宜到終。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L006",
      "original_quote": "巳安命：巳位天機天相臨，紫府朝垣福更深，戊辛壬丙皆為貴，一生順遂少災侵。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L007",
      "original_quote": "午安命：午宮紫府太陽同，機梁破殺喜相逢，甲丁己癸生人福，一世風光廩祿豐。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L008",
      "original_quote": "未安命：未宮紫武廉貞同，日月巨門喜相逢，女人值此全福壽，男子逢之位三公。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L009",
      "original_quote": "申安命：申宮紫帝貞梁同，武曲巨門喜相逢，甲庚癸人如得喜，一生富貴逞英雄。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L010",
      "original_quote": "酉安命：酉宮最喜太陰逢，巨日又逢當面沖，辛乙生人為貴格，一生福祿永亨通。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L011",
      "original_quote": "戌安命：戌宮天機天梁同，紫府左右喜相逢，甲己辛壬生人美，一生榮華直到終。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L012",
      "original_quote": "亥安命：亥宮紫府及貪狼，天同相拱亦為良，壬辛乙己生人美，開張貿易人。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "十二宮合格訣",
        "line_id": "ZWQS_Juan1_PalaceFormulas_L012",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "格局論第二部分（十等論、十二宮合格訣）完成"
}