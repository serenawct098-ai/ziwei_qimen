      }
    },
    {
      "line_id": "ZWQS_Juan3_LunTaiSuiXiaoXian_L014",
      "original_quote": "寅年太歲併小限到寅宮入廟化吉",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論太歲小限星辰廟陷遇十二宮中吉凶",
