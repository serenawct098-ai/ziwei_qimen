    },
    {
      "line_id": "ZWQS_Juan3_LunTaiSuiXiaoXian_L002",
      "original_quote": "子年太歲併小限到子宮入廟化吉",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論太歲小限星辰廟陷遇十二宮中吉凶",
        "line_ref": "第124行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunTaiSuiXiaoXian_L003",
      "original_quote": "七殺破軍在子宮守歲限癸庚己生人發福，巨門天機乙癸生人發福，天府天相天梁丁己庚人財旺遂心，又天同丙丁生人財官雙美。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論太歲小限星辰廟陷遇十二宮中吉凶",
        "line_ref": "第125行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunTaiSuiXiaoXian_L004",
      "original_quote": "子年太歲併小限到子宮不入廟化凶",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論太歲小限星辰廟陷遇十二宮中吉凶",
        "line_ref": "第127行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunTaiSuiXiaoXian_L005",
      "original_quote": "紫微在子宮守命及歲限丙戊生人悔吝，破財災殃。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論太歲小限星辰廟陷遇十二宮中吉凶",
        "line_ref": "第128行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunTaiSuiXiaoXian_L006",
      "original_quote": "子年太歲所值吉凶星",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論太歲小限星辰廟陷遇十二宮中吉凶",
        "line_ref": "第130行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunTaiSuiXiaoXian_L007",
      "original_quote": "祿存天機天同太陰昌曲輔弼破軍天相廉真武曲天府巨門七殺，可斷其年人財兩美事事遂心。若遇貪狼紫微天梁忌星太陽擎羊，便斷人財耗散孝服，本身災晦不寧，減半論之。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論太歲小限星辰廟陷遇十二宮中吉凶",
        "line_ref": "第131行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunTaiSuiXiaoXian_L008",
      "original_quote": "丑年太歲併小限到丑宮入廟化吉",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論太歲小限星辰廟陷遇十二宮中吉凶",
        "line_ref": "第133行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunTaiSuiXiaoXian_L009",
      "original_quote": "天機在丑守命丙辛生人發旺，天相戊生人發旺，太陰武曲丙戊生人發旺，天府廉貞戊生人發旺，天梁丙戊辛生人發旺。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論太歲小限星辰廟陷遇十二宮中吉凶",
        "line_ref": "第134行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunTaiSuiXiaoXian_L010",
      "original_quote": "丑年太歲併小限到丑宮不入廟化凶",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論太歲小限星辰廟陷遇十二宮中吉凶",
        "line_ref": "第136行"
      }
