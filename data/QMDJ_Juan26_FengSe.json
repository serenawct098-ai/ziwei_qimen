{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan26",
  "section": "風色",
  "entries": [
    {
      "line_id": "QMDJ_Juan26_FengSe_L000",
      "original_quote": "風色",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L001",
      "original_quote": "風為教始來自四方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L002",
      "original_quote": "其政鳴條",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L003",
      "original_quote": "啟折其化",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L004",
      "original_quote": "鼓舞飄頌乎則清和明淨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L005",
      "original_quote": "政治則天氣溫涼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L006",
      "original_quote": "發屋折本者為怒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L007",
      "original_quote": "揚砂轉石者為狂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L008",
      "original_quote": "其勢分錯交橫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L009",
      "original_quote": "任小人而疏君子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L010",
      "original_quote": "其聲啾唧慘淒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L011",
      "original_quote": "不疾疫而必大喪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L012",
      "original_quote": "慽慽蓬勃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L013",
      "original_quote": "大兵將至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L014",
      "original_quote": "炎炎恍惚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L015",
      "original_quote": "火旱為殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L016",
      "original_quote": "大風橫露",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L017",
      "original_quote": "兮白日沉沉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L018",
      "original_quote": "主上昏亂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L019",
      "original_quote": "兮政教未明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L020",
      "original_quote": "觸塵蓬勃者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L021",
      "original_quote": "為悖亂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L022",
      "original_quote": "扶搖羊角者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L023",
      "original_quote": "為飄風",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L024",
      "original_quote": "凜冽而人懷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L025",
      "original_quote": "戰懼刑戮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L026",
      "original_quote": "暴急猝起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L027",
      "original_quote": "而南北靡定者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_FengSe_L028",
      "original_quote": "上下不寧",
      "tag": []
    }
  ],
