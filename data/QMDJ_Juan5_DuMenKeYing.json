{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan5",
  "section": "杜門剋應",
  "entries": [
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L000",
      "original_quote": "杜門剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L001",
      "original_quote": "杜門原是木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L002",
      "original_quote": "犯者災禍頻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L003",
      "original_quote": "亥卯未年月",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L004",
      "original_quote": "遭入獄迍生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L005",
      "original_quote": "生死離別事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L006",
      "original_quote": "六畜也多瘟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L007",
      "original_quote": "跌打見膿血",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L008",
      "original_quote": "禍害及子孫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L009",
      "original_quote": "問曰：杜門陽木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L010",
      "original_quote": "夏冬繁盛之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L011",
      "original_quote": "本為旺氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L012",
      "original_quote": "何以凶論?",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L013",
      "original_quote": "衢仙答曰：杜門陽木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L014",
      "original_quote": "時值夏冬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L015",
      "original_quote": "發生於外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L016",
      "original_quote": "而津液已洩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L017",
      "original_quote": "陽氣亢極",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L018",
      "original_quote": "一陰將至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L019",
      "original_quote": "木性至此而力屈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L020",
      "original_quote": "欲收斂而不能收斂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L021",
      "original_quote": "欲生旺而力已盡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L022",
      "original_quote": "又不洩其力以實其子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L023",
      "original_quote": "而待陰伏藏其子於堅密之處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L024",
      "original_quote": "恐有傷於子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L025",
      "original_quote": "故謂之杜門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L026",
      "original_quote": "小凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L027",
      "original_quote": "杜門為藏形之方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L028",
      "original_quote": "為宜躲災避難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L029",
      "original_quote": "塞穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L030",
      "original_quote": "捕捉則吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L031",
      "original_quote": "餘事皆不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L032",
      "original_quote": "靜應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L033",
      "original_quote": "杜門加杜：主因父母疾病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L034",
      "original_quote": "田宅出脫事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L035",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L036",
      "original_quote": "加景：主文書印信阻隔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L037",
      "original_quote": "陽人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L038",
      "original_quote": "小口疾病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L039",
      "original_quote": "遲疑不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L040",
      "original_quote": "加死：主田宅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L041",
      "original_quote": "文書失落",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L042",
      "original_quote": "官司破財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L043",
      "original_quote": "小凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L044",
      "original_quote": "加驚：主門戶內憂疑驚恐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L045",
      "original_quote": "並有詞訟事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L046",
      "original_quote": "加開：主見貴人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L047",
      "original_quote": "官長",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L048",
      "original_quote": "謀事主先破己財後吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L049",
      "original_quote": "加休：主求財有益",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L050",
      "original_quote": "加生：主陽人小口破財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L051",
      "original_quote": "及田宅求財不成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L052",
      "original_quote": "加傷：主兄弟相爭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L053",
      "original_quote": "田產破財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L054",
      "original_quote": "加甲戊：主謀事不成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L055",
      "original_quote": "密處求財得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L056",
      "original_quote": "加乙：主宜暗求陽人財物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L057",
      "original_quote": "後主不明至訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L058",
      "original_quote": "加丙：主文契遺失",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L059",
      "original_quote": "加丁：主陽人訟獄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L060",
      "original_quote": "加己：主私謀害人招非",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L061",
      "original_quote": "加庚：主因女人訟獄被刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L062",
      "original_quote": "加辛：主打傷人詞訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L063",
      "original_quote": "陽人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L064",
      "original_quote": "小口凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L065",
      "original_quote": "加壬：主奸盜事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L066",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L067",
      "original_quote": "加癸：主百事皆阻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L068",
      "original_quote": "病者不食",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L069",
      "original_quote": "動應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L070",
      "original_quote": "杜門出三十里逢少女同行歌唱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L071",
      "original_quote": "六十里逢惡人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L072",
      "original_quote": "乙奇臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L073",
      "original_quote": "見少婦著色衣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L074",
      "original_quote": "丙奇臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L075",
      "original_quote": "見火光燒屋或烽火之物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L076",
      "original_quote": "丁奇臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L077",
      "original_quote": "見人騎馬帶弓弩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L078",
      "original_quote": "杜門加杜：四里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L079",
      "original_quote": "十四里逢婦人引孫兒著綠衣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L080",
      "original_quote": "加景：九里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L081",
      "original_quote": "十九里逢孕婦著色衣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L082",
      "original_quote": "或公吏人騎赤馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L083",
      "original_quote": "加死：二里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L084",
      "original_quote": "十二里逢喪服人哭泣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L085",
      "original_quote": "加驚：七里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L086",
      "original_quote": "十七里逢歌唱鑼鼓聲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L087",
      "original_quote": "或人言公訟事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L088",
      "original_quote": "加開：六里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L089",
      "original_quote": "十六里逢歌唱及犬咬豬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L090",
      "original_quote": "加休：一里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L091",
      "original_quote": "十一里逢唱戲或皂衣婦人抱孩兒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L092",
      "original_quote": "加生：八里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L093",
      "original_quote": "十八里逢人扛錢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L094",
      "original_quote": "或手拿食物並唱詞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L095",
      "original_quote": "加傷：三里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L096",
      "original_quote": "十三里逢木匠拿木棍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L097",
      "original_quote": "占身命：火命者發貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L098",
      "original_quote": "水命者發富",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L099",
      "original_quote": "木命者平穩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L100",
      "original_quote": "金命者疾病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L101",
      "original_quote": "土命者官司凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L102",
      "original_quote": "若金年月日時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L103",
      "original_quote": "或土命年月日時者不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_DuMenKeYing_L104",
      "original_quote": "如逢水火年月日時吉",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan5",
    "section": "杜門剋應",
