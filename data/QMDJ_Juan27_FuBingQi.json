{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan27",
  "section": "伏兵氣",
  "entries": [
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L000",
      "original_quote": "伏兵氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L001",
      "original_quote": "凡兩軍相當",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L002",
      "original_quote": "前後左右有赤氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L003",
      "original_quote": "即有伏氣雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L004",
      "original_quote": "紛紛綿綿而相繼者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L005",
      "original_quote": "車騎伏也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L006",
      "original_quote": "如有席蒿草者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L007",
      "original_quote": "少兵伏也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L008",
      "original_quote": "白氣紛紜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L009",
      "original_quote": "如樓上狀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L010",
      "original_quote": "萬人伏也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L011",
      "original_quote": "軍上黑氣洋洋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L012",
      "original_quote": "而赤氣在中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L013",
      "original_quote": "或如烏雲之赤杵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L014",
      "original_quote": "或赤雲中之鳥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L015",
      "original_quote": "人在烏雲內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L016",
      "original_quote": "或如幢節在烏雲中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L017",
      "original_quote": "或如山嶽之王外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L018",
      "original_quote": "或前黑而白雲在後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_FuBingQi_L019",
      "original_quote": "皆伏兵氣也",
      "tag": []
    }
  ],
