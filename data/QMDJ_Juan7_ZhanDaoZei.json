{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan7",
  "section": "占盜賊",
  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L000",
      "original_quote": "占盜賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L001",
      "original_quote": "敵兵來去先分界限",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L002",
      "original_quote": "冬至以後以坎艮震巽為內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L003",
      "original_quote": "離坤兌干四宮為不至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L004",
      "original_quote": "六庚落宮被剋者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L005",
      "original_quote": "為安營不穩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L006",
      "original_quote": "自驚而退",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L007",
      "original_quote": "六庚剋所落之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L008",
      "original_quote": "又逢元武",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L009",
      "original_quote": "天蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L010",
      "original_quote": "白虎之神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L011",
      "original_quote": "乘必大戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L012",
      "original_quote": "庚得九天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L013",
      "original_quote": "則大張聲勢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L014",
      "original_quote": "鳴鼓而進",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L015",
      "original_quote": "庚得九地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L016",
      "original_quote": "則掩旗息鼓而來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L017",
      "original_quote": "如賊已入境",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L018",
      "original_quote": "占其何時去?看六庚在內四宮為不去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L019",
      "original_quote": "在外四宮為去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L020",
      "original_quote": "總以六庚地盤干支年月日時為去來之期",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L021",
      "original_quote": "庚加年年為方吉之類",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L022",
      "original_quote": "如太白入熒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L023",
      "original_quote": "雖賊來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L024",
      "original_quote": "若在外界外四宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L025",
      "original_quote": "亦主不來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L026",
      "original_quote": "熒入太白",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L027",
      "original_quote": "雖主賊去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L028",
      "original_quote": "若在內界",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanDaoZei_L029",
      "original_quote": "亦不去",
      "tag": []
    }
  ],
