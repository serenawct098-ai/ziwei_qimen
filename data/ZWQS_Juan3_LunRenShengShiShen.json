      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenShengShiShen_L002",
      "original_quote": "太陽天機天梁七殺貪狼文昌左輔右弼，便斷其年財祿大進益，家道更興隆，添丁進口，婚姻喜慶重重。若遇紫微天同廉貞天府太陰巨門天相破軍忌宿，便斷其年破財孝服，官災口舌。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人生時身宮吉凶",
        "line_ref": "第167行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenShengShiShen_L003",
      "original_quote": "巳年太歲併小限到巳宮入廟化吉",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人生時身宮吉凶",
        "line_ref": "第169行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenShengShiShen_L004",
      "original_quote": "紫微天府天同巨門天相天梁破軍丙戊辛人發福，太陰天機丁壬辛丙生人破財，貪狼甲戊生人平平。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人生時身宮吉凶",
        "line_ref": "第170行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenShengShiShen_L005",
      "original_quote": "巳年太歲併小限到巳宮不入廟化凶",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
