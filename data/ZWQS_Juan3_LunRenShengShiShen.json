    },
    {
      "line_id": "ZWQS_Juan3_LunRenShengShiShen_L001",
      "original_quote": "辰年太歲所值吉凶星",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
