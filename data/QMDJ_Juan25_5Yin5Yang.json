{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan25",
  "section": "五陰五陽時",
  "entries": [
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L000",
      "original_quote": "五陰五陽時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L001",
      "original_quote": "《三元經》曰：「甲乙丙丁戊為五陽時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L002",
      "original_quote": "利為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L003",
      "original_quote": "宜先舉兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L004",
      "original_quote": "高旗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L005",
      "original_quote": "響鼓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L006",
      "original_quote": "耀武揚威",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L007",
      "original_quote": "客兵大勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L008",
      "original_quote": "所謂陽者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L009",
      "original_quote": "飛而不止也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L010",
      "original_quote": "己庚辛壬癸為五陰時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L011",
      "original_quote": "利為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L012",
      "original_quote": "宜偃旗息鼓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L013",
      "original_quote": "銜枚靜聽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L014",
      "original_quote": "待客敵至後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L015",
      "original_quote": "則戰大勝矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L016",
      "original_quote": "所謂得陰者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L017",
      "original_quote": "伏而不舉也」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L018",
      "original_quote": "凡奇門一時一換",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L019",
      "original_quote": "謂不善必先知之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L020",
      "original_quote": "若天盤甲申庚加地盤月奇丙之方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L021",
      "original_quote": "防其衝營擊寨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L022",
      "original_quote": "夜間必要守備",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L023",
      "original_quote": "每一更一令一籌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L024",
      "original_quote": "密傳若籌錯令差",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L025",
      "original_quote": "便是奸細",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L026",
      "original_quote": "所謂入金鄉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L027",
      "original_quote": "賊獨至也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L028",
      "original_quote": "即在入門之內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L029",
      "original_quote": "取路埋伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_5Yin5Yang_L030",
      "original_quote": "以逸代勞",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
