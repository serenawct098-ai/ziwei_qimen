{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan7",
  "section": "占鄉會試",
  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L000",
      "original_quote": "占鄉會試",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L001",
      "original_quote": "以日干為士子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L002",
      "original_quote": "值符總裁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L003",
      "original_quote": "天乙值使也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L004",
      "original_quote": "此指貴人言",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L005",
      "original_quote": "非值符名也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L006",
      "original_quote": "疑即六壬所謂廉幕者也為房師",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L007",
      "original_quote": "六丁為文章",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L008",
      "original_quote": "值符宮剋日干宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L009",
      "original_quote": "座師不取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L010",
      "original_quote": "天乙宮剋日干宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L011",
      "original_quote": "房師不薦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L012",
      "original_quote": "六丁宮剋日干宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L013",
      "original_quote": "日干宮剋六丁宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L014",
      "original_quote": "及六丁休囚廢沒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L015",
      "original_quote": "俱主題目大難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L016",
      "original_quote": "文章失意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L017",
      "original_quote": "如值符宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L018",
      "original_quote": "天乙宮來生日干宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L019",
      "original_quote": "六丁宮又得旺相必中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L020",
      "original_quote": "缺一不中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L021",
      "original_quote": "故必須此格皆全乃獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L022",
      "original_quote": "此至理也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanXiangHuiShi_L023",
      "original_quote": "六壬亦當仿此法推之",
      "tag": []
    }
  ],
