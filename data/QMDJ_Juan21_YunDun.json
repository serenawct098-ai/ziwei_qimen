{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan21",
  "section": "云遁",
  "entries": [
    {
      "line_id": "QMDJ_Juan21_YunDun_L000",
      "original_quote": "云遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L001",
      "original_quote": "凡乙奇與開門合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L002",
      "original_quote": "下臨坤宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L003",
      "original_quote": "不犯墓迫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L004",
      "original_quote": "得雲之蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L005",
      "original_quote": "又曰：「乙奇與開門合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L006",
      "original_quote": "下臨六辛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L007",
      "original_quote": "其方可以默吸風雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L008",
      "original_quote": "噴噀甲胄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L009",
      "original_quote": "音搖普遍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L010",
      "original_quote": "或托射雕為名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L011",
      "original_quote": "令士卒仰望",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L012",
      "original_quote": "更宜求雨澤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L013",
      "original_quote": "利農稼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L014",
      "original_quote": "建營寨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L015",
      "original_quote": "造軍器",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_YunDun_L016",
      "original_quote": "以候雲應」",
      "tag": []
    }
  ],
