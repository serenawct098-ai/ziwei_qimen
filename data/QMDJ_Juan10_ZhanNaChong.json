{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan10",
  "section": "占納寵",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L000",
      "original_quote": "占納寵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L001",
      "original_quote": "以乙奇為妻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L002",
      "original_quote": "丁奇為妾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L003",
      "original_quote": "太白庚金為夫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L004",
      "original_quote": "若乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L005",
      "original_quote": "丁奇之落宮生庚之落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L006",
      "original_quote": "其女必肯嫁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L007",
      "original_quote": "乙丁落宮剋庚之落宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L008",
      "original_quote": "不肯嫁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L009",
      "original_quote": "乙丁宮相比和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L010",
      "original_quote": "主妻妾和諧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L011",
      "original_quote": "如乙剋丁宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L012",
      "original_quote": "主妻不能容妾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L013",
      "original_quote": "或丁剋乙宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L014",
      "original_quote": "主妾欲欺妻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L015",
      "original_quote": "若乙丁入空陷庫絕之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L016",
      "original_quote": "主不能成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L017",
      "original_quote": "成亦不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L018",
      "original_quote": "如庚金宮生丁奇之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanNaChong_L019",
      "original_quote": "主徒勞無成",
      "tag": []
    }
  ],
