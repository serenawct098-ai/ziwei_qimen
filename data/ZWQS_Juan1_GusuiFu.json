      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第767行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L052",
      "original_quote": "項⽻英雄限⾄天空⽽喪國,⽯崇豪富限⾏劫地以亡家｡",
