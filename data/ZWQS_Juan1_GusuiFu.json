{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "斗數骨髓賦",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L001",
      "original_quote": "太極星纏，乃群宿眾星之主，天門運限，即扶身助命之源，在天則運用無常，在人則命有格局。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L002",
      "original_quote": "先明格局，次看眾星。或有同年同月同日同時而生，則有貧賤富貴壽天之異。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L003",
      "original_quote": "或在惡限，積百萬之金銀。或在旺鄉，遭連年之困苦。禍福不可一途而惟，吉凶不可一例而斷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L004",
      "original_quote": "要知一世之榮枯，定看五行之宮位。立命可知貴賤，安身便曉根基。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L005",
      "original_quote": "第一先看福德，再三細考遷移，分對宮之體用，定三合之源流。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L006",
      "original_quote": "命無正曜，夭折孤貧。吉有凶星，美玉瑕玷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L007",
      "original_quote": "既得根源堅固，須知合局相生，堅固則富貴延壽，相生則財官昭著。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L008",
      "original_quote": "命好身好限好到老榮昌。命衰身衰限衰終身乞丐。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L009",
      "original_quote": "夾貴夾祿少人知，夾權夾科世所宜。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L010",
      "original_quote": "夾日夾月誰能遇，夾昌夾曲主貴兮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L011",
      "original_quote": "夾空夾劫主貧賤，夾羊夾陀為乞丐。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L012",
      "original_quote": "廉貞七殺反為積富之人，天梁太陰卻作飄蓬之客。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L012",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L013",
      "original_quote": "廉貞主下賤孤寒，太陰主一生快樂。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L013",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L014",
      "original_quote": "先貧後富武貪同身命之宮，先富後貧只為運限逢劫殺。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L014",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L015",
      "original_quote": "出世榮華權祿守財官之位，生來貧賤劫空臨財福之鄉。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L015",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L016",
      "original_quote": "文曲武曲為人多學多能，左輔右弼稟性克寬克厚。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L016",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L017",
      "original_quote": "天府天相乃為衣祿之神，為仕為官定主亨通之兆。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L017",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L018",
      "original_quote": "苗而不秀科名陷於凶神，發不主財祿主躔於弱地。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L018",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L019",
      "original_quote": "七殺朝斗爵祿榮昌，紫府同宮終身福厚。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L019",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L020",
      "original_quote": "紫微居午無殺湊位至三公，天府臨戌有星扶腰金衣紫。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L020",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L021",
      "original_quote": "科權祿拱名譽昭彰，武曲廟垣威名赫奕。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L021",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L022",
      "original_quote": "科明祿暗位列三台，日月同臨官居侯伯。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L022",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L023",
      "original_quote": "巨機同宮公卿之位，貪鈴並守將相之名。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L023",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L024",
      "original_quote": "天魁天鉞蓋世文章，天祿天馬驚人甲第。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L024",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L025",
      "original_quote": "左輔文昌會吉星尊居八座，貪狼火星居廟旺名鎮諸邦。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L025",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L026",
      "original_quote": "巨日同宮官封三代，紫府朝垣食祿萬鍾。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L026",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L027",
      "original_quote": "科權對拱躍三汲於禹門，日月並明佐九重於堯殿。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L027",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L028",
      "original_quote": "府相同來會命宮全家食祿，三合明珠生旺地穩步蟾宮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L028",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L029",
      "original_quote": "七殺破軍宜出外，機月同梁作吏人。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L029",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L030",
      "original_quote": "紫府日月居旺地斷定公侯器，日月科祿丑宮中定是方伯公。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L030",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L031",
      "original_quote": "天梁天馬陷飄蕩無疑，廉貞殺不加聲名遠播。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L031",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L032",
      "original_quote": "日照雷門富貴榮華，月朗天門進爵封侯。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L032",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L033",
      "original_quote": "寅逢府相位登一品之榮，曲遇梁星位至台綱。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L033",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L034",
      "original_quote": "梁居午位官資清顯，文星暗拱賈誼允矣登科。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L034",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L035",
      "original_quote": "科祿巡逢周勃欣然入相，貪武同行威鎮邊夷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L035",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L036",
      "original_quote": "擎羊火星威權出眾，墓逢左右尊居八座之貴。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L036",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L037",
      "original_quote": "李廣不封擎羊逢於力士，顏回天折文昌陷於天傷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L037",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L038",
      "original_quote": "仲由威猛廉貞入廟遇將軍，子羽才能巨宿同梁沖且合。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L038",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L039",
      "original_quote": "寅申最喜同梁會，辰戌應嫌陷巨門。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L039",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L040",
      "original_quote": "祿倒馬倒忌太歲之合，劫空孤貧多有壽，富貴即天亡。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L040",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L041",
      "original_quote": "官符太歲公冶有縲絏之憂。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L041",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L042",
      "original_quote": "吊客喪門綠珠有墮樓之厄，運衰限衰喜紫微之解凶厄。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L042",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L043",
      "original_quote": "限至天羅地網屈原溺水而身亡，運遇地劫天空阮籍有貧窮之苦。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L043",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L044",
      "original_quote": "文昌文曲會廉貞喪命天年，命空限空無吉湊功名蹭蹬。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L044",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L045",
      "original_quote": "生逢天空猶如半天折翅，命中遇劫恰如浪裡行船。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L045",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L046",
      "original_quote": "項羽英雄限至天空而喪國，石崇豪富限行劫地以亡家。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L046",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L047",
      "original_quote": "呂后專權兩重天祿天馬，楊妃好色三合文曲文昌。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L047",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L048",
      "original_quote": "天梁遇馬女命賤而且淫，昌曲夾墀男命貴而且顯。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L048",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L049",
      "original_quote": "極居卯西多為脫俗僧人，貞居卯西定是公胥吏輩。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L049",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L050",
      "original_quote": "左府同宮尊居萬乘，廉貞七殺流蕩天涯。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L050",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L051",
      "original_quote": "鄧通餓死運逢大耗之鄉，夫子絕糧限到天傷之內。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L051",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L052",
      "original_quote": "鈴昌羅武限至投河，巨火擎羊終身縊死。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L052",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L053",
      "original_quote": "命裡逢空不飄流即主疾苦，馬頭帶劍非夭折則主刑傷。",
      "tag": [
        "_custom",
        "non_classical"
      ],
      "tag_reason": "後世格局命名，非本句原文自稱格局，需於解讀引擎輸出時與原文引述區隔",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L053",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L054",
      "original_quote": "子午破軍加官進祿，昌貪居命粉骨碎屍。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L054",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L055",
      "original_quote": "朝斗仰斗爵祿榮昌，文桂文華九重貴顯。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L055",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L056",
      "original_quote": "丹墀桂墀早遂青雲之志，合祿拱祿定為巨擘之臣。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L056",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L057",
      "original_quote": "陰陽會昌曲出世榮華，輔弼遇財官衣緋著紫。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L057",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L058",
      "original_quote": "巨梁相會廉貞併，合祿鴛鴦一世榮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L058",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L059",
      "original_quote": "武曲閑宮多手藝，貪狼陷地作屠人。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L059",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L060",
      "original_quote": "天祿朝垣身榮貴顯，魁星臨命位列三台。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L060",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L061",
      "original_quote": "武曲居乾戌亥上，最怕太陰逢貪狼。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L061",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L062",
      "original_quote": "化祿還為好，休向墓中藏。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L062",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L063",
      "original_quote": "子午巨門石中隱玉，明祿暗祿錦上添花。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L063",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L064",
      "original_quote": "紫微辰戌遇破軍，富而不貴有虛名。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L064",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L065",
      "original_quote": "昌曲破軍逢刑剋多勞碌，貪武墓中居三十才發福。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L065",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L066",
      "original_quote": "天同戌宮為反背，丁人化吉主大貴。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L066",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L067",
      "original_quote": "巨門辰戌為陷地，辛人化吉祿崢嶸。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L067",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L068",
      "original_quote": "機梁西上化吉者，縱遇財官也不榮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L068",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L069",
      "original_quote": "日月最嫌反背乃為失輝，命身定要精求恐差分數。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L069",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L070",
      "original_quote": "陰騭延年增百福，至於陷地不遭傷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L070",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L071",
      "original_quote": "命實運堅稿田得雨，命衰限弱嫩草遭霜。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L071",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L072",
      "original_quote": "論命必推星惡善，巨破擎羊性必剛。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L072",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L073",
      "original_quote": "府相同梁性必好，火劫空貪性不常。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L073",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L074",
      "original_quote": "昌曲祿機清秀巧，陰陽左右最慈祥。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L074",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L075",
      "original_quote": "武破貞貪沖合曲全固貴，羊陀七殺相雜互見則傷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L075",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L076",
      "original_quote": "貪狼廉貞破軍惡，七殺擎羊陀羅凶。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L076",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L077",
      "original_quote": "火星鈴星專作禍，劫空傷使禍重重。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L077",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L078",
      "original_quote": "巨門忌星皆不吉，運身命限忌相逢。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L078",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L079",
      "original_quote": "更兼太歲官符至，官非口舌決不空。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L079",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L080",
      "original_quote": "吊客喪門又相遇，管教災病兩相攻。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L080",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L081",
      "original_quote": "七殺守身終是天，貪狼入命必為娼。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L081",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L082",
      "original_quote": "心好命微亦主壽，心毒命固亦天亡。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "斗數骨髓賦",
        "line_id": "ZWQS_Juan1_GusuiFu_L082",
