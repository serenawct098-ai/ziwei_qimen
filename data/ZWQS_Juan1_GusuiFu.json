{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "⽃數⾻隨賦",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L000",
      "original_quote": "⽃數⾻隨賦",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第719行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L001",
      "original_quote": "⽃數⾻隨賦太極星纏,乃群宿眾星之主,天⾨運限,即扶⾝助命之源,在天則運⽤無常,在⼈則命有格局｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第719行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L002",
      "original_quote": "先明格局,次看眾星｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第722行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L003",
      "original_quote": "或有同年同⽉同⽇同時⽽⽣,則有貧賤富貴壽天之異｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第722行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L004",
      "original_quote": "或在惡限,積百萬之⾦銀｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第724行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L005",
      "original_quote": "或在旺鄉,遭連年之困苦｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第724行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L006",
      "original_quote": "禍福不可⼀途⽽惟,吉凶不可⼀例⽽斷｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第724行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L007",
      "original_quote": "要知⼀世之榮枯,定看五⾏之宮位｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第726行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L008",
      "original_quote": "立命可知貴賤,安⾝便曉根基｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第726行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L009",
      "original_quote": "第⼀先看福德,再三細考遷移,分對宮之體⽤,定三合之源流｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第727行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L010",
      "original_quote": "命無正曜,夭折孤貧｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第728行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L011",
      "original_quote": "吉有凶星,美⽟瑕玷｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第728行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L012",
      "original_quote": "既得根源堅固,須知合局相⽣,堅固則富貴延壽,相⽣則財官昭著｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第729行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L013",
      "original_quote": "命好⾝好限好到老榮昌｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第730行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L014",
      "original_quote": "命衰⾝衰限衰終⾝乞丐｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第730行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L015",
      "original_quote": "夾貴夾祿少⼈知,夾權夾科世所宜｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第731行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L016",
      "original_quote": "夾⽇夾⽉誰能遇,夾昌夾曲主貴兮｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第732行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L017",
      "original_quote": "夾空夾劫主貧賤,夾⽺夾陀為乞丐｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第733行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L018",
      "original_quote": "廉貞七殺反為積富之⼈,天梁太陰卻作飄蓬之客｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第734行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L019",
      "original_quote": "廉貞主下賤孤寒,太陰主⼀⽣快樂｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第735行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L020",
      "original_quote": "先貧後富武貪同⾝命之宮,先富後貧只為運限逢劫殺｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第736行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L021",
      "original_quote": "出世榮華權祿守財官之位,⽣來貧賤劫空臨財福之鄉｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第737行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L022",
      "original_quote": "⽂曲武曲為⼈多學多能,左輔右弼稟性克寬克厚｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第738行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L023",
      "original_quote": "天府天相乃為衣祿之神,為仕為官定主亨通之兆｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第739行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L024",
      "original_quote": "苗⽽不秀科名陷於凶神,發不主財祿主躔於弱地｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第740行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L025",
      "original_quote": "七殺朝⽃爵祿榮昌,紫府同宮終⾝福厚｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第741行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L026",
      "original_quote": "紫微居午無殺湊位⾄三公,天府臨戌有星扶腰⾦衣紫｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第742行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L027",
      "original_quote": "科權祿拱名譽昭彰,武曲廟垣威名赫奕｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第743行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L028",
      "original_quote": "科明祿暗位列三台,⽇⽉同臨官居侯伯｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第744行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L029",
      "original_quote": "巨機同宮公卿之位,貪鈴並守將相之名｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第745行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L030",
      "original_quote": "天魁天鉞蓋世⽂章,天祿天⾺驚⼈甲第｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第746行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L031",
      "original_quote": "左輔⽂昌會吉星尊居⼋座,貪狼火星居廟旺名鎮諸邦｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第747行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L032",
      "original_quote": "巨⽇同宮官封三代,紫府朝垣食祿萬鐘｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第748行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L033",
      "original_quote": "科權對拱躍三汲於禹⾨,⽇⽉並明佐九重於堯殿｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第749行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L034",
      "original_quote": "府相同來會命宮全家食祿,三合明珠⽣旺地穩步蟾宮｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第750行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L035",
      "original_quote": "七殺破軍宜出外,機⽉同梁作吏⼈｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第751行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L036",
      "original_quote": "紫府⽇⽉居旺地斷定公侯器,⽇⽉科祿丑宮中定是⽅伯公｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第752行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L037",
      "original_quote": "天梁天⾺陷飄蕩無疑,廉貞殺不加聲名遠播｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第753行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L038",
      "original_quote": "⽇照雷⾨富貴榮華,⽉朗天⾨進爵封侯｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第754行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L039",
      "original_quote": "寅逢府相位登⼀品之榮梁居午位官資清顯科祿巡逢周勃欣然入相擎⽺火星威權出眾,墓逢左右尊居⼋座之貴｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第755行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L040",
      "original_quote": ",曲遇梁星位⾄台綱｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第756行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L041",
      "original_quote": ",⽂星暗拱賈誼允矣登科｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第757行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L042",
      "original_quote": ",貪武同⾏威鎮邊夷｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第758行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L043",
      "original_quote": "李廣不封擎⽺逢於⼒⼠,顏回天折⽂昌陷於天傷｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第759行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L044",
      "original_quote": "仲由威猛廉貞入廟遇將軍,⼦⽻才能巨宿同梁沖且合｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第760行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L045",
      "original_quote": "寅申最喜同梁會,辰戌應嫌陷巨⾨｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第761行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L046",
      "original_quote": "祿倒⾺倒忌太歲之合劫空孤貧多有壽,富貴即天亡｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第762行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L047",
      "original_quote": "吊客喪⾨綠珠有墮樓之厄,運衰限衰喜紫微之解凶厄｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數⾻隨賦",
        "line_ref": "第763行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L048",
      "original_quote": ",官符太歲公冶有縲絏之憂｡",
