{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "⽃數⾻隨賦",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L000",
      "original_quote": "⽃數⾻隨賦",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L001",
      "original_quote": "⽃數⾻隨賦太極星纏,乃群宿眾星之主,天⾨運限,即扶⾝助命之源,在天則運⽤無常,在⼈則命有格局｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L002",
      "original_quote": "先明格局,次看眾星｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L003",
      "original_quote": "或有同年同⽉同⽇同時⽽⽣,則有貧賤富貴壽天之異｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L004",
      "original_quote": "或在惡限,積百萬之⾦銀｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L005",
      "original_quote": "或在旺鄉,遭連年之困苦｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L006",
      "original_quote": "禍福不可⼀途⽽惟,吉凶不可⼀例⽽斷｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L007",
      "original_quote": "要知⼀世之榮枯,定看五⾏之宮位｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L008",
      "original_quote": "立命可知貴賤,安⾝便曉根基｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L009",
      "original_quote": "第⼀先看福德,再三細考遷移,分對宮之體⽤,定三合之源流｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L010",
      "original_quote": "命無正曜,夭折孤貧｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L011",
      "original_quote": "吉有凶星,美⽟瑕玷｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L012",
      "original_quote": "既得根源堅固,須知合局相⽣,堅固則富貴延壽,相⽣則財官昭著｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L013",
      "original_quote": "命好⾝好限好到老榮昌｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L014",
      "original_quote": "命衰⾝衰限衰終⾝乞丐｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L015",
      "original_quote": "夾貴夾祿少⼈知,夾權夾科世所宜｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L016",
      "original_quote": "夾⽇夾⽉誰能遇,夾昌夾曲主貴兮｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L017",
      "original_quote": "夾空夾劫主貧賤,夾⽺夾陀為乞丐｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L018",
      "original_quote": "廉貞七殺反為積富之⼈,天梁太陰卻作飄蓬之客｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L019",
      "original_quote": "廉貞主下賤孤寒,太陰主⼀⽣快樂｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L020",
      "original_quote": "先貧後富武貪同⾝命之宮,先富後貧只為運限逢劫殺｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L021",
      "original_quote": "出世榮華權祿守財官之位,⽣來貧賤劫空臨財福之鄉｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L022",
      "original_quote": "⽂曲武曲為⼈多學多能,左輔右弼稟性克寬克厚｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L023",
      "original_quote": "天府天相乃為衣祿之神,為仕為官定主亨通之兆｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L024",
      "original_quote": "苗⽽不秀科名陷於凶神,發不主財祿主躔於弱地｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L025",
      "original_quote": "七殺朝⽃爵祿榮昌,紫府同宮終⾝福厚｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L026",
      "original_quote": "紫微居午無殺湊位⾄三公,天府臨戌有星扶腰⾦衣紫｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L027",
      "original_quote": "科權祿拱名譽昭彰,武曲廟垣威名赫奕｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L028",
      "original_quote": "科明祿暗位列三台,⽇⽉同臨官居侯伯｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L029",
      "original_quote": "巨機同宮公卿之位,貪鈴並守將相之名｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L030",
      "original_quote": "天魁天鉞蓋世⽂章,天祿天⾺驚⼈甲第｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L031",
      "original_quote": "左輔⽂昌會吉星尊居⼋座,貪狼火星居廟旺名鎮諸邦｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L032",
      "original_quote": "巨⽇同宮官封三代,紫府朝垣食祿萬鐘｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L033",
      "original_quote": "科權對拱躍三汲於禹⾨,⽇⽉並明佐九重於堯殿｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L034",
      "original_quote": "府相同來會命宮全家食祿,三合明珠⽣旺地穩步蟾宮｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L035",
      "original_quote": "七殺破軍宜出外,機⽉同梁作吏⼈｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L036",
      "original_quote": "紫府⽇⽉居旺地斷定公侯器,⽇⽉科祿丑宮中定是⽅伯公｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L037",
      "original_quote": "天梁天⾺陷飄蕩無疑,廉貞殺不加聲名遠播｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L038",
      "original_quote": "⽇照雷⾨富貴榮華,⽉朗天⾨進爵封侯｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L039",
      "original_quote": "寅逢府相位登⼀品之榮梁居午位官資清顯科祿巡逢周勃欣然入相擎⽺火星威權出眾,墓逢左右尊居⼋座之貴｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L040",
      "original_quote": ",曲遇梁星位⾄台綱｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L041",
      "original_quote": ",⽂星暗拱賈誼允矣登科｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L042",
      "original_quote": ",貪武同⾏威鎮邊夷｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L043",
      "original_quote": "李廣不封擎⽺逢於⼒⼠,顏回天折⽂昌陷於天傷｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L044",
      "original_quote": "仲由威猛廉貞入廟遇將軍,⼦⽻才能巨宿同梁沖且合｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L045",
      "original_quote": "寅申最喜同梁會,辰戌應嫌陷巨⾨｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L046",
      "original_quote": "祿倒⾺倒忌太歲之合劫空孤貧多有壽,富貴即天亡｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L047",
      "original_quote": "吊客喪⾨綠珠有墮樓之厄,運衰限衰喜紫微之解凶厄｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L048",
      "original_quote": ",官符太歲公冶有縲絏之憂｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L049",
      "original_quote": "限⾄天羅地網屈原溺⽔⽽⾝亡,運遇地劫天空阮籍有貧窮之苦｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L050",
      "original_quote": "⽂昌⽂曲會廉貞喪命天年,命空限空無吉湊功名蹭蹬｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L051",
      "original_quote": "⽣逢天空猶如半天折翅,命中遇劫恰如浪裡⾏船｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L052",
      "original_quote": "項⽻英雄限⾄天空⽽喪國,⽯崇豪富限⾏劫地以亡家｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L053",
      "original_quote": "呂后專權兩重天祿天⾺,楊妃好⾊三合⽂曲⽂昌｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L054",
      "original_quote": "天梁遇⾺女命賤⽽且淫,昌曲夾墀男命貴⽽且顯｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L055",
      "original_quote": "極居卯⻄多為脫俗僧⼈,貞居卯⻄定是公胥吏輩｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L056",
      "original_quote": "左府同宮尊居萬乘,廉貞七殺流蕩天涯｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L057",
      "original_quote": "鄧通餓死運逢⼤耗之鄉,夫⼦絕糧限到天傷之內｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L058",
      "original_quote": "鈴昌羅武限⾄投河,巨火擎⽺終⾝縊死｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L059",
      "original_quote": "命裡逢空不飄流即主疾苦,⾺頭帶劍非夭折則主刑傷｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L060",
      "original_quote": "⼦午破軍加官進祿,昌貪居命粉⾻碎屍｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L061",
      "original_quote": "朝⽃仰⽃爵祿榮昌,⽂桂⽂華九重貴顯｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L062",
      "original_quote": "丹墀桂墀早遂⻘雲之志,合祿拱祿定為巨擘之⾂｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L063",
      "original_quote": "陰陽會昌曲出世榮華,輔弼遇財官衣緋著紫｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L064",
      "original_quote": "巨梁相會廉貞併,合祿鴛鴦⼀世榮｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L065",
      "original_quote": "武曲閑宮多⼿藝天祿朝垣⾝榮貴顯,貪狼陷地作屠⼈｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L066",
      "original_quote": ",魁星臨命位列三台｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L067",
      "original_quote": "武曲居乾戌亥上,最怕太陰逢貪狼｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L068",
      "original_quote": "化祿還為好,休向墓中藏｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L069",
      "original_quote": "⼦午巨⾨⽯中隱⽟,明祿暗祿錦上添花｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L070",
      "original_quote": "紫微辰戌遇破軍,富⽽不貴有虛名｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L071",
      "original_quote": "昌曲破軍逢刑剋多勞碌天同戌宮為反背,丁⼈化吉主⼤貴｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L072",
      "original_quote": ",貪武墓中居三⼗才發福｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L073",
      "original_quote": "巨⾨辰戌為陷地,辛⼈化吉祿崢嶸｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L074",
      "original_quote": "機梁⻄上化吉者,縱遇財官也不榮｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L075",
      "original_quote": "⽇⽉最嫌反背乃為失輝,命⾝定要精求恐差分數｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L076",
      "original_quote": "陰騭延年增百福,⾄於陷地不遭傷｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L077",
      "original_quote": "命實運堅稿⽥得雨,命衰限弱嫩草遭霜｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L078",
      "original_quote": "論命必推星善惡,巨破擎⽺性必剛｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L079",
      "original_quote": "府相同梁性必好,火劫空貪性不常｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L080",
      "original_quote": "昌曲祿機清秀巧,陰陽左右最慈祥｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L081",
      "original_quote": "武破貞貪沖合曲全固貴,⽺陀七殺相雜互⾒則傷｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L082",
      "original_quote": "貪狼廉貞破軍惡,七殺擎⽺陀羅凶｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L083",
      "original_quote": "火星鈴星專作禍,劫空傷使禍重重｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L084",
      "original_quote": "巨⾨忌星皆不吉,運⾝命限忌相逢｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L085",
      "original_quote": "更兼太歲官符⾄,官非⼝⾆決不空｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L086",
      "original_quote": "吊客喪⾨⼜相遇,管教災病兩相攻｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L087",
      "original_quote": "七殺守⾝終是天,貪狼入命必為娼｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L088",
      "original_quote": "⼼好命微亦主壽,⼼毒命固亦天亡｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L089",
      "original_quote": "今⼈命有千⾦貴,運去之時豈久長｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_GusuiFu_L090",
      "original_quote": "數內包藏多少理,學者須當仔細詳｡",
      "tag": []
    }
  ],
  "_source": {
    "text": "紫微斗數全書",
    "juan": "卷一",
    "section": "⽃數⾻隨賦",
    "line_id_start": "ZWQS_Juan1_GusuiFu_L000",
    "line_id_end": "ZWQS_Juan1_GusuiFu_L090"
  }
}