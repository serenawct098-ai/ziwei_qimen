{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan8",
  "section": "占避難",
  "entries": [
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L000",
      "original_quote": "占避難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L001",
      "original_quote": "專以杜門決之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L002",
      "original_quote": "看其落於何方?即以其方避之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L003",
      "original_quote": "再看所乘之乾是何干?見戊為貴人潛避",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L004",
      "original_quote": "若杜門乘三奇則去無阻隔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L005",
      "original_quote": "大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L006",
      "original_quote": "若見庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L007",
      "original_quote": "須抱木行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L008",
      "original_quote": "方免凶災",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L009",
      "original_quote": "見辛為天獄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L010",
      "original_quote": "壬為地牢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L011",
      "original_quote": "必不能逃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L012",
      "original_quote": "若杜門落地盤癸為天網之格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L013",
      "original_quote": "在坎艮二宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L014",
      "original_quote": "可用三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L015",
      "original_quote": "四尺之木壓之而逃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L016",
      "original_quote": "若乾兌二宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L017",
      "original_quote": "可匍匐而過之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L018",
      "original_quote": "逃方在艮離二宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L019",
      "original_quote": "或高八",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L020",
      "original_quote": "九尺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L021",
      "original_quote": "可挺身而行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L022",
      "original_quote": "若杜門同癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L023",
      "original_quote": "震",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L024",
      "original_quote": "巽二宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L025",
      "original_quote": "天網盈門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L026",
      "original_quote": "不能逃脫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L027",
      "original_quote": "若杜門臨乾兌二宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L028",
      "original_quote": "木被金剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L029",
      "original_quote": "雖然逃去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L030",
      "original_quote": "後亦拿獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L031",
      "original_quote": "若有三奇吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L032",
      "original_quote": "落日乾之宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBiNan_L033",
      "original_quote": "有救",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan8",
    "section": "占避難",
