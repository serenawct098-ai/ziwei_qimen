{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan24",
  "section": "居青龍法",
  "entries": [
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L000",
      "original_quote": "居青龍法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L001",
      "original_quote": "凡出天門入地戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L002",
      "original_quote": "過太陰居青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L003",
      "original_quote": "經曰：「初兵出天門六戊也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L004",
      "original_quote": "入地戶六己也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L005",
      "original_quote": "過太陰六丁也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L006",
      "original_quote": "居青龍六甲也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L007",
      "original_quote": "居其下百戰百勝」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L008",
      "original_quote": "假如冬至上元甲己之日夜半生甲子時初起兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L009",
      "original_quote": "岀天門辰地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L010",
      "original_quote": "入地戶巳地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L011",
      "original_quote": "過太陰午地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L012",
      "original_quote": "居青龍子地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L013",
      "original_quote": "即百戰百勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L014",
      "original_quote": "又一法曰：「出天門者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L015",
      "original_quote": "天上六戊在一宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L016",
      "original_quote": "入天上地戶在二宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L017",
      "original_quote": "過天上太陰在七宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L018",
      "original_quote": "居天上青龍在一宮」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_JuQingLong_L019",
      "original_quote": "餘仿此",
      "tag": []
    }
  ],
