{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan19",
  "section": "突圍",
  "entries": [
    {
      "line_id": "QMDJ_Juan19_TuWei_L000",
      "original_quote": "突圍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L001",
      "original_quote": "或被兵圍不要忙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L002",
      "original_quote": "加時出路是天罡太公曰：「兵圍千里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L003",
      "original_quote": "鬥道必通」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L004",
      "original_quote": "鬥者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L005",
      "original_quote": "天罡也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L006",
      "original_quote": "以月將加時尋天罡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L007",
      "original_quote": "其下一實可出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L008",
      "original_quote": "若天罡方無路可出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L009",
      "original_quote": "當尋三官時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L010",
      "original_quote": "三官時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L011",
      "original_quote": "亥子醜也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L012",
      "original_quote": "若值絳官申酉地以月將加時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L013",
      "original_quote": "若亥臨子午卯酉為絳官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L014",
      "original_quote": "宜向天盤申酉下出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L015",
      "original_quote": "明堂時往太衝方子臨子午卯酉為明堂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L016",
      "original_quote": "宜向天盤卯方出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L017",
      "original_quote": "玉堂宜突天魁下醜臨子午卯酉為玉堂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L018",
      "original_quote": "宜向戌方出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L019",
      "original_quote": "利若鋒芒八極張逢豪強之賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L020",
      "original_quote": "勢不可當",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L021",
      "original_quote": "向天罡可出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L022",
      "original_quote": "此為八極張也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L023",
      "original_quote": "日辰上將相生吉傷不傷視陰陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L024",
      "original_quote": "若日辰與上將相生者吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L025",
      "original_quote": "相剋如今有損傷日辰與上將相剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L026",
      "original_quote": "又制日辰者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L027",
      "original_quote": "必有損傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L028",
      "original_quote": "用兵者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_TuWei_L029",
      "original_quote": "宜審之",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan19",
    "section": "突圍",
