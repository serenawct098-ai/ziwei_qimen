      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L001",
      "original_quote": "⼗⼆宮諸星得地合格訣⼦安命⼦宮貪狼殺陰星,機梁相拱福興隆,庚辛⼄癸⽣⼈美,⼀⽣富貴⾜豐榮｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第929行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L002",
      "original_quote": "丑安命丑宮立命⽇⽉朝,丙成⽣⼈福祿饒,正坐平常中局論,對照富貴禍皆消｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第932行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L003",
      "original_quote": "為官女受封｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第934行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L004",
      "original_quote": "寅安命寅宮巨⽇⾜豐隆,七殺天梁百事通,申已庚⼈皆為吉,男⼦卯安命卯宮機巨武曲逢,辛⼄⽣⼈福氣隆,男⼦為當縻廩祿,女⼈享福受褒封｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第935行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L005",
      "original_quote": "辰安命辰位機梁坐命宮,天府戍地最盈豐,腰⾦衣紫真榮顯,富華貴輝宜到終｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第938行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L006",
      "original_quote": "已安命已位天機天相臨,紫府朝垣福更深,戊辛壬丙皆為貴,⼀⽣順遂少災侵｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第940行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L007",
      "original_quote": "風光廩祿豐｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第942行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L008",
      "original_quote": "午安命午宮紫府太陽同,機梁破殺喜相逢,甲丁⼰癸⽣⼈福,⼀世未安命未宮紫武廉貞同,⽇⽉巨⾨喜相逢,女⼈值此全福壽,男⼦逢之位三公｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第943行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L009",
      "original_quote": "中安命申宮紫帝貞梁同,武曲巨⾨喜相逢,甲庚癸⼈如得喜,⼀⽣富貴逞英雄｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第945行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L010",
      "original_quote": "⻄安命⻄宮最喜太陰逢,巨⽇⼜逢當⾯沖,辛⼄⽣⼈為貴格,⼀⽣福祿永亨通｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第947行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L011",
      "original_quote": "開張貿易⼈｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第949行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L012",
      "original_quote": "榮華直到終｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⼗⼆宮諸星得地合格訣",
        "line_ref": "第950行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_PalaceFormulas_L013",
      "original_quote": "成安命戍宮紫微對沖辰,富⽽不貴有虛名,更加吉曜多權祿,只利亥安命亥宮最喜太陰逢,若⼈值此福祿隆,男女逢之皆稱意,富貴",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
