{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "地盤定法",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L000",
      "original_quote": "地盤定法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L001",
      "original_quote": "此地盤一定不易者也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L002",
      "original_quote": "所謂地主靜也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L003",
      "original_quote": "五日換一元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L004",
      "original_quote": "天盤則時時不同",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L005",
      "original_quote": "所謂天主動也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L006",
      "original_quote": "如乙丑時則以休門加天盤坤為值使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L007",
      "original_quote": "以值符天蓬星甲子戊加離九為值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L008",
      "original_quote": "諸照此例",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L009",
      "original_quote": "歌曰：「戊子乾宮亥為庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L010",
      "original_quote": "戊寅坎艮丑壬辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L011",
      "original_quote": "戊午生門同甲卯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L012",
      "original_quote": "四宮戊戌二九申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L013",
      "original_quote": "上有戊辰庚酉辛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L014",
      "original_quote": "一飛盤過一回新",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L015",
      "original_quote": "二十四盤方上起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L016",
      "original_quote": "門從方上定金鳴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L017",
      "original_quote": "所泊若差時一位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L018",
      "original_quote": "就將方位東方神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L019",
      "original_quote": "此是九星真秘訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L020",
      "original_quote": "消凶納吉萬全亨」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L021",
      "original_quote": "歌曰：「一盤西去兩盤東",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L022",
      "original_quote": "二至精微在此中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L023",
      "original_quote": "一二卻從天上落",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L024",
      "original_quote": "八九順從地下通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L025",
      "original_quote": "二九伏從丁九丙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L026",
      "original_quote": "乙丙山山盡起風",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L027",
      "original_quote": "三四過去重三九",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L028",
      "original_quote": "一盤起去一盤宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L029",
      "original_quote": "此方即是真神女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L030",
      "original_quote": "九九移來路上同",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L031",
      "original_quote": "非是賢人莫妄語",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L032",
      "original_quote": "怕將機巧亂研窮」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L033",
      "original_quote": "以子加直使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L034",
      "original_quote": "陽遁順",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L035",
      "original_quote": "陰遁逆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L036",
      "original_quote": "玉女時上落在何宮是也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L037",
      "original_quote": "此是陽遁上元甲己日乙亥時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L038",
      "original_quote": "值使在三宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L039",
      "original_quote": "故休門杜坤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L040",
      "original_quote": "取子加卯順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L041",
      "original_quote": "看亥落何宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L042",
      "original_quote": "即知亥時在艮景門上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L043",
      "original_quote": "左足先二步華蓋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L044",
      "original_quote": "豹向豹尾而去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L045",
      "original_quote": "人鬼不見形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L046",
      "original_quote": "其法照飛宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L047",
      "original_quote": "指陰陽二遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L048",
      "original_quote": "如冬至上元甲己日甲子時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L049",
      "original_quote": "則知九天在休門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L050",
      "original_quote": "九地在離",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L051",
      "original_quote": "夏至上元甲己日甲子時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L052",
      "original_quote": "九地在休門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L053",
      "original_quote": "九天在離",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L054",
      "original_quote": "餘仿此而推之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L055",
      "original_quote": "歌曰：「赤道白道與黃道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L056",
      "original_quote": "不避千年騐不到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L057",
      "original_quote": "餘此六道是吉神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L058",
      "original_quote": "配合奇門遁真好」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L059",
      "original_quote": "法分二遁隱避之訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L060",
      "original_quote": "必分道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L061",
      "original_quote": "遁道之中赤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L062",
      "original_quote": "白",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L063",
      "original_quote": "黃三道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L064",
      "original_quote": "尤宜謹避",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L065",
      "original_quote": "不然雖合三奇吉門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L066",
      "original_quote": "亦遁不通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L067",
      "original_quote": "難免十患",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L068",
      "original_quote": "此即甲乙丙丁戊陽時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L069",
      "original_quote": "神居天上要君知也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_DiPanDingFa_L070",
      "original_quote": "陰時仿此",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan30",
    "section": "地盤定法",
