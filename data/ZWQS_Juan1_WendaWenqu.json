  "section": "星垣問答論_Wenqu",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaWenqu_L001",
      "original_quote": "問文曲星所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaWenqu_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaWenqu_L002",
      "original_quote": "答曰：文曲屬水，北斗第四星也，主科甲文車之宿。其象屬水，與文昌同協，吉數最為祥，臨身命中作科第之客。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaWenqu_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaWenqu_L003",
      "original_quote": "桃花浪煖，入仕無疑。於官祿面君顏而執政。單居身命，吏逢凶曜，亦作無名舌辯之徒。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaWenqu_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaWenqu_L004",
      "original_quote": "與廉貞共處必作公吏官。身與太陰同行，定係九流術士。怕逢破軍恐臨水以生災；嫌遇貪狼蒞政事而顛倒。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaWenqu_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaWenqu_L005",
      "original_quote": "逢七殺刑忌囚及諸惡曜，詐偽莫逃。逢巨門共其度，和而喪志。女命不宜於逢，水性楊花。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaWenqu_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaWenqu_L006",
      "original_quote": "忌入土宮，限臨蹭蹬。若祿存、化祿來纏，不可以為凶論。相之格，文昌遇合亦然。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaWenqu_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaWenqu_L007",
      "original_quote": "若陷宮午戌之地，巨門羊陀沖破，喪命夭折，水大驚險。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaWenqu_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaWenqu_L008",
      "original_quote": "若亥卯未旺地，與天梁天相會主聰明博學，殺沖破只宜僧道。若女命值之清秀聰明主貴，若陷地沖破淫而且賤。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaWenqu_L008",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
