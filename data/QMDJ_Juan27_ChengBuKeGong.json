{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan27",
  "section": "城有不可攻者",
  "entries": [
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L000",
      "original_quote": "城有不可攻者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L001",
      "original_quote": "凡青黃雲氣臨城",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L002",
      "original_quote": "若白雲從城中南北出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L003",
      "original_quote": "或白氣中出而青氣北入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L004",
      "original_quote": "往返四遠",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L005",
      "original_quote": "若赤氣如杵向外有黑雲如星出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L006",
      "original_quote": "曰星精",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L007",
      "original_quote": "若日暈有青赤氣從中四出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L008",
      "original_quote": "若蒙氣繞城而不入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L009",
      "original_quote": "若城上白氣如旌旗形狀云",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L010",
      "original_quote": "若赤絮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L011",
      "original_quote": "若青雲入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L012",
      "original_quote": "如牛頭觸千人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L013",
      "original_quote": "若氣如煙火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L014",
      "original_quote": "若中出而入我軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L015",
      "original_quote": "若如雙蛇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L016",
      "original_quote": "若雲分雨雪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L017",
      "original_quote": "若云剋日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L018",
      "original_quote": "如甲乙平旦有白云",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L019",
      "original_quote": "丙丁日有黑雲等",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L020",
      "original_quote": "若圍城",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L021",
      "original_quote": "雷雨過旬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L022",
      "original_quote": "又城上氣滿人不見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_ChengBuKeGong_L023",
      "original_quote": "皆為不可攻",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan27",
    "section": "城有不可攻者",
    "line_id_start": "QMDJ_Juan27_ChengBuKeGong_L000",
    "line_id_end": "QMDJ_Juan27_ChengBuKeGong_L023"
