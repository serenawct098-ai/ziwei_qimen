{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan7",
  "section": "占雀噪",
  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L000",
      "original_quote": "占雀噪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L001",
      "original_quote": "以朱雀為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L002",
      "original_quote": "看朱雀所臨何奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L003",
      "original_quote": "何門?以決其事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L004",
      "original_quote": "如開門得奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L005",
      "original_quote": "主有親朋至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L006",
      "original_quote": "或行人遠歸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L007",
      "original_quote": "或主酒食此皆以開門斷之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L008",
      "original_quote": "人盤以斷人事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L009",
      "original_quote": "此舉一隅也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L010",
      "original_quote": "休門得奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L011",
      "original_quote": "主有喜事休即喜也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L012",
      "original_quote": "喜信及婚姻之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L013",
      "original_quote": "生門得奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L014",
      "original_quote": "主得田產",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L015",
      "original_quote": "財物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L016",
      "original_quote": "豬畜之事俱切生門斷法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L017",
      "original_quote": "若不得三門及門迫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L018",
      "original_quote": "奇墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L019",
      "original_quote": "俱主無所關系",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L020",
      "original_quote": "要看景門臨吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L021",
      "original_quote": "則有喜信",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L022",
      "original_quote": "凶格則有憂信",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanQueZao_L023",
      "original_quote": "或小煩惱",
      "tag": []
    }
  ],
