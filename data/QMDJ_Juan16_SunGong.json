{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan16",
  "section": "總論太陽過宮",
  "entries": [
    {
      "line_id": "QMDJ_Juan16_SunGong_L000",
      "original_quote": "總論太陽過宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L001",
      "original_quote": "總論太陽過宮天三門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L002",
      "original_quote": "地四戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L003",
      "original_quote": "地私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L004",
      "original_quote": "太衝天馬方同例",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L005",
      "original_quote": "旦貴用上一字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L006",
      "original_quote": "即內盤之乙巽丙丁坤庚六時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L007",
      "original_quote": "暮貴用下一字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L008",
      "original_quote": "即內盤之辛幹壬癸艮坤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L009",
      "original_quote": "甲六時神所到之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L010",
      "original_quote": "自亥至辰為陽支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L011",
      "original_quote": "宜順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L012",
      "original_quote": "自巳至戌為陰支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L013",
      "original_quote": "宜逆行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L014",
      "original_quote": "二盤當合推用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L015",
      "original_quote": "但分之以知甲在卯宮用暮貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L016",
      "original_quote": "巽在巳宮用旦貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L017",
      "original_quote": "假如正月雨水後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L018",
      "original_quote": "太陽躔娵訾之次",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L019",
      "original_quote": "月將在亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L020",
      "original_quote": "則以亥加用時之上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L021",
      "original_quote": "以分旦暮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L022",
      "original_quote": "定其陰陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L023",
      "original_quote": "又視貴神所到之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L024",
      "original_quote": "詳其陽支宜順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L025",
      "original_quote": "陰支宜逆行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L026",
      "original_quote": "以求三辰所在之位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L027",
      "original_quote": "假如甲日用卯時屬下之一字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L028",
      "original_quote": "用暮貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L029",
      "original_quote": "定為陽貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L030",
      "original_quote": "則以亥加卯宮順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L031",
      "original_quote": "陽貴神未在亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L032",
      "original_quote": "亥為陽支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L033",
      "original_quote": "加貴神順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L034",
      "original_quote": "六合在寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L035",
      "original_quote": "太常在未",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L036",
      "original_quote": "太陰在酉也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L037",
      "original_quote": "假如甲日用午時屬上之一字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L038",
      "original_quote": "用旦貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L039",
      "original_quote": "定為陰貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L040",
      "original_quote": "則以亥加午順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L041",
      "original_quote": "陰貴醜在申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L042",
      "original_quote": "申為陰支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L043",
      "original_quote": "加貴神逆行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L044",
      "original_quote": "太陰在戌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L045",
      "original_quote": "太常在子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L046",
      "original_quote": "六合在巳也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L047",
      "original_quote": "假如甲日用子時屬下之一字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L048",
      "original_quote": "用暮貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L049",
      "original_quote": "定為陽貴神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L050",
      "original_quote": "則以亥加子順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L051",
      "original_quote": "陽貴神未在申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L052",
      "original_quote": "申為陰支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L053",
      "original_quote": "加貴神逆行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L054",
      "original_quote": "太陰在戌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L055",
      "original_quote": "太常在子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L056",
      "original_quote": "六合在巳也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L057",
      "original_quote": "餘皆仿此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L058",
      "original_quote": "陽貴詩曰：「庚戊見牛甲在羊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L059",
      "original_quote": "乙猴己鼠丙雞方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L060",
      "original_quote": "丁豬癸蛇壬是兔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L061",
      "original_quote": "六辛逢虎貴為陽」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L062",
      "original_quote": "陰貴詩曰：「甲貴陰牛庚戊羊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L063",
      "original_quote": "乙陰在鼠己猴鄉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L064",
      "original_quote": "丙雞丁豬辛遇馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_SunGong_L065",
      "original_quote": "壬蛇癸兔是陰方」",
      "tag": []
    }
  ],
  "_source": {
