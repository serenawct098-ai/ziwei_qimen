        "line_ref": "第1865行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P001_S000",
      "original_quote": "天蓬、天芮星值辰時",
      "paragraph_index": 1,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1866行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P002_S000",
      "original_quote": "東北樹倒打人迷，鼓響女穿紅衣至，鳥鵲遠繞賊劫財，六十日有風人到，後生貴子大發財。",
      "paragraph_index": 2,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1867行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P003_S000",
      "original_quote": "天衝星值辰時",
      "paragraph_index": 3,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1868行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P004_S000",
      "original_quote": "鯉魚上樹，白虎出山，僧道成群，用後拾得金銀物，家中大發百事成，七旬因主折傷災，一女一男退回靈。",
      "paragraph_index": 4,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1869行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P005_S000",
      "original_quote": "天輔星值辰時",
      "paragraph_index": 5,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1870行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P006_S000",
      "original_quote": "羊犬相撞，賣油人遇賣菓米，白衣童子哭家去，孕婦至此問產期，造後大發財榖旺，一年雙生貴孫兒。",
      "paragraph_index": 6,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1871行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P007_S000",
      "original_quote": "天禽星值辰時",
      "paragraph_index": 7,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1872行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P008_S000",
      "original_quote": "師巫爭，東方鷗鵲鳴為應，雀鶴必定喜臨屋，造葬七九之日內，自有道士僧人來，並及絕戶產物至。",
      "paragraph_index": 8,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1873行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P009_S000",
      "original_quote": "天心星值辰時",
      "paragraph_index": 9,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1874行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P010_S000",
      "original_quote": "干雲起，青衣人手攜魚至，女人同行及僧道，六十井中氣如云，出來三日生貴子，及第聯登甚有意。",
      "paragraph_index": 10,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1875行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P011_S000",
      "original_quote": "天柱星值辰時",
      "paragraph_index": 11,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1876行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P012_S000",
      "original_quote": "人扛樹，男子持鼓有引婦，老人攜鋤一作攜鍋後六十，烏貓白子鷄雙生，北方人進寡婦財，紅面人說羽音物。",
      "paragraph_index": 12,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1877行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P013_S000",
      "original_quote": "天任星值辰時",
      "paragraph_index": 13,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1878行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P014_S000",
      "original_quote": "老人臨，弟兄相會小不留，禽噪犬吠黃衣過，古器男子獲的真，開店人家童手拍，六十日內家畜訟。",
      "paragraph_index": 14,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1879行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P015_S000",
      "original_quote": "天英星值辰時",
      "paragraph_index": 15,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1880行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P016_S000",
      "original_quote": "乾來雨，鷄飛上樹是赤尾，女人穿紅攜籃錯，用後七日怪氣寓，六十日內進血財，火光臨處誠有起。",
      "paragraph_index": 16,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1881行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P017_S000",
      "original_quote": "天蓬星值巳時",
      "paragraph_index": 17,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1882行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P018_S000",
      "original_quote": "見老人，女人執酒宴忘雄，口舌皆因水上起，百日得火有黃金，周年武職加官祿，豬過必然見蛇形。",
      "paragraph_index": 18,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1883行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P019_S000",
      "original_quote": "天芮星值巳時",
      "paragraph_index": 19,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1884行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P020_S000",
      "original_quote": "孕婦至，妓巫為樂著黃衣，烏鵝成群北來過，六十日內見寡婦，貓兒咬雞真堪怪，牛入草房方可異。",
      "paragraph_index": 20,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1885行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P021_S000",
      "original_quote": "天衝星值巳時",
      "paragraph_index": 21,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1886行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P022_S000",
      "original_quote": "牛爭鬪，羊亂行時女相並，南方禽喧因坤程，六十日內蛇咬雞，牛入屋中女送契，田財發生花兒一作犬生花子。",
      "paragraph_index": 22,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1887行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P023_S000",
      "original_quote": "天輔星值巳時",
      "paragraph_index": 23,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1888行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P024_S000",
      "original_quote": "人相打，女人抱布有風起，小兒嘆叫爭家冷，六十日內進震財，鬼神運糧大發達，竹木器物盡置來。",
      "paragraph_index": 24,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1889行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P025_S000",
      "original_quote": "天禽星值巳時",
      "paragraph_index": 25,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1890行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P026_S000",
      "original_quote": "雞鳴至一作鴨成隊，師巫術人相打罵，貴人騎馬慌忙過，七十日中婦打魔，合生貴子成家業，三年田蠶發苗禾。",
      "paragraph_index": 26,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1891行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P027_S000",
      "original_quote": "天心星值巳時",
      "paragraph_index": 27,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1892行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P028_S000",
      "original_quote": "女穿青，抱得小兒龜上樹，紫衣騎馬半月後，四方進的畜財屬，跛人作牙商音產，三年寡婦成空服。",
      "paragraph_index": 28,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1893行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P029_S000",
      "original_quote": "天柱星值巳時",
      "paragraph_index": 29,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1894行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P030_S000",
      "original_quote": "黑牛過，鐘鳴豬走入山林，二十日進商音物，六十日女下水池，周年貓捕白鼠至，大發富貴何待時。",
      "paragraph_index": 30,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1895行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P031_S000",
      "original_quote": "天任星值巳時",
      "paragraph_index": 31,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1896行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P032_S000",
      "original_quote": "兩犬爭，野人負薪至此程，吏役持蓋童子拍，六十日獲公門財，南方人送鯉魚至，異路顯達貴子排。",
      "paragraph_index": 32,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1897行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P033_S000",
      "original_quote": "天英星值巳時",
      "paragraph_index": 33,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1898行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P034_S000",
      "original_quote": "婦穿紅，婚姻事體口舌起，花馬過後六十日，拾得獵財血光榮，徵音人進文書至，信炮一聲滿天烘。",
      "paragraph_index": 34,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1899行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P035_S000",
      "original_quote": "天蓬星值午時",
      "paragraph_index": 35,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1900行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P036_S000",
      "original_quote": "婦青衣，有人持刀上南山，東北有嘆聲，六旬犬作人言怪，赤面風瘋人家主死，三年內有古窖財。",
      "paragraph_index": 36,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1901行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P037_S000",
      "original_quote": "天芮星值午時",
      "paragraph_index": 37,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1902行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P038_S000",
      "original_quote": "缺唇人，身著白衣牽黃牛，孕婦過後六十日，貓兒咬人因賣屋，橫財獲的進田地，後姜奩財多上壁。",
      "paragraph_index": 38,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1903行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P039_S000",
      "original_quote": "天衝星值午時",
      "paragraph_index": 39,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1904行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P040_S000",
      "original_quote": "原文缺",
      "paragraph_index": 40,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第338行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P041_S000",
      "original_quote": "天輔星值午時",
      "paragraph_index": 41,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1906行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P042_S000",
      "original_quote": "僧持蓋，女人穿紅家中來，石火光發至後日，六十貴人進異財，西方金銀人送至，周年寡婦將物來。",
      "paragraph_index": 42,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1907行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P043_S000",
      "original_quote": "天禽星值午時",
      "paragraph_index": 43,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1908行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P044_S000",
      "original_quote": "女白衣，狗銜花枝鷄鬬山，風雨徐徐從東來，造六旬犬吠至，東北人財，一年內雞生白卵，田苗旺發。",
      "paragraph_index": 44,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1909行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P045_S000",
      "original_quote": "天心星值午時",
      "paragraph_index": 45,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1910行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P046_S000",
      "original_quote": "驟雨來，蛇過路去女紅裙，攜符酒送武士杯，六十日中釜鳴，有跛足人送生氣物，五年進金田莊財。",
      "paragraph_index": 46,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1911行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P047_S000",
      "original_quote": "天柱星值午時",
      "paragraph_index": 47,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1912行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P048_S000",
      "original_quote": "鴉飛鳴，西方騎馬就有云，五日孕婦並喪泣，六十日內水尋神物，古器真是寶，小口傷時在一旬。",
      "paragraph_index": 48,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1913行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P049_S000",
      "original_quote": "天任星值午時",
      "paragraph_index": 49,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1914行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P050_S000",
      "original_quote": "來師尼，西北黃禽君子行，四十日進貴人寶，紫衣入宅生貴孫，孕婦童子來借馬，人還虎皮穿黃青。",
      "paragraph_index": 50,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1915行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P051_S000",
      "original_quote": "天英星值午時",
      "paragraph_index": 51,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1916行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P052_S000",
      "original_quote": "婚姻南，採獵漁人執弓弦，用後六十日中事，被木傷人火光炎，自縊落水是公子，乘馬必定為女娘。",
      "paragraph_index": 52,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1917行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P053_S000",
      "original_quote": "天蓬星值未時",
      "paragraph_index": 53,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1918行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P054_S000",
      "original_quote": "童子過，牽的牛兒是兩個，鷺飛鵝禽北方來，女人穿紅還是青衣，六十日內逢賊劫，破顏惹氣至官災。",
      "paragraph_index": 54,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1919行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P055_S000",
      "original_quote": "天芮星值未時",
      "paragraph_index": 55,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1920行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P056_S000",
      "original_quote": "捕獵應，白衣道人攜茶瓶，七日烏鴉繞屋噪，赤面須人三牙靈，鬬爭周年動瘟疫，火燒屋敗又傷人。",
      "paragraph_index": 56,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1921行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P057_S000",
      "original_quote": "天衝星值未時",
      "paragraph_index": 57,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1922行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P058_S000",
      "original_quote": "乾鼓響，小兒著孝馬成行，西北人叫或爭鬪，用後六十日內防，惡人持木剋寡母，白羊入屋六畜旺。",
      "paragraph_index": 58,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1923行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P059_S000",
      "original_quote": "天輔星值未時",
      "paragraph_index": 59,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1924行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P060_S000",
      "original_quote": "群犬吠，乞丐攜著破衣服，眾僧道人同議話，西北有人爭屋廚，百日內進文書契，商音人送金銀餘。",
      "paragraph_index": 60,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1925行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P061_S000",
      "original_quote": "天禽星值未時",
      "paragraph_index": 61,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1926行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P062_S000",
      "original_quote": "老人來，跛足人擔花果來，青黃衣人攜酒至，葬後六十日內裁，羽音人送雞畜物，鐵器原來是宰肉開。",
      "paragraph_index": 62,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1927行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P063_S000",
      "original_quote": "天心星值未時",
      "paragraph_index": 63,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1928行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P064_S000",
      "original_quote": "霧雨來，男子著黃女衣人彩，攜酒必定邀尊長，六十日中亦釜鳴，跛足人騎馬或坐車，金銅刃器為田程。",
      "paragraph_index": 64,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1929行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P065_S000",
      "original_quote": "天柱星值未時",
      "paragraph_index": 65,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1930行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P066_S000",
      "original_quote": "遇瘦婦，僧道同行求安否，東北人馬持旗蓋，用後百日有怪粕，新媳狐狸纏身邊，生鐵那火叩頭面。",
      "paragraph_index": 66,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1931行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P067_S000",
      "original_quote": "天任星值未時",
      "paragraph_index": 67,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1932行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P068_S000",
      "original_quote": "白雞飛，禽鳥飛自西南至，北來風雨鼓聲鬧，用後七日家童張一作一七內女送白物，六九家生白炁異，應得六畜大旺財。",
      "paragraph_index": 68,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1933行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P069_S000",
      "original_quote": "天英星值未時",
      "paragraph_index": 69,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1934行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P070_S000",
      "original_quote": "孕婦遇，西方鼓聲來相賀，造葬之後六十日，家主落水怎奈何，周年瘟疫身體敗，馬肥還得母草多。",
      "paragraph_index": 70,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1935行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P071_S000",
      "original_quote": "天蓬星值申時",
      "paragraph_index": 71,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1936行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P072_S000",
      "original_quote": "人取水，傘笠避雨必有趨，西方小兒打水過，擂鼓叫喊笑聲去，一十日鷄窼蛇傷人，妻淫自縊訟事惡。",
      "paragraph_index": 72,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1937行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P073_S000",
      "original_quote": "天芮星值申時",
      "paragraph_index": 73,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1938行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P074_S000",
      "original_quote": "東產來一作涼傘，道人一作僧道青蓋身長驅一作有胡須，牛鬬傷人犬咬毒，百日羽音進物排，周年水牛入屋中，鵬鳥人家染病懷。",
      "paragraph_index": 74,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1939行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P075_S000",
      "original_quote": "天衝星值申時",
      "paragraph_index": 75,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1940行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P076_S000",
      "original_quote": "作用時，南方騎馬白衣人，吏卒人持刃相殺，百二十日女作媒，絕戶田產來進納，寡婦被賊劫不容。",
      "paragraph_index": 76,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1941行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P077_S000",
      "original_quote": "天輔星值申時",
      "paragraph_index": 77,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1942行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P078_S000",
      "original_quote": "腫腳人攜酒至此，請醫婦儒釋，道人穿色衣，西北鼓聲女財發，半年蛇從井中出，平白人送牛羊至。",
      "paragraph_index": 78,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1943行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P079_S000",
      "original_quote": "天禽星值申時",
      "paragraph_index": 79,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1944行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P080_S000",
      "original_quote": "家一作飛鳥叫師巫持符，百日內女人自拾珠翠歸，周年新婦昌有位，生得貴子旺田蠶，誠恐家賊自劫退。",
      "paragraph_index": 80,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1945行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P081_S000",
      "original_quote": "天心星值申時",
      "paragraph_index": 81,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1946行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P082_S000",
      "original_quote": "僧道來，金鼓四鳴百鳥噪，紅裙女人送酒至，寡婦坐堂入寶窖，老人持杖馬銜環，軍人在家推病好。",
      "paragraph_index": 82,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1947行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P083_S000",
      "original_quote": "天柱星值申時",
      "paragraph_index": 83,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1948行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P084_S000",
      "original_quote": "作用時，水鷹鷂掠禽墜地，青衣女人攜籃至，用後百日火光起，家敗人亡白衣物，剋宅體生是游情。",
      "paragraph_index": 84,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1949行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P085_S000",
      "original_quote": "天任星值申時",
      "paragraph_index": 85,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1950行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P086_S000",
      "original_quote": "風雨來，三牙須人打鼓至，僧道穿黃應時候，七日軍置黃犬來一作七日之內甑釜，女人火燒湯潑水，車碾百禽銜榖排。",
      "paragraph_index": 86,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1951行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P087_S000",
      "original_quote": "天英星值申時",
      "paragraph_index": 87,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1952行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P088_S000",
      "original_quote": "作用時，懷孕婦人大哭啼，西方金鼓聲鳴響，僧道持蓋浪喘瘟，火臨金時門爭戰，六十日內有進金。",
      "paragraph_index": 88,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1953行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P089_S000",
      "original_quote": "天蓬星值酉時",
      "paragraph_index": 89,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1954行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P090_S000",
      "original_quote": "赤馬過，西方輪輿群鴉噪，用後百日生貴子，僧道作牙商音地，三年內雞生雙子，貓養白兒試及第。",
      "paragraph_index": 90,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1955行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P091_S000",
      "original_quote": "天芮星值酉時",
      "paragraph_index": 91,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1956行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P092_S000",
      "original_quote": "西黃馬，車轎傘蓋婦必寡，須人相鬪犬吠人，羽音進產主誠雅，周年牛必入屋中，鳥鵬來家腹得疾。",
      "paragraph_index": 92,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1957行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P093_S000",
      "original_quote": "天衝、天輔星值酉時",
      "paragraph_index": 93,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1958行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P094_S000",
      "original_quote": "遠方人送書至，東方狐狸咬叫聲，婦人拿火把來吹，用後周年生貴子，拾得橫財大發期。",
      "paragraph_index": 94,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1959行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P095_S000",
      "original_quote": "天禽星值酉時",
      "paragraph_index": 95,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1960行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P096_S000",
      "original_quote": "西火起，人家相打大叫理，鼓聲繞噪驚鳥飛，造後周歲有貴子，必有窖財進門庭，喜鵲簷前報霧雨。",
      "paragraph_index": 96,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1961行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P097_S000",
      "original_quote": "天心星值酉時",
      "paragraph_index": 97,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1962行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P098_S000",
      "original_quote": "僧尼來，火起從坤必定排，北方鐘鼓鳴聲鬧，騾叫官員駝寶財，藝人送到遠信至，七日商音娶女釵。",
      "paragraph_index": 98,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1963行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P099_S000",
      "original_quote": "天柱星值酉時",
      "paragraph_index": 99,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1964行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P100_S000",
      "original_quote": "作用時，白鷹撲鴿明是欺，青衣之人取鐵器，因火喪家女守孤，七十日有商音進，夫婦和諧遠路移。",
      "paragraph_index": 100,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1965行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P101_S000",
      "original_quote": "天任星值酉時",
      "paragraph_index": 101,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1966行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P102_S000",
      "original_quote": "犬上門，童子拍手笑黃狐，院中幼女喜歡娛，六十日中生貴兒，白雞地起婦傾酒，遠路必定遇碑石。",
      "paragraph_index": 102,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1967行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P103_S000",
      "original_quote": "天英星值酉時",
      "paragraph_index": 103,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1968行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P104_S000",
      "original_quote": "火入金，西方有人宅相爭，鴉鳴喧呼暴碑過，白衣女人懷孕臨，事後一旬小口母折足，百日爭得財。",
      "paragraph_index": 104,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1969行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P105_S000",
      "original_quote": "天蓬星值戌時",
      "paragraph_index": 105,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1970行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P106_S000",
      "original_quote": "作用時，老人持杖入側，西北露雨至此下，三牙須人擔籮至，白犬過後依旬內，拾得軍器有橫財。",
      "paragraph_index": 106,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1971行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P107_S000",
      "original_quote": "天芮星值戌時",
      "paragraph_index": 107,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1972行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P108_S000",
      "original_quote": "黃牛來，孕婦東方持傘回，惡犬家中出傷人，周年宮音送土財，百禽飛過車入到，糞中拋出女金釵。",
      "paragraph_index": 108,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1973行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P109_S000",
      "original_quote": "天衝、天輔星值戌時",
      "paragraph_index": 109,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1974行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P110_S000",
      "original_quote": "西方來了三五人，手執火把尋失物，師巫與三牙須人逢，鷄上樹啼遠有信，周年小口被牛損。",
      "paragraph_index": 110,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1975行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P111_S000",
      "original_quote": "天禽星值戌時",
      "paragraph_index": 111,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1976行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P112_S000",
      "original_quote": "東北應，鐘聲鐃鈸響叮咚，青衣童子攜籃過，一旬之內白龜臨，就得寡母田地發，有人攜舉福到門。",
      "paragraph_index": 112,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1977行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P113_S000",
      "original_quote": "天心星值戌時",
      "paragraph_index": 113,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1978行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P114_S000",
      "original_quote": "作用時，南方大叫賊驚疑，小兒騎牛至此過，百日家中主生貴子，金鷄鳴分玉犬吠，二年之後請得舉。",
      "paragraph_index": 114,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1979行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P115_S000",
      "original_quote": "天柱星值戌時",
      "paragraph_index": 115,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1980行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P116_S000",
      "original_quote": "女抱布，北方樹倒打人故，西有鼓聲因葬事，六十日內蛇入宅，咬人皆是白色毒，連年瘟疫死未絕。",
      "paragraph_index": 116,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1981行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P117_S000",
      "original_quote": "天任星值戌時",
      "paragraph_index": 117,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1982行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P118_S000",
      "original_quote": "童來時，家中爭訟因失時，犬噪發凶喪戶過，飛禽色黃尼姑來，貴人財旺一百日，紫衣之人來有財。",
      "paragraph_index": 118,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1983行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P119_S000",
      "original_quote": "天英星值戌時",
      "paragraph_index": 119,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1984行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P120_S000",
      "original_quote": "用時推，西方女人執白布，火光至此賊獄死，赤馬買到遭訟非，一旬之內瘟病急，野雞紅翅主退財。",
      "paragraph_index": 120,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1985行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P121_S000",
      "original_quote": "天蓬星值亥時",
      "paragraph_index": 121,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1986行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P122_S000",
      "original_quote": "童子多成群，女人著孝服，後因投賊得橫財，三年內出道人過，術人求財積成家，義豬被鵬銜肉過。",
      "paragraph_index": 122,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1987行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P123_S000",
      "original_quote": "天芮星值亥時",
      "paragraph_index": 123,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1988行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P124_S000",
      "original_quote": "走禽驚，秋冬吉時客主宅，春夏不用囚剋洩，坤方火起二人還，貓犬傷人孕婦病，女人自縊一自悲。",
      "paragraph_index": 124,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1989行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P125_S000",
      "original_quote": "天衝、天輔星值亥時",
      "paragraph_index": 125,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1990行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P126_S000",
      "original_quote": "跛足青衣人即至，東北人家火光起，百日貓兒捉白鼠，商音人進田地契，妻財大發扶其主。",
      "paragraph_index": 126,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1991行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P127_S000",
      "original_quote": "天禽星值亥時",
      "paragraph_index": 127,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1992行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P128_S000",
      "original_quote": "起西風，乾地婦人有哭聲，樹倒拆屋大叫起，六十日進鐵匠財，商音人說僧人產，喜鵲報到家信來。",
      "paragraph_index": 128,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1993行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P129_S000",
      "original_quote": "天心星值亥時",
      "paragraph_index": 129,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1994行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P130_S000",
      "original_quote": "鷄夜鳴，又主無故犬狂吠，老人頭戴皮帽子，手執鐵器必然貴，七日不知異人至，借宿遺財天賜得。",
      "paragraph_index": 130,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1995行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P131_S000",
      "original_quote": "天柱星值亥時",
      "paragraph_index": 131,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1996行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P132_S000",
      "original_quote": "西磬聲，山下有人持火焚，叫呼喧天造葬後，救火得財大發榮，百日恐有雞作怪，人死雙雙拜古墳。",
      "paragraph_index": 132,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1997行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P133_S000",
      "original_quote": "天任星值亥時",
      "paragraph_index": 133,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1998行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P134_S000",
      "original_quote": "小兒過，悔苔之下笑呵呵，西方鑼鼓喧喧鬧，鐵器手空中傷多，白日憂福至家僕，一人土墊水渠橋。",
      "paragraph_index": 134,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第1999行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P135_S000",
      "original_quote": "天英星值亥時",
      "paragraph_index": 135,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
        "section": "卷十八",
        "line_ref": "第2000行"
      }
    },
    {
      "line_id": "QMDJ_Juan18_P136_S000",
      "original_quote": "女人來，手執火把出大街，百日內有癩人至，鍾命要與投井壞，北方樹倒傷人屋，星為客兮宮主斷。",
      "paragraph_index": 136,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十八",
