{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan21",
  "section": "總法天機前篇",
  "entries": [
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L000",
      "original_quote": "總法天機前篇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L001",
      "original_quote": "凡布演奇門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L002",
      "original_quote": "先觀天象",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L003",
      "original_quote": "後察細微",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L004",
      "original_quote": "總在我一心之所用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L005",
      "original_quote": "不可不知也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L006",
      "original_quote": "如天盤九星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L007",
      "original_quote": "奇儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L008",
      "original_quote": "八門屬金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L009",
      "original_quote": "加於地盤諸星上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L010",
      "original_quote": "木是金水為客來傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L011",
      "original_quote": "主戰利為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L012",
      "original_quote": "行兵先舉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L013",
      "original_quote": "放炮吶喊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L014",
      "original_quote": "士卒精強",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L015",
      "original_quote": "百戰百勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L016",
      "original_quote": "凡求謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L017",
      "original_quote": "請謁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L018",
      "original_quote": "交易等事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L019",
      "original_quote": "破敗驚憂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L020",
      "original_quote": "客舍暗昧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L021",
      "original_quote": "遭逢盜賊小人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L022",
      "original_quote": "惟行人即至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L023",
      "original_quote": "若金旺木衰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L024",
      "original_quote": "其凶尤甚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L025",
      "original_quote": "如天盤金星在衰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L026",
      "original_quote": "墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L027",
      "original_quote": "死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L028",
      "original_quote": "絕之時加於木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L029",
      "original_quote": "無氣之金不能剋木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L030",
      "original_quote": "若木在生旺之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L031",
      "original_quote": "則木星為吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L032",
      "original_quote": "如木亦衰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L033",
      "original_quote": "墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L034",
      "original_quote": "絕之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L035",
      "original_quote": "而凶終不能免矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L036",
      "original_quote": "如天盤木星加於地盤火星上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L037",
      "original_quote": "是為木能生火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L038",
      "original_quote": "戰利為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L039",
      "original_quote": "諸為一切等事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L040",
      "original_quote": "皆如心意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L041",
      "original_quote": "如有重木臨生旺之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L042",
      "original_quote": "謂之貪生之木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L043",
      "original_quote": "壓火無光",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L044",
      "original_quote": "火漸自滅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L045",
      "original_quote": "若木臨退氣之宮或木少",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L046",
      "original_quote": "多是枯木生火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L047",
      "original_quote": "大利主兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L048",
      "original_quote": "如天盤土加於地盤金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L049",
      "original_quote": "是客來生主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L050",
      "original_quote": "若系土旺或有重土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L051",
      "original_quote": "雖曰生金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L052",
      "original_quote": "而土重埋金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L053",
      "original_quote": "必有暗兵埋伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L054",
      "original_quote": "或英雄失志",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L055",
      "original_quote": "或忠烈受屈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L056",
      "original_quote": "如天盤木加地盤金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L057",
      "original_quote": "乃主傷其客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L058",
      "original_quote": "宜偃旗息皷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L059",
      "original_quote": "禁聲而敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L060",
      "original_quote": "大勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L061",
      "original_quote": "凡有謀為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L062",
      "original_quote": "事多破敗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L063",
      "original_quote": "有始無終",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L064",
      "original_quote": "惟求名顯達",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L065",
      "original_quote": "官事得失",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L066",
      "original_quote": "出行吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L067",
      "original_quote": "如天盤金加地盤土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L068",
      "original_quote": "乃主生客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L069",
      "original_quote": "宜耀武揚威",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L070",
      "original_quote": "徵兵奏凱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L071",
      "original_quote": "客兵大勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L072",
      "original_quote": "凡事謀為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L073",
      "original_quote": "始終皆耗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L074",
      "original_quote": "勞碌勞力",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZongFaQian_L075",
      "original_quote": "得援安妥",
      "tag": []
    }
  ],
