{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan20",
  "section": "安營",
  "entries": [
    {
      "line_id": "QMDJ_Juan20_AnYing_L000",
      "original_quote": "安營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L001",
      "original_quote": "六甲起青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L002",
      "original_quote": "大將居之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L003",
      "original_quote": "六乙為蓬星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L004",
      "original_quote": "旗鼓居之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L005",
      "original_quote": "六丙為明堂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L006",
      "original_quote": "次將居之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L007",
      "original_quote": "六丁為太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L008",
      "original_quote": "出入私路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L009",
      "original_quote": "探聽軍情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L010",
      "original_quote": "脫身隱匿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L011",
      "original_quote": "六戊為天門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L012",
      "original_quote": "又為軍門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L013",
      "original_quote": "吉事出入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L014",
      "original_quote": "六己為地戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L015",
      "original_quote": "伏兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L016",
      "original_quote": "凶事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L017",
      "original_quote": "出入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L018",
      "original_quote": "躲藏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L019",
      "original_quote": "六庚為天獄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L020",
      "original_quote": "宜積糧草",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L021",
      "original_quote": "六辛為天庭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L022",
      "original_quote": "判斷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L023",
      "original_quote": "斬決",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L024",
      "original_quote": "六壬為天牢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L025",
      "original_quote": "宜積蓄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L026",
      "original_quote": "六癸為華蓋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L027",
      "original_quote": "又為天藏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L028",
      "original_quote": "若欲脫難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L029",
      "original_quote": "入太陰出天藏而去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L030",
      "original_quote": "安營壘而有慶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L031",
      "original_quote": "攻擊敵以無乖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L032",
      "original_quote": "《三元經》曰：「夫將兵四出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L033",
      "original_quote": "統眾安營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L034",
      "original_quote": "必取其法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L035",
      "original_quote": "以六甲為首",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L036",
      "original_quote": "十時一易」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L037",
      "original_quote": "真卓曰：「以歲月旬而為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L038",
      "original_quote": "或依歲月",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L039",
      "original_quote": "或取六甲旬首而推排之」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L040",
      "original_quote": "大將居青龍甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L041",
      "original_quote": "旗鼓居蓬星乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L042",
      "original_quote": "士卒居明堂丙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L043",
      "original_quote": "伏兵居太陰丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L044",
      "original_quote": "軍門居天門戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L045",
      "original_quote": "小將居地戶己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L046",
      "original_quote": "斬伐居天獄庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L047",
      "original_quote": "判斷居天庭辛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L048",
      "original_quote": "囚擊糧儲居天牢壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_AnYing_L049",
      "original_quote": "天藏居華蓋癸",
      "tag": []
    }
  ],
