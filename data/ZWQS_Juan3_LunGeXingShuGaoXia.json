{
  "text": "紫微斗數全書",
  "juan": "卷三",
  "section": "論格星數高下",
  "entries": [
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L000",
      "original_quote": "論格星數高下",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L002",
      "original_quote": "紫府與數相合何如，紫微南北斗中天帝主，天府乃南斗主。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L003",
      "original_quote": "又看陰陽相半者，看陰陽不相半，又數不相生，為下格。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L004",
      "original_quote": "陰陽純駁為中格。又三方四正皆吉星為上格。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L005",
      "original_quote": "吉凶相半守照為中格。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L006",
      "original_quote": "凶星惡殺為下格凶徒論。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L007",
      "original_quote": "凡星得上格而數得上格為第一，位至極品之貴。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L008",
      "original_quote": "凡星得上格而數得中格為第二，位至三公。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L009",
      "original_quote": "星得上格而數得下格為第三，位至六卿。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L010",
      "original_quote": "皆為上格上壽之人。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L011",
      "original_quote": "星得中格而數得上格為第四，位至監司。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L012",
      "original_quote": "星中數中為第五，位至縣令。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L013",
      "original_quote": "星中敷下為第六，異路前程貴顯。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L014",
      "original_quote": "皆得中等享福主人也。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L015",
      "original_quote": "又星得下格而數得上格為第七，衣祿豐足，富比陶朱，子孫蕃盛，壽享遐齡，以星雖凶而命入格合局故也，再否虛名虛利。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L016",
      "original_quote": "星下數中為第八，衣食無虧。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L017",
      "original_quote": "星下數下為第九，辛苦奔波，貧窮夭折。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunGeXingShuGaoXia_L018",
      "original_quote": "上中下三等，依理而斷，則上可以知祖宗之源，而下可以知子孫之盛衰也。",
      "tag": []
    }
  ],
  "_extraction_status": "論格星數高下完成"
}