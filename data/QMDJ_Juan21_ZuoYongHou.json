  "entries": [
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L000",
      "original_quote": "作用妙法後篇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L001",
      "original_quote": "妙用之法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L002",
      "original_quote": "全在年月日時四天干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L003",
      "original_quote": "詳臨九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L004",
      "original_quote": "合為吉凶等格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L005",
      "original_quote": "則知聖君",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L006",
      "original_quote": "賢臣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L007",
      "original_quote": "孝子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L008",
      "original_quote": "慈孫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L009",
      "original_quote": "父母",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L010",
      "original_quote": "妻妾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L011",
      "original_quote": "奴婢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L012",
      "original_quote": "戚鄰諸事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L013",
      "original_quote": "成敗可推詳之矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L014",
      "original_quote": "年乾為君",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L015",
      "original_quote": "為父母",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L016",
      "original_quote": "月干為臣宰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L017",
      "original_quote": "為伯叔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L018",
      "original_quote": "日乾為兄弟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L019",
      "original_quote": "朋友",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L020",
      "original_quote": "時幹為妻妾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L021",
      "original_quote": "子女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L022",
      "original_quote": "士卒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L023",
      "original_quote": "奴婢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L024",
      "original_quote": "如天盤年乾合吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L025",
      "original_quote": "門生宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L026",
      "original_quote": "或上下相合者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L027",
      "original_quote": "主國泰民安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L028",
      "original_quote": "君臣父子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L029",
      "original_quote": "福壽康寧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L030",
      "original_quote": "若年乾合凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L031",
      "original_quote": "或被衝剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L032",
      "original_quote": "主四海兵戈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L033",
      "original_quote": "身心不寧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L034",
      "original_quote": "骨肉刑傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L035",
      "original_quote": "災厄憂驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L036",
      "original_quote": "若月乾得天盤相生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L037",
      "original_quote": "或合吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L038",
      "original_quote": "有忠臣烈士",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L039",
      "original_quote": "輔國安民",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L040",
      "original_quote": "加官封爵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L041",
      "original_quote": "萬事稱心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L042",
      "original_quote": "若合凶格又被剋制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L043",
      "original_quote": "有奸臣專權",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L044",
      "original_quote": "休官罷職",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L045",
      "original_quote": "六親參商",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L046",
      "original_quote": "貧苦奔波",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L047",
      "original_quote": "若日幹得天盤八門生合吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L048",
      "original_quote": "主兄弟和睦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L049",
      "original_quote": "貴喜臨門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L050",
      "original_quote": "身安友助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L051",
      "original_quote": "求謀遂心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L052",
      "original_quote": "若日乾貝剋合凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L053",
      "original_quote": "主兄弟刑傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L054",
      "original_quote": "六親不和",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L055",
      "original_quote": "身困招穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L056",
      "original_quote": "若時幹得天盤生合吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L057",
      "original_quote": "主妻子賢能",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L058",
      "original_quote": "士卒精強",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L059",
      "original_quote": "奴婢得力",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L060",
      "original_quote": "倘合凶格又被衝剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L061",
      "original_quote": "主子女刑傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L062",
      "original_quote": "父子不和",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L063",
      "original_quote": "兵卒自亂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L064",
      "original_quote": "奴婢欺主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L065",
      "original_quote": "凡六庚加於年",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L066",
      "original_quote": "月",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L067",
      "original_quote": "日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L068",
      "original_quote": "時幹上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L069",
      "original_quote": "或年",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L070",
      "original_quote": "月",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L071",
      "original_quote": "日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L072",
      "original_quote": "時干加臨六庚上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L073",
      "original_quote": "須看六庚加於何人干上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L074",
      "original_quote": "則知某人之吉凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L075",
      "original_quote": "吉格尤吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L076",
      "original_quote": "合凶格尤凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L077",
      "original_quote": "骨肉不和",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L078",
      "original_quote": "己身危困",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L079",
      "original_quote": "假如陽遁三局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L080",
      "original_quote": "甲己日起丁卯時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L081",
      "original_quote": "時幹在九宮離上開門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L082",
      "original_quote": "遁甲子戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L083",
      "original_quote": "天衝一同臨宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L084",
      "original_quote": "驚門與庚在坤二宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L085",
      "original_quote": "如己日為飛幹格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L086",
      "original_quote": "主兄弟不和",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L087",
      "original_quote": "朋友反目",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L088",
      "original_quote": "身招災困",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L089",
      "original_quote": "又如陽遁九局乙庚日起丙子時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L090",
      "original_quote": "得青龍返首吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L091",
      "original_quote": "主貴喜盈門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L092",
      "original_quote": "身安友助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L093",
      "original_quote": "求謀遂心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L094",
      "original_quote": "若看年乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L095",
      "original_quote": "月乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L096",
      "original_quote": "時幹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L097",
      "original_quote": "須另起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L098",
      "original_quote": "不可即以此為准",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ZuoYongHou_L099",
      "original_quote": "恐吉凶不驗也",
      "tag": []
    }
  ],
