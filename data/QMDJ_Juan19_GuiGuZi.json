  "entries": [
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L000",
      "original_quote": "鬼谷子九仙數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L001",
      "original_quote": "河圖甲己子午九",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L002",
      "original_quote": "乙庚丑未八當頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L003",
      "original_quote": "丙辛寅申七數真",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L004",
      "original_quote": "丁壬卯酉六相親",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L005",
      "original_quote": "戊癸辰戌五為坎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L006",
      "original_quote": "巳亥原來數當四",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L007",
      "original_quote": "其法日則干支並用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L008",
      "original_quote": "時則止用支不用干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L009",
      "original_quote": "如甲子日未時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L010",
      "original_quote": "干支相配合得二十六數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L011",
      "original_quote": "乃是大吉仙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L012",
      "original_quote": "餘仿此數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L013",
      "original_quote": "甲九數子亦九數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_GuiGuZi_L014",
      "original_quote": "未得八數",
      "tag": []
    }
  ],
