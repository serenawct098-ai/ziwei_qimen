  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L000",
      "original_quote": "占打抽豐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L001",
      "original_quote": "以日幹落宮為打抽豐之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L002",
      "original_quote": "所往之方為抽豐之處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L003",
      "original_quote": "得奇門吉格來生日乾者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L004",
      "original_quote": "所往必利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L005",
      "original_quote": "即不得奇門吉格而來生者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L006",
      "original_quote": "亦利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L007",
      "original_quote": "比和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L008",
      "original_quote": "平平",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L009",
      "original_quote": "剋制日乾之宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L010",
      "original_quote": "去必有損",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L011",
      "original_quote": "臨空亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L012",
      "original_quote": "墓絕之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L013",
      "original_quote": "主不見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L014",
      "original_quote": "徒勞無益",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanChouFeng_L015",
      "original_quote": "不必去",
      "tag": []
    }
