      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L001",
      "original_quote": "丁巳神君號曰「陳將軍」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L002",
      "original_quote": "蛇首人身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L003",
      "original_quote": "性最毒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L004",
      "original_quote": "不可輕用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L005",
      "original_quote": "喜食六畜之物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L006",
      "original_quote": "不忌水陸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L007",
      "original_quote": "高一丈四尺九寸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L008",
      "original_quote": "鎮守天屏之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L009",
      "original_quote": "統領神兵四萬四千四百四十數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L010",
      "original_quote": "複城陷陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L011",
      "original_quote": "變化無窮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L012",
      "original_quote": "鈴赤赤下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L013",
      "original_quote": "符式長一尺四寸九分",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L014",
      "original_quote": "濶二寸九分",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L015",
      "original_quote": "用紅紙圬研黑丹為上吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L016",
      "original_quote": "右畫六丁符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L017",
      "original_quote": "用鬥訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L018",
      "original_quote": "以左手大指",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L019",
      "original_quote": "杜天地步鬥而坐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L020",
      "original_quote": "默念六丁神咒七遍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L021",
      "original_quote": "吸南方一口吹入神筆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L022",
      "original_quote": "一氣呵成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L023",
      "original_quote": "作法如前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L024",
      "original_quote": "咒曰：「六丁神兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L025",
      "original_quote": "八卦之精",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L026",
      "original_quote": "推例神將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L027",
      "original_quote": "安在吾身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L028",
      "original_quote": "聞咒速至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L029",
      "original_quote": "百事通靈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L030",
      "original_quote": "無事不報",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L031",
      "original_quote": "不得動令",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_DingSiFu_L032",
      "original_quote": "吾奉九天玄女急急如律令」",
      "tag": []
    }
  ],
