      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L131",
      "original_quote": "畏剋制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L132",
      "original_quote": "忌入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L133",
      "original_quote": "春夏則生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L134",
      "original_quote": "秋冬則殺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L135",
      "original_quote": "司君後之柄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L136",
      "original_quote": "坤納乙癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L137",
      "original_quote": "自乙至癸其數九",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L138",
      "original_quote": "故名之曰「九地」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L139",
      "original_quote": "舉乙醜而六乙在其中矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L140",
      "original_quote": "九天者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L141",
      "original_quote": "乾金也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L142",
      "original_quote": "其體屬金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L143",
      "original_quote": "乾納甲壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L144",
      "original_quote": "性剛而好動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L145",
      "original_quote": "所主者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L146",
      "original_quote": "名正言順之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L147",
      "original_quote": "值其令而無阻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L148",
      "original_quote": "至吉之神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L149",
      "original_quote": "若得門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L150",
      "original_quote": "得奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L151",
      "original_quote": "萬福咸集",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L152",
      "original_quote": "即不得奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L153",
      "original_quote": "亦不為凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L154",
      "original_quote": "畏入墓而力屈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L155",
      "original_quote": "天始於甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L156",
      "original_quote": "自甲至壬其數九",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L157",
      "original_quote": "故名之曰「九天」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L158",
      "original_quote": "太常者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L159",
      "original_quote": "五行之化氣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L160",
      "original_quote": "其神好歌飲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L161",
      "original_quote": "專司宴享",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L162",
      "original_quote": "祭祀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L163",
      "original_quote": "衣帛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L164",
      "original_quote": "羔雁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L165",
      "original_quote": "酒食之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L166",
      "original_quote": "此神隨天禽遍游諸方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L167",
      "original_quote": "遇火則從火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L168",
      "original_quote": "遇金則從金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L169",
      "original_quote": "遇水則從水",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L170",
      "original_quote": "遇木則從木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L171",
      "original_quote": "遇土則從土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L172",
      "original_quote": "與五體相合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L173",
      "original_quote": "其性不常",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L174",
      "original_quote": "故名之曰「太常」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L175",
      "original_quote": "與吉門並則吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L176",
      "original_quote": "與凶門並則凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L177",
      "original_quote": "主衣服",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L178",
      "original_quote": "彩衣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L179",
      "original_quote": "孝服之變更也",
      "tag": []
    }
  ],
