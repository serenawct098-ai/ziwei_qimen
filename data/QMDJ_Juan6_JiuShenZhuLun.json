      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L036",
      "original_quote": "其神好陰匿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L037",
      "original_quote": "暗昧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L038",
      "original_quote": "欺蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L039",
