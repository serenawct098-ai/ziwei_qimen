      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L042",
      "original_quote": "位鎮兌宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L043",
      "original_quote": "兌為少女",
      "tag": []
    },
