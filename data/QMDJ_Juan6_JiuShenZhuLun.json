      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L020",
      "original_quote": "螣蛇者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L021",
      "original_quote": "丁火之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L022",
      "original_quote": "其實屬陰土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L023",
      "original_quote": "兌納丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L024",
      "original_quote": "其神性柔而口毒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L025",
      "original_quote": "專司驚恐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L026",
      "original_quote": "怪異",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L027",
      "original_quote": "火妖蠱之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L028",
      "original_quote": "位鎮巽方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L029",
      "original_quote": "又名「玉女」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L030",
      "original_quote": "遁為六丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L031",
      "original_quote": "六甲之神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L032",
      "original_quote": "乃陰神之最靈者",
      "tag": []
    },
