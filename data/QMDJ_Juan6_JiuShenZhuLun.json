    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L001",
      "original_quote": "值符者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L002",
      "original_quote": "諸神之元首",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L003",
      "original_quote": "九星之領袖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L004",
      "original_quote": "因名值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L005",
      "original_quote": "其體屬火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L006",
      "original_quote": "其神所到之處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L007",
      "original_quote": "百惡消散",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L008",
      "original_quote": "諸凶寂滅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L009",
      "original_quote": "至吉之神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L010",
      "original_quote": "所畏者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L011",
      "original_quote": "太白金星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L012",
      "original_quote": "忌入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L013",
      "original_quote": "吉處不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L014",
      "original_quote": "凶處更凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L015",
      "original_quote": "天始於甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L016",
      "original_quote": "地始於子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuShenZhuLun_L017",
      "original_quote": "固謂萬匯之尊者",
      "tag": []
    },
