{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan26",
  "section": "主客法",
  "entries": [
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L000",
      "original_quote": "主客法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L001",
      "original_quote": "凡日辰納音為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L002",
      "original_quote": "風所來之處為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L003",
      "original_quote": "如甲子商為君",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L004",
      "original_quote": "風從未申丑寅上來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L005",
      "original_quote": "為商動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L006",
      "original_quote": "徵火剋金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L007",
      "original_quote": "主人勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L008",
      "original_quote": "若從巳上來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L009",
      "original_quote": "受制於金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L010",
      "original_quote": "客勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L011",
      "original_quote": "又日納音為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L012",
      "original_quote": "加時為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L013",
      "original_quote": "如丙寅日火音",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L014",
      "original_quote": "時加卯酉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L015",
      "original_quote": "為徵動羽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L016",
      "original_quote": "羽水剋徵火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L017",
      "original_quote": "主人勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L018",
      "original_quote": "若加辰戌為徵動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L019",
      "original_quote": "商火剋金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L020",
      "original_quote": "客勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L021",
      "original_quote": "又甲子金日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L022",
      "original_quote": "時加丑寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L023",
      "original_quote": "為徵動商",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L024",
      "original_quote": "火剋金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L025",
      "original_quote": "主勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L026",
      "original_quote": "風又從醜未上來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L027",
      "original_quote": "是二火一金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L028",
      "original_quote": "主大勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L029",
      "original_quote": "又風從巳刑上來客勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L030",
      "original_quote": "從時刑上來主勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L031",
      "original_quote": "凡遠者為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L032",
      "original_quote": "近者為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L033",
      "original_quote": "行者客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L034",
      "original_quote": "居者主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L035",
      "original_quote": "起者客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L036",
      "original_quote": "應者主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L037",
      "original_quote": "動者客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L038",
      "original_quote": "靜者主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L039",
      "original_quote": "如兩人相擊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L040",
      "original_quote": "先舉者客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L041",
      "original_quote": "後舉者主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L042",
      "original_quote": "有氣勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhuKeFa_L043",
      "original_quote": "無氣敗也",
      "tag": []
    }
  ],
