  "entries": [
    {
      "line_id": "QMDJ_Juan21_RenDun_L000",
      "original_quote": "人遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L001",
      "original_quote": "凡丁奇與休門合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L002",
      "original_quote": "下臨太陰之位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L003",
      "original_quote": "得星精所蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L004",
      "original_quote": "其氣青黑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L005",
      "original_quote": "內應於腎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L006",
      "original_quote": "外主耳目",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L007",
      "original_quote": "名曰「還陽丹」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L008",
      "original_quote": "修之者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L009",
      "original_quote": "駐世長年",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L010",
      "original_quote": "有事出門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L011",
      "original_quote": "呼本旬玉女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L012",
      "original_quote": "如前法咒之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L013",
      "original_quote": "其方可以擇賢人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L014",
      "original_quote": "求猛將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L015",
      "original_quote": "說敵和仇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L016",
      "original_quote": "三年竝吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L017",
      "original_quote": "又宜獻策謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L018",
      "original_quote": "結婚姻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L019",
      "original_quote": "添進人口",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L020",
      "original_quote": "和合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L021",
      "original_quote": "交易利市十倍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L022",
      "original_quote": "若藏伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L023",
      "original_quote": "獻策",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_RenDun_L024",
      "original_quote": "上書俱吉",
      "tag": []
    }
