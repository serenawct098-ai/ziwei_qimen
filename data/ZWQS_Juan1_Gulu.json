{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "重補斗數彀率",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_Gulu_L001",
      "original_quote": "諸星吉多逢凶也吉，諸星惡多逢吉也凶。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L002",
      "original_quote": "星更纏度，數分定局。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L003",
      "original_quote": "重在看星得垣受制，方可論人禍福窮通。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L004",
      "original_quote": "大概以身命為禍福之柄，以根源為窮通之機。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L005",
      "original_quote": "紫微在命輔弼同垣，其貴必矣，財印夾命日月夾財，其富何疑。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L006",
      "original_quote": "蔭福臨不怕凶沖，日月會不如合照。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L007",
      "original_quote": "貪狼居子乃為泛水桃花，天刑遭貪必主風流刑杖。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L008",
      "original_quote": "紫微坐命庫則日金轝捧櫛輦，臨官安文曜號為衣錦惹天香。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L009",
      "original_quote": "太陰合文曲於妻宮翰林清異，太陽會文昌於官祿金殿傳臚。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L010",
      "original_quote": "祿合守田財為爛穀堆金，財蔭居遷移為高商豪客。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L011",
      "original_quote": "耗居敗地沿途丐求，貪會旺宮終身鼠竊。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L012",
      "original_quote": "殺居絕地生成三十二之顏回，日在旺宮可學八百年之彭祖。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L012",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L013",
      "original_quote": "巨暗同垣於身命疾厄贏瘦其軀，凶星交會於相貌遷移傷刑其面。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L013",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L014",
      "original_quote": "大耗會廉貞於官祿枷杻囚徒，官符會刑殺於遷移離鄉遠配。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L014",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L015",
      "original_quote": "七殺臨於陷地流年必見死亡，耗殺忌逢破軍火鈴嫌逢太歲。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L015",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L016",
      "original_quote": "奏書博士並流祿以盡乎吉祥，力士將軍與青龍以顯其威福。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L016",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L017",
      "original_quote": "童子限弱水上浮泡，老人限衰風中燃燭。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L017",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L018",
      "original_quote": "遇殺必驚，流年最緊。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L018",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L019",
      "original_quote": "人生發達限元最怕浮沉，一世迍邅命限逢乎駁雜。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L019",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Gulu_L020",
      "original_quote": "論而至此允矣玄微。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "重補斗數彀率",
        "line_id": "ZWQS_Juan1_Gulu_L020",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "重補斗數彀率全文完成，已根據語義斷句"
}