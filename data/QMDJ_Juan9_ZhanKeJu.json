  "section": "占科舉",
  "entries": [
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L000",
      "original_quote": "占科舉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L001",
      "original_quote": "以值符為正主考",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L002",
      "original_quote": "月乾為副主考",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L003",
      "original_quote": "天乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L004",
      "original_quote": "朱雀為文章",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L005",
      "original_quote": "為廉官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L006",
      "original_quote": "景門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L007",
      "original_quote": "丁奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L008",
      "original_quote": "日乾為士子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L009",
      "original_quote": "以值符落宮生日幹落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L010",
      "original_quote": "景門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L011",
      "original_quote": "丁奇落宮再合吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L012",
      "original_quote": "必高中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L013",
      "original_quote": "月乾來生亦然",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L014",
      "original_quote": "朱雀來生景門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L015",
      "original_quote": "丁奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L016",
      "original_quote": "主廉官力薦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L017",
      "original_quote": "不生不薦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L018",
      "original_quote": "丁奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L019",
      "original_quote": "景門落宮剋值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L020",
      "original_quote": "月乾之宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L021",
      "original_quote": "文卷雖佳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L022",
      "original_quote": "主考不喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L023",
      "original_quote": "剋朱雀之落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L024",
      "original_quote": "不薦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L025",
      "original_quote": "乘凶格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L026",
      "original_quote": "文章差池",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L027",
      "original_quote": "空亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L028",
      "original_quote": "入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L029",
      "original_quote": "必犯格式",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L030",
      "original_quote": "乘元武必錯訛字跡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L031",
      "original_quote": "不中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L032",
      "original_quote": "日幹落空亡之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L033",
      "original_quote": "得值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L034",
      "original_quote": "月乾來生者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L035",
      "original_quote": "文章雖佳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L036",
      "original_quote": "榜上無名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L037",
      "original_quote": "值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L038",
      "original_quote": "日乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L039",
      "original_quote": "朱雀空亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L040",
      "original_quote": "文卷不入主考之目",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L041",
      "original_quote": "入墓者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L042",
      "original_quote": "亦不中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L043",
      "original_quote": "場後見天驛二馬及太衝者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L044",
      "original_quote": "不中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanKeJu_L045",
      "original_quote": "更不必候榜",
      "tag": []
    }
