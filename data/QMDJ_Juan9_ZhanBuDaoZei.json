  "entries": [
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L000",
      "original_quote": "占捕盜賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L001",
      "original_quote": "劫人財物者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L002",
      "original_quote": "謂之盜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L003",
      "original_quote": "殺人取財者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L004",
      "original_quote": "謂之賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L005",
      "original_quote": "以天蓬為大賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L006",
      "original_quote": "元武為小賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L007",
      "original_quote": "勾陳為捕盜之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L008",
      "original_quote": "杜門為捕獲之方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L009",
      "original_quote": "皆以天盤主之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L010",
      "original_quote": "勾陳落宮剋蓬元之落宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L011",
      "original_quote": "捕之必獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L012",
      "original_quote": "若蓬元剋勾陳之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L013",
      "original_quote": "主賊旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L014",
      "original_quote": "捕人不敢獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L015",
      "original_quote": "蓬元與勾陳宮比和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L016",
      "original_quote": "必捕人通同為盜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L017",
      "original_quote": "勾陳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L018",
      "original_quote": "蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L019",
      "original_quote": "元同宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L020",
      "original_quote": "必捕人為盜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L021",
      "original_quote": "蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L022",
      "original_quote": "元宮生勾陳宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L023",
      "original_quote": "捕人受賄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L024",
      "original_quote": "縱之不捕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L025",
      "original_quote": "總以庚格主之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L026",
      "original_quote": "年格年獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L027",
      "original_quote": "月格月獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L028",
      "original_quote": "日格日獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L029",
      "original_quote": "時格時獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L030",
      "original_quote": "不格不獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L031",
      "original_quote": "杜門有格必獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanBuDaoZei_L032",
      "original_quote": "否亦不獲",
      "tag": []
    }
