{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan5",
  "section": "驚門剋應",
  "entries": [
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L000",
      "original_quote": "驚門剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L001",
      "original_quote": "驚門主爭訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L002",
      "original_quote": "瘟疫死人丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L003",
      "original_quote": "辰年並花月",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L004",
      "original_quote": "非禍進門庭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L005",
      "original_quote": "惟宜詞訟事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L006",
      "original_quote": "捕捉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L007",
      "original_quote": "博戲吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L008",
      "original_quote": "餘皆凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L009",
      "original_quote": "問曰：驚門屬金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L010",
      "original_quote": "值八月秋令",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L011",
      "original_quote": "萬物俱老",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L012",
      "original_quote": "天地大示肅殺之威",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L013",
      "original_quote": "亦可棄乎?",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L014",
      "original_quote": "衢仙答曰：驚門氣肅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L015",
      "original_quote": "物數蒼老",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L016",
      "original_quote": "本無生氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L017",
      "original_quote": "固凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L018",
      "original_quote": "但天地存好生之心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L019",
      "original_quote": "不欲殺盡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L020",
      "original_quote": "而生蒜麥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L021",
      "original_quote": "亦不得已而殺也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L022",
      "original_quote": "此門雖凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L023",
      "original_quote": "若諛詞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L024",
      "original_quote": "獻詐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L025",
      "original_quote": "捕捉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L026",
      "original_quote": "設疑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L027",
      "original_quote": "伏兵皆吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L028",
      "original_quote": "亦不可棄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L029",
      "original_quote": "靜應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L030",
      "original_quote": "驚門加驚：主疾病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L031",
      "original_quote": "憂慮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L032",
      "original_quote": "驚疑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L033",
      "original_quote": "加開：主憂疑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L034",
      "original_quote": "官司",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L035",
      "original_quote": "驚恐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L036",
      "original_quote": "又主上見喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L037",
      "original_quote": "不凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L038",
      "original_quote": "加休：主求財事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L039",
      "original_quote": "或因口舌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L040",
      "original_quote": "求財事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L041",
      "original_quote": "遲吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L042",
      "original_quote": "加生：主因婦人生憂驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L043",
      "original_quote": "或因求財生憂驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L044",
      "original_quote": "皆吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L045",
      "original_quote": "加傷：主因商議同謀害人事洩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L046",
      "original_quote": "惹訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L047",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L048",
      "original_quote": "加杜：主因失脫破財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L049",
      "original_quote": "驚恐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L050",
      "original_quote": "不凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L051",
      "original_quote": "加景：主詞訟不息及小口疾病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L052",
      "original_quote": "加死：主因宅中怪異而生是非",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L053",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L054",
      "original_quote": "加甲戊：主損財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L055",
      "original_quote": "信阻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L056",
      "original_quote": "加乙：主謀財不得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L057",
      "original_quote": "加丙：主文書印信驚恐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L058",
      "original_quote": "加丁：主詞訟牽連",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L059",
      "original_quote": "加戊：主因田宅致訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L060",
      "original_quote": "加己：主惡犬傷人成訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L061",
      "original_quote": "加庚：主道路損折",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L062",
      "original_quote": "賊盜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L063",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L064",
      "original_quote": "加辛：主女人成訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L065",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L066",
      "original_quote": "加壬：主官司囚禁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L067",
      "original_quote": "病者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L068",
      "original_quote": "大凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L069",
      "original_quote": "加癸：主被盜賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L070",
      "original_quote": "失物不獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L071",
      "original_quote": "動應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L072",
      "original_quote": "驚門出者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L073",
      "original_quote": "三十里逢群鳥雀噪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L074",
      "original_quote": "六畜相鬪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L075",
      "original_quote": "四十里見人爭打則吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L076",
      "original_quote": "若無",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L077",
      "original_quote": "七十里必有折損之凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L078",
      "original_quote": "不可前往",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L079",
      "original_quote": "驚門加驚：七里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L080",
      "original_quote": "十七里逢二女吵鬧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L081",
      "original_quote": "旁人說打官司",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L082",
      "original_quote": "加開：六里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L083",
      "original_quote": "十六里逢官吏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L084",
      "original_quote": "役人爭訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L085",
      "original_quote": "加休：一里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L086",
      "original_quote": "十一里逢青衣婦人說官司",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L087",
      "original_quote": "加生：八里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L088",
      "original_quote": "十八里逢女人引童子趕牛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L089",
      "original_quote": "小兒拿吃物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L090",
      "original_quote": "加傷：三里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L091",
      "original_quote": "十三里逢男女吵鬧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L092",
      "original_quote": "打孩子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L093",
      "original_quote": "宜退回",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L094",
      "original_quote": "若強行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L095",
      "original_quote": "主車折馬死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L096",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L097",
      "original_quote": "加杜：四里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L098",
      "original_quote": "十四里逢僧道同行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L099",
      "original_quote": "或男女相商",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L100",
      "original_quote": "加景：九里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L101",
      "original_quote": "十九里逢色衣婦人說官司",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L102",
      "original_quote": "加死：二里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L103",
      "original_quote": "十二里逢女人哭泣及喪亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L104",
      "original_quote": "占身命：主詞訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L105",
      "original_quote": "官災",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L106",
      "original_quote": "口舌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L107",
      "original_quote": "血光之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L108",
      "original_quote": "若值丙丁巳午年月日時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L109",
      "original_quote": "占者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L110",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L111",
      "original_quote": "甲乙寅卯年月日時占者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_JingMenKeYing_L112",
      "original_quote": "亦不利",
      "tag": []
    }
  ],
