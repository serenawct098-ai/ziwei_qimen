{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan16",
  "section": "地四戶",
  "entries": [
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L000",
      "original_quote": "地四戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L001",
      "original_quote": "歌云：「用時支上加月建",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L002",
      "original_quote": "建除滿平一順流",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L003",
      "original_quote": "定執破危相接去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L004",
      "original_quote": "成收開閉掌中周",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L005",
      "original_quote": "除定危開為四戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L006",
      "original_quote": "此方有難來逃避」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L007",
      "original_quote": "以月建加用時順數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L008",
      "original_quote": "如寅月寅時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L009",
      "original_quote": "於寅上起建",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L010",
      "original_quote": "卯為除",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L011",
      "original_quote": "午為定",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L012",
      "original_quote": "酉為危",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L013",
      "original_quote": "子為開",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L014",
      "original_quote": "三奇臨之大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L015",
      "original_quote": "若得三吉門更佳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L016",
      "original_quote": "餘仿此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L017",
      "original_quote": "如九月戌建用巳時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L018",
      "original_quote": "則以戌加巳上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L019",
      "original_quote": "建在巳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L020",
      "original_quote": "除在午",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L021",
      "original_quote": "午為地戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L022",
      "original_quote": "滿在未",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L023",
      "original_quote": "平在申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L024",
      "original_quote": "定在酉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L025",
      "original_quote": "酉為地戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L026",
      "original_quote": "執在戌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L027",
      "original_quote": "破在亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L028",
      "original_quote": "危在子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L029",
      "original_quote": "子為地戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L030",
      "original_quote": "成在丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L031",
      "original_quote": "收在寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L032",
      "original_quote": "開在卯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L033",
      "original_quote": "卯為地戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L034",
      "original_quote": "閉在辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L035",
      "original_quote": "子午卯酉四宮為地四戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiHu_L036",
      "original_quote": "俱吉",
      "tag": []
    }
  ],
