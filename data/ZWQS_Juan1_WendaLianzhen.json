{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "星垣問答論_Lianzhen",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaLianzhen_L001",
      "original_quote": "問廉貞所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLianzhen_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLianzhen_L002",
      "original_quote": "答曰：廉貞屬火，北斗第五星也。在斗司品秩，在數司權令。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLianzhen_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLianzhen_L003",
      "original_quote": "不臨廟旺，更犯官符，故曰化囚為殺。觸之不可解其禍，逢之不可測其祥。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLianzhen_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLianzhen_L004",
      "original_quote": "主人心狠性狂，不習禮義。逢帝座執威權，遇祿存主富貴，遇文昌好禮樂，遇殺曜顯武職，在官祿有威權，在身命為次桃花。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLianzhen_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLianzhen_L005",
      "original_quote": "若居旺宮，則賭博迷花而致訟。限逢巨門於陷地，則是非起於官司。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLianzhen_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLianzhen_L006",
      "original_quote": "逢財星耗合祖業必破，遇刑忌則膿血不免。遇白虎則刑杖難逃，遇武曲於受制之鄉，恐木壓蛇傷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLianzhen_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLianzhen_L007",
      "original_quote": "同火曜於陷空之地，主投河自縊。破軍與日月以濟行，目疾而不免。限逢至此，災不可攘。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLianzhen_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLianzhen_L008",
      "original_quote": "只宜官祿身命之位，遇吉福映，逢凶則不慈。若在他宮，禍福宜詳。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLianzhen_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLianzhen_L009",
      "original_quote": "歌曰",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLianzhen_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaLianzhen_L010",
      "original_quote": "廉貪巳亥宮，遇吉福盈豐，應過三旬後，須防不善終。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaLianzhen_L010",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "星垣問答論-Lianzhen星部分完成"
}