      "line_id": "QMDJ_Juan25_LeiGong_L000",
      "original_quote": "雷公",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L001",
      "original_quote": "雷公者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L002",
      "original_quote": "六庚耳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L003",
      "original_quote": "庚為天刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L004",
      "original_quote": "又為百神所聚之方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L005",
      "original_quote": "故宜避之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L006",
      "original_quote": "不敢犯也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L007",
      "original_quote": "攝殺六律曰：「雷公將軍在午游庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L008",
      "original_quote": "領十二日將友",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L009",
      "original_quote": "風伯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L010",
      "original_quote": "雨師其所游之處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L011",
      "original_quote": "郡居響應而到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L012",
      "original_quote": "若出軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L013",
      "original_quote": "布陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L014",
      "original_quote": "安營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L015",
      "original_quote": "則雷公之所處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L016",
      "original_quote": "慎不可犯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L017",
      "original_quote": "犯之主敗軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L018",
      "original_quote": "殺將也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L019",
      "original_quote": "甲子旬六庚在午",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L020",
      "original_quote": "甲戌旬六庚在辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L021",
      "original_quote": "甲申旬六庚在寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L022",
      "original_quote": "甲午旬在子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L023",
      "original_quote": "甲辰旬在戌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_LeiGong_L024",
      "original_quote": "甲寅旬在申」",
      "tag": []
    }
