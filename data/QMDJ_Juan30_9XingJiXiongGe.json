  "section": "九星吉凶歌",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L000",
      "original_quote": "九星吉凶歌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L001",
      "original_quote": "一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L002",
      "original_quote": "太乙水神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L003",
      "original_quote": "逢著皂衣人求謁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L004",
      "original_quote": "訪謁婚姻皆大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L005",
      "original_quote": "門中見太乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L006",
      "original_quote": "星曜號貪狼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L007",
      "original_quote": "博奕錢財眾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L008",
      "original_quote": "婚姻大吉昌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L009",
      "original_quote": "出門無阻滯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L010",
      "original_quote": "參謁見賢良",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L011",
      "original_quote": "二",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L012",
      "original_quote": "攝提土神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L013",
      "original_quote": "遇死門大凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L014",
      "original_quote": "逢老婦悲啼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L015",
      "original_quote": "再逢牛犁耕田",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L016",
      "original_quote": "不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L017",
      "original_quote": "遠行遭羈絆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L018",
      "original_quote": "耕地損牛犁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L019",
      "original_quote": "相生又問可",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L020",
      "original_quote": "相剋見災危",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L021",
      "original_quote": "死門並相見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L022",
      "original_quote": "老婦哭悲啼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L023",
      "original_quote": "求財並嫁娶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L024",
      "original_quote": "萬事不相宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L025",
      "original_quote": "主隱匿藏道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L026",
      "original_quote": "言動則傷身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L027",
      "original_quote": "三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L028",
      "original_quote": "軒轅木神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L029",
      "original_quote": "路遇宜見於十五里外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L030",
      "original_quote": "出入遇軒轅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L031",
      "original_quote": "作事必牽纏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L032",
      "original_quote": "相生災侵慢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L033",
      "original_quote": "相剋必憂煎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L034",
      "original_quote": "遠行逢迍遰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L035",
      "original_quote": "博奕定輸錢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L036",
      "original_quote": "九天玄女法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L037",
      "original_quote": "句句不虛傳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L038",
      "original_quote": "四",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L039",
      "original_quote": "招搖木神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L040",
      "original_quote": "逢二親人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L041",
      "original_quote": "又見婦人口舌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L042",
      "original_quote": "怪夢驚恐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L043",
      "original_quote": "鄰家釜鳴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L044",
      "original_quote": "屋響不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L045",
      "original_quote": "招搖號木星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L046",
      "original_quote": "當門百事成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L047",
      "original_quote": "相剋行人阻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L048",
      "original_quote": "陰人口舌迎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L049",
      "original_quote": "怪夢多驚恐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L050",
      "original_quote": "屋響釜自鳴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L051",
      "original_quote": "陰陽消息用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L052",
      "original_quote": "作事不容情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L053",
      "original_quote": "五",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L054",
      "original_quote": "天符土神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L055",
      "original_quote": "五鬼是天符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L056",
      "original_quote": "當門陰女謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L057",
      "original_quote": "相剋無好事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L058",
      "original_quote": "言客在程遲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L059",
      "original_quote": "走失難得見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L060",
      "original_quote": "吊客惹成孤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L061",
      "original_quote": "此星當門值",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L062",
      "original_quote": "切忌有災途",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L063",
      "original_quote": "交戰出兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L064",
      "original_quote": "迎鋒出陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L065",
      "original_quote": "軍糧則利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L066",
      "original_quote": "六",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L067",
      "original_quote": "青龍金神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L068",
      "original_quote": "路逢醫人或是酒仙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L069",
      "original_quote": "今博奕於道中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L070",
      "original_quote": "門內見青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L071",
      "original_quote": "求財喜重重",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L072",
      "original_quote": "每逢茶酒食",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L073",
      "original_quote": "博奕定見贏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L074",
      "original_quote": "相生錢財旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L075",
      "original_quote": "休言剋破刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L076",
      "original_quote": "接貴安營寨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L077",
      "original_quote": "萬事喜和同",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L078",
      "original_quote": "七",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L079",
      "original_quote": "咸池金神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L080",
      "original_quote": "不可行軍破敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L081",
      "original_quote": "五將號咸池",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L082",
      "original_quote": "當門事不宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L083",
      "original_quote": "相生皆無破",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L084",
      "original_quote": "相剋有災危",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L085",
      "original_quote": "博奕相輸脫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L086",
      "original_quote": "求財空手歸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L087",
      "original_quote": "神仙真妙訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L088",
      "original_quote": "愚人要與知",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L089",
      "original_quote": "軍事虛驚退",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L090",
      "original_quote": "反複逆風吹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L091",
      "original_quote": "八",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L092",
      "original_quote": "太陰土神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L093",
      "original_quote": "行六七里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L094",
      "original_quote": "見有小兒牽羊至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L095",
      "original_quote": "求財成就吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L096",
      "original_quote": "當門見太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L097",
      "original_quote": "百禍不能侵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L098",
      "original_quote": "方行六七里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L099",
      "original_quote": "知交有覓尋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L100",
      "original_quote": "妙法牢收取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L101",
      "original_quote": "回軍引馬前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L102",
      "original_quote": "有伏兵截路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L103",
      "original_quote": "慎不可輕行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L104",
      "original_quote": "九",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L105",
      "original_quote": "天乙火神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L106",
      "original_quote": "行三十里見一婦人著五六色",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L107",
      "original_quote": "遇抱小兒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L108",
      "original_quote": "百事吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L109",
      "original_quote": "門迎天乙星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L110",
      "original_quote": "相生百事成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L111",
      "original_quote": "動用皆和順",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L112",
      "original_quote": "茶酒自相迎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L113",
      "original_quote": "求婚行嫁娶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L114",
      "original_quote": "相會天自成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L115",
      "original_quote": "出軍交兵陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingJiXiongGe_L116",
      "original_quote": "一見定勝贏",
      "tag": []
    }
