  "section": "論大小限星辰過十二宮遇十二支所忌訣",
  "entries": [
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L000",
      "original_quote": "論大小限星辰過十二宮遇十二支所忌訣",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第105行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L001",
      "original_quote": "人生子命忌寅申",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第106行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L002",
      "original_quote": "假如子年生人切忌寅申歲限，災晦至重，及忌子午歲限相沖。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第106行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L003",
      "original_quote": "丑午生人丑午瞋",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第107行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L004",
      "original_quote": "假如丑年生人忌午丑歲限，午生人亦忌丑午歲限，及忌七殺星，災晦極重。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第107行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L005",
      "original_quote": "寅卯之人防巳亥",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第108行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L006",
      "original_quote": "假如寅卯人忌巳亥歲限，及忌卯酉寅申相沖。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第108行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L007",
      "original_quote": "龍蛇切忌本身臨",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第109行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L008",
      "original_quote": "假如巳生人忌逢巳年及忌行到巳限、辰生人忌行辰年又忌行到辰限為天羅，又忌行到戌為地網，限遇此災晦疾厄之險，官非破財憂制連連矣。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第109行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L009",
      "original_quote": "申人鈴火災殃重",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第110行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L010",
      "original_quote": "假如申生人忌逢火鈴二星，必主災晦至重，及忌寅年沖。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第110行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L011",
      "original_quote": "未遇豬雞墓患殷",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第111行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L012",
      "original_quote": "假如未生人忌逢酉戌歲限，又忌見擎羊在四墓宮。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第111行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L013",
      "original_quote": "戌亥羊陀須避忌",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第112行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L014",
      "original_quote": "假如戌亥生人忌遇羊陀災重，戌生人又行到戍宮歲限為地網，又忌行到辰宮歲限為天羅，謂之辰戌相沖不美。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第112行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L015",
      "original_quote": "酉人陀刃亦非親",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第113行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L016",
      "original_quote": "假如酉生人亦忌羊陀歲限及忌行卯宮限，及卯年歲君相沖。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第113行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunDaXiaoXianJiJue_L017",
      "original_quote": "豬犬生人莫遇蛇，辰戍切忌到網羅，預先整頓衣冠木，未免生人唱挽歌。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論大小限星辰過十二宮遇十二支所忌訣",
        "line_ref": "第115行"
      }
    }
  ],
  "_extraction_status": "論大小限星辰過十二宮遇十二支所忌訣完成"
}