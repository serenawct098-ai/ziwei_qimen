      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L043",
      "original_quote": "橫發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L044",
      "original_quote": "丙奇到乾有披衣人至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L045",
      "original_quote": "或鳥鵲成隊飛來為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L046",
      "original_quote": "後月內進寡婦財產",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L047",
      "original_quote": "文契",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L048",
      "original_quote": "若聞南方有生產者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L049",
      "original_quote": "發旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L050",
      "original_quote": "到坎有瞽目人至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L051",
