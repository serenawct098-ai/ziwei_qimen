      "original_quote": "後六十日內進商音人財產",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L004",
      "original_quote": "大發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L005",
      "original_quote": "到坎有人著皂衣至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L006",
      "original_quote": "或有鼓聲為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L007",
      "original_quote": "後七日得財",
      "tag": []
    },
