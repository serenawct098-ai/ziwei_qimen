      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L011",
      "original_quote": "後一年內進人口",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L012",
      "original_quote": "若有人送家禽來者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L013",
      "original_quote": "大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L014",
      "original_quote": "到震有有漁獵人至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L015",
      "original_quote": "並小兒二人同來為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L016",
      "original_quote": "後七日內進財寶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L017",
      "original_quote": "若聞有東方產亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L018",
      "original_quote": "大發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L019",
      "original_quote": "到巽有白衣人騎馬過",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L020",
      "original_quote": "或小兒作戲耍為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L021",
      "original_quote": "後三年內生貴子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L022",
      "original_quote": "進東方財產",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L023",
      "original_quote": "若聞東方人家失火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L024",
      "original_quote": "或有縊死者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L025",
      "original_quote": "必大發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L026",
      "original_quote": "到離有人著色衣為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L027",
      "original_quote": "後三十日進橫財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L028",
      "original_quote": "若聞東方有刀刃自殺者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L029",
      "original_quote": "必大發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L030",
      "original_quote": "到坤有三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L031",
      "original_quote": "五人至為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L032",
      "original_quote": "後七日進橫財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L033",
      "original_quote": "六十日進文契",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L034",
      "original_quote": "若聞南方有雷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L035",
      "original_quote": "牛畜者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L036",
      "original_quote": "大發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L037",
      "original_quote": "到兌有三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SanQiDaoGong_L038",
