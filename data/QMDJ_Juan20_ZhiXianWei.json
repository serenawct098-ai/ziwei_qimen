{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan20",
  "section": "陟險危論",
  "entries": [
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L000",
      "original_quote": "陟險危論",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L001",
      "original_quote": "經曰：九山河水際深大為絕過山朦朧為天牢過",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L002",
      "original_quote": "絕人者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L003",
      "original_quote": "為天羅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L004",
      "original_quote": "兼葭者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L005",
      "original_quote": "眾草也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L006",
      "original_quote": "潢者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L007",
      "original_quote": "池也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L008",
      "original_quote": "險者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L009",
      "original_quote": "疾也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L010",
      "original_quote": "高下有水之處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L011",
      "original_quote": "天井者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L012",
      "original_quote": "坑下也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L013",
      "original_quote": "翳薈者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L014",
      "original_quote": "屏蔽之處也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L015",
      "original_quote": "此地情形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L016",
      "original_quote": "兵不得轉移者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L017",
      "original_quote": "賊從利方上來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L018",
      "original_quote": "即視天時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L019",
      "original_quote": "如陽時令士卒皆坦前左肩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L020",
      "original_quote": "引聲大呼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L021",
      "original_quote": "鳴鐘鼓而先擊之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L022",
      "original_quote": "若陰時令士卒銜枚駐車",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L023",
      "original_quote": "立馬桴皷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L024",
      "original_quote": "靜以待之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L025",
      "original_quote": "倘賊人四面圍迫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L026",
      "original_quote": "當分軍馬為三部",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L027",
      "original_quote": "一部居月建上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L028",
      "original_quote": "一部居月德上一云居日月德上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L029",
      "original_quote": "一部居生神上即每月建逢開是生神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L030",
      "original_quote": "時衝逢死氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L031",
      "original_quote": "月德正從未順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L032",
      "original_quote": "日德正從亥逆行數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L033",
      "original_quote": "時德亥子丑逢申酉戌巳午未寅十二卯上勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L034",
      "original_quote": "一云：「大將居亭亭上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L035",
      "original_quote": "引兵擊之大勝」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_ZhiXianWei_L036",
      "original_quote": "生神一作生門",
      "tag": []
    }
  ],
