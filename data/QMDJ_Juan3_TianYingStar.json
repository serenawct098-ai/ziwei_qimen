      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L042",
      "original_quote": "發達",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L043",
      "original_quote": "值午時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L044",
