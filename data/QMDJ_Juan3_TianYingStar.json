      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L031",
      "original_quote": "鷄上樹為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L032",
      "original_quote": "作用後人七十日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L033",
      "original_quote": "野物進宅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L034",
      "original_quote": "大發財產",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L035",
      "original_quote": "值巳時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L036",
      "original_quote": "主有人抱文書",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L037",
