    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L062",
      "original_quote": "白衣女人過為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L063",
      "original_quote": "作用後主小口",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L064",
