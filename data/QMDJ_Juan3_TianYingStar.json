      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L001",
      "original_quote": "天英之星嫁娶凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L002",
      "original_quote": "遠行移徙不宜逢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L003",
      "original_quote": "上官商賈凶敗死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L004",
      "original_quote": "造作求財一場空",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L005",
      "original_quote": "天英值子時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L006",
      "original_quote": "主有鑼聲自西北來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L007",
      "original_quote": "三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L008",
      "original_quote": "五人掌火伐木為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L009",
      "original_quote": "作用後一年內主有殘病人抵賴破家",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L010",
      "original_quote": "三年內自刎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L011",
      "original_quote": "小兒因湯火災傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L012",
      "original_quote": "值醜時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L013",
      "original_quote": "主東北方師巫僧道至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L014",
      "original_quote": "鑼聲鳴為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L015",
      "original_quote": "作用後一月內火燒房屋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L016",
      "original_quote": "一年內犬作人言",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L017",
      "original_quote": "百怪俱見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L018",
      "original_quote": "死亡大敗凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L019",
      "original_quote": "值寅時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L020",
      "original_quote": "主東方有兵馬來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L021",
      "original_quote": "及捕魚人持網過為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L022",
      "original_quote": "作用後女人路上拾得財物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L023",
      "original_quote": "六十日內進寡婦田產",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L024",
      "original_quote": "龍雷折屋凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L025",
      "original_quote": "值卯時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L026",
      "original_quote": "主有提燈籠過或持米來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L027",
      "original_quote": "雷鳴為應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L028",
      "original_quote": "作用後應六十日內進女人財寶發家",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L029",
      "original_quote": "值辰時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan3_TianYingStar_L030",
