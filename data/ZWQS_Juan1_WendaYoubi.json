    },
    {
      "line_id": "ZWQS_Juan1_WendaYoubi_L002",
      "original_quote": "希夷先生答曰：右弼帝極主宰之星，守身命文墨精通。紫府吉星同垣，財官雙美，文武雙全。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYoubi_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYoubi_L003",
      "original_quote": "羊陀火忌沖破，下局斷之。女人賢良有志，縱四殺沖破，不為下賤，僧道清閑。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYoubi_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYoubi_L004",
      "original_quote": "歌曰",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYoubi_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYoubi_L005",
      "original_quote": "左輔原屬土，右弼水為根，失君為無用，三合宜見君，若在紫微位，爵祿不須論，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYoubi_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYoubi_L006",
      "original_quote": "若在夫妻位，主人定二婚，若與廉貞併，惡賤遭鉗髡，輔弼為上相，輔佐紫微星，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYoubi_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYoubi_L007",
      "original_quote": "喜居日月側，文人遇禹門，倘居閑位上，無爵更無名，妻宮遇此宿，決定兩妻成，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaYoubi_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaYoubi_L008",
      "original_quote": "若與刑囚處，遭傷作盜賊。",
      "tag": [],
      "tag_reason": "",
