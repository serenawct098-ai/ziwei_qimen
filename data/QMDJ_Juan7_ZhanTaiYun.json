  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L000",
      "original_quote": "占胎孕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L001",
      "original_quote": "占捕捉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L002",
      "original_quote": "以六合為逃人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L003",
      "original_quote": "以傷門為捕人全以八門為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L004",
      "original_quote": "以八門為人盤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L005",
      "original_quote": "主人事也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L006",
      "original_quote": "如六合宮謂天盤六合所臨地盤之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L007",
      "original_quote": "後凡言宮皆仿此剋傷門宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L008",
      "original_quote": "不可得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L009",
      "original_quote": "反此易得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L010",
      "original_quote": "傷門宮生六合宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L011",
      "original_quote": "捕人不實力",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L012",
      "original_quote": "必受其賂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L013",
      "original_quote": "傷門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L014",
      "original_quote": "六合同宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L015",
      "original_quote": "兩相通同",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L016",
      "original_quote": "值年月日時格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L017",
      "original_quote": "則可獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanTaiYun_L018",
      "original_quote": "天網低亦然",
      "tag": []
    }
  ],
