    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L000",
      "original_quote": "占文武升遷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L001",
      "original_quote": "法以開",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L002",
      "original_quote": "杜二門主之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L003",
      "original_quote": "文官看開門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L004",
      "original_quote": "武官看杜門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L005",
      "original_quote": "二門乘三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L006",
      "original_quote": "再得旺相相生其年命日乾者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L007",
      "original_quote": "必升",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L008",
      "original_quote": "太歲來生年命日乾者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L009",
      "original_quote": "必系天子特旨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L010",
      "original_quote": "值符來生者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L011",
      "original_quote": "上司保舉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L012",
      "original_quote": "月建來生日干年命及開門者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L013",
      "original_quote": "部臣保舉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L014",
      "original_quote": "開門再得旺相相生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L015",
      "original_quote": "升之必速",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L016",
      "original_quote": "得門不得奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L017",
      "original_quote": "亦升",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L018",
      "original_quote": "得奇不得門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanShengQian_L019",
      "original_quote": "只加銜不升",
      "tag": []
    }
  ],
