{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan 13",
  "section": "行人占",
  "entries": [
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L000",
      "original_quote": "行人占",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L001",
      "original_quote": "論干支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L002",
      "original_quote": "推測行人來不來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L003",
      "original_quote": "只從時日細安排",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L004",
      "original_quote": "時元合生日元上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L005",
      "original_quote": "逢制日支軍馬回",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L006",
      "original_quote": "又喜時支作日馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L007",
      "original_quote": "日支合馬歸時下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L008",
      "original_quote": "若使時馬系日支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L009",
      "original_quote": "投墓支干定返期",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L010",
      "original_quote": "最忌截空與刑墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L011",
      "original_quote": "死絕多應音信稀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L012",
      "original_quote": "日音時納去留人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L013",
      "original_quote": "納音生合已登程",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L014",
      "original_quote": "時音來剋日乾納",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L015",
      "original_quote": "行人飛驥在武陵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L016",
      "original_quote": "乾納剋制用時納",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L017",
      "original_quote": "縱欲動身又怕行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L018",
      "original_quote": "更詳臨官占驛馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L019",
      "original_quote": "三合時日察歸情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L020",
      "original_quote": "論值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L021",
      "original_quote": "值符所推論行人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L022",
      "original_quote": "旺相逢生必稱心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L023",
      "original_quote": "休囚刑剋豈得意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L024",
      "original_quote": "空亡在後想家門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L025",
      "original_quote": "勾白朱蛇逢剋制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L026",
      "original_quote": "多般遲滯是非生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L027",
      "original_quote": "元武太陰如生合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L028",
      "original_quote": "又疑陰小絆行程",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L029",
      "original_quote": "五馬如投天與地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L030",
      "original_quote": "歸鞭已拂嶺頭云",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L031",
      "original_quote": "論值使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L032",
      "original_quote": "值使斷可斷行蹤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L033",
      "original_quote": "門合來方歸意濃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L034",
      "original_quote": "惟忌驚傷與杜死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L035",
      "original_quote": "刑格迫伏未回蹤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L036",
      "original_quote": "開休生景乘天忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L037",
      "original_quote": "加臨乾符墓相逢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L038",
      "original_quote": "論十干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L039",
      "original_quote": "十干時兮所望親",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L040",
      "original_quote": "用神乘馬始來臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L041",
      "original_quote": "馬阻關東歸未得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L042",
      "original_quote": "馬過山谷喜相尋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L043",
      "original_quote": "論九星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L044",
      "original_quote": "九星南北與西東",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L045",
      "original_quote": "來旺投生在外棲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L046",
      "original_quote": "入墓加比營歸計",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L047",
      "original_quote": "前程空絕必回廬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L048",
      "original_quote": "論九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L049",
      "original_quote": "起元伐問去何方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L050",
      "original_quote": "卻將本局所推詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L051",
      "original_quote": "議歷過來搜父比",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L052",
      "original_quote": "此官此日合回鄉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L053",
      "original_quote": "論門戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L054",
      "original_quote": "門戶要合符與門關",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L055",
      "original_quote": "時日驛馬可搜尋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L056",
      "original_quote": "要看加臨何親屬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L057",
      "original_quote": "加合占人評來臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L058",
      "original_quote": "論三甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L059",
      "original_quote": "行人孟闔未登程",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L060",
      "original_quote": "仲甲開兮路宿雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L061",
      "original_quote": "季甲值開人便到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L062",
      "original_quote": "本甲之上考門時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L063",
      "original_quote": "喜時日干支門符坐馬來馬又杳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L064",
      "original_quote": "又行人類神年命相生相合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L065",
      "original_quote": "而甲門內開不闔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L066",
      "original_quote": "大為准到也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L067",
      "original_quote": "論吉凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L068",
      "original_quote": "返首跌穴早已束裝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L069",
      "original_quote": "其中遲速刑合參詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L070",
      "original_quote": "虎狂兮羈留而不返",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L071",
      "original_quote": "龍走兮蹭蹬不歸鄉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L072",
      "original_quote": "遁格合時日兩元可以言到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L073",
      "original_quote": "詐假會白虎朱蛇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L074",
      "original_quote": "書信必來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L075",
      "original_quote": "蛇夭而道路災疫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L076",
      "original_quote": "投江而歸計徬徨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L077",
      "original_quote": "飛幹伏乾來情不善",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L078",
      "original_quote": "伏宮飛宮客若遐荒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L079",
      "original_quote": "大小格而遷延時日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L080",
      "original_quote": "刑悖格而彼此俱傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L081",
      "original_quote": "白入熒而行人將到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L082",
      "original_quote": "熒入白而書信皆亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L083",
      "original_quote": "不遇何須盼望",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L084",
      "original_quote": "擊刑有事相妨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L085",
      "original_quote": "入墓無傷可雲到宅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L086",
      "original_quote": "羅網相格莫斷回鄉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L087",
      "original_quote": "返伏門迫須分行人遠近",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L088",
      "original_quote": "若合驛馬臨宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_HangRenZhan_L089",
      "original_quote": "反主去客登堂",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan 13",
