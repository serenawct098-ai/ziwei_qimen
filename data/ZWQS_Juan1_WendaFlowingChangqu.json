  "section": "星垣問答論_FlowingChangqu",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L001",
      "original_quote": "問流年昌曲若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L002",
      "original_quote": "答曰：命逢流年昌曲，為科名科甲。大小二限逢之，三合拱照太陽，又照流年祿；",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L003",
      "original_quote": "小限太歲逢魁鉞、左右、台座、日月、科權祿馬三方拱照，決然高中無疑。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L004",
      "original_quote": "然亦此數星俱全方為大吉，但以流年科甲為主。如命限值之，其餘吉曜，若得二三拱照，亦必高中。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L005",
      "original_quote": "但二星在巳西得地，不富即貴，只是不能耐久。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L006",
      "original_quote": "歌曰",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L007",
      "original_quote": "南北昌曲星，數中推第一，身命最為佳，諸吉恐非吉，得居人命上，桃花浪三汲，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L008",
      "original_quote": "入仕更無虛，從容要輔弼，只恐惡殺臨，火鈴羊陀激，若還逢陷地，苗而不秀實，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L009",
      "original_quote": "不是公吏輩，九流工數術，無破宰職權，女人多淫佚，樂居亥子宮，空亡官無益。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaFlowingChangqu_L009",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
