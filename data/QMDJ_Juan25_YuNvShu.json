{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan25",
  "section": "玉女術",
  "entries": [
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L000",
      "original_quote": "玉女術",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L001",
      "original_quote": "圍然後入局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L002",
      "original_quote": "玉女術曰：「先畫地圖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L003",
      "original_quote": "用桑柴灰為之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L004",
      "original_quote": "可以隱匿逃亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L005",
      "original_quote": "或有患難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L006",
      "original_quote": "隱遁人無見者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L007",
      "original_quote": "即不避歸忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L008",
      "original_quote": "往亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L009",
      "original_quote": "陷破",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L010",
      "original_quote": "一切凶神惡煞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L011",
      "original_quote": "又可以市賈求利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L012",
      "original_quote": "進見長吏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L013",
      "original_quote": "報仇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L014",
      "original_quote": "攻惡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L015",
      "original_quote": "宜深保此局法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L016",
      "original_quote": "父子不傳之秘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L017",
      "original_quote": "毋輕易語人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L018",
      "original_quote": "以洩天機也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L019",
      "original_quote": "布局時讀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L020",
      "original_quote": "左三右七",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L021",
      "original_quote": "戴九履一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L022",
      "original_quote": "二四為肩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L023",
      "original_quote": "六八為足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L024",
      "original_quote": "畫地圖訖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L025",
      "original_quote": "即心下排定東西南北",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L026",
      "original_quote": "布十二支辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L027",
      "original_quote": "八乾四維之位」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L028",
      "original_quote": "假如",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L029",
      "original_quote": "甲日便從甲地入局內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L030",
      "original_quote": "乙日便從乙地入局內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L031",
      "original_quote": "丙丁庚辛壬癸日俱仿此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L032",
      "original_quote": "惟戊日從乾坤方位上入局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L033",
      "original_quote": "己日便從艮巽方入局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L034",
      "original_quote": "手執六算祝四方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L035",
      "original_quote": "急急如律令",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvShu_L036",
      "original_quote": "欲行千里法亦念此咒",
      "tag": []
    }
  ],
