      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengChan_L002",
      "original_quote": "以六乙為女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengChan_L003",
      "original_quote": "六庚為男",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengChan_L004",
      "original_quote": "取甲以乙妹娶庚之義也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengChan_L005",
      "original_quote": "如乙庚二干落宮兩相生合則成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengChan_L006",
      "original_quote": "兩相剋則不成如地盤子卯刑之類",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengChan_L007",
      "original_quote": "又以天上六合為媒人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengChan_L008",
      "original_quote": "如六合宮生六乙宮媒向女家",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengChan_L009",
      "original_quote": "生六庚宮媒向男家",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengChan_L010",
      "original_quote": "六庚宮剋六乙宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengChan_L011",
      "original_quote": "女家畏男而不嫁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengChan_L012",
      "original_quote": "六乙宮剋六庚宮",
