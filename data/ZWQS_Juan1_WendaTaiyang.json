{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "星垣問答論_Taiyang",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L001",
      "original_quote": "問太陽所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L002",
      "original_quote": "答曰：太陽星屬火，日之精也。乃造化之表儀，在數主人有貴氣，能為文為武。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L003",
      "original_quote": "諸吉集則降禎祥，處黑星則勞心費力。若隨身命之中，居於廟樂之地。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L004",
      "original_quote": "為數中之至曜，乃官祿之樞機。後化貴化祿，最宜在官祿宮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L005",
      "original_quote": "男作父星，女為夫主。命逢諸吉守照，更得太陰同照，富貴全美。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L006",
      "original_quote": "若身居之，逢吉聚，則可在貴人門下客，否則公卿走卒。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L007",
      "original_quote": "夫妻亦為強宮，男為諸吉聚，可因妻得貴。陷地加殺，傷妻不吉。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L008",
      "original_quote": "男女宮得八座，加吉星在廟旺地，主生貴子，權柄不小。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L009",
      "original_quote": "若財帛宮於旺地，會吉相助，不怕巨門纏，其富貴綿遠矣！若旺相無空劫，一生主富。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L010",
      "original_quote": "居田宅，得祖父蔭澤。若左右諸吉星皆至，大小二限俱到，必有驟興之喜。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L011",
      "original_quote": "若限不扶，不可以三合論議，恐應小差。女命逢之，限旺亦可共享。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L012",
      "original_quote": "與鈴刑忌集限，目下有憂，或生剋父母。刑殺聚限，有傷官之憂，常人有官非之撓。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L012",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L013",
      "original_quote": "與羊陀聚則有疾病，與火鈴合其苦楚不少。推而至此，禍福瞭然。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L013",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L014",
      "original_quote": "遷移宮其福與身命不同，難招祖業，移根換葉，出祖為家。限步逢之，決要動移。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L014",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L015",
      "original_quote": "女命逢之不吉，若福德宮有相佐，招賢明之夫。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L015",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L016",
      "original_quote": "父母宮男子單作父星，有輝則吉，無輝剋父。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L016",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L017",
      "original_quote": "希夷先生曰：太陽星周天曆度輸轉無窮。喜輔弼而佐君象，以祿存而助福。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L017",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L018",
      "original_quote": "所忌者，巨暗遭逢。所樂者，太陰相旺。諸項會吉則吉、黑道遇之則勞。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L018",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L019",
      "original_quote": "守人身命，主人忠鯁，不較是非。若居廟旺，化祿化權，允為貴論。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L019",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L020",
      "original_quote": "若得左右、昌曲、魁鉞三合拱照財官二宮，富貴極品。加四殺，亦主飽煖，僧道有師號。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L020",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L021",
      "original_quote": "女人廟旺，主旺夫益子，加權祿封贈，加殺主平常。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L021",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L022",
      "original_quote": "歌曰",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L022",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L023",
      "original_quote": "太陽原屬火，正主官祿星，若居身命位，稟性最聰明，慈愛量寬大，福壽享遐齡，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L023",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L024",
      "original_quote": "若與太陰會，驟發貴無倫，有輝照身命，平步入金門，巨門不相犯，升殿承君恩，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L024",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L025",
      "original_quote": "偏垣逢暗度，貧賤不可言，男人必剋父，女命夫不全，火鈴逢若定，羊陀眼目昏，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L025",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L026",
      "original_quote": "二限若值此，否定賣田園。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L026",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L027",
      "original_quote": "玉蟾先生曰：太陽司權貴為文，遇天刑為武。在寅卯為初昇，在辰巳為日麗中天，在午為日麗中天，在未申為偏垣。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L027",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L028",
      "original_quote": "在酉為西沒，貴而不顯，秀而不實。在戌亥子為失輝，更逢巨暗一生勞碌貧忙。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L028",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L029",
      "original_quote": "更主眼目有傷，與人寡合招非。女命逢之，夫星不美，遇耗則非禮成婚。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L029",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L030",
      "original_quote": "若與祿存同宮，雖主財帛，亦辛苦不閑。若與左右同宮則為貴論。又嫌火鈴、刑忌，未免先剋其父。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L030",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyang_L031",
      "original_quote": "此星男得之為父星，女得之為夫星。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyang_L031",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "星垣問答論-Taiyang星部分完成"
}