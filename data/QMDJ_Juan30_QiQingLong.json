{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "起青龍訣",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L000",
      "original_quote": "起青龍訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L001",
      "original_quote": "起青龍訣不論冬至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L002",
      "original_quote": "夏至皆順數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L003",
      "original_quote": "子午青龍起在申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L004",
      "original_quote": "卯酉之日又到寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L005",
      "original_quote": "寅申須從子上起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L006",
      "original_quote": "巳亥到午不須論",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L007",
      "original_quote": "惟有辰戌歸辰位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L008",
      "original_quote": "醜未反逆戌上尋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L009",
      "original_quote": "如甲子日從申上起青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L010",
      "original_quote": "酉上起明堂順數之例",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L011",
      "original_quote": "申青龍酉明堂戌天刑亥朱雀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L012",
      "original_quote": "未勾陳子金匱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L013",
      "original_quote": "午司命丑天德",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L014",
      "original_quote": "巳玄武辰天牢卯玉堂寅白虎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L015",
      "original_quote": "本日如遇時上有青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L016",
      "original_quote": "明堂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L017",
      "original_quote": "金匱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L018",
      "original_quote": "天德",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L019",
      "original_quote": "玉堂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L020",
      "original_quote": "司命為黃道時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L021",
      "original_quote": "如遇時上有天刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L022",
      "original_quote": "朱雀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L023",
      "original_quote": "白虎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L024",
      "original_quote": "天牢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L025",
      "original_quote": "玄武",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiQingLong_L026",
      "original_quote": "勾陳為黑道時",
      "tag": []
    }
  ],
