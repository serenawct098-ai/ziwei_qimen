{
  "text": "紫微斗數全書",
  "juan": "卷二",
  "section": "傷使禍福緊慢圖",
  "entries": [
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L001",
      "original_quote": "--------------------------------------------------------",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L002",
      "original_quote": "|。如六|災，天|天|寅怕六|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L003",
      "original_quote": "|寅丙|。若殤|殤|一者庚|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L004",
      "original_quote": "|一生|身禍|禍|樣，生|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L005",
      "original_quote": "|樣人|合緊|緊|。如人|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L006",
      "original_quote": "|巳|午|未|申|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L007",
      "original_quote": "--------------+----------------------------+--------------",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L008",
      "original_quote": "|天|殤使禍福緊慢圖歲限為災之局|天|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L009",
      "original_quote": "|殤||使|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L010",
      "original_quote": "|禍|凡歲限行到此星必死，若有救|禍|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L011",
      "original_quote": "|緊|始不妨也。|緊|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L012",
      "original_quote": "|辰||酉|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L013",
      "original_quote": "--------------天殤子辰卯午未宮禍緊--------------",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L014",
      "original_quote": "|天|天使丑卯辰酉戌宮禍緊|惡臨殺，天|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L015",
      "original_quote": "|殤|殤使寅申巳亥禍緊|。此，不使|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L016",
      "original_quote": "|禍||宮太可禍|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L017",
      "original_quote": "|緊||災歲見緊|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L018",
      "original_quote": "|卯||戌|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L019",
      "original_quote": "--------------+----------------------------+--------------",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L020",
      "original_quote": "|相二，不六|天|天|大限此|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L021",
      "original_quote": "|遇限怕宜甲|使|殤|宜至斗|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L022",
      "original_quote": "|。太殤到生|禍|禍|。此方|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L023",
      "original_quote": "|歲使此人|緊|緊|宮，|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L024",
      "original_quote": "|寅|丑|子|亥|",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_ShangshiTu_L025",
      "original_quote": "--------------------------------------------------------",
      "tag": []
    }
  ],
  "_extraction_status": "傷使禍福緊慢圖完成"
}