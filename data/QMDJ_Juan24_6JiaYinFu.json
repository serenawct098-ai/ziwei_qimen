{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan24",
  "section": "六甲陰符法",
  "entries": [
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L000",
      "original_quote": "六甲陰符法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L001",
      "original_quote": "經曰：「為上將者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L002",
      "original_quote": "禦敵須作六甲陰符法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L003",
      "original_quote": "令敵人身誅」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L004",
      "original_quote": "故曰：「寧與人千金",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L005",
      "original_quote": "不教人六甲之陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L006",
      "original_quote": "天地之間",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L007",
      "original_quote": "此道最靈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L008",
      "original_quote": "藏之金匱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L009",
      "original_quote": "貴之於心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L010",
      "original_quote": "不傳非人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L011",
      "original_quote": "慎勿輕洩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L012",
      "original_quote": "盜視者盲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L013",
      "original_quote": "盜讀者疫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L014",
      "original_quote": "若作六甲陰符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L015",
      "original_quote": "必須至誠齋戒以邀天福",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L016",
      "original_quote": "稍有污犯便不潔矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L017",
      "original_quote": "安望靈驗」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L018",
      "original_quote": "凡作符者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L019",
      "original_quote": "當於月蝕之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L020",
      "original_quote": "伐桐木及杜荊等木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L021",
      "original_quote": "陰枝或栢心亦可",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L022",
      "original_quote": "悉長九寸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L023",
      "original_quote": "廣二寸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L024",
      "original_quote": "厚三分",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L025",
      "original_quote": "用雌黃塗之作像",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L026",
      "original_quote": "並書其名於像下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L027",
      "original_quote": "即丁卯陰神孔林族等之像及名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L028",
      "original_quote": "畫符之後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L029",
      "original_quote": "絳錦為囊盛之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L030",
      "original_quote": "大將自隨身佩之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L031",
      "original_quote": "用兵時便取本旬陰神之符於囊外以指敵人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L032",
      "original_quote": "敵人自散",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L033",
      "original_quote": "不敢交兵也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L034",
      "original_quote": "凡取木時必先齋戒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L035",
      "original_quote": "取酒一升",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L036",
      "original_quote": "鹿脯三斤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L037",
      "original_quote": "鹽一盞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L038",
      "original_quote": "祝而祭之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L039",
      "original_quote": "白茆為席",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L040",
      "original_quote": "北向再拜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L041",
      "original_quote": "祝於杜荊之前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L042",
      "original_quote": "百鬼之神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L043",
      "original_quote": "與子俱游",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L044",
      "original_quote": "變化其身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L045",
      "original_quote": "以子所指",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L046",
      "original_quote": "莫不服者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L047",
      "original_quote": "謹奉清酌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L048",
      "original_quote": "美脯及鹽等物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L049",
      "original_quote": "願歆饗之」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L050",
      "original_quote": "咒訖再拜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L051",
      "original_quote": "凡三咒畢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L052",
      "original_quote": "乃伐取木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L053",
      "original_quote": "勿令污穢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L054",
      "original_quote": "亦勿近穢之物及婦人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L055",
      "original_quote": "雞犬見之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L056",
      "original_quote": "凡受持之法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L057",
      "original_quote": "齋戒五日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L058",
      "original_quote": "蘭湯沐浴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L059",
      "original_quote": "潔食淨飯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L060",
      "original_quote": "毋食五辛之物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L061",
      "original_quote": "及書畫畢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L062",
      "original_quote": "於六甲之日夜半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L063",
      "original_quote": "醮之於方壇之上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L064",
      "original_quote": "為法壇一丈二尺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L065",
      "original_quote": "外浮土十二丈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L066",
      "original_quote": "開十二辰門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L067",
      "original_quote": "以竹為纂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L068",
      "original_quote": "長三尺或九尺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L069",
      "original_quote": "隨地方列之於四向",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L070",
      "original_quote": "將六陰之符置壇上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L071",
      "original_quote": "依六位放",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L072",
      "original_quote": "以五色繪彩各三尺五寸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L073",
      "original_quote": "上安酒三杯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L074",
      "original_quote": "脯二筋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L075",
      "original_quote": "鹽一盞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L076",
      "original_quote": "白茆為席",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L077",
      "original_quote": "北向而跪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L078",
      "original_quote": "呼四方支辰神名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L079",
      "original_quote": "及六甲六陰神名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L080",
      "original_quote": "並門戶神名而祭之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L081",
      "original_quote": "假如甲子陰在丁卯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L082",
      "original_quote": "正東再拜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L083",
      "original_quote": "呼其神而祝之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L084",
      "original_quote": "以絳棉為囊盛陰符常隨身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L085",
      "original_quote": "則百鬼不敢侵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L086",
      "original_quote": "以陰符指敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L087",
      "original_quote": "則敵人自滅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L088",
      "original_quote": "如倉猝無壇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaYinFu_L089",
      "original_quote": "但於庭中或野外畫地為壇亦可矣",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan24",
    "section": "六甲陰符法",
