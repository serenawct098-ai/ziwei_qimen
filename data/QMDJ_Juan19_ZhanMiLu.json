{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan19",
  "section": "占迷路法",
  "entries": [
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L000",
      "original_quote": "占迷路法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L001",
      "original_quote": "三路迷失時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L002",
      "original_quote": "天罡隨於孟仲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L003",
      "original_quote": "兩歧感應日辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L004",
      "original_quote": "左右以規謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L005",
      "original_quote": "路逢三叉不知何道吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L006",
      "original_quote": "以正時占",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L007",
      "original_quote": "天罡加孟左道通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L008",
      "original_quote": "加季右道通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L009",
      "original_quote": "加仲中道通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L010",
      "original_quote": "此下出軍大捷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L011",
      "original_quote": "所求必遂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L012",
      "original_quote": "若逢兩歧路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L013",
      "original_quote": "日乾吉者左道通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L014",
      "original_quote": "辰支爻吉者右道通也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L015",
      "original_quote": "如七月申時占",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L016",
      "original_quote": "以巳將加地盤申上起順數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L017",
      "original_quote": "辰時天罡在地盤未上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L018",
      "original_quote": "未為季左道通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L019",
      "original_quote": "餘仿此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L020",
      "original_quote": "子午卯酉四仲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L021",
      "original_quote": "寅申巳亥為四孟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan19_ZhanMiLu_L022",
      "original_quote": "辰戌丑未為四季",
      "tag": []
    }
  ],
  "_source": {
