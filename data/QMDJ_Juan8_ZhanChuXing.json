{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan8",
  "section": "占出行",
  "entries": [
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L000",
      "original_quote": "占出行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L001",
      "original_quote": "以日幹落宮為出行謀干之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L002",
      "original_quote": "所往何方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L003",
      "original_quote": "有吉門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L004",
      "original_quote": "吉格來生日乾之宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L005",
      "original_quote": "往必大利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L006",
      "original_quote": "或不得奇門吉格來生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L007",
      "original_quote": "而與日幹比和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L008",
      "original_quote": "亦利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L009",
      "original_quote": "反此不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L010",
      "original_quote": "再被凶門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L011",
      "original_quote": "凶格來衝剋日乾者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L012",
      "original_quote": "大凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L013",
      "original_quote": "若臨空亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L014",
      "original_quote": "入墓之方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L015",
      "original_quote": "或日干年命刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L016",
      "original_quote": "墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L017",
      "original_quote": "空亡方位者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanChuXing_L018",
      "original_quote": "不利",
      "tag": []
    }
  ],
