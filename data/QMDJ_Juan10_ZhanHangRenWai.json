      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L001",
      "original_quote": "法以行人年命日乾決之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L002",
      "original_quote": "年命日幹落在坎艮震巽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L003",
      "original_quote": "陽遁為內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L004",
      "original_quote": "為近",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L005",
      "original_quote": "離坤兌乾為外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L006",
      "original_quote": "為遠",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L007",
      "original_quote": "合而決之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L008",
      "original_quote": "年命落於四維甚遠",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L009",
      "original_quote": "落坤艮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L010",
      "original_quote": "為極遠",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L011",
      "original_quote": "陰遁以離坤兌乾為內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L012",
      "original_quote": "為近",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L013",
      "original_quote": "坎艮震巽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L014",
      "original_quote": "為外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L015",
      "original_quote": "為遠",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L016",
      "original_quote": "合而決之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L017",
      "original_quote": "年命落於四正下者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L018",
      "original_quote": "不甚遠",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L019",
      "original_quote": "年命日幹落於休廢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L020",
      "original_quote": "其人在外必不如意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L021",
      "original_quote": "非困即病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L022",
      "original_quote": "若年命日幹落於墓庫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L023",
      "original_quote": "空亡之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L024",
      "original_quote": "再乘死絕之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L025",
      "original_quote": "其人必不在",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L026",
      "original_quote": "如年命日干乘旺相之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L027",
      "original_quote": "再得奇門吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanHangRenWai_L028",
      "original_quote": "行人在外發財如意",
      "tag": []
