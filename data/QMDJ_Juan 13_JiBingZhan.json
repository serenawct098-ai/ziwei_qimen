      "line_id": "QMDJ_Juan 13_JiBingZhan_L144",
      "original_quote": "開嘗噎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L145",
      "original_quote": "闔隔悶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L146",
      "original_quote": "季甲主下焦之病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L147",
      "original_quote": "開庤漏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L148",
      "original_quote": "闔痔閉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L149",
      "original_quote": "開忌刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L150",
      "original_quote": "闔忌衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L151",
      "original_quote": "陽開在表",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L152",
      "original_quote": "陰闔在裏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L153",
      "original_quote": "論干支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L154",
      "original_quote": "日乾為人時幹病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L155",
      "original_quote": "納乾之藏醫藥症",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L156",
      "original_quote": "人剋病兮可云瘥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L157",
      "original_quote": "病剋人兮憂險應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L158",
      "original_quote": "醫能剋病始可投",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L159",
      "original_quote": "如若傷人未可用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L160",
      "original_quote": "遙制符使是名醫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L161",
      "original_quote": "生合符使藥蹭蹬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L162",
      "original_quote": "惟喜日旺時休囚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L163",
      "original_quote": "五行檢點參病症",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L164",
      "original_quote": "論值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L165",
      "original_quote": "直符占病所由來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L166",
      "original_quote": "刑傷剋制考病胎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L167",
      "original_quote": "陰六遙傷情欲病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L168",
      "original_quote": "勾地刑符滯未開",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L169",
      "original_quote": "朱蛇制符因門惱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L170",
      "original_quote": "白天卻是恐驚災",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L171",
      "original_quote": "符入空鄉災不實",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L172",
      "original_quote": "胎沒死廢著意裁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L173",
      "original_quote": "論值使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L174",
      "original_quote": "直使占病之瘥劇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L175",
      "original_quote": "三五吉凶論門義",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L176",
      "original_quote": "吉值休囚主纏綿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L177",
      "original_quote": "凶更旺相堪畏懼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L178",
      "original_quote": "最忌墓命與刑年",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L179",
      "original_quote": "時中詳占進退氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L180",
      "original_quote": "凶退可痊吉進瘥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L181",
      "original_quote": "門戶生吉始無慮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L182",
      "original_quote": "論十干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L183",
      "original_quote": "十干論病在何處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L184",
      "original_quote": "肝膽脾胃心腎注",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L185",
      "original_quote": "參詳奇儀刑與擊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L186",
      "original_quote": "上下加臨識病處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L187",
      "original_quote": "木剋土兮脾胃傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L188",
      "original_quote": "火剋金兮肺家替",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L189",
      "original_quote": "金來剋木筋脈變",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L190",
      "original_quote": "水剋火兮心腎廢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L191",
      "original_quote": "年命日時細參詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L192",
      "original_quote": "生旺休囚知災竪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L193",
      "original_quote": "論九星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L194",
      "original_quote": "九星從來知禍福",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L195",
      "original_quote": "吉凶星宿從所屬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L196",
      "original_quote": "旺吉星臨災無虞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L197",
      "original_quote": "死凶星照防哀哭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L198",
      "original_quote": "吉逢生兮凶不刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L199",
      "original_quote": "任爾祈禱災不贖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L200",
      "original_quote": "論九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L201",
      "original_quote": "九宮病源與醫藥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L202",
      "original_quote": "水宜疏通木忌削",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L203",
      "original_quote": "金宜溫補火怕關",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L204",
      "original_quote": "土乃五行之歸橐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L205",
      "original_quote": "此行旺動比刑傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L206",
      "original_quote": "變理中和醫的確",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L207",
      "original_quote": "詳觀節氣察虛實",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L208",
      "original_quote": "病識真兮藥不錯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L209",
      "original_quote": "論門戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L210",
      "original_quote": "門傷發表抑何疑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L211",
      "original_quote": "戶傷治裏墓稽遲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L212",
      "original_quote": "門戶俱陽表裏治",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L213",
      "original_quote": "陰陽先後判因依",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L214",
      "original_quote": "論三甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L215",
      "original_quote": "三甲開闔論三焦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L216",
      "original_quote": "泥丸尾閭夾脊交",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L217",
      "original_quote": "開若傷兮休剋伐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L218",
      "original_quote": "闔遇刑囚忌補調",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L219",
      "original_quote": "論吉凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L220",
      "original_quote": "返首跌穴吉課成凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L221",
      "original_quote": "須得年命無傷始雲葉吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L222",
      "original_quote": "虎狂龍走凶中有吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L223",
      "original_quote": "若再刑迫符使便作凶推",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L224",
      "original_quote": "地遁臨命已作黃泉正客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L225",
      "original_quote": "鬼假當權定知冥府追呼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L226",
      "original_quote": "鬼遁人遁似非吉兆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L227",
      "original_quote": "鬼假人假非是休徵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L228",
      "original_quote": "三詐病有反複",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L229",
      "original_quote": "遁假貴辨陰陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L230",
      "original_quote": "得使而制鬼為利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L231",
      "original_quote": "守門而舊病不祥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L232",
      "original_quote": "三門四戶最忌刑墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L233",
      "original_quote": "年命那堪喪吊重逢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L234",
      "original_quote": "天馬私門豈宜擊迫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L235",
      "original_quote": "符使更嫌空亡刑陷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L236",
      "original_quote": "夭矯鬼怪近",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L237",
      "original_quote": "投江魂魄揚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L238",
      "original_quote": "伏乾飛幹醫不明而藥味反症",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L239",
      "original_quote": "飛宮伏宮人不安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L240",
      "original_quote": "而宅舍驚惶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L241",
      "original_quote": "大格小格胸膈便道不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L242",
      "original_quote": "刑格悖格肢體脈絡相妨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L243",
      "original_quote": "熒入白兮病轉添",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L244",
      "original_quote": "白入熒兮災自退",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L245",
      "original_quote": "年月日時逢悖格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L246",
      "original_quote": "新舊災疫可參詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L247",
      "original_quote": "五不遇兮將逝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L248",
      "original_quote": "六儀刑兮有傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L249",
      "original_quote": "入墓羅網纏綿災異",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L250",
      "original_quote": "反伏門迫迭罹凶殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L251",
      "original_quote": "金為尸兮木為棺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L252",
      "original_quote": "尸入木兮寧得安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L253",
      "original_quote": "庚辛若來刑甲乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_JiBingZhan_L254",
      "original_quote": "飛入中宮哭聲喧",
      "tag": []
    }
  ],
