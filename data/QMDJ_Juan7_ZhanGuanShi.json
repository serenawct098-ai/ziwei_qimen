{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan7",
  "section": "占官事催提緩急",
  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L000",
      "original_quote": "占官事催提緩急",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L001",
      "original_quote": "以時干為我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L002",
      "original_quote": "日干為官長",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L003",
      "original_quote": "六丁為公文",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L004",
      "original_quote": "值使為公差",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L005",
      "original_quote": "若值符宮剋天乙宮按此天乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L006",
      "original_quote": "時干也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L007",
      "original_quote": "天上時干為天乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L008",
      "original_quote": "而六丁臨於內地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L009",
      "original_quote": "其提緩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L010",
      "original_quote": "如值符宮剋天乙宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L011",
      "original_quote": "而值使臨於外地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L012",
      "original_quote": "其提急",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L013",
      "original_quote": "再有擊刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L014",
      "original_quote": "來意至惡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L015",
      "original_quote": "三奇至善",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L016",
      "original_quote": "若相生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L017",
      "original_quote": "公差與官長相見則喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L018",
      "original_quote": "相剋見怒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L019",
      "original_quote": "又看六庚為天獄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L020",
      "original_quote": "落休囚一去即結",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanGuanShi_L021",
      "original_quote": "旺相則不能結",
      "tag": []
    }
  ],
