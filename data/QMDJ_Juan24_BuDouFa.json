{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan24",
  "section": "真人步鬥法",
  "entries": [
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L000",
      "original_quote": "真人步鬥法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L001",
      "original_quote": "《步鬥經》曰：「夫步鬥可以通神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L002",
      "original_quote": "當於夜半居星光下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L003",
      "original_quote": "立場畫地作北斗七星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L004",
      "original_quote": "中間相去三尺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L005",
      "original_quote": "天蓬從天罡起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L006",
      "original_quote": "隨次第布之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L007",
      "original_quote": "居魁前逆布訖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L008",
      "original_quote": "正立天英而歌斗咒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L009",
      "original_quote": "誦至天英",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L010",
      "original_quote": "必先舉左足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L011",
      "original_quote": "並誦咒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L012",
      "original_quote": "以次依輕步之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L013",
      "original_quote": "左右更徧履之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L014",
      "original_quote": "如後法為之百日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L015",
      "original_quote": "則與神人自然感通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L016",
      "original_quote": "秘之勿洩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L017",
      "original_quote": "非人者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L018",
      "original_quote": "殃墮九祖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L019",
      "original_quote": "盜視者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L020",
      "original_quote": "其目必瞽也」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L021",
      "original_quote": "咒曰：「斗要妙兮十二神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L022",
      "original_quote": "承光明兮元武陳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L023",
      "original_quote": "氣仿髴兮如浮雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L024",
      "original_quote": "七變動兮上應天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L025",
      "original_quote": "知變化兮有吉凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L026",
      "original_quote": "入斗宿兮過天關",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L027",
      "original_quote": "合律呂兮治甲乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L028",
      "original_quote": "履天英兮度天任",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L029",
      "original_quote": "清冷淵兮可陸沉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L030",
      "original_quote": "住天柱兮擁天心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L031",
      "original_quote": "從此度兮登天禽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L032",
      "original_quote": "依天輔兮望天衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L033",
      "original_quote": "入天芮兮出天蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L034",
      "original_quote": "鬥道通兮剛柔濟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L035",
      "original_quote": "添福祿兮流後世",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L036",
      "original_quote": "出冥明兮千萬歲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L037",
      "original_quote": "急急如律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L038",
      "original_quote": "凡有事出門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L039",
      "original_quote": "呼本旬玉女名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L040",
      "original_quote": "如甲子旬陰在丁卯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L041",
      "original_quote": "從丁卯而出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L042",
      "original_quote": "咒曰：「丁卯玉女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L043",
      "original_quote": "護我佑我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L044",
      "original_quote": "毋令傷我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L045",
      "original_quote": "視我者瞽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L046",
      "original_quote": "聽我者反受其殃」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L047",
      "original_quote": "咒畢行去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L048",
      "original_quote": "慎勿反顧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L049",
      "original_quote": "其神隨護",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L050",
      "original_quote": "大獲其德",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L051",
      "original_quote": "如甲戌旬頭則呼丁丑玉女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L052",
      "original_quote": "咒之如前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L053",
      "original_quote": "餘仿此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L054",
      "original_quote": "乙奇神咒：「天帝威神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L055",
      "original_quote": "誅滅鬼賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L056",
      "original_quote": "六乙相扶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L057",
      "original_quote": "天道賛德",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L058",
      "original_quote": "吾今所行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L059",
      "original_quote": "無攻不剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L060",
      "original_quote": "急急如玄女律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L061",
      "original_quote": "丙奇神咒：「吾德助天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L062",
      "original_quote": "前後遮邏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L063",
      "original_quote": "青龍白虎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L064",
      "original_quote": "左右驅魔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L065",
      "original_quote": "朱雀道前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L066",
      "original_quote": "使吾會他",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L067",
      "original_quote": "天威助我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L068",
      "original_quote": "六丙除痾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L069",
      "original_quote": "急急如玄女律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L070",
      "original_quote": "丁奇神咒：「天帝弟子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L071",
      "original_quote": "部令天兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L072",
      "original_quote": "賞善罰惡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L073",
      "original_quote": "出幽入冥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L074",
      "original_quote": "來護我者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L075",
      "original_quote": "玉女六丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L076",
      "original_quote": "有犯我者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L077",
      "original_quote": "自滅其形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L078",
      "original_quote": "急急如玄女律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L079",
      "original_quote": "孤虛神咒：「天靈靈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L080",
      "original_quote": "地靈靈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L081",
      "original_quote": "孤虛孤虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L082",
      "original_quote": "神舉意如吾意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L083",
      "original_quote": "神不離吾左右",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L084",
      "original_quote": "急急如律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L085",
      "original_quote": "凡念各咒宜直行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L086",
      "original_quote": "不可回顧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuDouFa_L087",
      "original_quote": "至六十步外乃止",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan24",
