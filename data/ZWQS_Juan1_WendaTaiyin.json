{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "星垣問答論_Taiyin",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L001",
      "original_quote": "問太陰星所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L002",
      "original_quote": "答曰：太陰乃水之精，為田宅主，化富，與日為配。天儀表有上弦下弦之用，黃到黑到分勢尚好，虧數定廟樂。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L003",
      "original_quote": "其為人也聰明俊秀，其稟性也端雅純祥。上弦為要之機，下弦減威之論。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L004",
      "original_quote": "所值不以所見無妨，若相生坐於太陽，日在卯，月在西，俱為旺地，為富貴之基。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L005",
      "original_quote": "命坐銀輝之宮，諸吉咸集，為享福之論。若居陷地，則落弱之名。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L006",
      "original_quote": "若上弦下弦，仍以不逢巨門為佳。身若居之，則有隨娘繼拜，或離祖過房。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L007",
      "original_quote": "身命若見惡殺交沖，必作傷殘之論。除非僧道，反獲禎祥。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L008",
      "original_quote": "決禍福最為要緊，不可參差。又或與文曲同居身命，定是九流術士。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L009",
      "original_quote": "男為妻宿，又作母星。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L010",
      "original_quote": "希夷先生曰：太陰化祿與日為配，以卯辰巳午未為陷地，以西戌亥子丑為得垣。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L011",
      "original_quote": "西為西山之門，為東潛之所。嫌巨曜以來纏，怕羊陀以同度，廉囚相犯，七殺相沖，恐非得意之垣，定作傷殘之論。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L012",
      "original_quote": "此星屬水，為田宅宮主，有輝為福，失陷必凶。男女得之，皆為母星，又作妻宿。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L012",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L013",
      "original_quote": "若在身命廟樂，吉集主富貴。在疾厄遇陀暗為目疾，遇火鈴為災，值貪殺損目。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L013",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L014",
      "original_quote": "在父母，如陷地失輝，遇流年白虎太歲，主母有災。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L014",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTaiyin_L015",
      "original_quote": "此雖純和之星，但失輝受制則不吉。若逢白虎、喪門、吊客，妻亦慎之。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTaiyin_L015",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "星垣問答論-Taiyin星部分完成"
}