{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan7",
  "section": "占詞訟",
  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L000",
      "original_quote": "占詞訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L001",
      "original_quote": "占病何日愈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L002",
      "original_quote": "以病人日干為主八字內之日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L003",
      "original_quote": "以天芮為病神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L004",
      "original_quote": "以生死二門為生死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L005",
      "original_quote": "如日干落在生門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L006",
      "original_quote": "生主不死皆天盤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L007",
      "original_quote": "得死門者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L008",
      "original_quote": "難愈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L009",
      "original_quote": "更遇日干休囚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L010",
      "original_quote": "得凶星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L011",
      "original_quote": "凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L012",
      "original_quote": "必死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L013",
      "original_quote": "其餘六門主纏綿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L014",
      "original_quote": "以天芮廢沒之日為愈期",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L015",
      "original_quote": "占兒女病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanCiSong_L016",
      "original_quote": "時干入墓必死",
      "tag": []
    }
  ],
