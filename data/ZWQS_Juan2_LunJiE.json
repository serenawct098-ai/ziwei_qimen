{
  "text": "紫微斗數全書",
  "juan": "卷二",
  "section": "論疾厄訣",
  "entries": [
    {
      "line_id": "ZWQS_Juan2_LunJiE_L001",
      "original_quote": "六疾厄",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L002",
      "original_quote": "先看命宮星曜落陷加羊陀火鈴空劫化忌守照如何，又看疾厄宮星曜善惡廟旺落陷如何斷之。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L003",
      "original_quote": "紫微災少，天府同亦少，天相同皮胎勞，如加破軍血氣不和，同羊鈴主有暗疾，加空劫主疢疾心氣疾。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L004",
      "original_quote": "天機繈褓多災，陷地頭面破相，巨門同血氣疾，天梁同下部疾，太陰同瘡災，加羊火陷宮有目疾，四肢無力。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L005",
      "original_quote": "太陽頭風，太陰同加化忌，羊陀主眼目有傷，陷宮亦主目疾欠光明。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L006",
      "original_quote": "武曲繈褓災迍手足頭面有傷，羊陀同一生常有災，天相同招暗疾，七殺同血疾，貪狼同廟旺無疾，陷地加四殺，眼手足疾痔疾瘋瘡。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L007",
      "original_quote": "天同入廟災少，巨門同心氣疾，太陰同加羊火血氣疾，天梁同加四殺心氣疾。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L008",
      "original_quote": "廉貞繈褓災瘡腰足之疾，入廟加吉和平，遇貪狼同，陷地眼疾災多，七殺破軍天府同災少。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L009",
      "original_quote": "天府災少臨災有救，紫微同災少，加羊陀火鈴空劫有瘋疾，廉貞同加劫殺空亡，半途傷殘。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L010",
      "original_quote": "太陰廟旺無災，陷地災多主勞傷之症，女人主大傷殘，若太陽同加吉美一生災少，羊陀火鈴眼目疾，加空劫有瘋疾，天同同加羊陀，陷宮主加症同火鈴多災。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L011",
      "original_quote": "巨門少年膿血之厄，太陽同有頭瘋疽，天同同下部主有瘋症，加羊火酒免之疾，加忌有耳目之憂。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L012",
      "original_quote": "天相災少面皮黃腫血氣之疾，紫微同災少，武曲同加四殺破相，廉貞同加空劫手足傷。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L013",
      "original_quote": "七殺幼年多災，長主痔疾，武曲同加四殺手足傷殘，廉貞同主目疾，加擎羊四肢有傷殘。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L014",
      "original_quote": "破軍幼年瘡癩濃血羸黃，武曲同目視疾，紫微同災少，廉貞同加羊火四肢有傷殘。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L015",
      "original_quote": "文昌獨守災少，加羊陀火鈴空劫災多，同諸吉星一生無災。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L016",
      "original_quote": "文曲災少加吉星一世無災，加羊陀火鈴空劫，坐陷宮災有。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L017",
      "original_quote": "左輔獨守平和，加吉星災少，見羊陀火鈴空劫常有災。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L018",
      "original_quote": "右弼獨守逢災有救，見羊陀火鈴空劫災多。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L019",
      "original_quote": "祿存少年多災，加吉星災少，見羊陀火鈴四肢必傷殘，加空劫玫暗疾延生。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L020",
      "original_quote": "陀羅幼年災，磨唇齒頭面，有傷破方可延壽。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L021",
      "original_quote": "擎羊有頭瘋之症，或四肢欠力，頭面破相延壽，加吉星災少。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L022",
      "original_quote": "羊鈴主一生災少，身體健旺伶俐。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_LunJiE_L023",
      "original_quote": "斗君遇吉身心安寧其年無災。遇凶殺本生人有畏忌其年多災。",
      "tag": []
    }
  ],
  "_extraction_status": "論疾厄訣完成"
}