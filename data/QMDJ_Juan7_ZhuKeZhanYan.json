{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan7",
  "section": "奇門主客占驗論",
  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L000",
      "original_quote": "奇門主客占驗論",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L001",
      "original_quote": "論曰：奇門之應驗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L002",
      "original_quote": "時有先後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L003",
      "original_quote": "應有主客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L004",
      "original_quote": "以彼此人我而推之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L005",
      "original_quote": "大凡奇神應物之初",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L006",
      "original_quote": "星應事之中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L007",
      "original_quote": "門應事之末",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L008",
      "original_quote": "依次推詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L009",
      "original_quote": "無不應驗如神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L010",
      "original_quote": "若我去尋人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L011",
      "original_quote": "我為客他為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L012",
      "original_quote": "以天盤之星為我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L013",
      "original_quote": "地盤之星為他",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L014",
      "original_quote": "如他來尋我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L015",
      "original_quote": "他為客我為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L016",
      "original_quote": "以天盤之星為他",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L017",
      "original_quote": "地盤之星為我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L018",
      "original_quote": "看他來生我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L019",
      "original_quote": "我去生他",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L020",
      "original_quote": "他生我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L021",
      "original_quote": "益在我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L022",
      "original_quote": "我生他",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L023",
      "original_quote": "益在他",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L024",
      "original_quote": "他剋我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L025",
      "original_quote": "損在我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L026",
      "original_quote": "我剋他",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L027",
      "original_quote": "損在他",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L028",
      "original_quote": "又以陰日之天盤星為我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L029",
      "original_quote": "陽日之地盤星為他",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L030",
      "original_quote": "比和無損益",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L031",
      "original_quote": "須仿此而推之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L032",
      "original_quote": "奇門曰：「有陽無陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L033",
      "original_quote": "德祿在門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L034",
      "original_quote": "無陽半吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L035",
      "original_quote": "有陽欣欣」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L036",
      "original_quote": "此陽神系指飛值使門時適得丁奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L037",
      "original_quote": "即為陽神得助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L038",
      "original_quote": "如甲子值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L039",
      "original_quote": "丁卯為陽神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L040",
      "original_quote": "甲戌值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhuKeZhanYan_L041",
      "original_quote": "丁丑為陽神之類",
      "tag": []
    }
  ],
