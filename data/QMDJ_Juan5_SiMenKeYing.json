{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan5",
  "section": "死門剋應",
  "entries": [
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L000",
      "original_quote": "死門剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L001",
      "original_quote": "元死之方最為凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L002",
      "original_quote": "人命逢之禍不輕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L003",
      "original_quote": "犯者平平財產退",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L004",
      "original_quote": "更防孝服死人丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L005",
      "original_quote": "問曰：死門屬土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L006",
      "original_quote": "又系黑星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L007",
      "original_quote": "分夜之方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L008",
      "original_quote": "秋冬之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L009",
      "original_quote": "天地肅殺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L010",
      "original_quote": "自此而始彰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L011",
      "original_quote": "門凶星凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L012",
      "original_quote": "當棄之而不用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L013",
      "original_quote": "不知此門寧可用之?",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L014",
      "original_quote": "衢仙答曰：死門之凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L015",
      "original_quote": "天地令行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L016",
      "original_quote": "大肆肅殺之威",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L017",
      "original_quote": "草柳色變",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L018",
      "original_quote": "木逢葉落",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L019",
      "original_quote": "故為凶象",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L020",
      "original_quote": "若得奇相助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L021",
      "original_quote": "而吊死刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L022",
      "original_quote": "捕捉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L023",
      "original_quote": "畋獵之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L024",
      "original_quote": "有得吉者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L025",
      "original_quote": "順天之序而然也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L026",
      "original_quote": "不可棄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L027",
      "original_quote": "靜應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L028",
      "original_quote": "死門加死：主官司而留",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L029",
      "original_quote": "印信無氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L030",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L031",
      "original_quote": "加死：主官司動而被刑杖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L032",
      "original_quote": "凶?",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L033",
      "original_quote": "加驚：主因官司不給",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L034",
      "original_quote": "憂疑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L035",
      "original_quote": "患病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L036",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L037",
      "original_quote": "加開：主見貴人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L038",
      "original_quote": "求印信",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L039",
      "original_quote": "文書事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L040",
      "original_quote": "大利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L041",
      "original_quote": "加休：主求財物事不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L042",
      "original_quote": "若問僧道求方吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L043",
      "original_quote": "加生：主喪事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L044",
      "original_quote": "求財得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L045",
      "original_quote": "占病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L046",
      "original_quote": "死者複生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L047",
      "original_quote": "加傷：原文缺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L048",
      "original_quote": "加杜：原文缺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L049",
      "original_quote": "加景：主主因文契",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L050",
      "original_quote": "印信",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L051",
      "original_quote": "財產事見官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L052",
      "original_quote": "先怒後喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L053",
      "original_quote": "不凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L054",
      "original_quote": "加甲戊：主作偽財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L055",
      "original_quote": "加乙：主求事不成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L056",
      "original_quote": "加丙：主信息憂疑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L057",
      "original_quote": "加丁：主老陽人疾病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L058",
      "original_quote": "加己：主病訟牽連不已",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L059",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L060",
      "original_quote": "加庚：主女人生產",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L061",
      "original_quote": "子母俱凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L062",
      "original_quote": "加辛：主盜賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L063",
      "original_quote": "失脫難獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L064",
      "original_quote": "加壬：主訟人自訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L065",
      "original_quote": "自招",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L066",
      "original_quote": "加癸：主嫁娶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L067",
      "original_quote": "婦女事凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L068",
      "original_quote": "動應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L069",
      "original_quote": "死門出者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L070",
      "original_quote": "二十里逢病人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L071",
      "original_quote": "三十里逢孝服",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L072",
      "original_quote": "血光事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L073",
      "original_quote": "雖有三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L074",
      "original_quote": "亦不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L075",
      "original_quote": "丙奇臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L076",
      "original_quote": "逢抱文書",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L077",
      "original_quote": "乙奇臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L078",
      "original_quote": "見喪葬祭物或紙扎物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L079",
      "original_quote": "丁奇臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L080",
      "original_quote": "逢少婦孝服",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L081",
      "original_quote": "哭泣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L082",
      "original_quote": "死門加死：二里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L083",
      "original_quote": "十二里逢婦人哭泣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L084",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L085",
      "original_quote": "加驚：七里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L086",
      "original_quote": "十七里逢喪哭泣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L087",
      "original_quote": "或死畜物類",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L088",
      "original_quote": "加開：六里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L089",
      "original_quote": "十六里逢開墳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L090",
      "original_quote": "哭泣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L091",
      "original_quote": "或畜鬪傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L092",
      "original_quote": "加休：一里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L093",
      "original_quote": "十一里逢青衣婦人哭泣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L094",
      "original_quote": "加生：八里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L095",
      "original_quote": "十八里逢孝子拿生物大慟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L096",
      "original_quote": "加傷：三里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L097",
      "original_quote": "十三里逢人抬棺槨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L098",
      "original_quote": "加杜：四里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L099",
      "original_quote": "十四里逢埋葬及紙扎彩色物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L100",
      "original_quote": "加景：九里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L101",
      "original_quote": "十九里逢重孝人哭泣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L102",
      "original_quote": "退吉進凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L103",
      "original_quote": "占身命：主有孝服",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L104",
      "original_quote": "病死之凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L105",
      "original_quote": "水木命並年月日時者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L106",
      "original_quote": "大凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SiMenKeYing_L107",
      "original_quote": "餘平",
      "tag": []
    }
