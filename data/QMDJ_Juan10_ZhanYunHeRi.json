{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan10",
  "section": "占孕何日生",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L000",
      "original_quote": "占孕何日生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L001",
      "original_quote": "以坤宮為產室",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L002",
      "original_quote": "天芮為產母",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L003",
      "original_quote": "天盤所得之星為小兒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L004",
      "original_quote": "天芮剋天盤之星者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L005",
      "original_quote": "主產速",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L006",
      "original_quote": "天盤星生地盤星天芮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L007",
      "original_quote": "子戀母腹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L008",
      "original_quote": "產遲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L009",
      "original_quote": "天盤星剋地盤星者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L010",
      "original_quote": "主母凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L011",
      "original_quote": "地盤星剋天盤星者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L012",
      "original_quote": "主子亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L013",
      "original_quote": "若得旺相氣及奇門吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L014",
      "original_quote": "方吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L015",
      "original_quote": "如天盤星落地盤庫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L016",
      "original_quote": "子死母腹內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L017",
      "original_quote": "天地二盤乘凶門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L018",
      "original_quote": "凶格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L019",
      "original_quote": "子母俱凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanYunHeRi_L020",
      "original_quote": "以天地二盤乘死絕之氣也",
      "tag": []
    }
  ],
