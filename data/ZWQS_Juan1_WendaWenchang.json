    },
    {
      "line_id": "ZWQS_Juan1_WendaWenchang_L002",
      "original_quote": "答曰：文昌主科甲，守身命主人幽閑儒雅，清秀魁梧，博文廣記，機變異常，一舉成名，披緋衣紫，福壽雙全。縱四殺沖破不為下賤。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaWenchang_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaWenchang_L003",
      "original_quote": "女人加吉得地，衣祿充足。四殺沖破，偏房下賤，僧道宜之。加權祿厚重有師號。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaWenchang_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaWenchang_L004",
      "original_quote": "歌曰",
      "tag": [],
      "tag_reason": "",
      "_source": {
