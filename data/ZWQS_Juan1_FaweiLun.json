  "entries": [
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L000",
      "original_quote": "⽃數發微論",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第127行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L001",
      "original_quote": "⽃數發微論⽩⽟蟾先⽣⽇觀天⽃數與五星不同,按此星辰與諸術⼤異｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第127行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L002",
      "original_quote": "四正吉星定為貴,三⽅殺拱少為奇｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第129行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L003",
      "original_quote": "對照兮詳凶詳吉,合照兮觀賤觀榮｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第130行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L004",
      "original_quote": "吉星入垣則為吉,凶星失地則為凶｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第131行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L005",
      "original_quote": "命逢紫微非特壽⽽且榮,⾝遇殺星不但貧⽽且賤｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第132行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L006",
      "original_quote": "左右會於紫府極品之尊,科權陷於凶鄉功名蹭蹬｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第133行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L007",
      "original_quote": "⾏限逢乎弱地未必為災,立命會在強宮必能降福｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第134行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L008",
      "original_quote": "⽺陀七殺限運莫逢,逢之定有刑傷｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第135行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L009",
      "original_quote": "(劫空傷使在內合斷)天哭喪⾨流年莫遇,遇之實防破害｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第135行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L010",
      "original_quote": "南⽃主限必⽣男,北⽃加臨先得女｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第137行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L011",
      "original_quote": "科星居於陷地,燈火辛勤｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第138行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L012",
      "original_quote": "昌曲在於凶鄉,林泉冷淡｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第138行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L013",
      "original_quote": "奸謀頻設,紫微愧遇破軍｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第139行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L014",
      "original_quote": "淫奔⼤⾏,紅鸞差逢貪宿｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第139行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L015",
      "original_quote": "命⾝相剋,則⼼亂⽽不閑｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第140行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L016",
      "original_quote": "⽞媼三宮,則邪淫⽽耽酒｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第140行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L017",
      "original_quote": "(即天姚星)殺臨三位,定然妻⼦不和｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第140行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L018",
      "original_quote": "巨到⼆宮,必是兄弟無義｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第141行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L019",
      "original_quote": "刑殺守⼦,宮⼦難奉老｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第142行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L020",
      "original_quote": "諸凶照財,帛聚散無常｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第142行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L021",
      "original_quote": "⽺陀守疾厄,眼⽬昏盲｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第143行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L022",
      "original_quote": "火鈴到遷移,長途寂寞｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第143行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L023",
      "original_quote": "尊星列賤位,主⼈多勞｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第144行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L024",
      "original_quote": "惡星應⼋宮,奴僕無助｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第144行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L025",
      "original_quote": "官祿遇紫府,富⽽且貴｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第145行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L026",
      "original_quote": "⽥宅遇破軍,先破後成｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第145行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L027",
      "original_quote": "福德遇空劫,奔走無⼒｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第146行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L028",
      "original_quote": "相貌加刑殺,刑剋難免｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第146行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_FaweiLun_L029",
      "original_quote": "後學者執此推詳,萬無⼀失｡",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "⽃數發微論",
        "line_ref": "第147行"
      }
    }
  ],
