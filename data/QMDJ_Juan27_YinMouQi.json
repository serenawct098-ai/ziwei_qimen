{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan27",
  "section": "陰謀氣",
  "entries": [
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L000",
      "original_quote": "陰謀氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L001",
      "original_quote": "凡白氣群行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L002",
      "original_quote": "或如群羊徘徊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L003",
      "original_quote": "結陣而來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L004",
      "original_quote": "或日月蒙蒙無光",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L005",
      "original_quote": "士卒內亂及兵內發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L006",
      "original_quote": "或黑如幢節而出於營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L007",
      "original_quote": "必有詐謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L008",
      "original_quote": "或黑而車旗臨我陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L009",
      "original_quote": "必有亂臣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L010",
      "original_quote": "謀與賊通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L011",
      "original_quote": "晝陰夜月出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L012",
      "original_quote": "君謀臣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L013",
      "original_quote": "夜陰晝日出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L014",
      "original_quote": "臣謀君",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L015",
      "original_quote": "或晝夜陰沉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L016",
      "original_quote": "或連陰十日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L017",
      "original_quote": "不是冬月而風亂起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L018",
      "original_quote": "君臣奸謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L019",
      "original_quote": "亦是兩國相圖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L020",
      "original_quote": "黑氣流行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L021",
      "original_quote": "互含五色",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L022",
      "original_quote": "臨我軍上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L023",
      "original_quote": "則敵與臣謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L024",
      "original_quote": "自敗死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L025",
      "original_quote": "凡敵兵暴至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L026",
      "original_quote": "必有赤雲赫赫然及王子還見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L027",
      "original_quote": "或赤若旌旗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L028",
      "original_quote": "或獨見赤雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L029",
      "original_quote": "如虹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L030",
      "original_quote": "如狗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L031",
      "original_quote": "如覆船",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L032",
      "original_quote": "及天下白雲如布疋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L033",
      "original_quote": "經於丑未",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L034",
      "original_quote": "或廣六",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L035",
      "original_quote": "七丈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L036",
      "original_quote": "東西亙天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L037",
      "original_quote": "上下起兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L038",
      "original_quote": "赤者尤甚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L039",
      "original_quote": "青者大喪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L040",
      "original_quote": "又白如瓜蔓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L041",
      "original_quote": "如仙人衣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L042",
      "original_quote": "千萬戴結",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L043",
      "original_quote": "罷而反興",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L044",
      "original_quote": "至八九丈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L045",
      "original_quote": "連而不斷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L046",
      "original_quote": "千里兵至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L047",
      "original_quote": "或赤虹如狗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L048",
      "original_quote": "四枚相聚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L049",
      "original_quote": "如人行不絕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L050",
      "original_quote": "或如艾虎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L051",
      "original_quote": "或上有云",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L052",
      "original_quote": "下有零螟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L053",
      "original_quote": "中天而下入我軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L054",
      "original_quote": "或黑雲從敵來覆我軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L055",
      "original_quote": "有雲如人而赤臨城邑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L056",
      "original_quote": "而四望無雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L057",
      "original_quote": "獨見雲極天半起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L058",
      "original_quote": "或如胡人列陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L059",
      "original_quote": "或如執楯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L060",
      "original_quote": "如赤杵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L061",
      "original_quote": "如火雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L062",
      "original_quote": "如人持節之勢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L063",
      "original_quote": "或如旌旗之伸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L064",
      "original_quote": "皆主敵兵暴來襲我也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L065",
      "original_quote": "陣前色黑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L066",
      "original_quote": "有陰謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L067",
      "original_quote": "色青",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L068",
      "original_quote": "兵叛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L069",
      "original_quote": "色赤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L070",
      "original_quote": "兵飢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L071",
      "original_quote": "色黃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan27_YinMouQi_L072",
      "original_quote": "急去之勾擊",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan27",
    "section": "陰謀氣",
