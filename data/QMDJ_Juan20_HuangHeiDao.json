{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan20",
  "section": "黃黑道日時",
  "entries": [
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L000",
      "original_quote": "黃黑道日時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L001",
      "original_quote": "凡子午月日申上起青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L002",
      "original_quote": "所謂子午從申起是也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L003",
      "original_quote": "丑未月日戌上起青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L004",
      "original_quote": "即丑未戌上尋是也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L005",
      "original_quote": "寅申月日子上起青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L006",
      "original_quote": "即寅申居子位是也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L007",
      "original_quote": "卯酉月日寅上起青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L008",
      "original_quote": "即卯酉卻加寅是也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L009",
      "original_quote": "辰戌月日辰上起青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L010",
      "original_quote": "即辰戌龍位上是也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L011",
      "original_quote": "巳亥月日午上起青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L012",
      "original_quote": "即所謂巳亥午中行是也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L013",
      "original_quote": "如正月二十六庚戌日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L014",
      "original_quote": "寅月子上起道字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L015",
      "original_quote": "數至戌遇還字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L016",
      "original_quote": "是黃道日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L017",
      "original_quote": "又戌日辰上起道字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L018",
      "original_quote": "巳上遇遠字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L019",
      "original_quote": "申酉遇通達二字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L020",
      "original_quote": "亥上遇遙字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L021",
      "original_quote": "寅上遇還字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L022",
      "original_quote": "辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L023",
      "original_quote": "巳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L024",
      "original_quote": "申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L025",
      "original_quote": "酉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L026",
      "original_quote": "亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L027",
      "original_quote": "寅時皆是黃道時也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L028",
      "original_quote": "餘仿此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L029",
      "original_quote": "青龍明堂及天刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L030",
      "original_quote": "朱雀金匱天德神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L031",
      "original_quote": "白虎玉堂天牢黑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_HuangHeiDao_L032",
      "original_quote": "元武司命及勾陳",
      "tag": []
    },
    {
