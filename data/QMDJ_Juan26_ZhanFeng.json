    },
    {
      "line_id": "QMDJ_Juan26_ZhanFeng_L001",
      "original_quote": "爾雅曰：風而雨上曰霾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhanFeng_L002",
      "original_quote": "陰而雨曰曀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhanFeng_L003",
      "original_quote": "日出而風為暴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhanFeng_L004",
      "original_quote": "回風曰飄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhanFeng_L005",
      "original_quote": "焚輪謂之頹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhanFeng_L006",
      "original_quote": "扶搖謂之飈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhanFeng_L007",
      "original_quote": "宮曰風曰雨征三羽五正商",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan26_ZhanFeng_L008",
      "original_quote": "角始得雨則能",
      "tag": []
    }
  ],
