{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan22",
  "section": "九星吉凶詩訣",
  "entries": [
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L000",
      "original_quote": "九星吉凶詩訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L001",
      "original_quote": "天蓬主事異秋冬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L002",
      "original_quote": "用訟安邊春夏功",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L003",
      "original_quote": "嫁娶俱亡移徙火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L004",
      "original_quote": "入官險道門逢凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L005",
      "original_quote": "賈商埋葬居行否",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L006",
      "original_quote": "相會奇門畧少過",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L007",
      "original_quote": "天任之宿屬星儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L008",
      "original_quote": "百事求謀利四時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L009",
      "original_quote": "造葬入官並請謁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L010",
      "original_quote": "行商娶祀吉遷移",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L011",
      "original_quote": "主邊更喜氣神旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L012",
      "original_quote": "來發機緣客已危",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L013",
      "original_quote": "天衝報怨趁春溫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L014",
      "original_quote": "萬里威風膽氣雄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L015",
      "original_quote": "不利秋冬春夏勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L016",
      "original_quote": "賈商行徙入官迍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L017",
      "original_quote": "造葬修方娶產難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L018",
      "original_quote": "須知萬物來逢春",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L019",
      "original_quote": "天輔修身利造營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L020",
      "original_quote": "徵贏春夏地開平",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L021",
      "original_quote": "罪刑此出逢天赦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L022",
      "original_quote": "遠出居官功亦成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L023",
      "original_quote": "嫁娶多兒增利市",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L024",
      "original_quote": "謁求移徙卻無情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L025",
      "original_quote": "天英之宿是天衢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L026",
      "original_quote": "遠行飲宴樂愉愉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L027",
      "original_quote": "出入葬埋宜嫁娶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L028",
      "original_quote": "徙宮築室祀商違",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L029",
      "original_quote": "主令慎勿輕加客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L030",
      "original_quote": "彼若未攻自取危",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L031",
      "original_quote": "芮星授道結交宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L032",
      "original_quote": "作事征行不必為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L033",
      "original_quote": "盜賊憂驚傷小口",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L034",
      "original_quote": "災刑囚事被官羈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L035",
      "original_quote": "大凶春夏秋冬吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L036",
      "original_quote": "縱得奇門福亦虧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L037",
      "original_quote": "天禽中主四時通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L038",
      "original_quote": "硬衝堅大有奇功",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L039",
      "original_quote": "宜用智謀機活伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L040",
      "original_quote": "祭神感應上官亨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L041",
      "original_quote": "賈商嫁娶行修造",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L042",
      "original_quote": "奇門加到盡亨通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L043",
      "original_quote": "天柱山方修造良",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L044",
      "original_quote": "祀神嫁娶亦生光",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L045",
      "original_quote": "藏形謹守斯為美",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L046",
      "original_quote": "移徙征行卻受殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L047",
      "original_quote": "營謀不善如輕動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L048",
      "original_quote": "妄行相交主中傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L049",
      "original_quote": "心宿星機神道輝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L050",
      "original_quote": "求仙合藥百為宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L051",
      "original_quote": "入官嫁娶及移徙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L052",
      "original_quote": "造葬征行祭祀時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L053",
      "original_quote": "泰在秋冬春夏日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_9XingJiXiong_L054",
      "original_quote": "利加君子小人危",
      "tag": []
    }
  ],
