{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan8",
  "section": "占何病症",
  "entries": [
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L000",
      "original_quote": "占何病症",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L001",
      "original_quote": "以天芮所落之宮決之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L002",
      "original_quote": "後以戴九履一之法論是何病?離宮為頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L003",
      "original_quote": "眼目",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L004",
      "original_quote": "在內為心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L005",
      "original_quote": "為病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L006",
      "original_quote": "為火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L007",
      "original_quote": "落坤為腹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L008",
      "original_quote": "在內為胃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L009",
      "original_quote": "在病為蠱賬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L010",
      "original_quote": "在外為肌膚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L011",
      "original_quote": "又為右肩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L012",
      "original_quote": "右耳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L013",
      "original_quote": "在病為瘡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L014",
      "original_quote": "落兌宮為咽喉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L015",
      "original_quote": "胸膈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L016",
      "original_quote": "為肺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L017",
      "original_quote": "在內為咳嗽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L018",
      "original_quote": "噎疾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L019",
      "original_quote": "喘急",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L020",
      "original_quote": "喑啞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L021",
      "original_quote": "在外為口齒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L022",
      "original_quote": "額角",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L023",
      "original_quote": "右肋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L024",
      "original_quote": "在病為痞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L025",
      "original_quote": "落干為腿足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L026",
      "original_quote": "亦為頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L027",
      "original_quote": "在內為大腸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L028",
      "original_quote": "在病內為則膀胱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L029",
      "original_quote": "便閉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L030",
      "original_quote": "壅結",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L031",
      "original_quote": "外則腿足筋骨疼痛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L032",
      "original_quote": "又為瘡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L033",
      "original_quote": "落坎在內為小腸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L034",
      "original_quote": "腎氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L035",
      "original_quote": "丹田",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L036",
      "original_quote": "在病為寒疾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L037",
      "original_quote": "遺精",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L038",
      "original_quote": "洩瀉或淋漓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L039",
      "original_quote": "便閉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L040",
      "original_quote": "或茶酒久宿腹痛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L041",
      "original_quote": "在外為腎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L042",
      "original_quote": "在病為陰虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L043",
      "original_quote": "瘡癢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L044",
      "original_quote": "疝氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L045",
      "original_quote": "落艮在內為脾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L046",
      "original_quote": "內病主虛脹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L047",
      "original_quote": "在外為腿足腳氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L048",
      "original_quote": "在病為麻木風濕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L049",
      "original_quote": "又為瘡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L050",
      "original_quote": "落震在內為肝膽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L051",
      "original_quote": "在外為左肋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L052",
      "original_quote": "內病則為血虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L053",
      "original_quote": "為癆症",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L054",
      "original_quote": "吐血",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L055",
      "original_quote": "寤寐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L056",
      "original_quote": "驚悖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L057",
      "original_quote": "狂言",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L058",
      "original_quote": "外病則目盲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L059",
      "original_quote": "耳聾及膚瘋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L060",
      "original_quote": "癩瘡痛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L061",
      "original_quote": "左股肋眷之疾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L062",
      "original_quote": "落巽在內為胃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L063",
      "original_quote": "口",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L064",
      "original_quote": "膏盲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L065",
      "original_quote": "又為膽病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L066",
      "original_quote": "內則中風不語",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L067",
      "original_quote": "肝肺相傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L068",
      "original_quote": "三焦虛炎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L069",
      "original_quote": "感傷風熱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L070",
      "original_quote": "喘急",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L071",
      "original_quote": "在外為左耳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L072",
      "original_quote": "左肩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L073",
      "original_quote": "左胘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L074",
      "original_quote": "又為筋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L075",
      "original_quote": "外病則手足浮熱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L076",
      "original_quote": "四肢無力",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L077",
      "original_quote": "為火為疾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L078",
      "original_quote": "又為癱疾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L079",
      "original_quote": "狂悖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L080",
      "original_quote": "筋舒之疾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L081",
      "original_quote": "再以天芮落宮所帶之乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L082",
      "original_quote": "驗其寒熱虛實",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L083",
      "original_quote": "詳審節氣時令",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L084",
      "original_quote": "方為的驗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L085",
      "original_quote": "不可疏忽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L086",
      "original_quote": "取笑於人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanHeBingZheng_L087",
      "original_quote": "學者慎之",
      "tag": []
    }
  ],
  "_source": {
