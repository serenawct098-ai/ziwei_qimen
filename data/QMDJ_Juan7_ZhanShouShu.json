{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan7",
  "section": "占壽數",
  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L000",
      "original_quote": "占壽數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L001",
      "original_quote": "占走失",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L002",
      "original_quote": "以時干為失主與六壬之用干同理",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L003",
      "original_quote": "六合為逃走之物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L004",
      "original_quote": "俱以落宮論之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L005",
      "original_quote": "又以六合宮與時干落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L006",
      "original_quote": "看在內外以分遠近",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L007",
      "original_quote": "如日干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L008",
      "original_quote": "六合俱在內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L009",
      "original_quote": "易尋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L010",
      "original_quote": "俱在外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L011",
      "original_quote": "難尋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L012",
      "original_quote": "六合在外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L013",
      "original_quote": "時干在內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L014",
      "original_quote": "難尋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L015",
      "original_quote": "又以六合所在之宮為方向",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L016",
      "original_quote": "如得旺相星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L017",
      "original_quote": "又乘開休生杜四門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L018",
      "original_quote": "不可得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L019",
      "original_quote": "反此可得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L020",
      "original_quote": "乘九地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L021",
      "original_quote": "太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L022",
      "original_quote": "有人潛藏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L023",
      "original_quote": "乘九天遠走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L024",
      "original_quote": "乘元武被人盜去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L025",
      "original_quote": "乘螣蛇有人盤詰羈縻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L026",
      "original_quote": "乘朱雀有信",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L027",
      "original_quote": "勾陳有勾引而去以上指六壬所乘而言也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L028",
      "original_quote": "又看六庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L029",
      "original_quote": "年格則年獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L030",
      "original_quote": "月格則月獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L031",
      "original_quote": "日格則日獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShouShu_L032",
      "original_quote": "時格則時獲",
      "tag": []
    }
  ],
