{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan22",
  "section": "日家奇門九星",
  "entries": [
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L000",
      "original_quote": "日家奇門九星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L001",
      "original_quote": "更有太乙九星位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L002",
      "original_quote": "冬至艮宮夏坤地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L003",
      "original_quote": "命起甲子順逆行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L004",
      "original_quote": "本日住宮太乙立",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L005",
      "original_quote": "太乙求財萬事通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L006",
      "original_quote": "攝提門打鬧叢中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L007",
      "original_quote": "軒轅出入多驚恐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L008",
      "original_quote": "招搖到處血光紅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L009",
      "original_quote": "天符打圍射獵吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L010",
      "original_quote": "青龍覓利喜重重",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L011",
      "original_quote": "咸池所至主官事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L012",
      "original_quote": "太陰服處暗財豐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L013",
      "original_quote": "天乙貴人宜酒食",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L014",
      "original_quote": "九星應驗最靈通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L015",
      "original_quote": "天之最貴亭亭星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L016",
      "original_quote": "最宜背主擊向衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L017",
      "original_quote": "兼及亭亭月將加",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L018",
      "original_quote": "時神後是亭亭也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L019",
      "original_quote": "生神背向一般窮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L020",
      "original_quote": "天之好神白奸位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L021",
      "original_quote": "格在寅申合巳亥由亭亭而及白奸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L022",
      "original_quote": "月將加時求孟神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L023",
      "original_quote": "亥寅巳申合孟異",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L024",
      "original_quote": "旬里孤皆壬癸方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L025",
      "original_quote": "所對之方是虛位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L026",
      "original_quote": "背孤擊虛虛用奸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_RiJia9Xing_L027",
      "original_quote": "女流可當百夫氣由白奸而論孤虛",
      "tag": []
    }
  ],
