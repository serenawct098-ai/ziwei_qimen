{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan9",
  "section": "占河水消漲",
  "entries": [
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L000",
      "original_quote": "占河水消漲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L001",
      "original_quote": "以天蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L002",
      "original_quote": "休門決之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L003",
      "original_quote": "休門乘旺相氣而得三奇者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L004",
      "original_quote": "水雖漲不至泛濫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L005",
      "original_quote": "休門乘旺相氣而值庚格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L006",
      "original_quote": "主河水壅塞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L007",
      "original_quote": "泛濫湧漲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L008",
      "original_quote": "再看有甲辰壬帶螣蛇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L009",
      "original_quote": "主孽龍舞水為害",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L010",
      "original_quote": "休門落於二五八宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L011",
      "original_quote": "水被土剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L012",
      "original_quote": "主立消或無水",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L013",
      "original_quote": "休門不乘庚格與甲辰壬者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L014",
      "original_quote": "水雖旺發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeShui_L015",
      "original_quote": "亦不出岸",
      "tag": []
    }
  ],
