{
  "text": "紫微斗數全書",
  "juan": "卷三",
  "section": "論人命入格",
  "entries": [
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L000",
      "original_quote": "論大小限星辰過十二宮遇十二支所忌訣",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第105行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L001",
      "original_quote": "人生子命忌寅申假如子年生人切忌寅申歲限，災晦至重，及忌子午歲限相沖。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第106行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L002",
      "original_quote": "丑午生人丑午瞋假如丑年生人忌午丑歲限，午生人亦忌丑午歲限，及忌七殺星，災晦極重。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第107行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L003",
      "original_quote": "寅卯之人防巳亥假如寅卯人忌巳亥歲限，及忌卯酉寅申相沖。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第108行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L004",
      "original_quote": "龍蛇切忌本身臨假如巳生人忌逢巳年及忌行到巳限、辰生人忌行辰年又忌行到辰限為天羅，又忌行到戌為地網，限遇此災晦疾厄之險，官非破財憂制連連矣。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第109行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L005",
      "original_quote": "申人鈴火災殃重假如申生人忌逢火鈴二星，必主災晦至重，及忌寅年沖。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第110行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L006",
      "original_quote": "未遇豬雞墓患殷假如未生人忌逢酉戌歲限，又忌見擎羊在四墓宮。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第111行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L007",
      "original_quote": "戌亥羊陀須避忌假如戌亥生人忌遇羊陀災重，戌生人又行到戍宮歲限為地網，又忌行到辰宮歲限為天羅，謂之辰戌相沖不美。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第112行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L008",
      "original_quote": "酉人陀刃亦非親假如酉生人亦忌羊陀歲限及忌行卯宮限，及卯年歲君相沖。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第113行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L009",
      "original_quote": "豬犬生人莫遇蛇，辰戍切忌到網羅，預先整頓衣冠木，未免生人唱挽歌。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第115行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L010",
      "original_quote": "論立命行限宮歌",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第117行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L011",
      "original_quote": "金人遇坎命須傷，木命落離有禍殃，水遇艮宮應蹇滯，火來兌上禍難藏，",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第118行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L012",
      "original_quote": "土到東南逢震巽，須防膿血及驚慌，縱然吉曜相逢照，未免宮災鬧一場。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第119行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L013",
      "original_quote": "論太歲小限星辰廟陷遇十二宮中吉凶依此判斷人行年災患應如神",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第122行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L014",
      "original_quote": "子年太歲併小限到子宮入廟化吉",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第124行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L015",
      "original_quote": "七殺破軍在子宮守歲限癸庚己生人發福，巨門天機乙癸生人發福，天府天相天梁丁己庚人財旺遂心，又天同丙丁生人財官雙美。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第125行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L016",
      "original_quote": "子年太歲併小限到子宮不入廟化凶",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第127行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L017",
      "original_quote": "紫微在子宮守命及歲限丙戊生人悔吝，破財災殃。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第128行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L018",
      "original_quote": "子年太歲所值吉凶星",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第130行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L019",
      "original_quote": "祿存天機天同太陰昌曲輔弼破軍天相廉真武曲天府巨門七殺，可斷其年人財兩美事事遂心。若遇貪狼紫微天梁忌星太陽擎羊，便斷人財耗散孝服，本身災晦不寧，減半論之。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第131行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L020",
      "original_quote": "丑年太歲併小限到丑宮入廟化吉",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第133行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L021",
      "original_quote": "天機在丑守命丙辛生人發旺，天相戊生人發旺，太陰武曲丙戊生人發旺，天府廉貞戊生人發旺，天梁丙戊辛生人發旺。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第134行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L022",
      "original_quote": "丑年太歲併小限到丑宮不入廟化凶",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第136行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L023",
      "original_quote": "太陰在丑宮守命戊生人悔吝，太陽星甲乙生人悔吝，天機丙辛癸生人悔吝，天同廉貞丁庚生人招官非。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第137行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L024",
      "original_quote": "丑年太歲所值吉凶星",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第139行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L025",
      "original_quote": "紫微天相天梁太陰天府祿存廉貞破軍昌曲天機輔弼，可斷其年事事遂心。若遇天同巨門武曲貪狼忌宿太陽擎羊，便斷其年人財耗散，官災口舌孝服，本身遭晦，減半論之。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第140行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L026",
      "original_quote": "寅年太歲併小限到寅宮入廟化吉",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第142行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L027",
      "original_quote": "紫微太陽武曲天梁七殺，甲庚丁己生人財官雙美。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第143行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L028",
      "original_quote": "寅年太歲併小限到寅宮不入廟化凶",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第145行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L029",
      "original_quote": "廉貞貪狼破軍在寅，丙戊生人招官非，甲子生人不喜寅申歲限。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第146行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L030",
      "original_quote": "寅年太歲所值吉凶星",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第148行"
      }
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L031",
      "original_quote": "紫微天府天機太陰武曲七殺天同天相太陽巨門天梁，便斷其年人財進益作事遂心。若遇貪狼陀忌，便斷其年人財破散，官非孝服，本身見災，減半論之。",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷三",
        "section": "論人命入格",
        "line_ref": "第149行"
      }
    }
  ],
  "_extraction_status": "論人命入格完成"
}