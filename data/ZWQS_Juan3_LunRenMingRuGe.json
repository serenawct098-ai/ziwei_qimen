{
  "text": "紫微斗數全書",
  "juan": "卷三",
  "section": "論人命入格",
  "entries": [
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L000",
      "original_quote": "論人命入格",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L001",
      "original_quote": "如命入格，廟旺聚吉科權祿守，上上之命。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L002",
      "original_quote": "不入廟加吉化科權祿，上次之命。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L003",
      "original_quote": "不入廟不加吉，為平常命。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L004",
      "original_quote": "入廟不加吉，平等。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L005",
      "original_quote": "若居陷地又加殺化忌，為下格之命，不以入格而論也。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan3_LunRenMingRuGe_L006",
      "original_quote": "又入格不化吉而化凶，只以本命吉凶多寡而斷之。",
      "tag": []
    }
  ],
  "_extraction_status": "論人命入格完成"
}