{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan8",
  "section": "占病吉凶",
  "entries": [
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L000",
      "original_quote": "占病吉凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L001",
      "original_quote": "以天芮之落宮為病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L002",
      "original_quote": "以生死二門推之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L003",
      "original_quote": "天芮得生門者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L004",
      "original_quote": "生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L005",
      "original_quote": "得死門者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L006",
      "original_quote": "死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L007",
      "original_quote": "又看天芮落干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L008",
      "original_quote": "兌二宮為旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L009",
      "original_quote": "不能治",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L010",
      "original_quote": "落離宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L011",
      "original_quote": "中五",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L012",
      "original_quote": "其病纏綿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L013",
      "original_quote": "落震",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L014",
      "original_quote": "巽二宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L015",
      "original_quote": "病神受剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L016",
      "original_quote": "主不藥而愈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L017",
      "original_quote": "落坎宮為休囚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L018",
      "original_quote": "病雖纏綿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L019",
      "original_quote": "猶可醫治",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L020",
      "original_quote": "新病落空亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L021",
      "original_quote": "生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L022",
      "original_quote": "久病落空亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L023",
      "original_quote": "死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L024",
      "original_quote": "又看日乾帶死囚之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L025",
      "original_quote": "帶凶神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L026",
      "original_quote": "凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L027",
      "original_quote": "或不得奇門者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L028",
      "original_quote": "亦死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L029",
      "original_quote": "若天芮落宮乘凶神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L030",
      "original_quote": "凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L031",
      "original_quote": "日乾雖得旺相氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L032",
      "original_quote": "而被天芮來衝剋年命者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L033",
      "original_quote": "亦死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L034",
      "original_quote": "又看病人年命日乾即生日八字中之日乾入墓者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L035",
      "original_quote": "亦死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L036",
      "original_quote": "衢仙曰：「死門加生門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L037",
      "original_quote": "占病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanBingJiXiong_L038",
      "original_quote": "死者複生」",
      "tag": []
    }
  ],
