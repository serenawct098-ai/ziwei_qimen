{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "女命骨髓賦",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_NumingFu_L001",
      "original_quote": "府相之星女命躔，必當子貴與夫賢。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L002",
      "original_quote": "廉貞清白能相守，更有天同理亦然。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L003",
      "original_quote": "端正紫微太陽星，早遇賢夫性可憑。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L004",
      "original_quote": "太陽寅到午，遇吉終是福。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L005",
      "original_quote": "左輔天魁為福壽，左弼天相福相臨。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L006",
      "original_quote": "祿存厚重多衣食，府相朝垣命必榮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L007",
      "original_quote": "紫府巳亥相互輔，左右扶持福必生。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L008",
      "original_quote": "巨門天機為破蕩。天梁月曜女命貧。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L009",
      "original_quote": "擎羊火星為下賤。文昌文曲福不全。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L010",
      "original_quote": "武曲之宿為寡宿。破軍一曜性難明。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L011",
      "original_quote": "貪狼內狠多淫佚。七殺沉吟福不榮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L012",
      "original_quote": "十干化祿最榮昌，女命逢之大吉昌。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L012",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L013",
      "original_quote": "更得祿存相湊合，旺夫益子受恩光。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L013",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L014",
      "original_quote": "火鈴羊陀及巨門，天空地劫又相臨。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L014",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L015",
      "original_quote": "貪狼七殺廉貞宿，武曲加臨剋害侵。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L015",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L016",
      "original_quote": "三方四正嫌逢殺，更在夫宮禍患深。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L016",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L017",
      "original_quote": "若是本宮無正曜，必主生離剋害真。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L017",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_NumingFu_L018",
      "original_quote": "已前論賦俱係看命要訣，學者宜熟玩之，乃得原委也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "女命骨髓賦",
        "line_id": "ZWQS_Juan1_NumingFu_L018",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "女命骨髓賦全文完成"
}