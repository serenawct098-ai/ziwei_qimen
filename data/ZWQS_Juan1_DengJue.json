{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "定富貴貧賤等訣",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_DengJue_L001",
      "original_quote": "論對⾯朝⽃格⼦午宮逢祿存是也",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L002",
      "original_quote": "詩⽇祿有對⾯在遷移,⼦午逢之利祿宜,德合吉壤⼈敬重,雙全富",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L003",
      "original_quote": "貴福稀奇｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L004",
      "original_quote": "論科權祿主格",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L005",
      "original_quote": "詩⽇祿權周勃命中逢,入相王朝贊聖功,迎合權星兼吉曜,巍巍富",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L006",
      "original_quote": "貴列三公｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L007",
      "original_quote": "論左右朝垣格",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L008",
      "original_quote": "詩⽇天星左右最⾼明,若在三⽅祿位興,武職⾼登應顯佐,⽂⼈名",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L009",
      "original_quote": "譽列公卿｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L010",
      "original_quote": "論兼⽂武格⽂曲武曲在⾝命是也",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L011",
      "original_quote": "詩⽇格名⽂武少⼈知,遇此須教百事通,更值命宮無殺破,滔滔榮",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L012",
      "original_quote": "顯是英雄｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L013",
      "original_quote": "論⽂星朝命格",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L014",
      "original_quote": "詩⽇⽂昌⽂曲最榮華,值此須⽣富貴家,更得三⽅祥曜拱,卻如錦",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L015",
      "original_quote": "上⼜添花｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L016",
      "original_quote": "論⽯中隱⽟格命在⼦午逢巨⾨是也",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L017",
      "original_quote": "詩⽇巨⾨⼦午⼆宮逢,⾝命逢之必貴榮,更得三⽅科祿照,⽯中隱",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L018",
      "original_quote": "⽟是豐隆｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L019",
      "original_quote": "論貪狼遇火名為火貴格三合照⾝命是也",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L020",
      "original_quote": "詩⽇火遇貪狼照命宮,封侯食祿是英雄,三⽅倘若無凶殺,到老應知福壽隆｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L021",
      "original_quote": "論⼈有無商賈之命",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L022",
      "original_quote": "如⼈命有巨⽇紫府守照,為⼈安分,有仁德耿直之⼼,作事無私,",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L023",
      "original_quote": "不⾏邪僻,不肯妄求,為⼠為官主有廉潔:如值⽉貪同殺忌,⼼多",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L024",
      "original_quote": "機關,貪財無厭,暮夜求利之輩｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L025",
      "original_quote": "詩⽇貪⽉同殺會機梁,因財計利作經商,須知暮夜無眠睡,潮海營",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L026",
      "original_quote": "營⾃走忙｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L027",
      "original_quote": "⼜⽇經商紫府遇擎⽺,武曲遷移利市場,殺破廉貞同左右,⽺鈴火",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L028",
      "original_quote": "宿遠傳揚｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L029",
      "original_quote": "論⼈命有無藝術者",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L030",
      "original_quote": "寅申已亥安命或丑未辰戌遇有貪狼武曲在命化忌､加殺,必作細巧",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L031",
      "original_quote": "藝術之⼈也｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L032",
      "original_quote": "詩⽇閑宮貪狼何⽣業,不是屠⼈須打鐵,諸般巧藝更能精,性好遊",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L033",
      "original_quote": "畋並捕獵｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L034",
      "original_quote": "⼜⽇破武未宮多巧藝,已亥安命正相宜,破軍廉貞居卯⻄,細巧之",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L035",
      "original_quote": "⼈定藝奇｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L036",
      "original_quote": "是作奇⼯｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L037",
      "original_quote": "⼜⽇天機天相命⾝中,帝令財星入墓中,天府若居遷動位,平⽣定",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L038",
      "original_quote": "論出家僧道之命",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L039",
      "original_quote": "紫微居卯⻄遇劫空者,看命無正曜⼜兼⽺火劫空化忌者,更看⽗⺟",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L040",
      "original_quote": "妻⼦三宮有殺者⽅可斷｡及寅年申⽉已⽇亥時四正殺湊化忌,男僧",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L041",
      "original_quote": "道,女尼姑｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L042",
      "original_quote": "詩⽇極居卯⻄遇劫空,⼗⼈之命九⼈僧,道釋岩泉皆有分,清閑幽",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L043",
      "original_quote": "靜度平⽣｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L044",
      "original_quote": "⼜⽇命坐空鄉定出家,⽂星相會實堪誇,若還⽂曲臨⾝命,受蔭清",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L045",
      "original_quote": "閑福可嘉｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L046",
      "original_quote": "剋命⽅終｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L047",
      "original_quote": "⼜⽇天機七殺破梁同,⽻客僧流命所逢,更若太陽兼帝座,伶仃孤",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L048",
      "original_quote": "論⼈命內犯孤剋者",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L049",
      "original_quote": "如剋妻剋⼦剋⽗⺟內犯⼀⼆不為僧道亦作貧賤之⼈,第⼀看⽗⺟在",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L050",
      "original_quote": "廟旺地有無吉凶星辰,如在陷地加殺化忌必主刑剋,第⼆⼜看妻妾",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L051",
      "original_quote": "宮,三看⼦女宮廟陷之地,有無吉凶星辰,如在陷加殺化忌必鰥寡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L052",
      "original_quote": "孤獨論斷｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L053",
      "original_quote": "論壽夭淫蕩",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L054",
      "original_quote": "詩⽇貪狼入廟最⾼強,南極星同壽命長,北⽃帝星無惡殺,綿綿老",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L055",
      "original_quote": "耋衍禎祥｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L056",
      "original_quote": "詩⽇七殺臨⾝終是天,貪狼入廟定為娼,前示三合相臨照,也學韓",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L057",
      "original_quote": "君去竊香｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L058",
      "original_quote": "中卻⼜沈｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L059",
      "original_quote": "詩⽇⾝命兩宮俱有殺,貪花戀酒禍猶深,平⽣⼆限來符會,得意之",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L060",
      "original_quote": "論定⼈殘疾",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L061",
      "original_quote": "先看命宮星落陷,加⽺陀火鈴劫空忌宿,⼜看疾厄宮星廟陷吉凶⽽",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L062",
      "original_quote": "斷可也｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L063",
      "original_quote": "詩⽇命中⽺陀殺守⾝,火鈴坐照禍非輕,平⽣若不常年臥,也作陀",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L064",
      "original_quote": "腰曲背⼈｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L065",
      "original_quote": "論定⼈破相",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L066",
      "original_quote": "詩⽇相貌之中逢殺曜,更加三合⼜逢刑,疾厄擎⽺逢耗使,折傷肢",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L067",
      "original_quote": "體不和平｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L068",
      "original_quote": "論定⼈聰明",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L069",
      "original_quote": "詩⽇⽂曲天相破軍星,計策偏多性更靈,更若三⽅昌曲會,⼀⽣巧",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L070",
      "original_quote": "藝有聲名｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L071",
      "original_quote": "論定⼈富⾜",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L072",
      "original_quote": "詩⽇太陰入廟有光輝,財入財鄉分外奇,破耗凶星皆不犯,堆⾦積",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L073",
      "original_quote": "⽟富豪兒｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L074",
      "original_quote": "論定⼈貧賤",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L075",
      "original_quote": "詩⽇命中吉曜不來臨,火忌⽺陀四正侵,武曲廉貞巨破會,⼀⽣暴",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L076",
      "original_quote": "怒⼜⾝貧｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L077",
      "original_quote": "論定⼈作盜賊",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L078",
      "original_quote": "詩⽇命逢破耗與貪廉,七殺三⽅照及⾝,武曲更居遷動位,⼀⽣⾯",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L079",
      "original_quote": "背刺痕新｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L080",
      "original_quote": "論定⼈⼀⾝駁雜",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L081",
      "original_quote": "詩⽇吉曜相扶凶曜臨,百般巧藝不亨通,若逢⾝命遇惡曜,只做屠",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DengJue_L082",
      "original_quote": "⽜宰⾺⼈｡",
      "tag": []
    }
  ],
  "_extraction_status": "定富貴貧賤等訣完成"
}