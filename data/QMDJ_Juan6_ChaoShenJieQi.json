{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan6",
  "section": "超神接氣訣",
  "entries": [
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L000",
      "original_quote": "超神接氣訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L001",
      "original_quote": "夫閏奇者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L002",
      "original_quote": "有過九日而後閏者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L003",
      "original_quote": "有過十四日而值閏者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L004",
      "original_quote": "各有決例",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L005",
      "original_quote": "大約氣先到而節未到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L006",
      "original_quote": "先用其氣謂之「接氣」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L007",
      "original_quote": "節先到而氣未到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L008",
      "original_quote": "謂之「超神」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L009",
      "original_quote": "超神者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L010",
      "original_quote": "仍用其當局之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L011",
      "original_quote": "而不用其節",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L012",
      "original_quote": "待超過九日而方用其節",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L013",
      "original_quote": "謂之「超神」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L014",
      "original_quote": "接氣者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L015",
      "original_quote": "必在閏月之前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L016",
      "original_quote": "超神者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L017",
      "original_quote": "須在閏月之後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L018",
      "original_quote": "閏月前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L019",
      "original_quote": "氣必先到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L020",
      "original_quote": "閏月後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L021",
      "original_quote": "節必先到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L022",
      "original_quote": "節先到者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L023",
      "original_quote": "必先用其氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L024",
      "original_quote": "節先到者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L025",
      "original_quote": "猶不用其節",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L026",
      "original_quote": "超神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L027",
      "original_quote": "接氣之旨明矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L028",
      "original_quote": "若其年閏正",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L029",
      "original_quote": "二",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L030",
      "original_quote": "三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L031",
      "original_quote": "四月者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L032",
      "original_quote": "必閏大雪一氣之候",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L033",
      "original_quote": "如閏五",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L034",
      "original_quote": "六",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L035",
      "original_quote": "七",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L036",
      "original_quote": "八",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L037",
      "original_quote": "九月者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L038",
      "original_quote": "必閏芒種一氣之候",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L039",
      "original_quote": "所謂過猶不及者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L040",
      "original_quote": "不得中和之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L041",
      "original_quote": "而值閏也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L042",
      "original_quote": "總以甲己子午卯酉為上元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L043",
      "original_quote": "寅申巳亥為中元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L044",
      "original_quote": "辰戌丑未為下元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L045",
      "original_quote": "此定例也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L046",
      "original_quote": "又云：「節與氣同為中和」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L047",
      "original_quote": "中節之前甲己子午卯酉者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L048",
      "original_quote": "謂之過",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L049",
      "original_quote": "過則接氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L050",
      "original_quote": "中節之後見甲己子午卯酉者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L051",
      "original_quote": "謂之不及",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L052",
      "original_quote": "不及則超神總以三十舊本月令三十三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L053",
      "original_quote": "刪去三字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L054",
      "original_quote": "值月而值閏者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_ChaoShenJieQi_L055",
      "original_quote": "不過陰陽消長之道也",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan6",
    "section": "超神接氣訣",
