      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L281",
      "original_quote": "螣蛇含金憂口吻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L282",
      "original_quote": "忽然墜水生災非",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L283",
      "original_quote": "太陰課體或承羞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L284",
      "original_quote": "六白臨西陰謀忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L285",
      "original_quote": "勾陳卯位公事擾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L286",
      "original_quote": "到艮申庚門毀嗔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L287",
      "original_quote": "白虎驚柱銜刀可畏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L288",
      "original_quote": "朱雀杜景喧噪堪嫌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L289",
      "original_quote": "元武居乾不能終勢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L290",
      "original_quote": "九地杜死沒齒無聞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L291",
      "original_quote": "九天開雲龍變化",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L292",
      "original_quote": "甲乙春榮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L293",
      "original_quote": "丙丁夏盛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L294",
      "original_quote": "戊己四季",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L295",
      "original_quote": "庚辛旺秋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L296",
      "original_quote": "壬癸喜冬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L297",
      "original_quote": "此皆發達超群之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L298",
      "original_quote": "至若甲得己而中正可風",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L299",
      "original_quote": "乙遇庚而剛柔相濟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L300",
      "original_quote": "丙合辛而施威",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L301",
      "original_quote": "丁見壬而諂媚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L302",
      "original_quote": "戊癸剛決",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L303",
      "original_quote": "無緣宵小",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L304",
      "original_quote": "八宮互合靄靄吉人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L305",
      "original_quote": "各宮偏黨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L306",
      "original_quote": "硜硜鄙劣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L307",
      "original_quote": "合中帶刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L308",
      "original_quote": "美不足凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L309",
      "original_quote": "空吉寔樂有餘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L310",
      "original_quote": "從其相生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L311",
      "original_quote": "避其相剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L312",
      "original_quote": "年月日時參究",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L313",
      "original_quote": "旬得龍返首而事業順美",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L314",
      "original_quote": "鳥跌穴而聲名顯揚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L315",
      "original_quote": "得遁才堪權變",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L316",
      "original_quote": "逢詐自能斡旋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L317",
      "original_quote": "得使急外有助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L318",
      "original_quote": "守門出入亨通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L319",
      "original_quote": "五假機緣邁眾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L320",
      "original_quote": "三勝膽畧過人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L321",
      "original_quote": "夭矯而作事虛驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L322",
      "original_quote": "投江而文信遺失",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L323",
      "original_quote": "伏乾出遺財物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L324",
      "original_quote": "飛幹恃強自傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L325",
      "original_quote": "伏宮須防盜賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L326",
      "original_quote": "飛宮事業消亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L327",
      "original_quote": "大隔小隔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L328",
      "original_quote": "謀為不轉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L329",
      "original_quote": "刑格悖格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L330",
      "original_quote": "禍自內生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L331",
      "original_quote": "白入熒宜防外敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L332",
      "original_quote": "熒入白仇敵自亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L333",
      "original_quote": "龍逃防身災晦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L334",
      "original_quote": "虎狂恐物乖張",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L335",
      "original_quote": "五不遇舉事蹭蹬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L336",
      "original_quote": "羅網張出入宜防",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L337",
      "original_quote": "六儀擊刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L338",
      "original_quote": "凶災各別",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L339",
      "original_quote": "三奇入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L340",
      "original_quote": "圖謀不揚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L341",
      "original_quote": "反吟伏吟多啾唧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L342",
      "original_quote": "吉凶門迫果非祥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L343",
      "original_quote": "天馬吉門臨命上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L344",
      "original_quote": "策驥生方永無殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L345",
      "original_quote": "又訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L346",
      "original_quote": "凡占造化",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L347",
      "original_quote": "須看其本命行年屬何卦氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L348",
      "original_quote": "當令失令",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L349",
      "original_quote": "以斷其生平之吉凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L350",
      "original_quote": "次及本日干支之納",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L351",
      "original_quote": "正時干支之納",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L352",
      "original_quote": "生旺剋制何如",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L353",
      "original_quote": "以斷其目下事業興衰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L354",
      "original_quote": "值符起元何宮元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L355",
      "original_quote": "屬本宮何親",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L356",
      "original_quote": "今行何卦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L357",
      "original_quote": "旺相生剋何如",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L358",
      "original_quote": "其子入父垣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L359",
      "original_quote": "妾讓妻位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L360",
      "original_quote": "從中斟酌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L361",
      "original_quote": "自得消息",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L362",
      "original_quote": "再詳值使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L363",
      "original_quote": "以定眼前之作為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L364",
      "original_quote": "會合年命以觀其變化之神妙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L365",
      "original_quote": "如父占子則看兒舍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L366",
      "original_quote": "夫占妻則論妻神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L367",
      "original_quote": "遂得所值之星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L368",
      "original_quote": "以察其心事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L369",
      "original_quote": "人品",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L370",
      "original_quote": "更加詳於門戶開合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L371",
      "original_quote": "三甲陰陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_ShenMingZhan_L372",
      "original_quote": "自當得其玄妙矣",
      "tag": []
    }
  ],
