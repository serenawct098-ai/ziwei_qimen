  "entries": [
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L000",
      "original_quote": "占退役",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L001",
      "original_quote": "以開門為官長",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L002",
      "original_quote": "以日乾為退役之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L003",
      "original_quote": "若開門生日乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L004",
      "original_quote": "主官有眷戀之情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L005",
      "original_quote": "不准退",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L006",
      "original_quote": "開門剋日乾者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L007",
      "original_quote": "准退",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L008",
      "original_quote": "惹官怒責",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L009",
      "original_quote": "比和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L010",
      "original_quote": "准退",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L011",
      "original_quote": "又日干乘青龍逃走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L012",
      "original_quote": "熒入白者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L013",
      "original_quote": "必退",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L014",
      "original_quote": "若乘白入熒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L015",
      "original_quote": "虎猖狂者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L016",
      "original_quote": "不可退",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L017",
      "original_quote": "螣蛇妖矯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L018",
      "original_quote": "主驚恐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L019",
      "original_quote": "欲退不能",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L020",
      "original_quote": "若見大格與朱雀投江",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanTuiYi_L021",
      "original_quote": "必革",
      "tag": []
    }
