{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan22",
  "section": "八門吉凶詩訣",
  "entries": [
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L000",
      "original_quote": "八門吉凶詩訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L001",
      "original_quote": "休門一一原文九九氣盈室",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L002",
      "original_quote": "富貴子孫田土吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L003",
      "original_quote": "祭祀修營入宅基",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L004",
      "original_quote": "赴官遷徙事周悉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L005",
      "original_quote": "產招逃絕入興隆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L006",
      "original_quote": "北旺冬時數六一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L007",
      "original_quote": "南北婚姻有遠親",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L008",
      "original_quote": "送來六畜增官秩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L009",
      "original_quote": "生門八八氣盈星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L010",
      "original_quote": "凶煞皆降尊土精",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L011",
      "original_quote": "因待女財人寄物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L012",
      "original_quote": "從茲致富子孫興",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L013",
      "original_quote": "三年定有貴兒產",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L014",
      "original_quote": "出入外州泉貨盈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L015",
      "original_quote": "嫁娶種萌竝造作",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L016",
      "original_quote": "消災發福有奇靈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L017",
      "original_quote": "傷門氣短數三三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L018",
      "original_quote": "寅卯旺方音角間",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L019",
      "original_quote": "漁獵捕征搜索債",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L020",
      "original_quote": "更宜賭博追亡還",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L021",
      "original_quote": "官司口舌重喪至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L022",
      "original_quote": "六畜邅瘟火盜艱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L023",
      "original_quote": "夫婦血光災眼症",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L024",
      "original_quote": "三旬產厄禍力殘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L025",
      "original_quote": "刑名死以兼瘋疾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L026",
      "original_quote": "蛇虎傷人居不安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L027",
      "original_quote": "杜門四四星凶惡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L028",
      "original_quote": "木性時方寅卯泊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L029",
      "original_quote": "閉堤絕水事封培",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L030",
      "original_quote": "追邪伐盜竝勾捉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L031",
      "original_quote": "出亡逃難斷欲宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L032",
      "original_quote": "隱伏邀遮俱可托",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L033",
      "original_quote": "去佞遠藏埋閉藏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L034",
      "original_quote": "克絕陰私能久約",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L035",
      "original_quote": "用動似防盜賊侵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L036",
      "original_quote": "官刑財散瘟疫傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L037",
      "original_quote": "蛇傷雷打疥瘡濃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L038",
      "original_quote": "焚廩人亡家退落",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L039",
      "original_quote": "景門九九原文七七紫氣盈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L040",
      "original_quote": "巳午旺南寅戌結",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L041",
      "original_quote": "遣使上書能解危",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L042",
      "original_quote": "求謀修造訪尋謁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L043",
      "original_quote": "葬埋嫁娶吉中斗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L044",
      "original_quote": "給賞吏人如手捉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L045",
      "original_quote": "獻策求名墀陛親",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L046",
      "original_quote": "舉科文士藻文潔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L047",
      "original_quote": "死門二二凶星逆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L048",
      "original_quote": "戊己坤艮方位即",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L049",
      "original_quote": "穿獵漁網刑戳宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L050",
      "original_quote": "送喪吊死葬埋益",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L051",
      "original_quote": "修營妨長及平房",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L052",
      "original_quote": "忤逆重喪亡產憾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L053",
      "original_quote": "所求不利不宜行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L054",
      "original_quote": "動見敗亡官落職",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L055",
      "original_quote": "驚門無化氣為逆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L056",
      "original_quote": "旺在庚辛申酉地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L057",
      "original_quote": "羅網張疑立獄訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L058",
      "original_quote": "攻門刑擊一齊到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L059",
      "original_quote": "逃亡掩捕得功能",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L060",
      "original_quote": "市賈營修皆可忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L061",
      "original_quote": "致訟虛驚疾疫興",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L062",
      "original_quote": "敗囚軍賊牛羊斃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L063",
      "original_quote": "開門六六氣營奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L064",
      "original_quote": "謁貴求謀利有為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L065",
      "original_quote": "立宅扦修官職進",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L066",
      "original_quote": "外來財帛馬牛肥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L067",
      "original_quote": "蜂蜜窖冶橫財發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L068",
      "original_quote": "富盛子孫名利齊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L069",
      "original_quote": "金上庚辛秋月旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_8MenJiXiong_L070",
      "original_quote": "奴田畜產賈商宜",
      "tag": []
    }
