{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan16",
  "section": "地私門",
  "entries": [
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L000",
      "original_quote": "地私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L001",
      "original_quote": "以天月將加用時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L002",
      "original_quote": "看貴神所泊何宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L003",
      "original_quote": "即於貴神上起貴神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L004",
      "original_quote": "螣蛇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L005",
      "original_quote": "朱雀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L006",
      "original_quote": "六合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L007",
      "original_quote": "勾陳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L008",
      "original_quote": "青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L009",
      "original_quote": "天空",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L010",
      "original_quote": "白虎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L011",
      "original_quote": "太常",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L012",
      "original_quote": "元武",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L013",
      "original_quote": "太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L014",
      "original_quote": "天後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L015",
      "original_quote": "順逆而行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L016",
      "original_quote": "陽貴神出於先天之坤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L017",
      "original_quote": "子上起甲乾順布",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L018",
      "original_quote": "乙癸在丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L019",
      "original_quote": "庚與乙合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L020",
      "original_quote": "戊與癸合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L021",
      "original_quote": "取乾德為貴神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L022",
      "original_quote": "故庚戊二干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L023",
      "original_quote": "陽貴神在醜也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L024",
      "original_quote": "己乾在未",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L025",
      "original_quote": "甲與己合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L026",
      "original_quote": "故甲乾陽貴神在未也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L027",
      "original_quote": "自亥至辰為陽貴順流",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L028",
      "original_quote": "自巳至戌為陰貴逆行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L029",
      "original_quote": "若得太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L030",
      "original_quote": "太常",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L031",
      "original_quote": "六合之神與奇門同臨其方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L032",
      "original_quote": "百事大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L033",
      "original_quote": "陽時宜擊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L034",
      "original_quote": "陰時宜陜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L035",
      "original_quote": "陽先舉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L036",
      "original_quote": "陰後應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L037",
      "original_quote": "凡欲擊者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L038",
      "original_quote": "謂破而擊之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L039",
      "original_quote": "陜者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L040",
      "original_quote": "密而去之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L041",
      "original_quote": "其敗軍宜向六合下走得出也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L042",
      "original_quote": "以六合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L043",
      "original_quote": "太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L044",
      "original_quote": "太常三辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L045",
      "original_quote": "依圖推看何方日支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L046",
      "original_quote": "自子至巳為陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L047",
      "original_quote": "用陽貴神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L048",
      "original_quote": "自午至亥為陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L049",
      "original_quote": "用陰貴神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L050",
      "original_quote": "假如丁亥日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L051",
      "original_quote": "亥為陽日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L052",
      "original_quote": "丙丁豬雞位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L053",
      "original_quote": "則亥豬為陽日貴神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L054",
      "original_quote": "須將貴神加亥上順數去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L055",
      "original_quote": "卻是六合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L056",
      "original_quote": "太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L057",
      "original_quote": "太常在何處?即是地私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L058",
      "original_quote": "只是論日不論時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L059",
      "original_quote": "然須得奇門方可用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L060",
      "original_quote": "又一例",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L061",
      "original_quote": "審太陽過宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L062",
      "original_quote": "以月將加用時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L063",
      "original_quote": "尋本日貴人起星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L064",
      "original_quote": "求地私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L065",
      "original_quote": "如正月亥加甲日辰時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L066",
      "original_quote": "即以亥加辰順數去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L067",
      "original_quote": "尋本日陽貴未到子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L068",
      "original_quote": "陽貴順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L069",
      "original_quote": "則螣蛇在丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L070",
      "original_quote": "朱雀在寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L071",
      "original_quote": "六合在卯為地私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L072",
      "original_quote": "勾陳在辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L073",
      "original_quote": "青龍在巳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L074",
      "original_quote": "天空在午",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L075",
      "original_quote": "白虎在未",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L076",
      "original_quote": "太常在申為地私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L077",
      "original_quote": "玄武在酉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L078",
      "original_quote": "太陰在戌為地私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L079",
      "original_quote": "天后在亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L080",
      "original_quote": "如用陰貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L081",
      "original_quote": "亦以亥加辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L082",
      "original_quote": "陰貴丑到午",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L083",
      "original_quote": "陰貴逆行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L084",
      "original_quote": "則螣蛇在巳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L085",
      "original_quote": "朱雀在辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L086",
      "original_quote": "六合在卯為地私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L087",
      "original_quote": "勾陳在寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L088",
      "original_quote": "青龍在丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L089",
      "original_quote": "天空在子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L090",
      "original_quote": "白虎在亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L091",
      "original_quote": "太常在戌為地私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L092",
      "original_quote": "元武在酉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L093",
      "original_quote": "太陰在申為地私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L094",
      "original_quote": "天后在未",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan16_DiSiMen_L095",
      "original_quote": "餘皆仿此",
      "tag": []
    }
  ],
