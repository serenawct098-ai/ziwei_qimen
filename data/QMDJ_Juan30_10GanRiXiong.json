{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "十干日凶時",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L000",
      "original_quote": "十干日凶時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L001",
      "original_quote": "十干日凶時一名五不遇時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L002",
      "original_quote": "六壬遁甲專征伐云：五不遇時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L003",
      "original_quote": "陰陽交會",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L004",
      "original_quote": "干天庭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L005",
      "original_quote": "時幹剋日乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L006",
      "original_quote": "動必有災",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L007",
      "original_quote": "公歌曰：五不遇時豈知難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L008",
      "original_quote": "定為時幹剋日乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L009",
      "original_quote": "縱有奇門皆不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L010",
      "original_quote": "損其日月不堪觀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L011",
      "original_quote": "遁甲三奇乙丙丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L012",
      "original_quote": "若合開休生三吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L013",
      "original_quote": "門倘忌五不遇時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L014",
      "original_quote": "凡興兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L015",
      "original_quote": "除授",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L016",
      "original_quote": "上官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L017",
      "original_quote": "遠行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L018",
      "original_quote": "造作",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L019",
      "original_quote": "百事不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L020",
      "original_quote": "切宜避忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L021",
      "original_quote": "假如",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L022",
      "original_quote": "甲日午未時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L023",
      "original_quote": "時幹庚辛金剋日乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L024",
      "original_quote": "中甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_10GanRiXiong_L025",
      "original_quote": "餘仿此",
      "tag": []
    }
  ],
