  "entries": [
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L000",
      "original_quote": "原夫紫微帝座,⽣為厚重之容｡天府尊星,也作純和之體｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第54行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L001",
      "original_quote": "⾦烏圓滿,⽟免清奇｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第55行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L002",
      "original_quote": "天機為不長不短之姿,情懷好善｡武曲乃⾄要⾄緊之操,⼼性果決｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第56行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L003",
      "original_quote": "天同肥滿,⽬秀清奇｡廉貞眉寬,⼝闊⾯橫,為⼈性暴,好忿好爭｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第57行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L004",
      "original_quote": "貪狼為善惡之星,入廟必應長聳,出垣必定頑囂｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第58行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L005",
      "original_quote": "巨⾨乃是非之曜,在廟敦厚溫良｡天相精神,天梁穩重,⼼事⽟潔",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第59行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L006",
      "original_quote": "冰清｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第60行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L007",
      "original_quote": "七殺如⼦路暴虎馮河,火鈴似豫讓吞裝啞｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第61行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L008",
      "original_quote": "暴虎馮河兮⽬太凶狠,吞𡷫裝啞兮暗狼聲沉｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第62行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L009",
      "original_quote": "俊雅⽂昌眉清⽬秀,磊落⽂曲⼝⾆便佞,在廟定⽣異痣,失陷必有",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第63行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L010",
      "original_quote": "班痕｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第64行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L011",
      "original_quote": "左輔右弼溫良規模,端莊⾼⼠｡天魁天鉞具⾜威儀,重合三台則⼗",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第65行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L012",
      "original_quote": "全模範｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第66行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L013",
      "original_quote": "擎⽺陀羅,形醜貌粗,有矯詐體態｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第67行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L014",
      "original_quote": "破軍不仁,背重眉寬,⾏坐腰斜奸詐好⾏驚險｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第68行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L015",
      "original_quote": "性貌如春和藹,乃是祿存之情德｡情懷似火鋒衝,此誠破耗之威權｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第69行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L016",
      "original_quote": "星論廟旺最怕空亡,殺落空亡竟無威⼒｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第70行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L017",
      "original_quote": "權祿乃九竅之奇,耗積散平⽣之福｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第71行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L018",
      "original_quote": "祿逢梁蔭抱私財益與他⼈,耗遇貪狼溪淫情於井底｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第72行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L019",
      "original_quote": "貪星入於⾺垣易善易惡,惡曜扶同善曜稟性不常｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第73行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L020",
      "original_quote": "財居空亡巴三覽四,⽂曲旺宮聞⼀知⼗｡暗合廉貞為貪濫之曹吏｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第74行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L021",
      "original_quote": "⾝命司數實奸盜之技兒,豬屠之流｡善祿定是奇⾼之藝細巧,伶俐",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第75行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L022",
      "original_quote": "之⼈｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第76行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L023",
      "original_quote": "男居⽣旺最要得地,女居死絕專看福德｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第77行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L024",
      "original_quote": "命最嫌立於敗位,財源卻怕逢空亡｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第78行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L025",
      "original_quote": "機刑殺蔭孤星論嗣續之宮加惡星忌耗,不為奇特｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第79行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L026",
      "original_quote": "陀耗囚之星守⽗⺟之纏,決然破祖刑傷｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第80行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L027",
      "original_quote": "兼之童格宜相,根基要察｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第81行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L028",
      "original_quote": "紫微肥滿,天府精神｡祿存祿主,也應厚重｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第82行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L029",
      "original_quote": "⽇⽉曲相同梁機昌皆為美俊之姿,乃是清奇之格,上長下短⽬秀眉",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第83行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L030",
      "original_quote": "清｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第84行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L031",
      "original_quote": "貪狼同武曲形⼩聲⾼⽽量⼤,天同如陀忌肥滿⽽⽬渺｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第85行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L032",
      "original_quote": "擎⽺⾝體遭傷,若遇火鈴巨暗必⽣異痣｡⼜值耗殺定主形醜貌粗｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第86行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L033",
      "original_quote": "若居死絕之限,童⼦乳哺徒勞其⼒,老者亦然壽終｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第87行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L034",
      "original_quote": "此數中之綱領,乃為星緯之機關｡玩味專精,以參⽞妙｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第88行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L035",
      "original_quote": "限有⾼低星尋喜怒,假如運限駁雜終有浮沉｡",
      "tag": [],
      "tag_reason": "",
      "paragraph_index": 0,
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_ref": "第89行"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L036",
      "original_quote": "如逢殺地更要推詳倘,遇空亡必須細察｡精研於此不患不神｡",
      "tag": [],
      "tag_reason": "",
