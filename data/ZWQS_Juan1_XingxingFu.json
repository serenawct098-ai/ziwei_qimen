{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "形性賦",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L000",
      "original_quote": "形性賦",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L001",
      "original_quote": "形性賦原夫紫微帝座,⽣為厚重之容｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L002",
      "original_quote": "天府尊星,也作純和之體｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L003",
      "original_quote": "⾦烏圓滿,⽟免清奇｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L004",
      "original_quote": "天機為不長不短之姿,情懷好善｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L005",
      "original_quote": "武曲乃⾄要⾄緊之操,⼼性果決｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L006",
      "original_quote": "天同肥滿,⽬秀清奇｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L007",
      "original_quote": "廉貞眉寬,⼝闊⾯橫,為⼈性暴,好忿好爭｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L008",
      "original_quote": "貪狼為善惡之星,入廟必應長聳,出垣必定頑囂｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L009",
      "original_quote": "巨⾨乃是非之曜,在廟敦厚溫良｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L010",
      "original_quote": "天相精神,天梁穩重,⼼事⽟潔冰清｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L011",
      "original_quote": "七殺如⼦路暴虎馮河,火鈴似豫讓吞裝啞｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L012",
      "original_quote": "暴虎馮河兮⽬太凶狠,吞𡷫裝啞兮暗狼聲沉｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L013",
      "original_quote": "俊雅⽂昌眉清⽬秀,磊落⽂曲⼝⾆便佞,在廟定⽣異痣,失陷必有班痕｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L014",
      "original_quote": "左輔右弼溫良規模,端莊⾼⼠｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L015",
      "original_quote": "天魁天鉞具⾜威儀,重合三台則⼗全模範｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L016",
      "original_quote": "擎⽺陀羅,形醜貌粗,有矯詐體態｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L017",
      "original_quote": "破軍不仁,背重眉寬,⾏坐腰斜奸詐好⾏驚險｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L018",
      "original_quote": "性貌如春和藹,乃是祿存之情德｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L019",
      "original_quote": "情懷似火鋒衝,此誠破耗之威權｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L020",
      "original_quote": "星論廟旺最怕空亡,殺落空亡竟無威⼒｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L021",
      "original_quote": "權祿乃九竅之奇,耗積散平⽣之福｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L022",
      "original_quote": "祿逢梁蔭抱私財益與他⼈,耗遇貪狼溪淫情於井底｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L023",
      "original_quote": "貪星入於⾺垣易善易惡,惡曜扶同善曜稟性不常｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L024",
      "original_quote": "財居空亡巴三覽四,⽂曲旺宮聞⼀知⼗｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L025",
      "original_quote": "暗合廉貞為貪濫之曹吏｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L026",
      "original_quote": "⾝命司數實奸盜之技兒,豬屠之流｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L027",
      "original_quote": "善祿定是奇⾼之藝細巧,伶俐之⼈｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L028",
      "original_quote": "男居⽣旺最要得地,女居死絕專看福德｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L029",
      "original_quote": "命最嫌立於敗位,財源卻怕逢空亡｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L030",
      "original_quote": "機刑殺蔭孤星論嗣續之宮加惡星忌耗,不為奇特｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L031",
      "original_quote": "陀耗囚之星守⽗⺟之纏,決然破祖刑傷｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L032",
      "original_quote": "兼之童格宜相,根基要察｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L033",
      "original_quote": "紫微肥滿,天府精神｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L034",
      "original_quote": "祿存祿主,也應厚重｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L035",
      "original_quote": "⽇⽉曲相同梁機昌皆為美俊之姿,乃是清奇之格,上長下短⽬秀眉清｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L036",
      "original_quote": "貪狼同武曲形⼩聲⾼⽽量⼤,天同如陀忌肥滿⽽⽬渺｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L037",
      "original_quote": "擎⽺⾝體遭傷,若遇火鈴巨暗必⽣異痣｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L038",
      "original_quote": "⼜值耗殺定主形醜貌粗｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L039",
      "original_quote": "若居死絕之限,童⼦乳哺徒勞其⼒,老者亦然壽終｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L040",
      "original_quote": "此數中之綱領,乃為星緯之機關｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L041",
      "original_quote": "玩味專精,以參⽞妙｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L042",
      "original_quote": "限有⾼低星尋喜怒,假如運限駁雜終有浮沉｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L043",
      "original_quote": "如逢殺地更要推詳倘,遇空亡必須細察｡",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L044",
      "original_quote": "精研於此不患不神｡",
      "tag": []
    }
  ],
