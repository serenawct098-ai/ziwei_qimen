{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "形性賦",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L001",
      "original_quote": "原夫紫微帝座，生為厚重之容。天府尊星，也作純和之體。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L002",
      "original_quote": "金烏圓滿，玉兔清奇。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L003",
      "original_quote": "天機為不長不短之姿，情懷好善。武曲乃至要至緊之操，心性果決。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L004",
      "original_quote": "天同肥滿，目秀清奇。廉貞眉寬，口闊面橫，為人性暴，好忿好爭。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L005",
      "original_quote": "貪狼為善惡之星，入廟必應長聳，出垣必定頑囂。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L006",
      "original_quote": "巨門乃是非之曜，在廟敦厚溫良。天相精神，天梁穩重，心事玉潔冰清。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L007",
      "original_quote": "七殺如子路暴虎馮河，火鈴似豫讓吞炭裝啞。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L008",
      "original_quote": "暴虎馮河兮目太凶狠，吞炭裝啞兮暗狼聲沉。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L009",
      "original_quote": "俊雅文昌眉清目秀，磊落文曲口舌便佞，在廟定生異痣，失陷必有班痕。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L010",
      "original_quote": "左輔右弼溫良規模，端莊高士。天魁天鉞具足威儀，重合三台則十全模範。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L011",
      "original_quote": "擎羊陀羅，形醜貌粗，有矯詐體態。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L012",
      "original_quote": "破軍不仁，背重眉寬，行坐腰斜奸詐好行驚險。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L012",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L013",
      "original_quote": "性貌如春和藹，乃是祿存之情德。情懷似火鋒衝，此誠破耗之威權。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L013",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L014",
      "original_quote": "星論廟旺最怕空亡，殺落空亡竟無威力。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L014",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L015",
      "original_quote": "權祿乃九竅之奇，耗積散平生之福。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L015",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L016",
      "original_quote": "祿逢梁蔭抱私財益與他人，耗遇貪狼溪淫情於井底。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L016",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L017",
      "original_quote": "貪星入於馬垣易善易惡，惡曜扶同善曜稟性不常。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L017",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L018",
      "original_quote": "財居空亡巴三覽四，文曲旺宮聞一知十。暗合廉貞為貪濫之曹吏。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L018",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L019",
      "original_quote": "身命司數實奸盜之技兒，豬屠之流。善祿定是奇高之藝細巧，伶俐之人。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L019",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L020",
      "original_quote": "男居生旺最要得地，女居死絕專看福德。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L020",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L021",
      "original_quote": "命最嫌立於敗位，財源卻怕逢空亡。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L021",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L022",
      "original_quote": "機刑殺蔭孤星論嗣續之宮加惡星忌耗，不為奇特。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L022",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L023",
      "original_quote": "陀耗囚之星守父母之纏，決然破祖刑傷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L023",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L024",
      "original_quote": "兼之童格宜相，根基要察。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L024",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L025",
      "original_quote": "紫微肥滿，天府精神。祿存祿主，也應厚重。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L025",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L026",
      "original_quote": "日月曲相同梁機昌皆為美俊之姿，乃是清奇之格，上長下短目秀眉清。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L026",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L027",
      "original_quote": "貪狼同武曲形小聲高而量大，天同如陀忌肥滿而目渺。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L027",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L028",
      "original_quote": "擎羊身體遭傷，若遇火鈴巨暗必生異痣。又值耗殺定主形醜貌粗。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L028",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L029",
      "original_quote": "若居死絕之限，童子乳哺徒勞其力，老者亦然壽終。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L029",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L030",
      "original_quote": "此數中之綱領，乃為星緯之機關。玩味專精，以參玄妙。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L030",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L031",
      "original_quote": "限有高低星尋喜怒，假如運限駁雜終有浮沉。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L031",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_XingxingFu_L032",
      "original_quote": "如逢殺地更要推詳倘，遇空亡必須細察。精研於此不患不神。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "形性賦",
        "line_id": "ZWQS_Juan1_XingxingFu_L032",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "形性賦全文完成，已根據正確語義斷句"
}