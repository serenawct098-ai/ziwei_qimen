    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L001",
      "original_quote": "占訪友",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L002",
      "original_quote": "大凡奇門用事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L003",
      "original_quote": "專擇方向與時耳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L004",
      "original_quote": "如我欲訪友尋人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L005",
      "original_quote": "以所往之方地盤為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L006",
      "original_quote": "天盤為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L007",
      "original_quote": "主客要相生合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L008",
      "original_quote": "又得吉門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L009",
      "original_quote": "吉星必相遷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L010",
      "original_quote": "若門凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L011",
      "original_quote": "上下兩盤又相剋制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L012",
      "original_quote": "則不遷也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L013",
      "original_quote": "庚為年月日時格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiaoYi_L014",
      "original_quote": "值此亦不遷也",
      "tag": []
    }
