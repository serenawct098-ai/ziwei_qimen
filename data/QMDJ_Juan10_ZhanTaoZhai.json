{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan10",
  "section": "占討債",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L000",
      "original_quote": "占討債",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L001",
      "original_quote": "以天乙所落之宮為欠債之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L002",
      "original_quote": "以勾陳落宮為使討之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L003",
      "original_quote": "勾陳落宮剋天乙落宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L004",
      "original_quote": "其人實心去討",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L005",
      "original_quote": "天乙落宮剋勾陳宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L006",
      "original_quote": "所使之人畏彼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L007",
      "original_quote": "不敢討",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L008",
      "original_quote": "勾陳與天乙相生和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L009",
      "original_quote": "彼此通同",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L010",
      "original_quote": "不討",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L011",
      "original_quote": "勾陳被天乙生者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L012",
      "original_quote": "主囑托賄賂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L013",
      "original_quote": "所使之人不肯討",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L014",
      "original_quote": "天乙落宮得旺相氣來生值符者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L015",
      "original_quote": "必還",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L016",
      "original_quote": "若落空亡來生值符可知值符為放債之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L017",
      "original_quote": "者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L018",
      "original_quote": "有心無力",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L019",
      "original_quote": "天蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L020",
      "original_quote": "天乙落宮剋制值符宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L021",
      "original_quote": "安心不環",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanTaoZhai_L022",
      "original_quote": "必不能討",
      "tag": []
    }
  ],
