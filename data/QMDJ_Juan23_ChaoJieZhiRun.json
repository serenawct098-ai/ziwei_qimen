{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan23",
  "section": "超神接氣置閏訣",
  "entries": [
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L000",
      "original_quote": "超神接氣置閏訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L001",
      "original_quote": "閏奇自有玄妙訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L002",
      "original_quote": "以時置閏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L003",
      "original_quote": "神仙不肯說分明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L004",
      "original_quote": "冬夏二至前起閏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L005",
      "original_quote": "凡一月節氣以三十日零五時二刻為准",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L006",
      "original_quote": "以三十日分六局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L007",
      "original_quote": "以餘五時二刻置閏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L008",
      "original_quote": "遇芒種",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L009",
      "original_quote": "大雪超過九日便當置閏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L010",
      "original_quote": "大概五日一元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L011",
      "original_quote": "一日十二時也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L012",
      "original_quote": "甲己二字號符頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L013",
      "original_quote": "此甲己乃至要之訣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L014",
      "original_quote": "置閏以甲己二字為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L015",
      "original_quote": "假如甲己之符先到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L016",
      "original_quote": "謂之超",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L017",
      "original_quote": "甲己之符未到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L018",
      "original_quote": "謂之接",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L019",
      "original_quote": "甲己與節同到",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L020",
      "original_quote": "謂之正授",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L021",
      "original_quote": "子午卯酉上局設",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L022",
      "original_quote": "子午卯酉為上局也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L023",
      "original_quote": "寅申巳亥中局求",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L024",
      "original_quote": "辰戌丑未下局截",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L025",
      "original_quote": "節通符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L026",
      "original_quote": "符遇節",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L027",
      "original_quote": "符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L028",
      "original_quote": "即甲己符頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L029",
      "original_quote": "節",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L030",
      "original_quote": "即節氣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L031",
      "original_quote": "萬兩黃金不輕說",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L032",
      "original_quote": "節前遇符便是超",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L033",
      "original_quote": "節後遇符便是接",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L034",
      "original_quote": "超神接氣若能明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L035",
      "original_quote": "便是三山雲外客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ChaoJieZhiRun_L036",
      "original_quote": "六甲利用",
      "tag": []
    }
  ],
