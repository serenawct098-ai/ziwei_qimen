      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L001",
      "original_quote": "以景門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L002",
      "original_quote": "丁奇為文章",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L003",
      "original_quote": "如歲干所乘之宮來生景門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L004",
      "original_quote": "丁奇之落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L005",
      "original_quote": "再得奇門吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L006",
      "original_quote": "必中鼎甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L007",
      "original_quote": "歲干落宮生景門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L008",
      "original_quote": "丁奇之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L009",
      "original_quote": "不得奇門吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L010",
      "original_quote": "必中二甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L011",
      "original_quote": "歲干落宮不生景門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L012",
      "original_quote": "丁奇之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L013",
      "original_quote": "自乘旺相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L014",
      "original_quote": "中三甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L015",
      "original_quote": "歲乾不生景門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L016",
      "original_quote": "丁奇之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L017",
      "original_quote": "又返吟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L018",
      "original_quote": "入墓者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L019",
      "original_quote": "不中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L020",
      "original_quote": "或剋歲干之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanDianShi_L021",
