{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan9",
  "section": "占童生應試",
  "entries": [
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L000",
      "original_quote": "占童生應試",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L001",
      "original_quote": "以天輔星為試官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L002",
      "original_quote": "丁奇為文章",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L003",
      "original_quote": "日乾為童生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L004",
      "original_quote": "丁奇得門來生年命日乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L005",
      "original_quote": "合吉門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L006",
      "original_quote": "吉格而得天輔來生者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L007",
      "original_quote": "必高取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L008",
      "original_quote": "或年命日乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L009",
      "original_quote": "丁奇合吉門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L010",
      "original_quote": "吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L011",
      "original_quote": "不得天輔來生者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L012",
      "original_quote": "亦取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L013",
      "original_quote": "丁奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L014",
      "original_quote": "年命日乾不得吉門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L015",
      "original_quote": "吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L016",
      "original_quote": "而被天輔來生者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L017",
      "original_quote": "主文憲施恩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L018",
      "original_quote": "不在文章好歹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L019",
      "original_quote": "亦取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L020",
      "original_quote": "若返吟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L021",
      "original_quote": "伏吟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L022",
      "original_quote": "入庫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L023",
      "original_quote": "主錄舊文",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L024",
      "original_quote": "不取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L025",
      "original_quote": "落空亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L026",
      "original_quote": "必不完篇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L027",
      "original_quote": "驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L028",
      "original_quote": "傷二門主文卷扯割",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L029",
      "original_quote": "休門乘凶神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L030",
      "original_quote": "凶格衝剋年命日乾者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanTongSheng_L031",
      "original_quote": "主文章塗污",
      "tag": []
    }
  ],
