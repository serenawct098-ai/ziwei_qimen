      }
    },
    {
      "line_id": "QMDJ_Juan17_P001_S000",
      "original_quote": "三奇到宮斷",
      "paragraph_index": 1,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1755行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P002_S000",
      "original_quote": "六乙到乾名曰「玉兔入天門」，吉。",
      "paragraph_index": 2,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1756行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P002_S001",
      "original_quote": "天衝、天輔加六宮，在季夏、秋月或庚辛酉申日，有白色氣來助，主勝。",
      "paragraph_index": 2,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1756行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P002_S002",
      "original_quote": "一名「玉兔入林」。",
      "paragraph_index": 2,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1756行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P003_S000",
      "original_quote": "六丙到乾名為「天成天權」，凶。",
      "paragraph_index": 3,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1757行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P003_S001",
      "original_quote": "有白雲氣從西北或西方來助，主勝。",
      "paragraph_index": 3,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1757行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P003_S002",
      "original_quote": "天英加六宮，在夏秋月有赤色雲氣來助，客勝。",
      "paragraph_index": 3,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1757行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P003_S003",
      "original_quote": "一名「光明不全」。",
      "paragraph_index": 3,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1757行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P004_S000",
      "original_quote": "六丁到乾名為「火到天門」，吉。",
      "paragraph_index": 4,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1758行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P004_S001",
      "original_quote": "丙丁巳午日有赤色雲氣從正南方來助，客勝。",
      "paragraph_index": 4,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1758行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P004_S002",
      "original_quote": "一名「玉女游天門」，又名「火照天門」。",
      "paragraph_index": 4,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1758行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P005_S000",
      "original_quote": "六乙到坎名為「玉兔投泉」，吉。",
      "paragraph_index": 5,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1759行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P005_S001",
      "original_quote": "天英加一宮在秋冬月或壬癸亥子日，有黑色雲氣從正北方來助，主勝。",
      "paragraph_index": 5,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1759行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P005_S002",
      "original_quote": "一名「玉兔飲泉」。",
      "paragraph_index": 5,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1759行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P006_S000",
      "original_quote": "六丙到坎名為「丙火燒壬」，吉，主勝。",
      "paragraph_index": 6,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1760行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P006_S001",
      "original_quote": "天任、天禽、天芮加一宮在四季月或辰戌丑未日，一名「火投水池」。",
      "paragraph_index": 6,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1760行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P007_S000",
      "original_quote": "六丁到坎名曰「朱雀投江」，中吉。",
      "paragraph_index": 7,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1761行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P007_S001",
      "original_quote": "有黃色雲氣從東北或西南方來助，客勝。",
      "paragraph_index": 7,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1761行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P008_S000",
      "original_quote": "六乙到艮名為「玉兔步貴」，吉。",
      "paragraph_index": 8,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1762行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P008_S001",
      "original_quote": "天蓬臨八宮，在四季月或戊己辰戌丑未日，有黃色雲氣來助，主勝。",
      "paragraph_index": 8,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1762行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P009_S000",
      "original_quote": "六丙到艮名為「鳳入丹山」，吉。",
      "paragraph_index": 9,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1763行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P009_S001",
      "original_quote": "有黃色雲氣從東北或西南方來助，主勝。",
      "paragraph_index": 9,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1763行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P009_S002",
      "original_quote": "天輔、天衝加八宮在冬春月。",
      "paragraph_index": 9,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1763行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P010_S000",
      "original_quote": "六丁到艮名為「玉女乘雲」，吉。",
      "paragraph_index": 10,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1764行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P010_S001",
      "original_quote": "甲乙寅卯日有青色雲氣從正東或東南方來助，客勝。",
      "paragraph_index": 10,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1764行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P010_S002",
      "original_quote": "一名「玉女游鬼門」。",
      "paragraph_index": 10,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1764行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P011_S000",
      "original_quote": "六乙到震名為「日出扶桑」，吉。",
      "paragraph_index": 11,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1765行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P011_S001",
      "original_quote": "天任、天禽、天芮臨三宮，在冬夏月或甲乙寅卯日，有青雲來助，主勝。",
      "paragraph_index": 11,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1765行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P011_S002",
      "original_quote": "即貴人升乙卯正殿。",
      "paragraph_index": 11,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1765行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P012_S000",
      "original_quote": "六丙到震名為「月入雷門」，吉。",
      "paragraph_index": 12,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1766行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P012_S001",
      "original_quote": "有雲氣從正東或東南方來助，主勝。",
      "paragraph_index": 12,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1766行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P012_S002",
      "original_quote": "天柱、天任加三宮，在季秋月天柱疑誤。",
      "paragraph_index": 12,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1766行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P013_S000",
      "original_quote": "六丁到震名曰「最明」，吉。",
      "paragraph_index": 13,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1767行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P013_S001",
      "original_quote": "庚辛申酉日有白雲氣從正西或西北方來助，客勝。",
      "paragraph_index": 13,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1767行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P014_S000",
      "original_quote": "六乙到巽名曰「玉兔乘風」，吉。",
      "paragraph_index": 14,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1768行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P014_S001",
      "original_quote": "天任、天禽、天芮臨四宮，在冬春月或甲乙寅卯日，有青色雲氣來助，主勝。",
      "paragraph_index": 14,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1768行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P015_S000",
      "original_quote": "六丙到巽名曰「火行風起」，又為「龍神助威」吉。",
      "paragraph_index": 15,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1769行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P015_S001",
      "original_quote": "東南方神旺，主勝。",
      "paragraph_index": 15,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1769行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P015_S002",
      "original_quote": "天心、天柱加四宮在季夏秋月。",
      "paragraph_index": 15,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1769行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P016_S000",
      "original_quote": "六丁到巽名曰「美女留神」吉。",
      "paragraph_index": 16,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1770行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P016_S001",
      "original_quote": "或庚辛申酉日，有白色雲氣從正西或西北方來助，客勝。",
      "paragraph_index": 16,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1770行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P017_S000",
      "original_quote": "六乙到離名曰「玉兔當陽」，吉。",
      "paragraph_index": 17,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1771行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P017_S001",
      "original_quote": "天柱、天心加九宮，在春夏月或丙丁巳午日，有赤色雲氣來助，主勝。",
      "paragraph_index": 17,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1771行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P018_S000",
      "original_quote": "六丙到離名曰「月照端門」，吉。",
      "paragraph_index": 18,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1772行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P018_S001",
      "original_quote": "有雲氣從正南方來助，主勝。",
      "paragraph_index": 18,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1772行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P018_S002",
      "original_quote": "天蓬加九宮，在秋月或壬癸日，即貴人升丙午正殿。",
      "paragraph_index": 18,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1772行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P019_S000",
      "original_quote": "六丁到離名曰「乘龍萬里」。",
      "paragraph_index": 19,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1773行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P019_S001",
      "original_quote": "壬癸亥子日，有黑色雲從正北方來助，客勝。",
      "paragraph_index": 19,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1773行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P020_S000",
      "original_quote": "六乙到坤名曰「玉兔入坤」，中吉。",
      "paragraph_index": 20,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1774行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P020_S001",
      "original_quote": "天蓬臨二宮在四季月或戊己辰戌丑未日，有黃色雲氣從北方來助，主勝。",
      "paragraph_index": 20,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1774行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P020_S002",
      "original_quote": "一名「玉兔暗日」。",
      "paragraph_index": 20,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1774行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P021_S000",
      "original_quote": "六丙到坤名曰「子居母舍」，吉。",
      "paragraph_index": 21,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1775行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P021_S001",
      "original_quote": "雲氣從西南方來助，主勝。",
      "paragraph_index": 21,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1775行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P021_S002",
      "original_quote": "天輔、天衝加二宮，在冬春月或甲日吉。",
      "paragraph_index": 21,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1775行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P022_S000",
      "original_quote": "六丁到坤名為「玉女游地」，吉。",
      "paragraph_index": 22,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1776行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P022_S001",
      "original_quote": "甲乙寅卯日有青色雲氣從正東或東南來助，客勝，大吉。",
      "paragraph_index": 22,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1776行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P022_S002",
      "original_quote": "一名「玉女游地戶」，吉。",
      "paragraph_index": 22,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1776行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P023_S000",
      "original_quote": "六乙到兌名為「玉女受制」，平平。",
      "paragraph_index": 23,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1777行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P023_S001",
      "original_quote": "天衝、天輔加七宮，在季夏、秋月或庚辛申酉日，有白色雲氣來助，主勝。",
      "paragraph_index": 23,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1777行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P023_S002",
      "original_quote": "一名「白兔游宮」，吉。",
      "paragraph_index": 23,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1777行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P024_S000",
      "original_quote": "六丙到兌名曰「鳳凰折翅」，凶。",
      "paragraph_index": 24,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1778行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P024_S001",
      "original_quote": "白雲氣從正西或西北方來助，主勝。",
      "paragraph_index": 24,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1778行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P024_S002",
      "original_quote": "天英加七宮在春夏月及丙日，客勝。",
      "paragraph_index": 24,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1778行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P025_S000",
      "original_quote": "六丁到兌，平平。",
      "paragraph_index": 25,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1779行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P025_S001",
      "original_quote": "丙丁巳午日，有赤雲氣從南方來助，客勝。",
      "paragraph_index": 25,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1779行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P025_S002",
      "original_quote": "一云：丁見兌為天乙貴人，即為貴升於丁酉正殿，大吉。",
      "paragraph_index": 25,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1779行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P026_S000",
      "original_quote": "遁甲利主以先至者為主，後至者為客",
      "paragraph_index": 26,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1780行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P027_S000",
      "original_quote": "天英加坎宮，利為主，加在秋冬月及壬、癸、亥、子日，有黑色雲從正北方來助，主大勝。",
      "paragraph_index": 27,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1781行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P028_S000",
      "original_quote": "天任、天禽、天芮加震、巽，利為主。",
      "paragraph_index": 28,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1782行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P028_S001",
      "original_quote": "如在春、夏之月，甲、乙、寅、卯日，青色雲氣從東南方及正東方來助，主大勝。",
      "paragraph_index": 28,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1782行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P029_S000",
      "original_quote": "天蓬加坤、艮，利為主。",
      "paragraph_index": 29,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1783行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P029_S001",
      "original_quote": "如在四季月及戊、己、辰、戌、丑、未日，有黃色雲氣從東北或西南方來助，主大勝。",
      "paragraph_index": 29,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1783行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P030_S000",
      "original_quote": "遁甲利客",
      "paragraph_index": 30,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1784行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P031_S000",
      "original_quote": "天蓬加九宮利為客，如在秋冬之月，壬、癸、亥、子日，有黑色雲氣自北方來助，客勝。",
      "paragraph_index": 31,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1785行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P032_S000",
      "original_quote": "天心、天柱加三、四宮利為客。",
      "paragraph_index": 32,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1786行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P032_S001",
      "original_quote": "如在三秋四季月，庚、辛、申、酉日，有白色雲氣從西方來助，客大勝。",
      "paragraph_index": 32,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1786行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P033_S000",
      "original_quote": "天任、天禽、天芮加一宮，利為客。",
      "paragraph_index": 33,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1787行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P033_S001",
      "original_quote": "如在四季月，戊、己、辰、戌、丑、未日，有黃色雲氣從西南或正南方來助者，客大勝。",
      "paragraph_index": 33,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1787行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P034_S000",
      "original_quote": "天輔、天衝加二、八宮利為客。",
      "paragraph_index": 34,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1788行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P034_S001",
      "original_quote": "如在冬、春月，甲、乙、寅、卯日，有青色雲氣自東方或東南方來助，客大勝。",
      "paragraph_index": 34,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1788行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P035_S000",
      "original_quote": "天英加六、七宮，利為客。",
      "paragraph_index": 35,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1789行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P035_S001",
      "original_quote": "如在春、夏月，丙、丁、巳、午日，有赤色雲氣從南方來助，客大勝。",
      "paragraph_index": 35,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1789行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P036_S000",
      "original_quote": "九星值時剋應",
      "paragraph_index": 36,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1790行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P037_S000",
      "original_quote": "論用時者，以九星管事為主。",
      "paragraph_index": 37,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1791行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P038_S000",
      "original_quote": "天蓬星值子時",
      "paragraph_index": 38,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1792行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P039_S000",
      "original_quote": "值子入宅凶，赴任、安營、鬥訟，生雞犬吠鳥鬧林，北方鵬爭缺唇人，六十日內雞生卵，退財時至訟必勝。",
      "paragraph_index": 39,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1793行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P040_S000",
      "original_quote": "天芮星值子時",
      "paragraph_index": 40,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1794行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P041_S000",
      "original_quote": "值子身旺興，作用之時主走禽驚，坤方火光二人應，嫁娶豬犬傷人訟，六十日內女自縊，秋冬進財羽音珍。",
      "paragraph_index": 41,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1795行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P042_S000",
      "original_quote": "天衝星值子時",
      "paragraph_index": 42,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1796行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P043_S000",
      "original_quote": "值子有風雨、禽噪、鐘鳴，造葬後六十日內怪物入，周年田產數倍收，更防新婦產後死，虎狼口內可得財。",
      "paragraph_index": 43,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1797行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P044_S000",
      "original_quote": "天輔星值子時",
      "paragraph_index": 44,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1798行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P045_S000",
      "original_quote": "值子若反吟，天中有物夜中鳴，西方紅白人叫應，造葬後來六十日，得進商音人產物，野猿入屋甑鳴時，加官進祿生貴子，若得門奇並到來，十二年中大旺矣。",
      "paragraph_index": 45,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1799行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P046_S000",
      "original_quote": "天禽星值子時",
      "paragraph_index": 46,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1800行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P047_S000",
      "original_quote": "值子孕婦至、紫衣人來，造葬後六十日雞犬銜花，儒人饋物武得官，田土財榖進益旺，二十年後人千丁。",
      "paragraph_index": 47,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1801行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P048_S000",
      "original_quote": "天心星值子時",
      "paragraph_index": 48,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1802行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P049_S000",
      "original_quote": "值子人爭鬪，西北鼓聲鬧喧喧，用後百日赤人媒，商人古器畫仙家，生白雞，十二年田蠶大旺，諸公連連。",
      "paragraph_index": 49,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1803行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P050_S000",
      "original_quote": "天柱星值子時",
      "paragraph_index": 50,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1804行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P051_S000",
      "original_quote": "值子起大風，火從東至缺唇人，用後六十日內事，蛇犬傷人逢刀刃，殺人血光財破散，幼女遭殃必定臨。",
      "paragraph_index": 51,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1805行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P052_S000",
      "original_quote": "天任星值子時",
      "paragraph_index": 52,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1806行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P053_S000",
      "original_quote": "值子東風雨，水畔鷄鳴為應驗，巽方人來持刀槍，造葬百日新婦離，三牙須人木姓至，由賴退產男女淫。",
      "paragraph_index": 53,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1807行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P054_S000",
      "original_quote": "天英星值子時",
      "paragraph_index": 54,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1808行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P055_S000",
      "original_quote": "值子乾鑼聲，三五人持火把焚，斧鉞伐木缺唇人，用後破家三年中，血光自刎傷人物，小兒至湯火坑中。",
      "paragraph_index": 55,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1809行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P056_S000",
      "original_quote": "天蓬星值醜時",
      "paragraph_index": 56,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1810行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P057_S000",
      "original_quote": "值丑雷電生，樹倒傷人被風雨，七日鷄生鵝子卵，犬至屋上小口傾，三年後有白頭牙，商進屋旺十年退。",
      "paragraph_index": 57,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1811行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P058_S000",
      "original_quote": "天芮星值醜時",
      "paragraph_index": 58,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1812行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P059_S000",
      "original_quote": "值丑作用時，乾地金鼓聲至此，造葬後七日龜出林，六十日內盜賊起，退財口舌官訟至，大姑屢次索奩禮。",
      "paragraph_index": 59,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1813行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P060_S000",
      "original_quote": "天衝星值醜時",
      "paragraph_index": 60,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1814行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P061_S000",
      "original_quote": "值丑雲霧昏，小兒成隊來上門，婦人執木至為應，烏貓白子拾古鏡，周年僧道進田契，發財生得貴子聰。",
      "paragraph_index": 61,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1815行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P062_S000",
      "original_quote": "天輔星值醜時",
      "paragraph_index": 62,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1816行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P063_S000",
      "original_quote": "值丑東方犬吠，有人持刀來戰對，用後白兔野鷄入，六十日內僧道饋，羽音巽來信契歸，周年添丁加官品。",
      "paragraph_index": 63,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1817行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P064_S000",
      "original_quote": "天禽星值醜時",
      "paragraph_index": 64,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1818行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P065_S000",
      "original_quote": "值丑孝婦來，手持錫器為葬埋，小兒吹笛笑拍手，鼓鬧後進賭博財，獲得寶誥年後拾，得賊財富旺皆來。",
      "paragraph_index": 65,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1819行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P066_S000",
      "original_quote": "天心星值醜時",
      "paragraph_index": 66,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1820行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P067_S000",
      "original_quote": "值丑作用時，南方火光跛足人，五日內有貓成雙，四十日內遠物至，商音進書並財帛，官中更出有壽人。",
      "paragraph_index": 67,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1821行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P068_S000",
      "original_quote": "天柱星值醜時",
      "paragraph_index": 68,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1822行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P069_S000",
      "original_quote": "值丑匠北來，手攜斧斤樹上材，生得金花為後應，造葬六十日進財，羽音金器三年後，火光如洗人弄蛇。",
      "paragraph_index": 69,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1823行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P070_S000",
      "original_quote": "天任星值醜時",
      "paragraph_index": 70,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1824行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P071_S000",
      "original_quote": "值醜婦青衣，攜酒必然有跛聲，半載後進無名財，周年鸚鵡入屋來，口舌得財三年後，貓狗相咬主請舉。",
      "paragraph_index": 71,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1825行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P072_S000",
      "original_quote": "天英星值醜時",
      "paragraph_index": 72,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1826行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P073_S000",
      "original_quote": "值丑東北來，師巫鳴鑼至此寨，用後一月火燒屋，周年有大作人言，百怪起時可移鎮，不然定是死亡連。",
      "paragraph_index": 73,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1827行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P074_S000",
      "original_quote": "天蓬星值寅時",
      "paragraph_index": 74,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1828行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P075_S000",
      "original_quote": "值寅作用時，青衣童子持花枝，北方僧人包頭巾，女人穿著衫裙臨，賊劫蛇咬馬傷人，三年田地財旺臨。",
      "paragraph_index": 75,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1829行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P076_S000",
      "original_quote": "天芮星值寅時",
      "paragraph_index": 76,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1830行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P077_S000",
      "original_quote": "值寅瘦孕婦至，蓑衣臨門樂器音，奇門旺相六十日，水牛入屋進血財，加官進祿子孫，宿臨時乾在刻栽。",
      "paragraph_index": 77,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1831行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P078_S000",
      "original_quote": "天衝星值寅時",
      "paragraph_index": 78,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1832行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P079_S000",
      "original_quote": "值寅貴乘轎，童執金銀器物到，二十日進角音契，羽音作牙畜玩入，六十母鷄啼主死，陰乾人福發財凶。",
      "paragraph_index": 79,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1833行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P080_S000",
      "original_quote": "天輔星值寅時",
      "paragraph_index": 80,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1834行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P081_S000",
      "original_quote": "值寅見公吏，執鐵藝攜物至，六十日內貓咬鷄，有賊送財報恩義，赤面作牙，羽音，十二年發生貴子。",
      "paragraph_index": 81,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1835行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P082_S000",
      "original_quote": "天禽星值寅時",
      "paragraph_index": 82,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1836行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P083_S000",
      "original_quote": "值寅玉犬吠金鷄亂鳴，人帶笠，用後六十日便喜，宮商進契添人丁，田蠶大旺享富貴，宿旺立時有應情。",
      "paragraph_index": 83,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1837行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P084_S000",
      "original_quote": "天心星值寅時",
      "paragraph_index": 84,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1838行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P085_S000",
      "original_quote": "值寅白鷺到，金鼓四鳴水鏡曉，女穿黃赤攜籃過，小口火焰六十交，百日窖金商羽物，三年妻生貴得財。",
      "paragraph_index": 85,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1839行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P086_S000",
      "original_quote": "天柱星值寅時",
      "paragraph_index": 86,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1840行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P087_S000",
      "original_quote": "值寅北喧鬧，僧道持蓋雷雨到，喜得鐘鼓鳴以後，六十日內賊牽連，爭訟破財事已可，女人墮胎產中亡。",
      "paragraph_index": 87,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1841行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P088_S000",
      "original_quote": "天任星值寅時",
      "paragraph_index": 88,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1842行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P089_S000",
      "original_quote": "值寅女家隊火把前行，童子拍手，轎馬西北來，葬後六十日內甑鳴，墜婦死，百日進畜財田旺，缺唇人爭婚敗。",
      "paragraph_index": 89,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1843行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P090_S000",
      "original_quote": "天英星值寅時",
      "paragraph_index": 90,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1844行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P091_S000",
      "original_quote": "值寅東方軍馬，捕獵網魚手執至，用後女人拾得財，六十日內有暗喜，寡婦送到田地契，百日雷打屋即敗。",
      "paragraph_index": 91,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1845行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P092_S000",
      "original_quote": "天蓬星值卯時",
      "paragraph_index": 92,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1846行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P093_S000",
      "original_quote": "值卯黃雲起，婦人烹飪把火至，七日角音相邀請，半月徵音送財禮，六十女人進寶物，百日窖中多見喜。",
      "paragraph_index": 93,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1847行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P094_S000",
      "original_quote": "天芮星值卯時",
      "paragraph_index": 94,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1848行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P095_S000",
      "original_quote": "值卯婦人穿紅送財物，貴人馬至犬爭吠，水牛作聲這葬後，六十日進東絕屋，二年婦胎墮血死。",
      "paragraph_index": 95,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷十七",
        "section": "卷十七",
        "line_ref": "第1849行"
      }
    },
    {
      "line_id": "QMDJ_Juan17_P096_S000",
