  "section": "占入山訪道",
  "entries": [
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L000",
      "original_quote": "占入山訪道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L001",
      "original_quote": "以天芮為訪道之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L002",
      "original_quote": "天輔為傳道之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L003",
      "original_quote": "若天輔得奇門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L004",
      "original_quote": "吉格來生天芮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L005",
      "original_quote": "得高人傳授",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L006",
      "original_quote": "相比和者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L007",
      "original_quote": "空見人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L008",
      "original_quote": "不傳道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L009",
      "original_quote": "相剋者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L010",
      "original_quote": "不能見人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L011",
      "original_quote": "惟推陽日得僧道傳道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanFangDao_L012",
      "original_quote": "陰日得羽士傳道",
      "tag": []
    }
  ],
