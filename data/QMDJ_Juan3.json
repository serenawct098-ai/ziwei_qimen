{
  "text": "奇門遁甲秘笈大全",
  "juan": "上卷·卷三",
  "section": "卷三",
  "entries": [
    {
      "line_id": "QMDJ_Juan3_P000_S000",
      "original_quote": "《卷三》",
      "paragraph_index": 0,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第334行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P001_S000",
      "original_quote": "天輔星",
      "paragraph_index": 1,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第335行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P002_S000",
      "original_quote": "天輔之星遠行良，修造埋葬福綿長，上官移徙皆吉利，喜溢人財百事昌。",
      "paragraph_index": 2,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第336行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P003_S000",
      "original_quote": "天輔值子時，主西方著紅衣大叫前來為應。",
      "paragraph_index": 3,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第337行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P003_S001",
      "original_quote": "作用後六十日進商音人財物、猴入室、寶瓶鳴，主加官進職、生貴子，十二年興旺吉。",
      "paragraph_index": 3,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第337行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P004_S000",
      "original_quote": "原文缺值醜時，作用時主東方有犬吠，有人持刀殺人鬪叫。",
      "paragraph_index": 4,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第338行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P004_S001",
      "original_quote": "造葬後有白兔野鷄入室，六十日內僧道送物，及東南方羽音人送文契至、遠行信歸、周年添進人口、大旺血財、加官進祿。",
      "paragraph_index": 4,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第338行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P004_S002",
      "original_quote": "《遁甲演義》",
      "paragraph_index": 4,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第338行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P005_S000",
      "original_quote": "值寅時，有公吏人持鐵器至，及藝人送物來為應。",
      "paragraph_index": 5,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第339行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P005_S001",
      "original_quote": "六十日內進田契，十一年生貴子大發。",
      "paragraph_index": 5,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第339行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P006_S000",
      "original_quote": "值卯時，有女人持傘至，及師巫吹角聲為應。",
      "paragraph_index": 6,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第340行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P006_S001",
      "original_quote": "六十日內發財、添丁，有生氣物，家旺財榖，因女人公事進田地財產。",
      "paragraph_index": 6,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第340行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P007_S000",
      "original_quote": "值辰時，白羊與黃犬相鬪，賣菜人與賣油人相撞，白衣小兒啼哭、孕婦至為應。",
      "paragraph_index": 7,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第341行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P007_S001",
      "original_quote": "一年內生貴子，財產大發。",
      "paragraph_index": 7,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第341行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P008_S000",
      "original_quote": "值巳時，有二人相打，女人抱布衣，風四起、小兒啼哭。",
      "paragraph_index": 8,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第342行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P008_S001",
      "original_quote": "六十日進東財產，鬼神運來大發。",
      "paragraph_index": 8,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第342行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P009_S000",
      "original_quote": "值午時，有僧拿物，女人著紅衣過為應。",
      "paragraph_index": 9,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第343行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P009_S001",
      "original_quote": "六十日有貴人送異物，進四方金銀，一年內得寡婦財產大發。",
      "paragraph_index": 9,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第343行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P010_S000",
      "original_quote": "值未時，主二畜相觸，有人攜皮毛至，僧道成群過為應。",
      "paragraph_index": 10,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第344行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P010_S001",
      "original_quote": "作用後西北方人爭財，百日內進財物、文契。",
      "paragraph_index": 10,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第344行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P011_S000",
      "original_quote": "值申時，有患足人攜酒至，三色衣人來，西北方鼓聲鳴為應。",
      "paragraph_index": 11,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第345行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P011_S001",
      "original_quote": "作用後半年內蛇從井中出，白衣人送牛羊至，得婦人財發。",
      "paragraph_index": 11,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第345行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P012_S000",
      "original_quote": "值酉時，主有遠方人書信至，東方人言狐狸或有人喊叫為應，女人拿火至，後三年內生貴子，橫發財產。",
      "paragraph_index": 12,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第346行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P013_S000",
      "original_quote": "值戌時，主有三、五人來尋物，師巫對行為應，六十日鷄上樹鳴、遠信至、得婦人財，小兒被牛傷，一年內驗之。",
      "paragraph_index": 13,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第347行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P014_S000",
      "original_quote": "值亥時，主有跛足人至，青衣人來，東北方人家火光為應。",
      "paragraph_index": 14,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第348行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P014_S001",
      "original_quote": "作用後百日內貓捕白鼠，一年內進田產。",
      "paragraph_index": 14,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第348行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P015_S000",
      "original_quote": "天禽星",
      "paragraph_index": 15,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第349行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P016_S000",
      "original_quote": "天禽遠行偏得利，坐賈行商皆稱意，投謁貴人俱益懷，修造埋葬都豐裕。",
      "paragraph_index": 16,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第350行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P017_S000",
      "original_quote": "天禽值子時，主有孕婦來，紫衣人至為應。",
      "paragraph_index": 17,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第351行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P017_S001",
      "original_quote": "作用後五十日有文人送物，三年內因武得官，二十年外財榖廣益，人丁千口財旺。",
      "paragraph_index": 17,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第351行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P018_S000",
      "original_quote": "值醜時，主孝婦拿錫器來，小兒拍掌、吹哨、打鼓、喊叫為應。",
      "paragraph_index": 18,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第352行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P018_S001",
      "original_quote": "作用後因賭戲得財，或開窖得財，三年內得盜賊財，發家致富。",
      "paragraph_index": 18,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第352行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P019_S000",
      "original_quote": "值寅時，主鷄鳴犬吠，道人戴棕笠至為應。",
      "paragraph_index": 19,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第353行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P019_S001",
      "original_quote": "作用後進羽音人田契、人丁發旺。",
      "paragraph_index": 19,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第353行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P020_S000",
      "original_quote": "值卯時，主有大風東起、禽鳥四叫、孕婦至為應。",
      "paragraph_index": 20,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第354行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P020_S001",
      "original_quote": "作用後半年內得橫財起家。",
      "paragraph_index": 20,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第354行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P021_S000",
      "original_quote": "值辰時，主九流人相爭叫，東方烏鴉鳴為應。",
      "paragraph_index": 21,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第355行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P021_S001",
      "original_quote": "作用後六十日有僧道及孤獨人送物來。",
      "paragraph_index": 21,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第355行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P022_S000",
      "original_quote": "值巳時，主有白項鴉成群飛來，及師巫相打，貴人騎馬過為應。",
      "paragraph_index": 22,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第356行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P022_S001",
      "original_quote": "作用後七十日內主婦人生貴子，成家，田產大旺。",
      "paragraph_index": 22,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第356行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P023_S000",
      "original_quote": "值午時，主有白衣女人至，狗銜花、山鷄鬪，風雨至為應。",
      "paragraph_index": 23,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第357行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P023_S001",
      "original_quote": "作用後有人自來，因賭戲公事得財，黑雞生白雛，田產發旺。",
      "paragraph_index": 23,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第357行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P024_S000",
      "original_quote": "值未時，主有老年跛足擔花過，或青衣人攜物至為應。",
      "paragraph_index": 24,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第358行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P024_S001",
      "original_quote": "作用後六十日內進羽音人、鐵器，發旺。",
      "paragraph_index": 24,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第358行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P025_S000",
      "original_quote": "值申時，主空中飛鳥啼，師巫拿紙物來為應。",
      "paragraph_index": 25,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第359行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P025_S001",
      "original_quote": "作用後百日內女人拾珠翠歸，一年內生貴子起家。",
      "paragraph_index": 25,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第359行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P026_S000",
      "original_quote": "值酉時，主西方火起、人家吵嚷、鼓聲喧鬧為應。",
      "paragraph_index": 26,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第360行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P026_S001",
      "original_quote": "作用後一年內生貴子，發旺。",
      "paragraph_index": 26,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第360行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P027_S000",
      "original_quote": "值戌時，主東北方有鐘鼓聲，青衣童子攜籃至為應。",
      "paragraph_index": 27,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第361行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P027_S001",
      "original_quote": "作用後六十日內白鼠來，得寡婦財物發達。",
      "paragraph_index": 27,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第361行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P028_S000",
      "original_quote": "值亥時，主有西北方婦人笑聲，大起狂風，折樹毀屋，人喊叫為應。",
      "paragraph_index": 28,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第362行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P028_S001",
      "original_quote": "作用後百日內進鐵匠器物及僧道產。",
      "paragraph_index": 28,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第362行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P029_S000",
      "original_quote": "天心星",
      "paragraph_index": 29,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第363行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P030_S000",
      "original_quote": "天心求仙合藥當，商途客旅財祿昌，更將遷葬皆吉利，萬事欣逢盡高強。",
      "paragraph_index": 30,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第364行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P031_S000",
      "original_quote": "天心值子時，主有人爭鬪，鼓聲西北起為應。",
      "paragraph_index": 31,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第365行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P031_S001",
      "original_quote": "作用後九十日內有赤面人作牙，進商音人古銅畫軸，十二年田蠶發旺。",
      "paragraph_index": 31,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第365行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P032_S000",
      "original_quote": "值醜時，主西南方有火光，跛足人送物至，五日內雙貓自來為應。",
      "paragraph_index": 32,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第366行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P032_S001",
      "original_quote": "作用後四十日有遠方人送物，進商音人財產、文契。",
      "paragraph_index": 32,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第366行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P033_S000",
      "original_quote": "值寅時，主有水鳥至，鐘鼓鳴，青衣女子提籃至為應。",
      "paragraph_index": 33,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第367行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P033_S001",
      "original_quote": "作用後火燒小口，六十日有公事，百日進金銀，拾古器，進人口產業，三年因妻得財、生貴子。",
      "paragraph_index": 33,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第367行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P034_S000",
      "original_quote": "值卯時，主有跛足婦人相打，犬吠及鼓聲，北方轎至為應。",
      "paragraph_index": 34,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第368行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P034_S001",
      "original_quote": "作用後七日內進財物，三年內有牛馬來，財祿大旺。",
      "paragraph_index": 34,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第368行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P035_S000",
      "original_quote": "值辰時，主云從西北起，青衣人拿魚至，女人與僧道同行為應。",
      "paragraph_index": 35,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第369行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P035_S001",
      "original_quote": "作用後井中氣出如云，三日內生貴子，後主科第富貴。",
      "paragraph_index": 35,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第369行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P036_S000",
      "original_quote": "值巳時，主有女人抱小兒至，紫衣人騎馬過為應，龜上樹。",
      "paragraph_index": 36,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第370行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P036_S001",
      "original_quote": "作用後半月內進遠方人財，跛足人作牙、進田契、六畜旺，女人治家，寡婦坐堂。",
      "paragraph_index": 36,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第370行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P037_S000",
      "original_quote": "值午時，主有風雨驟至，蛇橫路，女人著紅裙提酒至為應。",
      "paragraph_index": 37,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第371行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P037_S001",
      "original_quote": "作用後六十日內有跛足人送活物，五年內橫發財產。",
      "paragraph_index": 37,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第371行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P038_S000",
      "original_quote": "值未時，主有法術人拿空器過，白衣老人至為應。",
      "paragraph_index": 38,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第372行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P038_S001",
      "original_quote": "作用後得商音姓人文契，田宅發富。",
      "paragraph_index": 38,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第372行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P039_S000",
      "original_quote": "值申時，主有僧道來，金鼓四鳴，百鳥齊嗓，紅裙女人送酒為應。",
      "paragraph_index": 39,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第373行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P039_S001",
      "original_quote": "作用後三年內寡婦持家。",
      "paragraph_index": 39,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第373行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P040_S000",
      "original_quote": "值酉時，主僧尼道姑拿火自西南來，北方鐘鼓聲為應。",
      "paragraph_index": 40,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第374行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P040_S001",
      "original_quote": "作用後七十日內得馬牛，得官府財，遠信至。",
      "paragraph_index": 40,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第374行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P041_S000",
      "original_quote": "值戌時，主南方喊叫有賊，小兒牽牛至為應。",
      "paragraph_index": 41,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第375行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P041_S001",
      "original_quote": "作用後百日內生貴子，金鷄石上鳴，無故犬吠，二年後中科第。",
      "paragraph_index": 41,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第375行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P042_S000",
      "original_quote": "值亥時，主鷄鳴犬吠，老人著皮衣帽至，手拿鐵器為應。",
      "paragraph_index": 42,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第376行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P042_S001",
      "original_quote": "作用後七日內有遠人來借宿，遺下財物而去。",
      "paragraph_index": 42,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第376行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P043_S000",
      "original_quote": "天柱星",
      "paragraph_index": 43,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第377行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P044_S000",
      "original_quote": "天柱藏形謹守宜，不須遠行及營為，商賈百事皆不利，動作立刻見凶危。",
      "paragraph_index": 44,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第378行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P045_S000",
      "original_quote": "天柱值子時，主有風雨，火從東方起，缺唇人至為應。",
      "paragraph_index": 45,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第379行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P045_S001",
      "original_quote": "作用後六十日內蛇犬咬人，刀刃傷人、見血光、破財。",
      "paragraph_index": 45,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第379行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P046_S000",
      "original_quote": "值醜時，主有北方木匠拿斧，樹上生金花為應。",
      "paragraph_index": 46,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第380行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P046_S001",
      "original_quote": "作用後六十日進羽音人金銀器，三年內火災，主敗家產，出人弄蛇戲犬。",
      "paragraph_index": 46,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第380行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P047_S000",
      "original_quote": "值寅時，主牛馬喧，僧道拿傘蓋至，有雷雨，喜鵲噪為應。",
      "paragraph_index": 47,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第381行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P047_S001",
      "original_quote": "作用後主賊人牽連，官訟破財，女人小產死凶。",
      "paragraph_index": 47,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第381行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P048_S000",
      "original_quote": "值卯時，主有人伐樹，男人拿鼓，黃衣老人拿鋤鐮過為應。",
      "paragraph_index": 48,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第382行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P048_S001",
      "original_quote": "作用後六十日內母雞犬上屋，一年內少婦死凶。",
      "paragraph_index": 48,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第382行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P049_S000",
      "original_quote": "值辰時，主有人自西方拿金器來為應。",
      "paragraph_index": 49,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第383行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P049_S001",
      "original_quote": "作用後七日內進陰人財物，三年內大發。",
      "paragraph_index": 49,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第383行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P050_S000",
      "original_quote": "值巳時，主有黑牛拉車，豬上山、鐘鼓聲鳴為應。",
      "paragraph_index": 50,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第384行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P050_S001",
      "original_quote": "作用後二十日內進商音姓人財物，六十日內有女人下水，野物入宅，一年內生貴子，大發之兆。",
      "paragraph_index": 50,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第384行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P051_S000",
      "original_quote": "值午時，主有人騎馬至，冬月有雪，夏秋有鴉飛鳴為應。",
      "paragraph_index": 51,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第385行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P051_S001",
      "original_quote": "作用後五日內孕婦帶疾行孝服哭泣，六十日內水邊得古銅器，退財小口凶。",
      "paragraph_index": 51,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第385行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P052_S000",
      "original_quote": "值未時，主有女人與僧道同行，東北方人攜傘蓋騎馬為應。",
      "paragraph_index": 52,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第386行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P052_S001",
      "original_quote": "作用後因女人見狐狸退敗大凶。",
      "paragraph_index": 52,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第386行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P053_S000",
      "original_quote": "值申時，主有鷹捕鳥落地，及青衣人攜傘蓋至為應。",
      "paragraph_index": 53,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第387行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P053_S001",
      "original_quote": "作用後三年內大火焚宅，家業大敗。",
      "paragraph_index": 53,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第387行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P054_S000",
      "original_quote": "值酉時，主東方有大小車連絡數十輛行為應。",
      "paragraph_index": 54,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第388行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P054_S001",
      "original_quote": "作用後七十日內得女人首飾發財。",
      "paragraph_index": 54,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第388行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P055_S000",
      "original_quote": "值戌時，主有女人抱白布物至，西北方有鼓聲為應。",
      "paragraph_index": 55,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第389行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P055_S001",
      "original_quote": "作用後東北方樹打人喊叫，後六十日蛇蠍傷人，瘟疫死，大敗凶。",
      "paragraph_index": 55,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第389行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P056_S000",
      "original_quote": "值亥時，主西方有鐘聲為應，山下人喊叫，作用後百日內，因救火得財大利。",
      "paragraph_index": 56,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第390行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P057_S000",
      "original_quote": "天任星",
      "paragraph_index": 57,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第391行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P058_S000",
      "original_quote": "天任吉宿事皆通，祭祀求官嫁娶同，斬絕妖蛇移徙事，商賈造葬喜重重。",
      "paragraph_index": 58,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第392行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P059_S000",
      "original_quote": "天任值子時，主有風雨至，水畔鷄鳴，東南方有人帶刀過為應。",
      "paragraph_index": 59,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第393行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P059_S001",
      "original_quote": "作用後百日內，主婦人離異，水姓人上門抵賴、退田產，後出人男盜女娼凶。",
      "paragraph_index": 59,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第393行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P060_S000",
      "original_quote": "值醜時，主青衣婦人提酒至，西方鼓聲為應。",
      "paragraph_index": 60,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第394行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P060_S001",
      "original_quote": "作用後半年內進異方財物，一年內鸚鵡入宅，因口舌得財，三年後貓犬相咬，主發科吉。",
      "paragraph_index": 60,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第394行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P061_S000",
      "original_quote": "值寅時，主女人成對至或拿火來，童子拍手大笑為應。",
      "paragraph_index": 61,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第395行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P061_S001",
      "original_quote": "作用後六十日內，甑鳴，老翁死，百日內進六畜、女人，財寶自來，田蠶發，後因缺唇人爭，婚姻事敗。",
      "paragraph_index": 61,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第395行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P062_S000",
      "original_quote": "值卯時，主有老人持杖至，喜鵲鳴造為應。",
      "paragraph_index": 62,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第396行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P062_S001",
      "original_quote": "作用後七日內有人送銅鐵器物，六十日內因女人得進六畜，賭博贏，官祿至吉。",
      "paragraph_index": 62,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第396行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P063_S000",
      "original_quote": "值辰時，主有白衣男女同行，或孕婦抱小兒為應。",
      "paragraph_index": 63,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第397行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P063_S001",
      "original_quote": "作用後有人送活物至，大吉。",
      "paragraph_index": 63,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第397行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P064_S000",
      "original_quote": "值巳時，主有二犬相爭，野人負薪，吏人拿傘過為應。",
      "paragraph_index": 64,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第398行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P064_S001",
      "original_quote": "作用後六十日得外方人財物，南方人送魚至，一年內生貴子，發富貴吉。",
      "paragraph_index": 64,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第398行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P065_S000",
      "original_quote": "值午時，主西方黃色禽鳥飛來，僧道與儒士同行為應。",
      "paragraph_index": 65,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第399行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P065_S001",
      "original_quote": "作用後四十日得貴人財寶，紫衣人進宅，生貴子吉。",
      "paragraph_index": 65,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第399行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P066_S000",
      "original_quote": "值未時，主有白鳥自西南方飛來，北方鐘鼓聲為應，風雨至。",
      "paragraph_index": 66,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第400行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P066_S001",
      "original_quote": "作用後七日，外女人送白衣物或白紙物來，主六畜興旺。",
      "paragraph_index": 66,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第400行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P067_S000",
      "original_quote": "值申時，主大風雨陡至，人打鼓，僧道著黃衣為應。",
      "paragraph_index": 67,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第401行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P067_S001",
      "original_quote": "作用後七日內，女人被火燒，蕩敗凶。",
      "paragraph_index": 67,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第401行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P068_S000",
      "original_quote": "值酉時，主僧道尼姑持火自西南方來，北方鐘鼓聲為應。",
      "paragraph_index": 68,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第402行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P068_S001",
      "original_quote": "作用後七十日內得官員財物，進牛馬，喜信至，大吉，錢財豐美大利。",
      "paragraph_index": 68,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第402行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P069_S000",
      "original_quote": "值戌時，主有女人抱布來，西北方鼓聲，北方樹木傷人為應。",
      "paragraph_index": 69,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第403行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P069_S001",
      "original_quote": "作用後六十日內蛇咬人，凶。",
      "paragraph_index": 69,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第403行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P069_S002",
      "original_quote": "若有老人與小兒同至，即解禍為福。",
      "paragraph_index": 69,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第403行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P070_S000",
      "original_quote": "值亥時，主西方磬鳴，人拿火喊叫為應。",
      "paragraph_index": 70,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第404行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P070_S001",
      "original_quote": "作用後一年內因救火得財大利。",
      "paragraph_index": 70,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第404行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P071_S000",
      "original_quote": "天英星",
      "paragraph_index": 71,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第405行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P072_S000",
      "original_quote": "天英之星嫁娶凶，遠行移徙不宜逢，上官商賈凶敗死，造作求財一場空。",
      "paragraph_index": 72,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第406行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P073_S000",
      "original_quote": "天英值子時，主有鑼聲自西北來，三、五人掌火伐木為應。",
      "paragraph_index": 73,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第407行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P073_S001",
      "original_quote": "作用後一年內主有殘病人抵賴破家，三年內自刎、小兒因湯火災傷。",
      "paragraph_index": 73,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第407行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P074_S000",
      "original_quote": "值醜時，主東北方師巫僧道至，鑼聲鳴為應。",
      "paragraph_index": 74,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第408行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P074_S001",
      "original_quote": "作用後一月內火燒房屋，一年內犬作人言，百怪俱見，死亡大敗凶。",
      "paragraph_index": 74,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第408行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P075_S000",
      "original_quote": "值寅時，主東方有兵馬來，及捕魚人持網過為應。",
      "paragraph_index": 75,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第409行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P075_S001",
      "original_quote": "作用後女人路上拾得財物，六十日內進寡婦田產，龍雷折屋凶。",
      "paragraph_index": 75,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第409行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P076_S000",
      "original_quote": "值卯時，主有提燈籠過或持米來，雷鳴為應。",
      "paragraph_index": 76,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第410行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P076_S001",
      "original_quote": "作用後應六十日內進女人財寶發家。",
      "paragraph_index": 76,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第410行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P077_S000",
      "original_quote": "值辰時，主西北方女人攜物來，鷄上樹為應。",
      "paragraph_index": 77,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第411行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P077_S001",
      "original_quote": "作用後人七十日，野物進宅，大發財產。",
      "paragraph_index": 77,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第411行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P078_S000",
      "original_quote": "值巳時，主有人抱文書、持傘蓋至，或抱錫磁器為應。",
      "paragraph_index": 78,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第412行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P078_S001",
      "original_quote": "作用後六十日內得異姓人財產，南方人送活物來，一年內生貴子，發達。",
      "paragraph_index": 78,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第412行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P079_S000",
      "original_quote": "值午時，主有人自南方來，著紅衣或騎馬持文書至為應。",
      "paragraph_index": 79,
      "tag": [],
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷三",
        "section": "卷三",
        "line_ref": "第413行"
      }
    },
    {
      "line_id": "QMDJ_Juan3_P079_S001",
      "original_quote": "作用後六十日內被木石打死，及自縊、人命官司凶。",
      "paragraph_index": 79,
      "tag": [],
