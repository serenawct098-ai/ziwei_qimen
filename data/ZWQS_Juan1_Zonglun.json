{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "諸星得地失陷總論",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_失陷破格訣_L001",
      "original_quote": "子丑安命：子午天機丑巨鈴，此星落陷果為真，縱然化吉更為美，任他富貴不清寧。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷破格訣",
        "line_id": "ZWQS_Juan1_失陷破格訣_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷破格訣_L002",
      "original_quote": "寅安命：寅上機昌曲月逢，雖然吉拱不豐隆，男為伴僕女娼婢，若非夭折即貧窮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷破格訣",
        "line_id": "ZWQS_Juan1_失陷破格訣_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷破格訣_L003",
      "original_quote": "卯辰安命：卯上太陰擎羊逢，辰宮巨宿紫微同，縱然化吉非全美，若非加殺到頭凶。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷破格訣",
        "line_id": "ZWQS_Juan1_失陷破格訣_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷破格訣_L004",
      "original_quote": "巳安命：巳宮武月天梁巨，貪宿廉貞共到蛇，三方吉曜皆不貴，下賤貧窮度歲華。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷破格訣",
        "line_id": "ZWQS_Juan1_失陷破格訣_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷破格訣_L005",
      "original_quote": "午安命：午宮貪巨月昌從，羊刃三合最嫌沖，雖然化吉居仕路，橫破橫成到老窮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷破格訣",
        "line_id": "ZWQS_Juan1_失陷破格訣_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷破格訣_L006",
      "original_quote": "未安命：未宮巨宿太陽嫌，縱少災危有剋傷，勞碌奔波官事至，隨緣下賤度時光。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷破格訣",
        "line_id": "ZWQS_Juan1_失陷破格訣_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷破格訣_L007",
      "original_quote": "申西安命：申宮機巨為破格，男人浪蕩女人貧，二宮若然桃花見，男女逢之總不榮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷破格訣",
        "line_id": "ZWQS_Juan1_失陷破格訣_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷破格訣_L008",
      "original_quote": "戍安命：戌上紫破若相逢，天同太陽皆主凶，若還孤寒更殀折，隨緣勤苦免貧窮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷破格訣",
        "line_id": "ZWQS_Juan1_失陷破格訣_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷破格訣_L009",
      "original_quote": "亥安命：亥宮貪火天梁同，飄蕩浪子走西東，若還富貴也年促，不然隸僕與貧窮。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷破格訣",
        "line_id": "ZWQS_Juan1_失陷破格訣_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_得地富貴論_L001",
      "original_quote": "子宮得地太陰星，殺破昌貪文曲明，丑未紫破朝日月，未貞梁丑福非輕，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "得地富貴論",
        "line_id": "ZWQS_Juan1_得地富貴論_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_得地富貴論_L002",
      "original_quote": "寅宮最喜逢陽巨，七殺天同梁文清，卯上巨機為貴格，武曲守卯福豐盈，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "得地富貴論",
        "line_id": "ZWQS_Juan1_得地富貴論_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_得地富貴論_L003",
      "original_quote": "辰戌機梁非小補，成宮天府累千金，巳亥天機天相貴，午宮紫府梁俱榮，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "得地富貴論",
        "line_id": "ZWQS_Juan1_得地富貴論_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_得地富貴論_L004",
      "original_quote": "申宮貞巨陰殺美，酉成亥上太陰停，卯辰巳午陽正照，紫府巨宿巳亥興，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "得地富貴論",
        "line_id": "ZWQS_Juan1_得地富貴論_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_得地富貴論_L005",
      "original_quote": "亥宮天府天梁吉，子宮機宿亦中平，七殺子午逢左右，文曲加之格最清，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "得地富貴論",
        "line_id": "ZWQS_Juan1_得地富貴論_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_得地富貴論_L006",
      "original_quote": "廉坐中宮逢輔弼，更兼化吉禍尤興。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "得地富貴論",
        "line_id": "ZWQS_Juan1_得地富貴論_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_得地富貴論_L007",
      "original_quote": "武曲巳亥逢，六甲帥邊庭，貪狼居卯，遇火作公卿，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "得地富貴論",
        "line_id": "ZWQS_Juan1_得地富貴論_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_得地富貴論_L008",
      "original_quote": "天機坐卯貴，寅月六丁榮，巨卯逢左右，六乙立邊庭，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "得地富貴論",
        "line_id": "ZWQS_Juan1_得地富貴論_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_得地富貴論_L009",
      "original_quote": "巨坐寅申位，偏喜甲庚生，二宮逢七殺，左右會昌星，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "得地富貴論",
        "line_id": "ZWQS_Juan1_得地富貴論_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_得地富貴論_L010",
      "original_quote": "辰戍遇三宿，必主位公卿。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "得地富貴論",
        "line_id": "ZWQS_Juan1_得地富貴論_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷貧賤論_L001",
      "original_quote": "丑未巨機為值福，失陷此月福須輕，卯西不喜逢羊刃，辰戌紫破朝羅網，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷貧賤論",
        "line_id": "ZWQS_Juan1_失陷貧賤論_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷貧賤論_L002",
      "original_quote": "辰休戌囚貪貞陷，午宮陰巨不堪稱，申宮合武為下格，西逢機巨日無精，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷貧賤論",
        "line_id": "ZWQS_Juan1_失陷貧賤論_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷貧賤論_L003",
      "original_quote": "卯辰巳午逢陰宿，戌亥逢陽亦不容，縱然遇吉亦為清，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷貧賤論",
        "line_id": "ZWQS_Juan1_失陷貧賤論_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷貧賤論_L004",
      "original_quote": "加殺遇劫為奸盜，此是刑邪不必論，六畜之命不可平，中平得明。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷貧賤論",
        "line_id": "ZWQS_Juan1_失陷貧賤論_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_失陷貧賤論_L005",
      "original_quote": "旺地發福終遠大，陷地崢嶸到底傾，二論不過五百字，富貴貧賤別。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "失陷貧賤論",
        "line_id": "ZWQS_Juan1_失陷貧賤論_L005",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "十二宮諸星得地/失陷/富貴/貧賤論完成"
}