{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan12",
  "section": "科試占",
  "entries": [
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L000",
      "original_quote": "科試占",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L001",
      "original_quote": "論干支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L002",
      "original_quote": "日乾原為應試人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L003",
      "original_quote": "時幹卻是主考臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L004",
      "original_quote": "日支文章忌刑害",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L005",
      "original_quote": "時支場屋所寄陳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L006",
      "original_quote": "納音之中去査取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L007",
      "original_quote": "等第優劣可詳分",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L008",
      "original_quote": "旺相生合為吉兆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L009",
      "original_quote": "刑囚攻截總遭迍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L010",
      "original_quote": "日生主文宜賄囑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L011",
      "original_quote": "主文生日宜中君",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L012",
      "original_quote": "文章再興主文合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L013",
      "original_quote": "擲地金聲姓氏芬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L014",
      "original_quote": "惟忌時納遭刑制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L015",
      "original_quote": "只恐類窄有遺淪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L016",
      "original_quote": "兩支亦忌相刑害",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L017",
      "original_quote": "傷驚塗抹要留心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L018",
      "original_quote": "論值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L019",
      "original_quote": "科試先須論值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L020",
      "original_quote": "逢生合旺可進圖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L021",
      "original_quote": "朱白生身名高擢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L022",
      "original_quote": "勾蛇刑害卷胡塗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L023",
      "original_quote": "年命日元九天位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L024",
      "original_quote": "皇都得意唱傳臚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L025",
      "original_quote": "論直使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L026",
      "original_quote": "值使論門以後先",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L027",
      "original_quote": "開遇九天御筆鮮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L028",
      "original_quote": "杜臨九地孫山外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L029",
      "original_quote": "景門臨之不列前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L030",
      "original_quote": "大約用門無刑格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L031",
      "original_quote": "旁類多吉副榜邊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L032",
      "original_quote": "論十干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L033",
      "original_quote": "奇儀用神怕刑格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L034",
      "original_quote": "飛伏宮次相推測",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L035",
      "original_quote": "三奇湊聚年命間",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L036",
      "original_quote": "來朝定作金榜客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L037",
      "original_quote": "論九星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L038",
      "original_quote": "符星起伏忌孤虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L039",
      "original_quote": "背時擊刑總嗟籲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L040",
      "original_quote": "入父入官要身旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L041",
      "original_quote": "獻策投書可曳裾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L042",
      "original_quote": "論九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L043",
      "original_quote": "起元專考飛伏宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L044",
      "original_quote": "弱飛旺兮可從龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L045",
      "original_quote": "官父互交多得意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L046",
      "original_quote": "比脫加臨可落空",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L047",
      "original_quote": "論門戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L048",
      "original_quote": "將揭曉兮看天門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L049",
      "original_quote": "吉星生合步青雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L050",
      "original_quote": "初入闈時看地戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L051",
      "original_quote": "得令生官中舉人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L052",
      "original_quote": "論三甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L053",
      "original_quote": "三甲區分前後中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L054",
      "original_quote": "陽開星吉與生身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L055",
      "original_quote": "得比堪言名已備",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L056",
      "original_quote": "只從甲位寄奇蹤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L057",
      "original_quote": "論吉凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L058",
      "original_quote": "返首跌穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L059",
      "original_quote": "無疵方得成名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L060",
      "original_quote": "虎狂龍走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L061",
      "original_quote": "有傷那能進步",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L062",
      "original_quote": "天遁人遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L063",
      "original_quote": "際會風雲之客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L064",
      "original_quote": "虎遁龍遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L065",
      "original_quote": "蟾宮折桂之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L066",
      "original_quote": "俱要填合年命用乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L067",
      "original_quote": "始可斷其天衢得路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L068",
      "original_quote": "三詐五假",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L069",
      "original_quote": "從前折挫始亨通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L070",
      "original_quote": "得使守門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L071",
      "original_quote": "旁求公薦方得意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L072",
      "original_quote": "門戶忌傷符使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L073",
      "original_quote": "人元最怕休囚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L074",
      "original_quote": "天馬上乘朱雀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L075",
      "original_quote": "泥封已出天衢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L076",
      "original_quote": "夭矯而文不入式",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L077",
      "original_quote": "投江而卷或漏遺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L078",
      "original_quote": "伏乾飛幹只疑場屋生變",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L079",
      "original_quote": "飛宮伏宮又懼試後興殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L080",
      "original_quote": "格隔進呈有阻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L081",
      "original_quote": "刑悖字號宜防",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L082",
      "original_quote": "熒入白兮不第",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L083",
      "original_quote": "白入熒兮不揚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L084",
      "original_quote": "不遇徒勞獻策",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L085",
      "original_quote": "擊刑反惹驚惶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L086",
      "original_quote": "入墓網羅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L087",
      "original_quote": "年命吉而可言中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L088",
      "original_quote": "反伏門迫雖入試",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L089",
      "original_quote": "而未免狼當",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L090",
      "original_quote": "天乙祿馬乘吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_KeShiZhan_L091",
      "original_quote": "時來生命自飛黃",
      "tag": []
    }
  ],
