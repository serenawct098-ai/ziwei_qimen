    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L001",
      "original_quote": "奇門飛鬥法即禹步",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L002",
      "original_quote": "凡有急事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L003",
      "original_quote": "不得奇門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L004",
      "original_quote": "用此亦妙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L005",
      "original_quote": "凡飛斗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L006",
      "original_quote": "足步手揚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L007",
      "original_quote": "口誦咒曰：「天圓地步",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L008",
      "original_quote": "六律九章",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L009",
      "original_quote": "出行大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L010",
      "original_quote": "永保安康",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L011",
      "original_quote": "掃除凶惡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L012",
      "original_quote": "削去災殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L013",
      "original_quote": "人來追我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L014",
      "original_quote": "掩其兩目",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L015",
      "original_quote": "馬來追我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L016",
      "original_quote": "折其四足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L017",
      "original_quote": "車來追我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L018",
      "original_quote": "斷其輪輔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L019",
      "original_quote": "所求遂意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L020",
      "original_quote": "咸願從心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L021",
      "original_quote": "吾奉九天玄女急急如律令敕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L022",
      "original_quote": "陽斗甲丙戊庚壬為六陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L023",
      "original_quote": "貪巨祿文廉武破",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L024",
      "original_quote": "○破○廉○文○貪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L025",
      "original_quote": "○武○祿○巨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L026",
      "original_quote": "陰斗乙丁己辛癸為六陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L027",
      "original_quote": "魁勺雚行畢甫魒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L028",
      "original_quote": "俱七斗之諱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L029",
      "original_quote": "○勺○雚○甫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_FeiDouFa_L030",
      "original_quote": "○魁○行○魓○魒",
      "tag": []
    }
