    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L127",
      "original_quote": "神將比為親屬好",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L128",
      "original_quote": "謀為作事托宗親",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L129",
      "original_quote": "將方比是為朋友",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L130",
      "original_quote": "進退作為朋友成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L131",
      "original_quote": "干戈比為兄弟類",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L132",
      "original_quote": "事謀不寔比肩行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L133",
      "original_quote": "全比親屬迭重連",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L134",
      "original_quote": "卑逾尊兮邪奪正",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L135",
      "original_quote": "上下混向無分別",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L136",
      "original_quote": "大凶無吉災刑並",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L137",
      "original_quote": "神與乾合為官合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L138",
      "original_quote": "士子科場榮擢廷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L139",
      "original_quote": "庸俗訟公官府累",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L140",
      "original_quote": "謀望小事多難成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L141",
      "original_quote": "神與將合為正合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L142",
      "original_quote": "婚姻成就事亨通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L143",
      "original_quote": "又多朋友親隣助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L144",
      "original_quote": "惟有病占秋複冬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L145",
      "original_quote": "將與方合為遙合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L146",
      "original_quote": "遠路來年婚就成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L147",
      "original_quote": "謀事遲成人病仰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L148",
      "original_quote": "以卑動長合相承",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L149",
      "original_quote": "干與將合名為格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L150",
      "original_quote": "內外關防遲送迎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L151",
      "original_quote": "方與神合經年事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L152",
      "original_quote": "卑幼乾尊事晚成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L153",
      "original_quote": "方與乾合人謀己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L154",
      "original_quote": "門中有事就相爭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L155",
      "original_quote": "星奇方位門諸將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L156",
      "original_quote": "吉凶平穩隨時評",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L157",
      "original_quote": "同朋為旺我生相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L158",
      "original_quote": "休是財官囚鬼將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L159",
      "original_quote": "死為父母分輕重",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L160",
      "original_quote": "有氣大凶無小恙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L161",
      "original_quote": "大吉星旺固勝小",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L162",
      "original_quote": "無氣不如小星暢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L163",
      "original_quote": "吉宿若逢時旺相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L164",
      "original_quote": "萬舉萬全功業尚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L165",
      "original_quote": "管甚身相竝定命",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L166",
      "original_quote": "諸家不論惡星將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L167",
      "original_quote": "官符太歲盡歸承",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L168",
      "original_quote": "壓煞擢凶靈顯真",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L169",
      "original_quote": "作著流財財便發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L170",
      "original_quote": "作著空亡空裡興",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L171",
      "original_quote": "若值休囚並廢棄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L172",
      "original_quote": "勸君不必進前升",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L173",
      "original_quote": "愚今推演局卦數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L174",
      "original_quote": "變易隨時見道流",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L175",
      "original_quote": "值符為綱使為目",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L176",
      "original_quote": "詳演西山數人周",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L177",
      "original_quote": "門為外卦宮為內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L178",
      "original_quote": "值使宰時正卦游",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L179",
      "original_quote": "飛爻出現目今斷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L180",
      "original_quote": "伏爻藏隱詳後頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L181",
      "original_quote": "反卦先天相對取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L182",
      "original_quote": "彼方之向敵占留",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L183",
      "original_quote": "互察未來後代事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L184",
      "original_quote": "用占旺相與休囚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L185",
      "original_quote": "用爻被傷尋生救",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L186",
      "original_quote": "絕處逢生一樣搜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L187",
      "original_quote": "二卷分明推斷類",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L188",
      "original_quote": "請君一一熟詳求",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L189",
      "original_quote": "泊宮本命六儀里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L190",
      "original_quote": "甲子行年本命頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L191",
      "original_quote": "本命宮中起甲子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L192",
      "original_quote": "陰陽逆順一般周",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L193",
      "original_quote": "命與行年隨宮斷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L194",
      "original_quote": "便知情性興亡籌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L195",
      "original_quote": "三易玩占周易主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L196",
      "original_quote": "啟蒙占法變之搜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L197",
      "original_quote": "參伍研幾惟在己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L198",
      "original_quote": "極深達用至誠求",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L199",
      "original_quote": "若能念念時存此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_10FangShengKe_L200",
      "original_quote": "方可循循達上俢",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan23",
    "section": "論十方星將生剋",
    "line_id_start": "QMDJ_Juan23_10FangShengKe_L000",
