      }
    },
    {
      "line_id": "QMDJ_Juan13_L001",
      "original_quote": "行人占",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落1"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L002",
      "original_quote": "論干支",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落2"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L003",
      "original_quote": "推測行人來不來，只從時日細安排，時元合生日元上，逢制日支軍馬回，又喜時支作日馬，日支合馬歸時下，若使時馬系日支，投墓支干定返期，最忌截空與刑墓，死絕多應音信稀，日音時納去留人，納音生合已登程，時音來剋日乾納，行人飛驥在武陵，乾納剋制用時納，縱欲動身又怕行，更詳臨官占驛馬，三合時日察歸情。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落3"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L004",
      "original_quote": "論值符",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落4"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L005",
      "original_quote": "值符所推論行人，旺相逢生必稱心，休囚刑剋豈得意，空亡在後想家門，勾白朱蛇逢剋制，多般遲滯是非生，元武太陰如生合，又疑陰小絆行程，五馬如投天與地，歸鞭已拂嶺頭云。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落5"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L006",
      "original_quote": "論值使",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落6"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L007",
      "original_quote": "值使斷可斷行蹤，門合來方歸意濃，惟忌驚傷與杜死，刑格迫伏未回蹤，開休生景乘天忌，加臨乾符墓相逢。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落7"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L008",
      "original_quote": "論十干",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落8"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L009",
      "original_quote": "十干時兮所望親，用神乘馬始來臨，馬阻關東歸未得，馬過山谷喜相尋。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落9"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L010",
      "original_quote": "論九星",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落10"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L011",
      "original_quote": "九星南北與西東，來旺投生在外棲，入墓加比營歸計，前程空絕必回廬。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落11"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L012",
      "original_quote": "論九宮",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落12"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L013",
      "original_quote": "起元伐問去何方，卻將本局所推詳，議歷過來搜父比，此官此日合回鄉。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落13"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L014",
      "original_quote": "論門戶",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落14"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L015",
      "original_quote": "門戶要合符與門關，時日驛馬可搜尋，要看加臨何親屬，加合占人評來臨。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落15"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L016",
      "original_quote": "論三甲",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落16"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L017",
      "original_quote": "行人孟闔未登程，仲甲開兮路宿雲，季甲值開人便到，本甲之上考門時，喜時日干支門符坐馬來馬又杳，又行人類神年命相生相合，而甲門內開不闔，大為准到也。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落17"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L018",
      "original_quote": "論吉凶格",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落18"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L019",
      "original_quote": "返首跌穴早已束裝，其中遲速刑合參詳，虎狂兮羈留而不返，龍走兮蹭蹬不歸鄉。遁格合時日兩元可以言到，詐假會白虎朱蛇，書信必來。蛇夭而道路災疫，投江而歸計徬徨，飛幹伏乾來情不善，伏宮飛宮客若遐荒，大小格而遷延時日，刑悖格而彼此俱傷，白入熒而行人將到，熒入白而書信皆亡，不遇何須盼望，擊刑有事相妨，入墓無傷可雲到宅，羅網相格莫斷回鄉，返伏門迫須分行人遠近，若合驛馬臨宮，反主去客登堂。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落19"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L020",
      "original_quote": "出行占",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落20"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L021",
      "original_quote": "論干支",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落21"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L022",
      "original_quote": "日元為人時元地，人元剋地去向利，時元如若剋人元，所往之方多不濟，時納所藏是中途，不傷人元堪策驥，若得再來生日元，未到地頭先稱意，最忌截空與刑害，進退趦趄方另議。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落22"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L023",
      "original_quote": "論值符",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落23"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L024",
      "original_quote": "出行道行宜生旺，六合所主同伴當，勾陳白虎依程途，朱蛇文信口舌項，元武所主盜與奸，前後俱忌相利創，地陰剋制路多岐，九天生合宜去向。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落24"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L025",
      "original_quote": "論值使",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落25"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L026",
      "original_quote": "出行直使最為重，加臨無傷始堪用，本門起自何卦中，飛臨生合人趨奉，其間用空與落空，反伏迫格及刑衝，起程不得去無向，勸君另自卜門從。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落26"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L027",
      "original_quote": "論十干",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落27"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L028",
      "original_quote": "奇儀所主六親神，旅舍風塵亦同因，圖謀宜入財宮位，投托須臨父舍恩，忌入官鄉與刑格，再據地方車折輪。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落28"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L029",
      "original_quote": "論吉凶格",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落29"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L030",
      "original_quote": "吉格事事俱吉，凶格事事俱凶，夭矯防口舌，投江莫長驅，伏乾飛幹途中前後有變，伏宮飛宮早晚旅宿多殃，大隔小隔舟車宜有防，刑格悖格盜劫鬥傷，熒入白而火盜留意，白入熒而輜重提防，不遇何勞遠去，擊刑莫求行裝，入墓羅網切莫輕身險地，反伏門迫進退受困，奔必求符便協吉，助元無礙起行。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落30"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L031",
      "original_quote": "家宅占",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落31"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L032",
      "original_quote": "論值符",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落32"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L033",
      "original_quote": "值符，宅艮山向。螣蛇，向小婢、驚癲。太陰，女婢。六合，子女弟兄、親友。勾陳、白虎，奴婢、道路。朱雀、元武，光棍、口舌、盜賊、小人。九天，明堂。九地，暗室。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落33"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L034",
      "original_quote": "值使",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落34"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L035",
      "original_quote": "休，坎宅門路。生，艮宅門路。傷，震宅門路。杜，巽宅門路。景，離宅門路。死，坤宅門路。驚，兌宅門路。開，乾宅門路。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落35"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L036",
      "original_quote": "十干",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落36"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L037",
      "original_quote": "甲，棟柱。乙，梁柱、福欞、東門、臥榻。丙，香火堂。丁，屈灶。戊，牆院、廠房。己，住居、天井、房屋。庚，過道、屋脊、爐鐺。辛，團積、戶牖、釜甑。壬，小路、門扇、井。癸，廁後門路。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落37"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L038",
      "original_quote": "九星",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落38"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L039",
      "original_quote": "蓬，房屋、亭院、神、中男、婦女。任，少男、道士、道路。衝，長男、經紀、戶牖、棺。輔，長女、僧尼、鼎筺。英，中女、堂室。芮，老脊、道路、井、院。禽，母姨、堂室。柱，少女、門戶、父叔、廁、閣。心，牆。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落39"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L040",
      "original_quote": "九宮",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落40"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L041",
      "original_quote": "一，得令，秀整委曲；失令，高低參差。二，得令夫圓寬廣。三，得令高低中院；失令，大破低路。四，節申子辰，氣巳酉丑。五，節居中四維土，氣居中四庫土。六，節寅午戌近岡冶，氣亥卯未近橋梁。七，得令，四齊院密；失令，缺凹破敗。八，失令，傾頹凸凹。九，得令，曲直新鮮；失令，衰析中。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落41"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L042",
      "original_quote": "門戶",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落42"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L043",
      "original_quote": "朱白忌登天門，勾元忌居地戶。門戶合陽星旺相者宅宇宮，門戶合陰星休囚者軒昂宮。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落43"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L044",
      "original_quote": "三甲",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落44"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L045",
      "original_quote": "孟甲前門路，開旺光明，闔囚歪破。仲甲門堂，陽開整齊，陰闔破漏。季甲後門牆，開旺壁光心，闔破損壞。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落45"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L046",
      "original_quote": "論干支",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落46"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L047",
      "original_quote": "日乾為人時幹宅，人宅相生多利益，人若剋宅庶可居，宅若傷人住不得，納音生剋與刑衝，較取年命定禍福，值符從中作生授，福神到堂喜安逸。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落47"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L048",
      "original_quote": "論值符",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落48"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L049",
      "original_quote": "占宅直符逢休廢，人眷房宇疑衰替，飛宮上下兩無傷，前後新舊皆遂意。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落49"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L050",
      "original_quote": "論值使",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落50"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L051",
      "original_quote": "直使得來怕悖迫，剋儀落宅及反伏，水木漂流火金勞，土值刑傷災疫逐，金水刑囚露風聲，木火猖狂防回祿，開杜生死若失宜，算來門向須改革。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落51"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L052",
      "original_quote": "論十干",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落52"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L053",
      "original_quote": "三奇六儀所臨宮，逢生乘旺必興隆，刑墓空亡隔悖害，休咎其間斷來蹤。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落53"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L054",
      "original_quote": "論九星",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落54"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L055",
      "original_quote": "九星五行古六親，得旺無傷喜慶新，反伏二吟刑囚星，宅眷災迍當新尋。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落55"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L056",
      "original_quote": "論九宮",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落56"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L057",
      "original_quote": "九宮起元論風水，乘旺臨生為福秘，假令飛符入鬼鄉，從旁休谷因類取。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落57"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L058",
      "original_quote": "論吉凶格",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落58"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L059",
      "original_quote": "虎入門兮離散，雀帶刑兮吏追，勾刑門兮宅禍，虎害干兮人追，蛇附蓬星值戰，小口驚癇憂疑武會，任宿當權匪人邪祟作孽，六合天柱子女怨尤，太陰英景寵婢竊位，九地庚辛為伏刃。若遇驚傷帶利害，而暗中有損。九天丙丁為飛牒。若乘甲乙蓬剋戰，而光棍須防。朱雀再附丙丁，喧爭聒耳。元武更乘壬癸，宵小跳梁。白虎得地而凶勢愈張，戊己勾陳刑衝而破敗立見，燒尾之虎先凶後吉，入土之蛇蟄後須防。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落59"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L060",
      "original_quote": "又論吉凶格",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落60"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L061",
      "original_quote": "返首宅宇軒昂，跌穴雕梁畫棟，藏風聚氣。遁格裏參詳拱護有情。詐局中理會，得使而堂構森嚴，守門而家居清吉，五假抽添偏宜，三勝修造獲吉，乙加辛而房廊有損，辛加乙而虎首房強，癸加丁而廚廁不利，丁加癸而魅祟為殃，伏乾入宅欠順，飛幹基址招殃，伏宮招入妬害，飛宮禍起蕭牆，大格小格衝射不利，刑格悖格宅眷不昌，熒入白兮防怪異，白入熒兮慎火光，五不遇兮人有損，羅網張兮見乖張，六儀擊刑凶災伏，三奇入墓暗幽房，天馬空陷無出路，反伏門迫總非詳，吉凶格見防其類，檢點六親何者當。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落61"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L062",
      "original_quote": "疾病占",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落62"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L063",
      "original_quote": "值符",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落63"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L064",
      "original_quote": "值符，陽症。螣蛇，驚恐、夜夢、遺精。太陰，肺勞、骨虛。六合，風麻。勾陳、白虎，翻胃嘔吐、傷亡道路。朱雀、元武，顛邪、崩瀉。九地，陰症。九天，落魄。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落64"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L065",
      "original_quote": "值使",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落65"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L066",
      "original_quote": "休，瀉痢、傷寒。生，癱毒、傷目。傷，拘彎、風寒。杜，壅寒、喉齒、胃風。景，傷食、疽疔。死，蠱塊。驚，勞瘵。開，肺癱、喉舌。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落66"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L067",
      "original_quote": "十干",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落67"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L068",
      "original_quote": "甲，頭面、肝。乙，肩背、膽。丙，額、鼻、心、筋。丁，齒、舌、小腸。戊，脾。己，胃。庚，肺、筋。辛，胸。壬，腎。癸，髒。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落68"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L069",
      "original_quote": "九星",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落69"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L070",
      "original_quote": "蓬，水祟為災。任，冷廟鬼作祟。衝，吊柱、產故、索命怪樹、時疫。輔，天神舊願未遂、東嶽査判。英，竈司不安。芮，家先作祟。禽，城隍、社神降福。柱，井、墓為穴。心，天神鬥府降災。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落70"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L071",
      "original_quote": "九宮",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落71"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L072",
      "original_quote": "一，血症、脈絡不利宜開導。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落72"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L073",
      "original_quote": "二，脾、胃病。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落73"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L074",
      "original_quote": "三，火症、心胸煩燥、宜溫涼。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落74"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L075",
      "original_quote": "四，申子辰、巳酉丑。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落75"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L076",
      "original_quote": "五，四維上四章上。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落76"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L077",
      "original_quote": "六，寅午戌、亥卯未。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落77"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L078",
      "original_quote": "七，勞症、筋骨不好、宜溫補。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落78"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L079",
      "original_quote": "八，宜針灸。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落79"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L080",
      "original_quote": "九，風症、肌體不便，宜和解。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落80"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L081",
      "original_quote": "門戶",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落81"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L082",
      "original_quote": "發散責天門，消導責地戶，門戶遇刑擊其病在表，門戶遇刑陷其病在裏，有救而陽症易治，有救而陰症易疹。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落82"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L083",
      "original_quote": "三甲",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落83"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L084",
      "original_quote": "孟甲主上焦之病，開嘔吐，闔鬱。仲甲主中焦之病，開嘗噎，闔隔悶。季甲主下焦之病，開庤漏，闔痔閉。開忌刑，闔忌衝，陽開在表，陰闔在裏。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落84"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L085",
      "original_quote": "論干支",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落85"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L086",
      "original_quote": "日乾為人時幹病，納乾之藏醫藥症，人剋病兮可云瘥，病剋人兮憂險應，醫能剋病始可投，如若傷人未可用，遙制符使是名醫，生合符使藥蹭蹬，惟喜日旺時休囚，五行檢點參病症。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落86"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L087",
      "original_quote": "論值符",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落87"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L088",
      "original_quote": "直符占病所由來，刑傷剋制考病胎，陰六遙傷情欲病，勾地刑符滯未開，朱蛇制符因門惱，白天卻是恐驚災，符入空鄉災不實，胎沒死廢著意裁。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落88"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L089",
      "original_quote": "論值使",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落89"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L090",
      "original_quote": "直使占病之瘥劇，三五吉凶論門義，吉值休囚主纏綿，凶更旺相堪畏懼，最忌墓命與刑年，時中詳占進退氣，凶退可痊吉進瘥，門戶生吉始無慮。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落90"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L091",
      "original_quote": "論十干",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落91"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L092",
      "original_quote": "十干論病在何處，肝膽脾胃心腎注，參詳奇儀刑與擊，上下加臨識病處，木剋土兮脾胃傷，火剋金兮肺家替，金來剋木筋脈變，水剋火兮心腎廢，年命日時細參詳，生旺休囚知災竪。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落92"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L093",
      "original_quote": "論九星",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落93"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L094",
      "original_quote": "九星從來知禍福，吉凶星宿從所屬，旺吉星臨災無虞，死凶星照防哀哭，吉逢生兮凶不刑，任爾祈禱災不贖。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落94"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L095",
      "original_quote": "論九宮",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落95"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L096",
      "original_quote": "九宮病源與醫藥，水宜疏通木忌削，金宜溫補火怕關，土乃五行之歸橐。此行旺動比刑傷，變理中和醫的確，詳觀節氣察虛實，病識真兮藥不錯。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落96"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L097",
      "original_quote": "論門戶",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落97"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L098",
      "original_quote": "門傷發表抑何疑，戶傷治裏墓稽遲，門戶俱陽表裏治，陰陽先後判因依。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落98"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L099",
      "original_quote": "論三甲",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落99"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L100",
      "original_quote": "三甲開闔論三焦，泥丸尾閭夾脊交，開若傷兮休剋伐，闔遇刑囚忌補調。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落100"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L101",
      "original_quote": "論吉凶格",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落101"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L102",
      "original_quote": "返首跌穴吉課成凶，須得年命無傷始雲葉吉，虎狂龍走凶中有吉。若再刑迫符使便作凶推。地遁臨命已作黃泉正客，鬼假當權定知冥府追呼，鬼遁人遁似非吉兆，鬼假人假非是休徵，三詐病有反複，遁假貴辨陰陽，得使而制鬼為利，守門而舊病不祥，三門四戶最忌刑墓，年命那堪喪吊重逢，天馬私門豈宜擊迫，符使更嫌空亡刑陷，夭矯鬼怪近，投江魂魄揚。伏乾飛幹醫不明而藥味反症。飛宮伏宮人不安，而宅舍驚惶。大格小格胸膈便道不利，刑格悖格肢體脈絡相妨，熒入白兮病轉添，白入熒兮災自退，年月日時逢悖格，新舊災疫可參詳，五不遇兮將逝，六儀刑兮有傷，入墓羅網纏綿災異，反伏門迫迭罹凶殃，金為尸兮木為棺，尸入木兮寧得安，庚辛若來刑甲乙，飛入中宮哭聲喧。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落102"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L103",
      "original_quote": "胎產占",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落103"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L104",
      "original_quote": "值符",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落104"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L105",
      "original_quote": "值符，胎孕母。螣蛇，漏胎。太陰，穩婆。六合，男女。勾陳、白虎，產門、木催、產神。朱雀、元武，胎衣、惡濁。九地，胎神。九天，產神。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落105"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L106",
      "original_quote": "值使",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落106"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L107",
      "original_quote": "休，胎產穩遲，主男。生，胎產利，主男。傷，產母有驚，主男。杜，防產空，主女。景，胎安產速，主女。死，子母不利主生女。驚，有損折之憂，主女。開，利產忌胎主生男。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落107"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L108",
      "original_quote": "十干",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落108"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L109",
      "original_quote": "甲，胎於酉，養於戌、生於亥、死於午。乙，胎申、養未、生午、死亥。丙，胎未、養丑、生寅、死酉。丁，胎亥、養戌、生酉、死寅。戊，胎子、養丑、生寅、死酉。己，胎亥、養戌、生酉、死寅。庚，胎卯、養辰、生巳、死子。辛，胎寅、養丑、生子、死巳。壬，胎午、養未、生申、死卯。癸，胎於巳、養於辰、生於卯、死於申。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落109"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L110",
      "original_quote": "九星",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落110"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L111",
      "original_quote": "蓬，水旺氣。任，土旺氣。衝，木旺氣。輔，木旺氣。英，火旺氣。芮，土旺氣。禽，土旺氣。柱，金旺氣。心，金旺氣。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落111"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L112",
      "original_quote": "九宮",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落112"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L113",
      "original_quote": "一，本局日時及申未日寅時主生男。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落113"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L114",
      "original_quote": "二，四維土陽主生男。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落114"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L115",
      "original_quote": "三，本局日時或醜寅日時生。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落115"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L116",
      "original_quote": "四，節申子辰氣巳酉丑，反此有坎坷刑害。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落116"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L117",
      "original_quote": "五，節氣土雙頂生。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落117"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L118",
      "original_quote": "六，節寅午戌，男防虛驚，氣亥卯未女怕休囚。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落118"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L119",
      "original_quote": "七，本局日時及辰巳日亥時生主女。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落119"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L120",
      "original_quote": "八，四庫土陰主女。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落120"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L121",
      "original_quote": "九，本局日時生或酉日卯時及亥日巳時生。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落121"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L122",
      "original_quote": "門戶",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落122"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L123",
      "original_quote": "地戶無刑胎必穩，天門吉馬產無虞，門戶合陽星主男，陰星主女。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落123"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L124",
      "original_quote": "三甲",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落124"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L125",
      "original_quote": "孟甲胎穩產遲疑，開男闔女斷因依，仲甲胎懸孕將產，開闔小產刑衝機，季甲胎虛即產子，開合虎馬定時期，孟利初胎，仲利次胎，季利三胎，看年命落何甲下。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落125"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L126",
      "original_quote": "論干支",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落126"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L127",
      "original_quote": "日乾為母時干子，納音之中辨男女，順生利產逆生時，化合胎刑奇耦取，旺相休囚與孤虛，課元用神飛伏旨，大象無疵是吉徵，化父化鬼憂危體，行年木命納音詳，天喜生氣時方舉。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落127"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L128",
      "original_quote": "論值符",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落128"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L129",
      "original_quote": "產母直符子六合，刑因旺相吉凶訣，蛇白催六是生期，地陰合六當出月，推求時日兩不傷，子母團圓不須說，專責符元起何親，輪飛之宮可生合，吉凶男女細參詳，陰陽奇耦官儀撥。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落129"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L130",
      "original_quote": "論值使",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
        "section": "卷13",
        "line_ref": "段落130"
      }
    },
    {
      "line_id": "QMDJ_Juan13_L131",
      "original_quote": "值使推詳羆與熊，門吉陽宮產豹龍，陰門陰宮瑤池女，刑格空亡最忌逢，宮制門兮多不育，門制宮兮畧有驚，若卜胎產全吉利，宮馬相生天馬騰。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
