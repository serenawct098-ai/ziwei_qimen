      }
    },
    {
      "line_id": "QMDJ_Juan13_L134",
      "original_quote": "論九星",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷13",
