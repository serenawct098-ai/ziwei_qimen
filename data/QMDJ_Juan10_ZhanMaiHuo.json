{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan10",
  "section": "占買貨",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L000",
      "original_quote": "占買貨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L001",
      "original_quote": "以日幹落宮為收買貨物之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L002",
      "original_quote": "以時幹落宮為貨物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L003",
      "original_quote": "時幹落宮乘旺相氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L004",
      "original_quote": "再得奇門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L005",
      "original_quote": "吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L006",
      "original_quote": "為美貨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L007",
      "original_quote": "乘休囚之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L008",
      "original_quote": "不得奇門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L009",
      "original_quote": "吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L010",
      "original_quote": "為廢貨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L011",
      "original_quote": "時幹落宮來生日幹落宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L012",
      "original_quote": "其貨不拘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L013",
      "original_quote": "美惡皆有",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L014",
      "original_quote": "利息來剋日幹落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L015",
      "original_quote": "或乘墓絕及空亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L016",
      "original_quote": "貨皆無利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L017",
      "original_quote": "不必買",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanMaiHuo_L018",
      "original_quote": "餘仿此類推之",
      "tag": []
    }
  ],
