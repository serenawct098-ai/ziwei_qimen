{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "星垣問答論_Pojun",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaPojun_L001",
      "original_quote": "問破軍所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaPojun_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaPojun_L002",
      "original_quote": "答曰：破軍屬水，北斗第七星也，司夫妻、子息、奴僕之神。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaPojun_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaPojun_L003",
      "original_quote": "居子午入廟，在天為殺氣，在數為耗星，故化氣日耗。主人暴凶狡詐，其性奸猾，與人寡合，動輒損人。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaPojun_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaPojun_L004",
      "original_quote": "不成人之善，善助人之惡。虐視六親如寇讎，處骨肉無仁義，惟六癸六甲生人合格主富貴。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaPojun_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaPojun_L005",
      "original_quote": "陷地加殺沖破，巧藝殘疾，不守祖業，僧道宜之。女人沖破淫蕩無恥。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaPojun_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaPojun_L006",
      "original_quote": "此星居紫微則失威權；逢天府則作奸偽；會紫貪則鼠竊狗盜。與廉貞火鈴同度則決起官非；與巨門同度則口舌爭鬥；與刑忌同度，則終身殘疾。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaPojun_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaPojun_L007",
      "original_quote": "與武曲入財位則東傾西敗；與文星守命一生貧士。遇諸凶結黨破敗，遇陷地其禍不輕。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaPojun_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaPojun_L008",
      "original_quote": "惟天梁可制其惡，天祿可解其狂。若逢流殺交併，家業蕩空。與文曲入於水域，殘疾、離鄉。遇文昌於震宮，遇吉可貴。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaPojun_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaPojun_L009",
      "original_quote": "若女命逢之，無媒自嫁，喪節飄流。凡坐人身命居子午，貪狼七殺相拱則威震華夷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaPojun_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaPojun_L010",
      "original_quote": "或與武曲同居巳宮，貪狼拱亦居台閣。但看惡星何如？甲癸生人入格，到老亦不全美也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaPojun_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaPojun_L011",
      "original_quote": "在身命陷地，棄祖離宗；在兄弟骨肉參商；在夫妻不正，主婚姻進退；在子息先損後成；在財帛如湯澆雪；在疾厄致尪贏之疾；在遷移奔走無力；在奴僕謗怨逃走；在官祿主清貧；在田宅陷度，祖基破蕩；在福德多災；在父母破相刑剋。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaPojun_L011",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
  "_extraction_status": "星垣問答論-Pojun星部分完成"
}