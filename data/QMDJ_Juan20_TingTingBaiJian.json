{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan20",
  "section": "亭亭白奸",
  "entries": [
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L000",
      "original_quote": "亭亭白奸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L001",
      "original_quote": "王璋曰：「亭亭者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L002",
      "original_quote": "天之貴神也」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L003",
      "original_quote": "背之而擊其衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L004",
      "original_quote": "其法以月將加時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L005",
      "original_quote": "神後下是",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L006",
      "original_quote": "歌曰：「常從此地擊其衝」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L007",
      "original_quote": "如正月雨水節",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L008",
      "original_quote": "太陽過亥宮之後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L009",
      "original_quote": "乃用登明天月將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L010",
      "original_quote": "將即太陽也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L011",
      "original_quote": "如午時用事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L012",
      "original_quote": "即以月將亥加午上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L013",
      "original_quote": "子加未上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L014",
      "original_quote": "是為亭亭在未",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L015",
      "original_quote": "宜背之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L016",
      "original_quote": "背之者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L017",
      "original_quote": "或坐其上而擊對衝也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L018",
      "original_quote": "又一法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L019",
      "original_quote": "子日在巳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L020",
      "original_quote": "丑日在未",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L021",
      "original_quote": "順行十二宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L022",
      "original_quote": "白奸者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L023",
      "original_quote": "天之奸神也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L024",
      "original_quote": "合於巳亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L025",
      "original_quote": "格於寅申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L026",
      "original_quote": "當合之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L027",
      "original_quote": "宜背之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L028",
      "original_quote": "當格之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L029",
      "original_quote": "背亭亭向白奸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L030",
      "original_quote": "其法以月將加時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L031",
      "original_quote": "寅午戌三宮見寅申巳亥四孟神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L032",
      "original_quote": "即白奸所在",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L033",
      "original_quote": "如正月雨水節",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L034",
      "original_quote": "太陽過亥宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L035",
      "original_quote": "或午時用事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L036",
      "original_quote": "以登明亥將加午上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L037",
      "original_quote": "以亥臨午",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L038",
      "original_quote": "即為白奸在午之數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L039",
      "original_quote": "又一法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L040",
      "original_quote": "寅午戌日白奸在亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L041",
      "original_quote": "亥卯未日白奸在寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L042",
      "original_quote": "申子辰日白奸在巳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L043",
      "original_quote": "巳酉丑日白奸在申",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L044",
      "original_quote": "日子丑寅卯辰巳午未申酉戌亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L045",
      "original_quote": "亭亭方巳午未申酉戌亥子丑寅卯辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L046",
      "original_quote": "白奸方巳申亥寅巳申亥寅巳申亥寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L047",
      "original_quote": "月正二三四五六七八九十十一十二",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L048",
      "original_quote": "亭亭卯辰巳午未申酉戌亥子丑寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_TingTingBaiJian_L049",
      "original_quote": "白奸亥寅巳申亥寅巳申亥寅巳申",
      "tag": []
    }
  ],
