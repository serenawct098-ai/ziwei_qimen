      "original_quote": "開男闔女斷因依",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L146",
      "original_quote": "仲甲胎懸孕將產",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L147",
      "original_quote": "開闔小產刑衝機",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L148",
      "original_quote": "季甲胎虛即產子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L149",
      "original_quote": "開合虎馬定時期",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L150",
      "original_quote": "孟利初胎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L151",
      "original_quote": "仲利次胎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L152",
      "original_quote": "季利三胎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L153",
      "original_quote": "看年命落何甲下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L154",
      "original_quote": "論干支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L155",
      "original_quote": "日乾為母時干子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L156",
      "original_quote": "納音之中辨男女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L157",
      "original_quote": "順生利產逆生時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L158",
      "original_quote": "化合胎刑奇耦取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L159",
      "original_quote": "旺相休囚與孤虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L160",
      "original_quote": "課元用神飛伏旨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L161",
      "original_quote": "大象無疵是吉徵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L162",
      "original_quote": "化父化鬼憂危體",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L163",
      "original_quote": "行年木命納音詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L164",
      "original_quote": "天喜生氣時方舉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L165",
      "original_quote": "論值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L166",
      "original_quote": "產母直符子六合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L167",
      "original_quote": "刑因旺相吉凶訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L168",
      "original_quote": "蛇白催六是生期",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L169",
      "original_quote": "地陰合六當出月",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L170",
      "original_quote": "推求時日兩不傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L171",
      "original_quote": "子母團圓不須說",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L172",
      "original_quote": "專責符元起何親",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L173",
      "original_quote": "輪飛之宮可生合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L174",
      "original_quote": "吉凶男女細參詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L175",
      "original_quote": "陰陽奇耦官儀撥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L176",
      "original_quote": "論值使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L177",
      "original_quote": "值使推詳羆與熊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L178",
      "original_quote": "門吉陽宮產豹龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L179",
      "original_quote": "陰門陰宮瑤池女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L180",
      "original_quote": "刑格空亡最忌逢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L181",
      "original_quote": "宮制門兮多不育",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L182",
      "original_quote": "門制宮兮畧有驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L183",
      "original_quote": "若卜胎產全吉利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L184",
      "original_quote": "宮馬相生天馬騰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L185",
      "original_quote": "論十干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L186",
      "original_quote": "儀主母兮奇主男",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L187",
      "original_quote": "生合刑囚逐類看",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L188",
      "original_quote": "胎養生死詳時日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L189",
      "original_quote": "起元飛加上下探",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L190",
      "original_quote": "論九星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L191",
      "original_quote": "九星陰陽判胎孕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L192",
      "original_quote": "旺相休囚時日論",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L193",
      "original_quote": "胎逢死廢孤與虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L194",
      "original_quote": "起飛宮次五行門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L195",
      "original_quote": "入墓逢生辨速遲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L196",
      "original_quote": "當今孕寔產將近",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L197",
      "original_quote": "就中形體可參詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L198",
      "original_quote": "入鬼入財與入印",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L199",
      "original_quote": "化空逢生產物客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L200",
      "original_quote": "化死坐墓產憂門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L201",
      "original_quote": "論九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L202",
      "original_quote": "九宮起元分節氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L203",
      "original_quote": "節氣分時猶阻滯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L204",
      "original_quote": "胎臨馬兮當轉移",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L205",
      "original_quote": "長生得馬產育易",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L206",
      "original_quote": "金火逢空將臨盆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L207",
      "original_quote": "水木逢空擬不濟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L208",
      "original_quote": "廢土空陷必墮胎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L209",
      "original_quote": "酌取年命斷來意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L210",
      "original_quote": "論門戶三甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L211",
      "original_quote": "占斷胎產有妙訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L212",
      "original_quote": "門戶陰陽甲開合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L213",
      "original_quote": "陽開問產盡亨通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L214",
      "original_quote": "陰闔胎安不須忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L215",
      "original_quote": "論吉凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L216",
      "original_quote": "返首偏宜問孕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L217",
      "original_quote": "跌穴占產為祥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L218",
      "original_quote": "白虎猖狂產母似有驚險",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L219",
      "original_quote": "青龍逃走孕子恐有淒惶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L220",
      "original_quote": "遁格雖多吉利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L221",
      "original_quote": "其中尚有微疵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L222",
      "original_quote": "詐假本非凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L223",
      "original_quote": "胎產各有疑忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L224",
      "original_quote": "三奇得使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L225",
      "original_quote": "究儀神之陰陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L226",
      "original_quote": "可辨弄章弄瓦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L227",
      "original_quote": "玉女守門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L228",
      "original_quote": "考宮次之主墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L229",
      "original_quote": "遂知男吉女良",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L230",
      "original_quote": "蛇夭矯而孕非禎祥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L231",
      "original_quote": "也遂虞穩婆作弊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L232",
      "original_quote": "雀投江而子之長年",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L233",
      "original_quote": "又兼小產須防",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L234",
      "original_quote": "伏乾飛幹產母未免啾唧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L235",
      "original_quote": "飛宮伏宮嬰兒必定狼當",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L236",
      "original_quote": "大格小格母子鮮獲全濟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L237",
      "original_quote": "刑格悖格胎前產後不昌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L238",
      "original_quote": "歲月格而胎重如山",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L239",
      "original_quote": "時日格而坐草徬徨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L240",
      "original_quote": "入白入熒胎產應分遲速",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L241",
      "original_quote": "而吉凶逐宮推算",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L242",
      "original_quote": "返吟伏吟胎產責辨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L243",
      "original_quote": "星門而返伏二項分詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L244",
      "original_quote": "星軺而胎不寔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L245",
      "original_quote": "門反而臨產乖張",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L246",
      "original_quote": "若是星門皆反",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L247",
      "original_quote": "雖然產速有妨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L248",
      "original_quote": "不遇兮災異",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L249",
      "original_quote": "刑擊兮凶殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L250",
      "original_quote": "入墓網羅產不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_TaiChanZhan_L251",
      "original_quote": "男女年命不可忘",
      "tag": []
    }
