{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan28",
  "section": "甲寅符",
  "entries": [
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L000",
      "original_quote": "甲寅符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L001",
      "original_quote": "甲寅神君號曰「六孽將軍」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L002",
      "original_quote": "其名灌佳郎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L003",
      "original_quote": "其神虎首人身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L004",
      "original_quote": "高一丈有奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L005",
      "original_quote": "性最躁不可輕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L006",
      "original_quote": "扶強抑弱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L007",
      "original_quote": "黨正害邪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L008",
      "original_quote": "神居天苑之位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L009",
      "original_quote": "常游六吉之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L010",
      "original_quote": "統領神將七萬七千七百七十數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L011",
      "original_quote": "綸綰青黑下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L012",
      "original_quote": "符式長一尺八寸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L013",
      "original_quote": "濶二寸七分",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L014",
      "original_quote": "用青紙圬研紅朱為上吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L015",
      "original_quote": "右畫六甲神符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L016",
      "original_quote": "用劍訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L017",
      "original_quote": "以左手大指杜天罡捧劍跌坐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L018",
      "original_quote": "默念六甲神咒七遍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L019",
      "original_quote": "吸東方一口氣吹入神筆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L020",
      "original_quote": "一氣呵成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L021",
      "original_quote": "用天池水一瓶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L022",
      "original_quote": "將符焚在瓶中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L023",
      "original_quote": "壓不利之門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L024",
      "original_quote": "化凶為吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L025",
      "original_quote": "咒曰：「吾呼六君元陽甲子神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L026",
      "original_quote": "急來速去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L027",
      "original_quote": "願君証吾身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L028",
      "original_quote": "魁康卯勺未吉並",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan28_JiaYinFu_L029",
      "original_quote": "召奉太上老君急急如律令」",
      "tag": []
    }
  ],
  "_source": {
