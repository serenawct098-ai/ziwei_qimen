{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "定貧賤局",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L001",
      "original_quote": "生不逢時：命坐空亡逢廉貞是也。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L002",
      "original_quote": "祿逢兩殺：祿坐空亡又逢空劫殺星是也。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L003",
      "original_quote": "馬落空亡：馬既落亡雖祿沖會無用主奔波。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L004",
      "original_quote": "日月藏輝：日月反背又逢巨暗是也。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L005",
      "original_quote": "財與囚仇：武貞同守身命是也。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L006",
      "original_quote": "一生孤貧：謂破守命星陷地是也。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L007",
      "original_quote": "君子在野：謂四殺守身命而言臨陷地是也。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L008",
      "original_quote": "兩重華蓋：謂祿存化祿坐命遇空劫是也。",
      "tag": []
    }
  ],
  "_extraction_status": "定貧賤局完成"
}