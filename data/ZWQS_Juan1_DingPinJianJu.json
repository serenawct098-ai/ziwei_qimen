  "entries": [
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L000",
      "original_quote": "定貧賤局",
      "tag": [],
      "paragraph_index": 0
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L001",
      "original_quote": "定貧賤局⽣不逢時命坐空亡逢廉貞是也｡",
      "tag": [],
      "paragraph_index": 0
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L002",
      "original_quote": "祿逢兩殺祿坐空亡⼜逢空劫殺星是也｡",
      "tag": [],
      "paragraph_index": 0
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L003",
      "original_quote": "⾺落空亡⾺既落亡雖祿沖會無⽤主奔波｡",
      "tag": [],
      "paragraph_index": 0
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L004",
      "original_quote": "⽇⽉藏輝⽇⽉反背⼜逢巨暗是也｡",
      "tag": [],
      "paragraph_index": 0
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L005",
      "original_quote": "財與囚仇武貞同守⾝命是也｡",
      "tag": [],
      "paragraph_index": 0
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L006",
      "original_quote": "⼀⽣孤貧謂破守命星陷地是也｡",
      "tag": [],
      "paragraph_index": 0
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L007",
      "original_quote": "君⼦在野謂四殺守⾝命⽽⾔臨陷地是也｡",
      "tag": [],
      "paragraph_index": 0
    },
    {
      "line_id": "ZWQS_Juan1_DingPinJianJu_L008",
      "original_quote": "兩重華蓋謂祿存化祿坐命遇空劫是也｡",
      "tag": [],
      "paragraph_index": 0
    }
  ],
