{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan23",
  "section": "奇門掌中金要訣",
  "entries": [
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L000",
      "original_quote": "奇門掌中金要訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L001",
      "original_quote": "奇門玄妙九宮邊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L002",
      "original_quote": "即邊九掌訣也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L003",
      "original_quote": "遁至奇儀順逆傳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L004",
      "original_quote": "陽遁順布六儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L005",
      "original_quote": "甲子戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L006",
      "original_quote": "甲戌己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L007",
      "original_quote": "甲申庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L008",
      "original_quote": "甲午辛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L009",
      "original_quote": "甲辰壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L010",
      "original_quote": "甲寅癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L011",
      "original_quote": "逆布三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L012",
      "original_quote": "星奇丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L013",
      "original_quote": "月奇丙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L014",
      "original_quote": "日奇乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L015",
      "original_quote": "陰遁逆布六儀順布三奇也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L016",
      "original_quote": "宮局星門隨甲換",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L017",
      "original_quote": "假如陽遁二局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L018",
      "original_quote": "就在邊九宮坤二上起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L019",
      "original_quote": "甲子至某時止",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L020",
      "original_quote": "甲旬符頭落在何宮?就將此宮星門二處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L021",
      "original_quote": "星為值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L022",
      "original_quote": "門為值使也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L023",
      "original_quote": "日時須遁五子元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L024",
      "original_quote": "甲己還加甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L025",
      "original_quote": "乙庚丙作初",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L026",
      "original_quote": "丙辛生戊子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L027",
      "original_quote": "丁壬庚子居",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L028",
      "original_quote": "戊癸何方落",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L029",
      "original_quote": "壬子是真途",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L030",
      "original_quote": "先將甲旬求符使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L031",
      "original_quote": "即前甲旬落在宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L032",
      "original_quote": "星符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L033",
      "original_quote": "門使也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L034",
      "original_quote": "次覓時辰幾宮安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L035",
      "original_quote": "本時落宮在何宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L036",
      "original_quote": "就以值門加之為使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L037",
      "original_quote": "再看時幹幾宮落",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L038",
      "original_quote": "假如以甲子至某甲符頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L039",
      "original_quote": "於邊九宮上算至甲宮止",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L040",
      "original_quote": "所餘者就是奇也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L041",
      "original_quote": "陽遁丙丁乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L042",
      "original_quote": "陰遁乙丙丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L043",
      "original_quote": "從上一宮甲子起戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L044",
      "original_quote": "己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L045",
      "original_quote": "庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L046",
      "original_quote": "辛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L047",
      "original_quote": "壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L048",
      "original_quote": "癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L049",
      "original_quote": "看本時幹落於何宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L050",
      "original_quote": "即值符在此也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L051",
      "original_quote": "乙丙丁所在亦然",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L052",
      "original_quote": "宮數星門記的端",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L053",
      "original_quote": "須記明宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L054",
      "original_quote": "星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L055",
      "original_quote": "門便成局矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L056",
      "original_quote": "八卦有定位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L057",
      "original_quote": "雖遇陰陽二遁亦不飛動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L058",
      "original_quote": "九星亦有定宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L059",
      "original_quote": "須隨值符而飛者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L060",
      "original_quote": "看某局上起子至某甲符頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L061",
      "original_quote": "即分星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L062",
      "original_quote": "又數至某時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L063",
      "original_quote": "即為門也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L064",
      "original_quote": "如甲子上起戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L065",
      "original_quote": "至時幹上之類也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L066",
      "original_quote": "便將符使九宮飛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L067",
      "original_quote": "於掌上飛九宮方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L068",
      "original_quote": "知前奇門吉凶下落",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L069",
      "original_quote": "休到二宮從二起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L070",
      "original_quote": "如陽遁二局甲子日乙丑時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L071",
      "original_quote": "休門飛到坤二宮即住",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L072",
      "original_quote": "便為值使門也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L073",
      "original_quote": "任駐三宮在三起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L074",
      "original_quote": "任從三宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L075",
      "original_quote": "即符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L076",
      "original_quote": "即三宮也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L077",
      "original_quote": "星奇門合是為奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L078",
      "original_quote": "九星奇門俱要合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L079",
      "original_quote": "方可用也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L080",
      "original_quote": "八門干支相加地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L081",
      "original_quote": "八門支干加地盤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L082",
      "original_quote": "俱要相生方用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L083",
      "original_quote": "生剋休旺吉凶稽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L084",
      "original_quote": "以休旺墓剋而推吉凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L085",
      "original_quote": "此是神仙秘密訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan23_ZhangZhongJin_L086",
      "original_quote": "頗得千金不授伊",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan23",
    "section": "奇門掌中金要訣",
