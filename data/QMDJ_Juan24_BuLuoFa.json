{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan24",
  "section": "卜螺法",
  "entries": [
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L000",
      "original_quote": "卜螺法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L001",
      "original_quote": "田中赤色大螺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L002",
      "original_quote": "取時忌婦人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L003",
      "original_quote": "孝子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L004",
      "original_quote": "雞犬見之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L005",
      "original_quote": "凡預卜勝負",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L006",
      "original_quote": "取二螺安於盤中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L007",
      "original_quote": "直畫一路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L008",
      "original_quote": "左為我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L009",
      "original_quote": "右為賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L010",
      "original_quote": "盤中盛水一寸許",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L011",
      "original_quote": "將螺各記之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L012",
      "original_quote": "咒曰：「田螺舞舞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L013",
      "original_quote": "能知風雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L014",
      "original_quote": "賊若來遇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L015",
      "original_quote": "入我境界",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L016",
      "original_quote": "田螺索索",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L017",
      "original_quote": "風雨不著",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L018",
      "original_quote": "賊若不來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L019",
      "original_quote": "各守城郭」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L020",
      "original_quote": "咒畢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L021",
      "original_quote": "候至天明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L022",
      "original_quote": "依法斷之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L023",
      "original_quote": "若賊螺入我境界",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L024",
      "original_quote": "不可與戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L025",
      "original_quote": "宜固守",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L026",
      "original_quote": "我螺入賊界",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L027",
      "original_quote": "宜急攻之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L028",
      "original_quote": "春螺頭向東大利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L029",
      "original_quote": "向南有驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L030",
      "original_quote": "向西被賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L031",
      "original_quote": "向北小吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L032",
      "original_quote": "夏螺頭向東小吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L033",
      "original_quote": "向南大利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L034",
      "original_quote": "向西賊來破我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L035",
      "original_quote": "向北大驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L036",
      "original_quote": "秋螺頭向西大利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L037",
      "original_quote": "向南有神助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L038",
      "original_quote": "向東大吉獲財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L039",
      "original_quote": "向北戰勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L040",
      "original_quote": "我宜守",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L041",
      "original_quote": "冬螺頭向北大利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L042",
      "original_quote": "向西平安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L043",
      "original_quote": "向南賊能散",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L044",
      "original_quote": "向東小驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L045",
      "original_quote": "宜固守吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L046",
      "original_quote": "甲乙日螺頭向東賊來急",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L047",
      "original_quote": "不宜戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L048",
      "original_quote": "向南五日內賊來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L049",
      "original_quote": "向西十四日賊來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L050",
      "original_quote": "向北賊不至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L051",
      "original_quote": "丙丁日螺頭向南九日去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L052",
      "original_quote": "向西七日去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L053",
      "original_quote": "向北當日至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L054",
      "original_quote": "交戰我勝敵敗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L055",
      "original_quote": "向東賊散",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L056",
      "original_quote": "戊己日占",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L057",
      "original_quote": "宜各固守",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L058",
      "original_quote": "庚辛日螺頭向西與賊平",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L059",
      "original_quote": "向北賊散",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L060",
      "original_quote": "向南賊來而複去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L061",
      "original_quote": "向東有賊大戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L062",
      "original_quote": "壬癸日螺頭向南賊不勝而去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L063",
      "original_quote": "向西賊不來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L064",
      "original_quote": "向東各守一方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_BuLuoFa_L065",
      "original_quote": "向北宜平",
      "tag": []
    }
  ],
