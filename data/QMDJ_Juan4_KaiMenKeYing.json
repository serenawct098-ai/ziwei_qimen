  "section": "開門剋應",
  "entries": [
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L000",
      "original_quote": "開門剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L001",
      "original_quote": "加壬：主遺失財後得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L002",
      "original_quote": "賊盜易獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L003",
      "original_quote": "加癸：主婚姻不成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L004",
      "original_quote": "餘事皆吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L005",
      "original_quote": "動應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L006",
      "original_quote": "生門出者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L007",
      "original_quote": "八里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L008",
      "original_quote": "十八里見貴人車馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L009",
      "original_quote": "或公吏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L010",
      "original_quote": "皂衣人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L011",
      "original_quote": "乙奇臨見兔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L012",
      "original_quote": "或二鼠相咬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L013",
      "original_quote": "丙奇臨見病人足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L014",
      "original_quote": "或二人爭財吵鬧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L015",
      "original_quote": "丁奇見漁獵人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L016",
      "original_quote": "此方大利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L017",
      "original_quote": "百事俱利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L018",
      "original_quote": "生門加生：八里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L019",
      "original_quote": "十八里逢朱衣貴人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L020",
      "original_quote": "加傷：三里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L021",
      "original_quote": "十三里逢公吏人持棍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L022",
      "original_quote": "或培土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L023",
      "original_quote": "栽樹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L024",
      "original_quote": "加杜：四里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L025",
      "original_quote": "十四里逢人拿彩色物行唱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L026",
      "original_quote": "並長嘆息者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L027",
      "original_quote": "加景：九里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L028",
      "original_quote": "十九里逢貴人車馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L029",
      "original_quote": "多人相隨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L030",
      "original_quote": "加死：二里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L031",
      "original_quote": "十二里逢孝服人哭泣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L032",
      "original_quote": "加驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L033",
      "original_quote": "七里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L034",
      "original_quote": "十七里逢人趕畜及有人說詞訟事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L035",
      "original_quote": "加開",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L036",
      "original_quote": "六里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L037",
      "original_quote": "十六里逢貴人車馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L038",
      "original_quote": "並有蛇咬豬者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L039",
      "original_quote": "加休",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L040",
      "original_quote": "一里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L041",
      "original_quote": "十一里逢皂衣及扛錢人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L042",
      "original_quote": "占身命：火土金命者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L043",
      "original_quote": "大利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L044",
      "original_quote": "水木命者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L045",
      "original_quote": "不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L046",
      "original_quote": "多厄難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L047",
      "original_quote": "忌甲乙寅卯年月日時者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L048",
      "original_quote": "不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_KaiMenKeYing_L049",
      "original_quote": "若壬癸命主腫脹凶",
      "tag": []
    }
