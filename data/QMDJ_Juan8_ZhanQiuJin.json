{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan8",
  "section": "占囚禁",
  "entries": [
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L000",
      "original_quote": "占囚禁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L001",
      "original_quote": "以甲午為罪人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L002",
      "original_quote": "辛為天獄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L003",
      "original_quote": "壬為地牢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L004",
      "original_quote": "癸為天網",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L005",
      "original_quote": "看日乾之落宮下臨甲午辛者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L006",
      "original_quote": "主凶禁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L007",
      "original_quote": "甲午辛落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L008",
      "original_quote": "下臨地盤壬癸者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L009",
      "original_quote": "為誤入天牢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L010",
      "original_quote": "待衝破之日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L011",
      "original_quote": "必出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L012",
      "original_quote": "若天盤壬癸之乾下臨地盤甲午辛者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L013",
      "original_quote": "為天網蒙頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L014",
      "original_quote": "主囚禁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L015",
      "original_quote": "又如天上星儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L016",
      "original_quote": "落地盤墓庫及壬癸者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L017",
      "original_quote": "終不出獄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L018",
      "original_quote": "竟作獄底之鬼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L019",
      "original_quote": "若落空亡之宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L020",
      "original_quote": "為空獄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanQiuJin_L021",
      "original_quote": "不囚禁",
      "tag": []
    }
  ],
