{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan12",
  "section": "求財占",
  "entries": [
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L000",
      "original_quote": "求財占",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L001",
      "original_quote": "論干支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L002",
      "original_quote": "日元為人時元財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L003",
      "original_quote": "兩支中間債物船",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L004",
      "original_quote": "納音之中定市價",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L005",
      "original_quote": "孤虛旺相著裁量",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L006",
      "original_quote": "日剋時兮財可就",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L007",
      "original_quote": "時剋日兮腦心懷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L008",
      "original_quote": "買貨時支分貴賤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L009",
      "original_quote": "生合人元可買來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L010",
      "original_quote": "賣貨日支分休旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L011",
      "original_quote": "最喜生支又作財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L012",
      "original_quote": "日納如若剋時納",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L013",
      "original_quote": "倍息生意此一回",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L014",
      "original_quote": "時納若剋於日納",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L015",
      "original_quote": "空費心機事不諧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L016",
      "original_quote": "一切藝術圖謀事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L017",
      "original_quote": "亦喜時生鬼化財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L018",
      "original_quote": "大抵上下無刑害",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L019",
      "original_quote": "始終如意不須猜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L020",
      "original_quote": "索債取捕他受制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L021",
      "original_quote": "支納生乾可得來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L022",
      "original_quote": "論值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L023",
      "original_quote": "值符貨物交易情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L024",
      "original_quote": "或生或旺休廢刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L025",
      "original_quote": "賣貨生旺宜售客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L026",
      "original_quote": "買貨休囚當速成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L027",
      "original_quote": "六合中人忌剋休",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L028",
      "original_quote": "勾如傷用必遲行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L029",
      "original_quote": "元朱傷人防失脫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L030",
      "original_quote": "又恐腐爛貨不真",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L031",
      "original_quote": "九地生身宜堆積",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L032",
      "original_quote": "九天生合賣遂心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L033",
      "original_quote": "就使空拳去覓利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L034",
      "original_quote": "亦喜符旺又相生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L035",
      "original_quote": "論值使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L036",
      "original_quote": "值使求財出八方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L037",
      "original_quote": "門無傷剋利偏安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L038",
      "original_quote": "吉門更臨生旺地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L039",
      "original_quote": "腰纏千萬可行藏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L040",
      "original_quote": "若得用門守財令",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L041",
      "original_quote": "坐賈行商不用忙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L042",
      "original_quote": "論十干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L043",
      "original_quote": "奇儀詳兮子與財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L044",
      "original_quote": "子旺財生可遂懷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L045",
      "original_quote": "最喜財庫命臨身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L046",
      "original_quote": "到手時日此中該",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L047",
      "original_quote": "論九星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L048",
      "original_quote": "符星喜旺制財星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L049",
      "original_quote": "財星空旺總勞神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L050",
      "original_quote": "財星化鬼君休覓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L051",
      "original_quote": "鬼化為財白手覆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L052",
      "original_quote": "若還飛入比肩地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L053",
      "original_quote": "其間必定有分爭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L054",
      "original_quote": "財星若去投子舍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L055",
      "original_quote": "我到其方必獲成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L056",
      "original_quote": "論九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L057",
      "original_quote": "起元分辨是何財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L058",
      "original_quote": "土宜布菽慄鹽諧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L059",
      "original_quote": "水木經商火窰冶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L060",
      "original_quote": "金為錢榖珠玉該",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L061",
      "original_quote": "時日會元乘生旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L062",
      "original_quote": "此時端的遂心懷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L063",
      "original_quote": "只有飛伏臨何處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L064",
      "original_quote": "便察從何得將來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L065",
      "original_quote": "論門戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L066",
      "original_quote": "門戶莫與財元劫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L067",
      "original_quote": "生助財宮方安貼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L068",
      "original_quote": "符元更制門戶上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L069",
      "original_quote": "青蚨多翼方門歇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L070",
      "original_quote": "論三甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L071",
      "original_quote": "孟甲原宜去求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L072",
      "original_quote": "仲甲半喜遂心懷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L073",
      "original_quote": "季甲欲求求未得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L074",
      "original_quote": "開闔中間得失裁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L075",
      "original_quote": "論吉凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L076",
      "original_quote": "返首跌穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L077",
      "original_quote": "垂手可得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L078",
      "original_quote": "虎狂龍走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L079",
      "original_quote": "枉自逢迎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L080",
      "original_quote": "得遁格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L081",
      "original_quote": "機變而取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L082",
      "original_quote": "逢詐假設計以求",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L083",
      "original_quote": "得使而中人效力",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L084",
      "original_quote": "守門而坐賈偏宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L085",
      "original_quote": "三門四戶最宜生合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L086",
      "original_quote": "財神天馬私門不宜刑衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L087",
      "original_quote": "符命",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L088",
      "original_quote": "妖矯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L089",
      "original_quote": "而人情反複",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L090",
      "original_quote": "投江而售賣不行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L091",
      "original_quote": "伏宮飛宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L092",
      "original_quote": "此地不比他地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L093",
      "original_quote": "伏乾飛幹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L094",
      "original_quote": "此人不比那人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L095",
      "original_quote": "大小格難以覓利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L096",
      "original_quote": "刑悖隔就早抽身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L097",
      "original_quote": "熒入白兮宜買貨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L098",
      "original_quote": "白入熒兮賣稱情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L099",
      "original_quote": "不遇空費心力",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L100",
      "original_quote": "擊刑此處難求",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L101",
      "original_quote": "入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L102",
      "original_quote": "羅網",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L103",
      "original_quote": "縱見利而不能得手",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L104",
      "original_quote": "反伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L105",
      "original_quote": "門迫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L106",
      "original_quote": "雖懷寶而難入亂邦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L107",
      "original_quote": "最要持納符元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan12_QiuCaiZhan_L108",
      "original_quote": "三才合式不逢鬼劫為詳",
      "tag": []
    }
  ],
