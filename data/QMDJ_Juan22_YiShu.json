    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L131",
      "original_quote": "日乾加庚飛幹推",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L132",
      "original_quote": "更有一般時格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L133",
      "original_quote": "六庚慎勿加三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L134",
      "original_quote": "此時若動出行去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L135",
      "original_quote": "匹馬只輪無返期",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L136",
      "original_quote": "六癸加丁蛇妖矯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L137",
      "original_quote": "憂惶心事何時了",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L138",
      "original_quote": "六癸加丁雀投江",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L139",
      "original_quote": "奸頑訟罣入公堂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L140",
      "original_quote": "六辛加乙虎猖狂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L141",
      "original_quote": "恐懼身親有損傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L142",
      "original_quote": "六乙加辛龍逃走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L143",
      "original_quote": "驚惶凜散財存否",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L144",
      "original_quote": "龍回首兮甲加丙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L145",
      "original_quote": "津悅意應無朽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L146",
      "original_quote": "丙加甲兮鳥跌穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L147",
      "original_quote": "百為舉動成功烈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L148",
      "original_quote": "天盤動用占為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L149",
      "original_quote": "地盤安靜占主穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L150",
      "original_quote": "細看星宮奇門知",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L151",
      "original_quote": "察其刑剋吉凶決",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L152",
      "original_quote": "分其日月旺休方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L153",
      "original_quote": "更辨其方雲氣色",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L154",
      "original_quote": "假如天蓬加九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L155",
      "original_quote": "旺相之月在秋冬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L156",
      "original_quote": "喜逢癸壬亥子日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L157",
      "original_quote": "北方黑氣客有功",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L158",
      "original_quote": "若還天英加一地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L159",
      "original_quote": "冬時北方主反利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L160",
      "original_quote": "奇門星位仿此推",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L161",
      "original_quote": "人在時方分仔細",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L162",
      "original_quote": "自寅至午五陽時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L163",
      "original_quote": "甲乙丙丁戊合宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L164",
      "original_quote": "先與出行為客勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L165",
      "original_quote": "利造姻宮並移徙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L166",
      "original_quote": "自未至亥時五陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L167",
      "original_quote": "己庚辛壬癸幹尋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L168",
      "original_quote": "利主集謀修備用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L169",
      "original_quote": "尤宜禱造與逃離",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L170",
      "original_quote": "十干六甲為宗主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L171",
      "original_quote": "上下交承開闔分",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L172",
      "original_quote": "陽星加一宮開吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L173",
      "original_quote": "陰星一宮闔事凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L174",
      "original_quote": "甲孟宜貞仲宜守",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L175",
      "original_quote": "宮方加季吉序興",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L176",
      "original_quote": "作為進往憑天局",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L177",
      "original_quote": "基穴陰謀靜地乘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L178",
      "original_quote": "若見三奇在五陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L179",
      "original_quote": "偏宜為客自高強",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L180",
      "original_quote": "三奇若遇五陰上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L181",
      "original_quote": "利宜為主志倘徉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L182",
      "original_quote": "三奇積蘊妙難言",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L183",
      "original_quote": "陰逆後占陽順前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L184",
      "original_quote": "每時須別初中末",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L185",
      "original_quote": "總把值符分後先",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L186",
      "original_quote": "乙德往來恍似神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L187",
      "original_quote": "行逢酒饌市財陳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L188",
      "original_quote": "入宮移娶皆宜客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L189",
      "original_quote": "卻忌鞭刑與怒嗔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L190",
      "original_quote": "丙子月奇天威吒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L191",
      "original_quote": "火氣銷金兵不起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L192",
      "original_quote": "市賈入官行遇仙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L193",
      "original_quote": "聽無憂兮聞有喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L194",
      "original_quote": "六丁玉女太陰精",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L195",
      "original_quote": "出入幽冥老不刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L196",
      "original_quote": "謁請入官商娶吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L197",
      "original_quote": "半為憂喜利私營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L198",
      "original_quote": "六戊三門凶不起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L199",
      "original_quote": "來龍萬里誰呵止",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L200",
      "original_quote": "大馬不鳴行客隨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L201",
      "original_quote": "市賈得財驚走否",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L202",
      "original_quote": "己為六合利機謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L203",
      "original_quote": "隱匿如神天莫指",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L204",
      "original_quote": "出入官行利百為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L205",
      "original_quote": "驚逃凶去小人利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L206",
      "original_quote": "六庚加時絕五本",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L207",
      "original_quote": "強出遭凌入天獄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L208",
      "original_quote": "市賈道亡物有傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L209",
      "original_quote": "百宜固守斯為福",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L210",
      "original_quote": "六辛出遇死尸陳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L211",
      "original_quote": "強出天庭罪縛身",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L212",
      "original_quote": "問疾官商婚娶忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L213",
      "original_quote": "自新利決罪刑人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L214",
      "original_quote": "壬是天牢強出焦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L215",
      "original_quote": "邀遮卻利亡與逃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L216",
      "original_quote": "病人進退存餘喘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L217",
      "original_quote": "官吏仇稽百事騷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L218",
      "original_quote": "癸藏出入百憂煎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L219",
      "original_quote": "利病逃亡與覓仙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L220",
      "original_quote": "遁跡隱形人莫曉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L221",
      "original_quote": "病加沉重日纏綿",
      "tag": []
    }
  ],
