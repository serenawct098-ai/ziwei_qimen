    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L016",
      "original_quote": "子房十八局法邃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L017",
      "original_quote": "智慧通神能達微",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L018",
      "original_quote": "四十八格難推致",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L019",
      "original_quote": "予今複古演成書",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L020",
      "original_quote": "易數通微可精義",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L021",
      "original_quote": "中人不知能推詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L022",
      "original_quote": "跬步登階天衢長",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L023",
      "original_quote": "衝輔禽任心最吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L024",
      "original_quote": "三奇加互發禎祥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L025",
      "original_quote": "值符值使嫌衝擊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L026",
      "original_quote": "開休生門為上吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L027",
      "original_quote": "大概要察候與節",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L028",
      "original_quote": "奇門造葬合龍穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L029",
      "original_quote": "開基斬草及行商",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L030",
      "original_quote": "動用作為占方向",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L031",
      "original_quote": "勿度勿疑勿反顧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L032",
      "original_quote": "至誠感應福無強",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L033",
      "original_quote": "三奇得使誠堪用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L034",
      "original_quote": "六甲遇之非小補",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L035",
      "original_quote": "乙歸犬馬丙鼠猴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L036",
      "original_quote": "六丁玉女騎龍虎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L037",
      "original_quote": "又有三奇游六儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L038",
      "original_quote": "號為玉女守門時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L039",
      "original_quote": "甲子己卯並庚午",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L040",
      "original_quote": "丙午丁酉乙卯期",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L041",
      "original_quote": "利作陰私和合事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L042",
      "original_quote": "宮庭宴樂亦堪為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L043",
      "original_quote": "三奇入墓總非宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L044",
      "original_quote": "作事此時防後危",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L045",
      "original_quote": "五不遇時尤可嗔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L046",
      "original_quote": "號為日月損明辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L047",
      "original_quote": "時幹來剋日乾位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L048",
      "original_quote": "百事皆凶莫輕試",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L049",
      "original_quote": "逆順直符統七神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L050",
