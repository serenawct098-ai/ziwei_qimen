    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L014",
      "original_quote": "今古幾時能盡知",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan22_YiShu_L015",
      "original_quote": "一千八百軒轅制",
