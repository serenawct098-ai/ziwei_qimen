{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan7",
  "section": "占升遷",
  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L000",
      "original_quote": "占升遷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L001",
      "original_quote": "凡蒞任日久",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L002",
      "original_quote": "薦多未見超擢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L003",
      "original_quote": "欲知升期",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L004",
      "original_quote": "當以開門決之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L005",
      "original_quote": "因開門為官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L006",
      "original_quote": "掌發印也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L007",
      "original_quote": "開加生旺宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L008",
      "original_quote": "再有三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L009",
      "original_quote": "德合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L010",
      "original_quote": "吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L011",
      "original_quote": "必再遇歲月建乘吉神來生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L012",
      "original_quote": "定然高擢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L013",
      "original_quote": "其有吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L014",
      "original_quote": "而不旺相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L015",
      "original_quote": "或旺相而無吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L016",
      "original_quote": "及旺相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L017",
      "original_quote": "吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L018",
      "original_quote": "而歲月建不來相生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanShengQian_L019",
      "original_quote": "亦不升也",
      "tag": []
    }
  ],
