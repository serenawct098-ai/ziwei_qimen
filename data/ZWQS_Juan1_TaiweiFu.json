      }
    },
    {
      "line_id": "ZWQS_Juan1_TaiweiFu_L004",
      "original_quote": "以 ⾝ 命 為 福 德 之 本 , 加 以 根 源 為 窮 通 之 資 ｡",
      "tag": [],
      "tag_reason": "",
      "_source": {
