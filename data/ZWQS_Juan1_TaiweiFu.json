      }
    },
    {
      "line_id": "ZWQS_Juan1_TaiweiFu_L008",
      "original_quote": "帝 星 動 則 列 宿 奔 馳 , 貪 守 空 ⽽ 財 源 不 聚 ｡",
      "tag": [],
