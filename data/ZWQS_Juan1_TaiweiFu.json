      }
    },
    {
      "line_id": "ZWQS_Juan1_TaiweiFu_L005",
      "original_quote": "星 有 同 躔 , 數 有 分 定 , 須 明 其 ⽣ 剋 之 要 , 必 詳 乎 得 垣 失 度 之 分 ｡",
      "tag": [],
      "tag_reason": "",
      "_source": {
