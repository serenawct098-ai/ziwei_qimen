      }
    },
    {
      "line_id": "ZWQS_Juan1_TaiweiFu_L007",
      "original_quote": "可 移 動 , ⾦ 星 專 司 財 庫 , 最 怕 空 亡 ｡",
      "tag": [],
      "tag_reason": "",
      "_source": {
