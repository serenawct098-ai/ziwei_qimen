{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan21",
  "section": "正超接閏歌",
  "entries": [
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L000",
      "original_quote": "正超接閏歌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L001",
      "original_quote": "甲己居仲上元逢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L002",
      "original_quote": "孟住中位季下宗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L003",
      "original_quote": "五日一元周二遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L004",
      "original_quote": "十時一甲用皆同",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L005",
      "original_quote": "陰陽二遁原洪造",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L006",
      "original_quote": "節氣未來符先訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L007",
      "original_quote": "遲時交節奇未來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L008",
      "original_quote": "超神接氣通元奧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L009",
      "original_quote": "四仲未來節先來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L010",
      "original_quote": "值符仍將本局裁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L011",
      "original_quote": "雖然新節已交氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L012",
      "original_quote": "奈何四仲來胚胎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L013",
      "original_quote": "四仲先來節後至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L014",
      "original_quote": "超用本來之節氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L015",
      "original_quote": "有時超越遇旬餘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L016",
      "original_quote": "所以積餘成閏位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L017",
      "original_quote": "二至之前有閏奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L018",
      "original_quote": "此時積累迭成之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L019",
      "original_quote": "陽極陰終無後飫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_ChaoJieGe_L020",
      "original_quote": "節因此立閏其餘",
      "tag": []
    }
  ],
  "_source": {
