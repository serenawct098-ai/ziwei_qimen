    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L148",
      "original_quote": "陰闔失令荒歉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L149",
      "original_quote": "三甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L150",
      "original_quote": "甲宜早榖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L151",
      "original_quote": "仲甲宜中稻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L152",
      "original_quote": "季甲宜晚禾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L153",
      "original_quote": "陽開無刑不怕旱",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L154",
      "original_quote": "陰闔刑格須慮水",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L155",
      "original_quote": "論干支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L156",
      "original_quote": "日乾農人時幹田",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L157",
      "original_quote": "納音牛力時籽兼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L158",
      "original_quote": "時生日兮宜佃種",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L159",
      "original_quote": "日剋時兮亦許全",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L160",
      "original_quote": "反此須防有災變",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L161",
      "original_quote": "納音化合考先天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L162",
      "original_quote": "課體之中怕金火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L163",
      "original_quote": "蟲荒焦旱查類銓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L164",
      "original_quote": "土木二象宜取用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L165",
      "original_quote": "水象泛濫正堪嫌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L166",
      "original_quote": "逐頂搜看田種子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L167",
      "original_quote": "參詳時令仔細言",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L168",
      "original_quote": "論值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L169",
      "original_quote": "值符六合怕刑傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L170",
      "original_quote": "飛宮伏宮生旺強",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L171",
      "original_quote": "朱蛇元白加臨處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L172",
      "original_quote": "休囚無氣忌猖狂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L173",
      "original_quote": "論值使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L174",
      "original_quote": "值使東作與西成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L175",
      "original_quote": "門次條分優劣情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L176",
      "original_quote": "得令逢水無刑格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L177",
      "original_quote": "用神旺相細多能",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L178",
      "original_quote": "論十干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L179",
      "original_quote": "秧苗花粒逐乾分",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L180",
      "original_quote": "四季天時亦繼陳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L181",
      "original_quote": "主幹乘生無刑擊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L182",
      "original_quote": "佐使兼濟榖如云",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L183",
      "original_quote": "論九星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L184",
      "original_quote": "九星五行各分行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L185",
      "original_quote": "吉星得令有收成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L186",
      "original_quote": "用神天星不生合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L187",
      "original_quote": "人力參差齟齬情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L188",
      "original_quote": "論九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L189",
      "original_quote": "九宮起元論所屬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L190",
      "original_quote": "旺相生合樹藝熟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L191",
      "original_quote": "時逢刑格與孤虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L192",
      "original_quote": "反局古來宜種粟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L193",
      "original_quote": "論門戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L194",
      "original_quote": "四季令星登門戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L195",
      "original_quote": "無隔無刑榖麥富",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L196",
      "original_quote": "門吉戶凶秋實虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L197",
      "original_quote": "戶吉門凶春作悞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L198",
      "original_quote": "論三甲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L199",
      "original_quote": "三甲查分播種田",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L200",
      "original_quote": "何開何闔各爭先逐類未",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L201",
      "original_quote": "三吉三勝來湊合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L202",
      "original_quote": "如茹如雲寄阡陌隴頭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L203",
      "original_quote": "論吉凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L204",
      "original_quote": "反首跌穴皆為吉象",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L205",
      "original_quote": "倘無刑剋與墓空",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L206",
      "original_quote": "自然千倉與頌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L207",
      "original_quote": "虎狂龍走原作凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L208",
      "original_quote": "推若遇震巽風雲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L209",
      "original_quote": "管教險後豐收",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L210",
      "original_quote": "地遁人遁吉無不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L211",
      "original_quote": "三詐五假權變合宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L212",
      "original_quote": "得使而本類皆豐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L213",
      "original_quote": "守門而本屬傷利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L214",
      "original_quote": "三門四戶出作入息喜恩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L215",
      "original_quote": "逢天馬私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L216",
      "original_quote": "風車水槽怕刑格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L217",
      "original_quote": "蛇夭矯而苗不秀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L218",
      "original_quote": "雀投江而秀入倉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L219",
      "original_quote": "伏乾飛幹蝗蟲災異",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L220",
      "original_quote": "伏宮飛宮耕種狼當",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L221",
      "original_quote": "大格小格水災蟲變",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L222",
      "original_quote": "刑格悖格旱魃為殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L223",
      "original_quote": "年月日時逢悖格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L224",
      "original_quote": "五行消息斷災祥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L225",
      "original_quote": "熒入白兮夏榖有損",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L226",
      "original_quote": "白入熒兮秋來須防",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L227",
      "original_quote": "五不遇兮徒勞心力",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L228",
      "original_quote": "六儀刑兮佃種相妨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L229",
      "original_quote": "入墓與羅網",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L230",
      "original_quote": "或因臨界偏生隙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L231",
      "original_quote": "反伏及門迫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L232",
      "original_quote": "縱雖佃種卻心忙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L233",
      "original_quote": "武侯賦比千金訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L234",
      "original_quote": "留為佃種細推詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L235",
      "original_quote": "再查來人行年命",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L236",
      "original_quote": "或逢生旺與刑傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L237",
      "original_quote": "如此會合類神取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_TianHeZhan_L238",
      "original_quote": "判斷佃種驗非常",
      "tag": []
    }
