    {
      "line_id": "ZWQS_Juan1_WendaZuofu_L002",
      "original_quote": "希夷先生答曰：左輔帝極主宰之星，守身命諸宮降福。主人形貌敦厚慷慨風流。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaZuofu_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaZuofu_L003",
      "original_quote": "紫府祿權若得三合沖照，主文武大貴。火忌沖破，雖富貴不久。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaZuofu_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaZuofu_L004",
      "original_quote": "僧道清閑，所以溫重賢曉，旺地封贈。火忌沖破，以中局斷之。",
      "tag": [],
