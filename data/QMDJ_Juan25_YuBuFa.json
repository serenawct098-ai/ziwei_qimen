{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan25",
  "section": "禹步法",
  "entries": [
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L000",
      "original_quote": "禹步法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L001",
      "original_quote": "禹步法凡作事皆宜禹步",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L002",
      "original_quote": "初移一步",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L003",
      "original_quote": "不在九步之數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L004",
      "original_quote": "然相因仍之一步七尺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L005",
      "original_quote": "合二丈一尺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L006",
      "original_quote": "故曰：見跡禹步",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L007",
      "original_quote": "乃成攝濟之卦",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L008",
      "original_quote": "正立右足以前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L009",
      "original_quote": "左足在後",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L010",
      "original_quote": "次複前左足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L011",
      "original_quote": "次複前右足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L012",
      "original_quote": "以左足從右足並一禹步也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L013",
      "original_quote": "次複前右足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L014",
      "original_quote": "次前左足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L015",
      "original_quote": "並二禹步也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L016",
      "original_quote": "次複前左",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L017",
      "original_quote": "次前右",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L018",
      "original_quote": "次左右足並",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L019",
      "original_quote": "三禹步也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L020",
      "original_quote": "未濟禹跡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L021",
      "original_quote": "芮坤右柱兌左心幹右",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L022",
      "original_quote": "英離左禽中左蓬坎左",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L023",
      "original_quote": "輔巽右衝震左任艮右",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L024",
      "original_quote": "既濟禹跡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L025",
      "original_quote": "芮坤右柱兌左心幹右",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L026",
      "original_quote": "英離左禽中左蓬坎左",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L027",
      "original_quote": "輔巽右衝震左任艮右",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L028",
      "original_quote": "巽雙離只坤單步",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L029",
      "original_quote": "震亦依依兌是雙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L030",
      "original_quote": "艮上獨行坎只立",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L031",
      "original_quote": "天門歸去望天罡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L032",
      "original_quote": "坤只兌只雙幹雙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L033",
      "original_quote": "離只中坎只",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuBuFa_L034",
      "original_quote": "巽雙震只艮雙只",
      "tag": []
    }
  ],
