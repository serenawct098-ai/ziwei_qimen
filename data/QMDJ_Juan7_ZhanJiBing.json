{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan7",
  "section": "占疾病",
  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L000",
      "original_quote": "占疾病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L001",
      "original_quote": "占干謁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L002",
      "original_quote": "干謁專看休門宮分如天盤休加震為本宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L003",
      "original_quote": "為所見之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L004",
      "original_quote": "時干宮天上時干加地盤坎方為水之類為所往之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L005",
      "original_quote": "加休門宮生時干宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L006",
      "original_quote": "而時干宮又有三奇臨之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L007",
      "original_quote": "遂意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L008",
      "original_quote": "如相剋制又無三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L009",
      "original_quote": "不得見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L010",
      "original_quote": "或不喜悅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L011",
      "original_quote": "所求不遂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L012",
      "original_quote": "又要彼此二宮旺相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L013",
      "original_quote": "有一處休咎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L014",
      "original_quote": "即不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L015",
      "original_quote": "若所見之方得休門臨之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJiBing_L016",
      "original_quote": "亦相見也",
      "tag": []
    }
  ],
