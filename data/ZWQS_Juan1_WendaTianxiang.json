{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "星垣問答論_Tianxiang",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaTianxiang_L001",
      "original_quote": "問天相星所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxiang_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxiang_L002",
      "original_quote": "答曰：天相屬水，南斗第五星也。為司爵之宿，為福善，化氣日印，是為官祿文星，佐帝之位。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxiang_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxiang_L003",
      "original_quote": "若人命逢之，言語誠實，事不虛偽。見人難，有惻隱之心；見人惡，抱不平之氣。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxiang_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxiang_L004",
      "original_quote": "官祿得之則顯榮，帝座合之則爭權。佐日月之光，兼化廉貞之惡。身命得之而榮耀；子女得之而嗣續昌，十二宮中皆為祥福，不隨惡而變志，不因殺而改移。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxiang_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxiang_L005",
      "original_quote": "限步逢之，富不可量。此星若臨生旺之鄉，雖不逢帝座，若得左右，則職掌威權。或居閑弱之地，也作吉利，二限逢之主富貴。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxiang_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxiang_L006",
      "original_quote": "希夷先生曰：天相南斗司爵之星，化氣為印。主人衣食豐足，昌曲左右相會，位至公卿。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxiang_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxiang_L007",
      "original_quote": "陷地貪廉武破羊陀殺湊，巧藝安身。火鈴沖破殘疾，女人主聰明端莊，志過丈夫。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxiang_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxiang_L008",
      "original_quote": "三方吉拱封贈論，若昌曲沖破侍妾，在僧道主清高。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxiang_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxiang_L009",
      "original_quote": "歌曰",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxiang_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxiang_L010",
      "original_quote": "天相原屬水，化印主官祿，身命二宮逢，定主多財福，形體又肥滿，語言不輕瀆，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxiang_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxiang_L011",
      "original_quote": "出仕主飛騰，居家主財穀，二限若逢之，百事看充足。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxiang_L011",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
