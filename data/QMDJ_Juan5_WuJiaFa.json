{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan5",
  "section": "五假法",
  "entries": [
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L000",
      "original_quote": "五假法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L001",
      "original_quote": "天假：景門合乙丙丁三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L002",
      "original_quote": "下臨地盤九天宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L003",
      "original_quote": "名曰「天假」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L004",
      "original_quote": "乙為天德",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L005",
      "original_quote": "丙為天威",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L006",
      "original_quote": "丁為太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L007",
      "original_quote": "凡三奇之靈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L008",
      "original_quote": "宜陳事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L009",
      "original_quote": "利便",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L010",
      "original_quote": "進謁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L011",
      "original_quote": "乾求之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L012",
      "original_quote": "大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L013",
      "original_quote": "地假：杜門合丁己癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L014",
      "original_quote": "下臨地盤九地宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L015",
      "original_quote": "名曰「地假」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L016",
      "original_quote": "宜潛藏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L017",
      "original_quote": "埋伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L018",
      "original_quote": "此三時宜遁跡藏形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L019",
      "original_quote": "地假：傷門合丁己癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L020",
      "original_quote": "下臨地盤太陰宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L021",
      "original_quote": "亦名「地假」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L022",
      "original_quote": "宜遣人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L023",
      "original_quote": "行間諜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L024",
      "original_quote": "謀探私事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L025",
      "original_quote": "又如六合宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L026",
      "original_quote": "亦名「地假」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L027",
      "original_quote": "宜逃亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L028",
      "original_quote": "躲災",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L029",
      "original_quote": "避難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L030",
      "original_quote": "神假：傷門合丁己癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L031",
      "original_quote": "下臨地盤九地宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L032",
      "original_quote": "名曰「神假」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L033",
      "original_quote": "利埋葬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L034",
      "original_quote": "伏藏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L035",
      "original_quote": "人不能知也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L036",
      "original_quote": "人假：驚門合六合一作六壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L037",
      "original_quote": "下臨地盤九天宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L038",
      "original_quote": "名曰「人假」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L039",
      "original_quote": "利捕捉逃亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L040",
      "original_quote": "若太白入熒惑在其下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L041",
      "original_quote": "必獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L042",
      "original_quote": "鬼假：死門合丁己癸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L043",
      "original_quote": "下臨地盤九地宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L044",
      "original_quote": "名曰「鬼假」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L045",
      "original_quote": "利超亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L046",
      "original_quote": "薦度",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L047",
      "original_quote": "一作臨「三隱宮」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L048",
      "original_quote": "疑即地盤之三吉門也?三隱宮太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L049",
      "original_quote": "六合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_WuJiaFa_L050",
      "original_quote": "九地",
      "tag": []
    }
  ],
