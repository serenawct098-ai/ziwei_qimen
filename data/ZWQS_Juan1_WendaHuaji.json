  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaHuaji_L001",
      "original_quote": "問化忌星所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
