{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "八門吉凶歌",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L000",
      "original_quote": "八門吉凶歌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L001",
      "original_quote": "休門水神貪狼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L002",
      "original_quote": "求公乾私遇休門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L003",
      "original_quote": "求財參謁貴人欽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L004",
      "original_quote": "欲速同行吉相助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L005",
      "original_quote": "出入嫁娶五福臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L006",
      "original_quote": "休門己見百般食",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L007",
      "original_quote": "出入經行得恁強",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L008",
      "original_quote": "但求休門門見路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L009",
      "original_quote": "更逢吉利和衷腸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L010",
      "original_quote": "生門土神左輔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L011",
      "original_quote": "此門爭財見官訟兆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L012",
      "original_quote": "嫁娶避走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L013",
      "original_quote": "二十里見飛鳥來迎之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L014",
      "original_quote": "大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L015",
      "original_quote": "但凡出入遇生門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L016",
      "original_quote": "吉曜臨之萬事成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L017",
      "original_quote": "若有凶神相隔輟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L018",
      "original_quote": "求財所得利稱心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L019",
      "original_quote": "生門已見好經營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L020",
      "original_quote": "百事流通得稱情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L021",
      "original_quote": "此門出入逢歡喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L022",
      "original_quote": "但求經營喜氣生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L023",
      "original_quote": "傷門木神祿存",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L024",
      "original_quote": "此門出行必見精怪嚇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L025",
      "original_quote": "喧事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L026",
      "original_quote": "扭洩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L027",
      "original_quote": "血傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L028",
      "original_quote": "出入求財如遇傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L029",
      "original_quote": "更逢吉曜亦難當",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L030",
      "original_quote": "跟前人惹疼病禍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L031",
      "original_quote": "自身須防有災殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L032",
      "original_quote": "傷門往往是非傳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L033",
      "original_quote": "若出門來有禍僽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L034",
      "original_quote": "採捕稱心雖是好",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L035",
      "original_quote": "其餘不得不憂煎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L036",
      "original_quote": "杜門木神文曲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L037",
      "original_quote": "此門宜出行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L038",
      "original_quote": "謁貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L039",
      "original_quote": "求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L040",
      "original_quote": "或遇避者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L041",
      "original_quote": "剋難吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L042",
      "original_quote": "杜門公用各施行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L043",
      "original_quote": "亦見門中有吉星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L044",
      "original_quote": "茶酒自然留客住",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L045",
      "original_quote": "忻歡百事喜相成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L046",
      "original_quote": "杜門曾見好經營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L047",
      "original_quote": "出入從來未稱情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L048",
      "original_quote": "若然逃遁如避難",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L049",
      "original_quote": "即是元木也不成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L050",
      "original_quote": "景門火神廉貞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L051",
      "original_quote": "此門出行見貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L052",
      "original_quote": "博戲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L053",
      "original_quote": "爭逐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L054",
      "original_quote": "捕獵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L055",
      "original_quote": "行四十里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L056",
      "original_quote": "必見喜樂聲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L057",
      "original_quote": "遠行出入景門中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L058",
      "original_quote": "無剋無生平吉凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L059",
      "original_quote": "若值星辰方位惡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L060",
      "original_quote": "心頭作事亦難通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L061",
      "original_quote": "景門出入且宜良",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L062",
      "original_quote": "玩賞嬉中第一強",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L063",
      "original_quote": "採獵捕魚人少得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L064",
      "original_quote": "無憂無喜見安康",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L065",
      "original_quote": "死門土神巨門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L066",
      "original_quote": "此門宜出獵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L067",
      "original_quote": "張捕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L068",
      "original_quote": "殺生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L069",
      "original_quote": "千死一生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L070",
      "original_quote": "行二十里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L071",
      "original_quote": "路旁必見死傷應之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L072",
      "original_quote": "參謁求謀入死門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L073",
      "original_quote": "吉神刻剝不堪論",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L074",
      "original_quote": "若不自身作橫事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L075",
      "original_quote": "其人必定見傷痕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L076",
      "original_quote": "死門不可東西去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L077",
      "original_quote": "大抵為名事莫言",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L078",
      "original_quote": "死傷求哀為不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L079",
      "original_quote": "聖人怎肯教胡傳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L080",
      "original_quote": "驚門金神破軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L081",
      "original_quote": "此門不宜出行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L082",
      "original_quote": "上官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L083",
      "original_quote": "諸事不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L084",
      "original_quote": "行六七里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L085",
      "original_quote": "必見驚怪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L086",
      "original_quote": "犬物騐方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L087",
      "original_quote": "尋求走失出驚門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L088",
      "original_quote": "逃人財物盡都存",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L089",
      "original_quote": "更得吉星變刑剋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L090",
      "original_quote": "在失逃人自失魂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L091",
      "original_quote": "驚門一定有虛驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L092",
      "original_quote": "出入如逢百不成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L093",
      "original_quote": "百般美事休更說",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L094",
      "original_quote": "往往居家不稱情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L095",
      "original_quote": "開門金神武曲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L096",
      "original_quote": "此門宜上官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L097",
      "original_quote": "見貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L098",
      "original_quote": "出入",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L099",
      "original_quote": "求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L100",
      "original_quote": "回避",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L101",
      "original_quote": "三十里必見婦人或穿顏色衣人以應之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L102",
      "original_quote": "開門出入最為良",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L103",
      "original_quote": "萬事亨通大吉昌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L104",
      "original_quote": "出入求財定見喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L105",
      "original_quote": "八方幹事一齊強",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L106",
      "original_quote": "求財出入遇開門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L107",
      "original_quote": "自有欣歡百事成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L108",
      "original_quote": "更值吉星當位照",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_8MenJiXiongGe_L109",
      "original_quote": "相逢酒食笑忻忻",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan30",
    "section": "八門吉凶歌",
    "line_id_start": "QMDJ_Juan30_8MenJiXiongGe_L000",
    "line_id_end": "QMDJ_Juan30_8MenJiXiongGe_L109"
  },
  "_extraction_status": "八門吉凶歌完成"
}