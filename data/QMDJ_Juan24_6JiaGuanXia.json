{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan24",
  "section": "六甲管轄",
  "entries": [
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L000",
      "original_quote": "六甲管轄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L001",
      "original_quote": "甲子旬神名「王文卿」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L002",
      "original_quote": "登壇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L003",
      "original_quote": "拜將令",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L004",
      "original_quote": "領授兵符者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L005",
      "original_quote": "元帥運籌命起兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L006",
      "original_quote": "發儲糧者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L007",
      "original_quote": "皆向其方呼其神之名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L008",
      "original_quote": "而行六十步左轉入太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L009",
      "original_quote": "則發握如神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L010",
      "original_quote": "甲戌旬神名「徐何」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L011",
      "original_quote": "利通伐山林",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L012",
      "original_quote": "平治道途路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L013",
      "original_quote": "分決河道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L014",
      "original_quote": "得於自然",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L015",
      "original_quote": "開路無損",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L016",
      "original_quote": "皆向其方呼其神之名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L017",
      "original_quote": "行六十步左轉入太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L018",
      "original_quote": "則得所願道路自通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L019",
      "original_quote": "甲申旬首名「蓋新」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L020",
      "original_quote": "若入山畋獵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L021",
      "original_quote": "捕捉虎狼蟲獸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L022",
      "original_quote": "皆向其方呼其神之名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L023",
      "original_quote": "而行六十步左轉入太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L024",
      "original_quote": "蟲獸自然不動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L025",
      "original_quote": "甲午旬神名「靈光」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L026",
      "original_quote": "若安營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L027",
      "original_quote": "置陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L028",
      "original_quote": "巡狩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L029",
      "original_quote": "戰鬪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L030",
      "original_quote": "向其方呼其神之名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L031",
      "original_quote": "行六十步左轉入太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L032",
      "original_quote": "則必勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L033",
      "original_quote": "甲辰旬神名「含章」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L034",
      "original_quote": "若求官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L035",
      "original_quote": "拜將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L036",
      "original_quote": "臨民",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L037",
      "original_quote": "赴任",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L038",
      "original_quote": "皆向其方呼其神之名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L039",
      "original_quote": "行六十步左轉入太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L040",
      "original_quote": "則為官不敗悔",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L041",
      "original_quote": "甲寅旬神名「監兵」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L042",
      "original_quote": "若揚兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L043",
      "original_quote": "振武",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L044",
      "original_quote": "教陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L045",
      "original_quote": "蕩寇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L046",
      "original_quote": "行軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L047",
      "original_quote": "征伐不道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L048",
      "original_quote": "皆向其方呼其神之名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L049",
      "original_quote": "行六十步左轉入太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L050",
      "original_quote": "出行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L051",
      "original_quote": "安邊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L052",
      "original_quote": "賊自然不起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L053",
      "original_quote": "以上六甲管轄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L054",
      "original_quote": "五行尊神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L055",
      "original_quote": "體統好靜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L056",
      "original_quote": "行事之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L057",
      "original_quote": "書相制之字則吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L058",
      "original_quote": "蓋六甲內管五行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L059",
      "original_quote": "而動靜無方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L060",
      "original_quote": "其五行而舍勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L061",
      "original_quote": "有相生相剋之道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L062",
      "original_quote": "左手象天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L063",
      "original_quote": "右手法地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L064",
      "original_quote": "神靈好靜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L065",
      "original_quote": "故書五行相制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L066",
      "original_quote": "運化之道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L067",
      "original_quote": "無不兼該",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L068",
      "original_quote": "若欲出兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L069",
      "original_quote": "大將左手中用朱書「強」字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L070",
      "original_quote": "將手捏住",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L071",
      "original_quote": "行六十步左轉入太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L072",
      "original_quote": "能欺弱制勝之道也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L073",
      "original_quote": "若見貴人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L074",
      "original_quote": "求官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L075",
      "original_quote": "及二千石令長",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L076",
      "original_quote": "左手中書「天」字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L077",
      "original_quote": "若商賈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L078",
      "original_quote": "興販",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L079",
      "original_quote": "和結交友",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L080",
      "original_quote": "嫁娶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L081",
      "original_quote": "立契",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L082",
      "original_quote": "則書「和」字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L083",
      "original_quote": "若入山",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L084",
      "original_quote": "捕獵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L085",
      "original_quote": "畋獵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L086",
      "original_quote": "則書「獅」字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L087",
      "original_quote": "若部工居眾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L088",
      "original_quote": "則書「強」字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L089",
      "original_quote": "若過河",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L090",
      "original_quote": "治水",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L091",
      "original_quote": "則書「土」字或「戊」字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L092",
      "original_quote": "若波浪騰聲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L093",
      "original_quote": "舟楫將溺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L094",
      "original_quote": "尤忌八風",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L095",
      "original_quote": "觸水龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L096",
      "original_quote": "招搖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L097",
      "original_quote": "咸池之日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L098",
      "original_quote": "宜書「戊」字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L099",
      "original_quote": "若游山",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L100",
      "original_quote": "入道",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L101",
      "original_quote": "則書「龍」字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L102",
      "original_quote": "龍不敢動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L103",
      "original_quote": "值符臨其方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L104",
      "original_quote": "前行六十步左轉入太陰中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L105",
      "original_quote": "得此者天道亨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_6JiaGuanXia_L106",
      "original_quote": "此五行制勝之妙用也",
      "tag": []
    }
  ],
