{
  "text": "奇門遁甲秘笈大全",
  "juan": "卷一",
  "section": "煙波釣叟歌",
  "entries": [
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L000",
      "original_quote": "煙波釣叟歌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L001",
      "original_quote": "陰暘順逆妙難窮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L002",
      "original_quote": "二至還鄉一九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L003",
      "original_quote": "若能了達陰陽理",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L004",
      "original_quote": "天地都來一掌中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L005",
      "original_quote": "軒轅黃帝戰蚩尤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L006",
      "original_quote": "涿鹿經年苦未休",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L007",
      "original_quote": "偶夢天神授符訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L008",
      "original_quote": "登壇致祭謹虔修",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L009",
      "original_quote": "神龍負圖出洛水",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L010",
      "original_quote": "彩鳳銜書碧雲裏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L011",
      "original_quote": "因命風後演成文",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L012",
      "original_quote": "遁甲奇門從此始",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L013",
      "original_quote": "一千八十當時制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L014",
      "original_quote": "太公刪成七十二",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L015",
      "original_quote": "逮於漢代張子房",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L016",
      "original_quote": "一十八局為精藝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L017",
      "original_quote": "先須掌上排九宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L018",
      "original_quote": "縱橫十五圖其中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L019",
      "original_quote": "次將八卦分八節",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L020",
      "original_quote": "一氣統三為正宗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L021",
      "original_quote": "陰陽二遁分順逆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L022",
      "original_quote": "一氣三元人莫測",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L023",
      "original_quote": "五日都來換一元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L024",
      "original_quote": "接氣超神為准則",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L025",
      "original_quote": "認取九宮分九星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L026",
      "original_quote": "八門又逐九宮行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L027",
      "original_quote": "九宮逢甲為值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L028",
      "original_quote": "八門值使自分明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L029",
      "original_quote": "符上之門為值使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L030",
      "original_quote": "十時一易堪憑據",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L031",
      "original_quote": "值符常遣加時幹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L032",
      "original_quote": "值使順逆遁宮去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L033",
      "original_quote": "六甲元號六儀名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L034",
      "original_quote": "三奇即是乙丙丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L035",
      "original_quote": "陽遁順儀奇逆布",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L036",
      "original_quote": "陰遁逆儀奇順行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L037",
      "original_quote": "吉門偶合爾三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L038",
      "original_quote": "萬事開三萬事宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L039",
      "original_quote": "更合從傍加檢點",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L040",
      "original_quote": "餘宮不可有微疵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L041",
      "original_quote": "三奇得使誠堪使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L042",
      "original_quote": "六甲遇之非小補",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L043",
      "original_quote": "乙逢犬馬丙鼠猴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L044",
      "original_quote": "六丁玉女騎龍虎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L045",
      "original_quote": "又有三奇游六儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L046",
      "original_quote": "號為玉女守門扉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L047",
      "original_quote": "若作陰私和合事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L048",
      "original_quote": "請君但向此中推",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L049",
      "original_quote": "天三門兮地四戶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L050",
      "original_quote": "問君此法如何處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L051",
      "original_quote": "太衝小吉與從魁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L052",
      "original_quote": "此是天門私出路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L053",
      "original_quote": "地戶除危定與開",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L054",
      "original_quote": "舉事皆從此中去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L055",
      "original_quote": "六合太陰太常君",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L056",
      "original_quote": "三辰元是地私門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L057",
      "original_quote": "更得奇門相照輝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L058",
      "original_quote": "出行百事總欣欣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L059",
      "original_quote": "太衝天馬最為貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L060",
      "original_quote": "猝然有難宜逃避",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L061",
      "original_quote": "但能乘馭天馬行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L062",
      "original_quote": "劍戟如山不足畏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L063",
      "original_quote": "三為生氣五為死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L064",
      "original_quote": "勝在三兮衰在五",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L065",
      "original_quote": "能識游三避五時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L066",
      "original_quote": "造化真機須記取",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L067",
      "original_quote": "就中伏吟為最凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L068",
      "original_quote": "天蓬加著地天蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L069",
      "original_quote": "天蓬若到天英上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L070",
      "original_quote": "須知即是返吟宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L071",
      "original_quote": "八門反伏皆如此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L072",
      "original_quote": "生在生兮死在死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L073",
      "original_quote": "就是凶宿得奇門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L074",
      "original_quote": "萬事皆凶不堪使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L075",
      "original_quote": "六儀擊刑何太凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L076",
      "original_quote": "甲子直符愁向東",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L077",
      "original_quote": "戌刑未上申刑虎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L078",
      "original_quote": "寅巳辰辰午刑午",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L079",
      "original_quote": "三奇入墓宜細推",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L080",
      "original_quote": "甲日那堪入坤宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L081",
      "original_quote": "丙奇屬火火墓戌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L082",
      "original_quote": "此時諸事不宜為",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L083",
      "original_quote": "更兼六乙來臨二",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L084",
      "original_quote": "丁奇臨八亦同論",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L085",
      "original_quote": "又有時幹入墓宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L086",
      "original_quote": "課中時下忌相逢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L087",
      "original_quote": "戊戌壬辰兼丙戌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L088",
      "original_quote": "癸未丁丑亦同凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L089",
      "original_quote": "五不遇時龍不精",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L090",
      "original_quote": "號為日月損光明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L091",
      "original_quote": "時幹來剋日乾上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L092",
      "original_quote": "甲日須知時忌庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L093",
      "original_quote": "奇與門兮共太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L094",
      "original_quote": "三般難得共加臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L095",
      "original_quote": "若還得二亦為吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L096",
      "original_quote": "舉措行藏必遂心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L097",
      "original_quote": "更得值符直使利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L098",
      "original_quote": "兵家用事最為貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L099",
      "original_quote": "常從此地擊其衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L100",
      "original_quote": "百戰百勝君須記",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L101",
      "original_quote": "天乙之神所在宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L102",
      "original_quote": "大將宜居擊對衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L103",
      "original_quote": "假令值符居離位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L104",
      "original_quote": "天英坐取擊天蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L105",
      "original_quote": "甲乙丙丁戊陽時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L106",
      "original_quote": "神人天上報君知",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L107",
      "original_quote": "坐擊須憑天上奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L108",
      "original_quote": "陰時地下亦如此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L109",
      "original_quote": "若見三奇在五陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L110",
      "original_quote": "偏宜為客是高強",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L111",
      "original_quote": "忽然逢著五陰位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L112",
      "original_quote": "又宜為主好裁詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L113",
      "original_quote": "值符前三六合位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L114",
      "original_quote": "太陰之神在前二",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L115",
      "original_quote": "後一宮中為九天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L116",
      "original_quote": "後二之神為九地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L117",
      "original_quote": "九天之上好揚兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L118",
      "original_quote": "九地潛藏可立營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L119",
      "original_quote": "伏兵但向太陰位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L120",
      "original_quote": "若逢六合利逃形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L121",
      "original_quote": "天地人分三遁名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L122",
      "original_quote": "天遁日精華蓋臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L123",
      "original_quote": "地遁月精紫雲蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L124",
      "original_quote": "人遁當知是太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L125",
      "original_quote": "生門六丙合六丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L126",
      "original_quote": "此為天遁自分明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L127",
      "original_quote": "開門六乙合六己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L128",
      "original_quote": "地遁如斯而已矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L129",
      "original_quote": "休門六丁共太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L130",
      "original_quote": "欲求人遁無過此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L131",
      "original_quote": "要知三遁何所宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L132",
      "original_quote": "藏形遁跡斯為美",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L133",
      "original_quote": "庚為太白丙熒惑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L134",
      "original_quote": "庚丙相加誰會得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L135",
      "original_quote": "六庚加丙白入熒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L136",
      "original_quote": "六丙加庚熒入白",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L137",
      "original_quote": "白入熒兮賊即來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L138",
      "original_quote": "熒入白兮賊即去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L139",
      "original_quote": "丙為悖兮庚為格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L140",
      "original_quote": "格則不通悖亂逆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L141",
      "original_quote": "天丙加地庚為勃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L142",
      "original_quote": "天庚加地癸為格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L143",
      "original_quote": "丙加天乙為伏逆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L144",
      "original_quote": "天乙加丙為飛悖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L145",
      "original_quote": "庚加日乾為伏乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L146",
      "original_quote": "日乾加庚飛幹格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L147",
      "original_quote": "加一宮兮戰在野",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L148",
      "original_quote": "同一宮兮戰於國",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L149",
      "original_quote": "庚加值符天乙伏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L150",
      "original_quote": "值符加庚天乙飛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L151",
      "original_quote": "庚加癸兮為大格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L152",
      "original_quote": "加己為刑最不宜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L153",
      "original_quote": "加壬之時為上格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L154",
      "original_quote": "又嫌年月日時逢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L155",
      "original_quote": "更有一般奇格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L156",
      "original_quote": "六庚謹勿加三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L157",
      "original_quote": "此時若也行兵去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L158",
      "original_quote": "匹馬只輪無返期",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L159",
      "original_quote": "六癸加丁蛇夭蹻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L160",
      "original_quote": "六丁加癸雀投江",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L161",
      "original_quote": "六乙加辛龍逃走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L162",
      "original_quote": "六辛加乙虎猖狂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L163",
      "original_quote": "請觀四者是凶神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L164",
      "original_quote": "百事逢之莫措手",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L165",
      "original_quote": "丙加甲兮鳥跌穴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L166",
      "original_quote": "甲加丙兮龍返首",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L167",
      "original_quote": "只此二者是吉神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L168",
      "original_quote": "為事如意十八九",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L169",
      "original_quote": "八門若遇開休生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L170",
      "original_quote": "諸事逢之皆稱情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L171",
      "original_quote": "傷宜捕獵終須獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L172",
      "original_quote": "杜好邀遮及隱形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L173",
      "original_quote": "景上投書並破陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L174",
      "original_quote": "驚能擒訟有聲名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L175",
      "original_quote": "若問死門何所主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L176",
      "original_quote": "只宜吊死與行刑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L177",
      "original_quote": "蓬任衝輔禽陽星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L178",
      "original_quote": "英芮柱心陰宿名",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L179",
      "original_quote": "輔禽心星為上吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L180",
      "original_quote": "衝任小吉未全亨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L181",
      "original_quote": "大凶蓬芮不堪使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L182",
      "original_quote": "小凶英柱不精明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L183",
      "original_quote": "小凶無氣變為吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L184",
      "original_quote": "大凶無氣卻平平",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L185",
      "original_quote": "吉宿更能逢旺相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L186",
      "original_quote": "萬舉萬全必成功",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L187",
      "original_quote": "若遇休囚並廢沒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L188",
      "original_quote": "勸君不必走前程",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L189",
      "original_quote": "要識九星配五行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L190",
      "original_quote": "須求八卦考羲經",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L191",
      "original_quote": "坎蓬水星離英火",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L192",
      "original_quote": "中宮坤艮土為營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L193",
      "original_quote": "乾兌為金震巽木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L194",
      "original_quote": "旺相休囚看重輕",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L195",
      "original_quote": "與我同行即為相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L196",
      "original_quote": "我生之月誠為旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L197",
      "original_quote": "廢於父母休於財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L198",
      "original_quote": "囚於鬼兮真不妄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L199",
      "original_quote": "假令水宿號天蓬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L200",
      "original_quote": "相在初冬與仲冬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L201",
      "original_quote": "旺於正二休四五",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L202",
      "original_quote": "其餘仿此自研窮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L203",
      "original_quote": "急則從神緩從門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L204",
      "original_quote": "三五反複天道亨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L205",
      "original_quote": "十干加符若加錯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L206",
      "original_quote": "入墓休囚吉事危",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L207",
      "original_quote": "十精為使用為貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L208",
      "original_quote": "起宮天乙用無遺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L209",
      "original_quote": "天目為客地耳主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L210",
      "original_quote": "六甲推合無差理",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L211",
      "original_quote": "勸君莫失此玄機",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L212",
      "original_quote": "洞徹九宮輔明主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L213",
      "original_quote": "宮制其門不為迫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L214",
      "original_quote": "門制其宮是迫雄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L215",
      "original_quote": "天網四張無走路",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L216",
      "original_quote": "一二網低有路蹤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L217",
      "original_quote": "三至四宮難回避",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L218",
      "original_quote": "八九高張任西東",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L219",
      "original_quote": "節氣推移時候定",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L220",
      "original_quote": "陰陽順逆要精通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L221",
      "original_quote": "三元積數成六紀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L222",
      "original_quote": "天地未成有一理",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L223",
      "original_quote": "請觀歌裏真妙訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan1_YianBoDiaoSouGe_L224",
      "original_quote": "非是真賢莫傳與",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "卷一",
    "section": "煙波釣叟歌",
