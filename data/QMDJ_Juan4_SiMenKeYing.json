{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan4",
  "section": "死門剋應",
  "entries": [
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L000",
      "original_quote": "死門剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L001",
      "original_quote": "加景：九里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L002",
      "original_quote": "十九里逢皂衣公吏人騎騾馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L003",
      "original_quote": "加死：二里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L004",
      "original_quote": "十二里逢孝服人哭泣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L005",
      "original_quote": "更有綠衣人相伴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L006",
      "original_quote": "加驚：七里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L007",
      "original_quote": "十七里逢皂衣人打足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L008",
      "original_quote": "婦人引孩童",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L009",
      "original_quote": "加開：六里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L010",
      "original_quote": "十六里逢人打架",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L011",
      "original_quote": "嘆氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L012",
      "original_quote": "畜物鬪敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L013",
      "original_quote": "占身命：木命者大利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L014",
      "original_quote": "金命者脫耗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L015",
      "original_quote": "土命者災疾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L016",
      "original_quote": "火命者大凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L017",
      "original_quote": "丙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L018",
      "original_quote": "丁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L019",
      "original_quote": "戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L020",
      "original_quote": "己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L021",
      "original_quote": "巳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L022",
      "original_quote": "午",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L023",
      "original_quote": "辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L024",
      "original_quote": "戌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L025",
      "original_quote": "丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L026",
      "original_quote": "未年月日時者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L027",
      "original_quote": "不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L028",
      "original_quote": "生門剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L029",
      "original_quote": "生門臨著吉星辰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L030",
      "original_quote": "人財資旺各稱情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L031",
      "original_quote": "子丑年中三七月",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L032",
      "original_quote": "牛羊鞍馬進門庭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L033",
      "original_quote": "蠶榖綿絲皆豐足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L034",
      "original_quote": "朱紫兒郎在帝京",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L035",
      "original_quote": "南方商信田土進",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L036",
      "original_quote": "子孫祿位到公卿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L037",
      "original_quote": "問曰：生門艮土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L038",
      "original_quote": "少陽之方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L039",
      "original_quote": "何以為至言?",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L040",
      "original_quote": "衢仙答曰：「艮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L041",
      "original_quote": "寅位天開於子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L042",
      "original_quote": "地闢於丑",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L043",
      "original_quote": "人建於寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L044",
      "original_quote": "天氣至此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L045",
      "original_quote": "而三陽俱足",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L046",
      "original_quote": "開泰從此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L047",
      "original_quote": "而萬物皆生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L048",
      "original_quote": "陽回氣轉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L049",
      "original_quote": "天地好生之情",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L050",
      "original_quote": "而廣及萬物",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L051",
      "original_quote": "仁道生焉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L052",
      "original_quote": "所以為至吉之門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L053",
      "original_quote": "生門與乙奇合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L054",
      "original_quote": "下臨九地為地遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L055",
      "original_quote": "得日精所蔽吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L056",
      "original_quote": "與丙奇合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L057",
      "original_quote": "得月精所蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L058",
      "original_quote": "為天遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L059",
      "original_quote": "與丁奇合得星精所蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L060",
      "original_quote": "為人遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L061",
      "original_quote": "百事大吉」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L062",
      "original_quote": "生門宜上官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L063",
      "original_quote": "修造",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L064",
      "original_quote": "嫁娶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L065",
      "original_quote": "求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L066",
      "original_quote": "牧養皆大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L067",
      "original_quote": "出六十里主見貴人車馬吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L068",
      "original_quote": "臨乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L069",
      "original_quote": "兌二宮為旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L070",
      "original_quote": "中宮為相",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L071",
      "original_quote": "坎宮為迫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L072",
      "original_quote": "震宮被木剋制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L073",
      "original_quote": "入巽宮入墓皆不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L074",
      "original_quote": "生於離宮吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L075",
      "original_quote": "靜應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L076",
      "original_quote": "生門加生：主遠行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L077",
      "original_quote": "求財產吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_SiMenKeYing_L078",
      "original_quote": "加傷：主親友變動道路不吉",
      "tag": []
    }
  ],
