{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan25",
  "section": "德威之時",
  "entries": [
    {
      "line_id": "QMDJ_Juan25_DeWei_L000",
      "original_quote": "德威之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L001",
      "original_quote": "葛洪曰：「六丙為威",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L002",
      "original_quote": "六甲為德",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L003",
      "original_quote": "利以為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L004",
      "original_quote": "宜發號施令",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L005",
      "original_quote": "入其國犬不吠馬不鳴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L006",
      "original_quote": "回車止輪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L007",
      "original_quote": "折衝萬里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L008",
      "original_quote": "不敢有聲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L009",
      "original_quote": "兵來向者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L010",
      "original_quote": "還自滅形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L011",
      "original_quote": "賊必亡矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L012",
      "original_quote": "天兵來助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L013",
      "original_quote": "敵人自恐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L014",
      "original_quote": "天兵扶行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L015",
      "original_quote": "敵人自驚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L016",
      "original_quote": "將兵征伐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L017",
      "original_quote": "為客大勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L018",
      "original_quote": "若此時不利為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L019",
      "original_quote": "惟宜固守屯營",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_DeWei_L020",
      "original_quote": "以待天時」",
      "tag": []
    }
  ],
