      "line_id": "QMDJ_Juan14_MaiZangZhan_L270",
      "original_quote": "值使與時元日元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L271",
      "original_quote": "天馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L272",
      "original_quote": "私門要值六合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L273",
      "original_quote": "九天與值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L274",
      "original_quote": "值使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L275",
      "original_quote": "蛇夭矯而穴情不實",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L276",
      "original_quote": "須防道路穿傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L277",
      "original_quote": "雀投江而案山低卸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L278",
      "original_quote": "還疑元神直流",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L279",
      "original_quote": "伏乾飛幹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L280",
      "original_quote": "此地必有更變",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L281",
      "original_quote": "猶恐後日作邊場",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L282",
      "original_quote": "飛宮伏宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L283",
      "original_quote": "此地必見凶咎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L284",
      "original_quote": "待看蟻屯與風透",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L285",
      "original_quote": "大格小格水不朝而反射",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L286",
      "original_quote": "刑格悖格砂不合而門傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L287",
      "original_quote": "熒入白兮醜聲官非造出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L288",
      "original_quote": "白入熒兮尸靡棺爛遭殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L289",
      "original_quote": "年月日時逢悖格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L290",
      "original_quote": "龍穴砂水可推詳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L291",
      "original_quote": "五不遇兮人丁不旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L292",
      "original_quote": "六儀刑兮財帛分張",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L293",
      "original_quote": "入墓羅網拱護皆帶刑煞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L294",
      "original_quote": "反伏門迫山向那得禎樣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L295",
      "original_quote": "符使休囚縱葬而不發",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L296",
      "original_quote": "時日刑害雖用而喪亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L297",
      "original_quote": "兩元納音無刑陷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan14_MaiZangZhan_L298",
      "original_quote": "符使生旺時葬之良",
      "tag": []
    }
