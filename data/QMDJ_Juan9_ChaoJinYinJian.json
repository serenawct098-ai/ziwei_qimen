{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan9",
  "section": "朝覲引見",
  "entries": [
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L000",
      "original_quote": "朝覲引見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L001",
      "original_quote": "以休門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L002",
      "original_quote": "歲干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L003",
      "original_quote": "年命日乾之落宮決之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L004",
      "original_quote": "歲乾為天子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L005",
      "original_quote": "日乾為引見之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L006",
      "original_quote": "年命日幹得歲干來生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L007",
      "original_quote": "再有三奇相扶者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L008",
      "original_quote": "大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L009",
      "original_quote": "又有休門落宮得奇儀相乘者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L010",
      "original_quote": "主引見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L011",
      "original_quote": "天子必喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L012",
      "original_quote": "而得隆寵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L013",
      "original_quote": "如歲乾不生命日乾之落宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L014",
      "original_quote": "亦不相剋制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L015",
      "original_quote": "而休門得奇來生年命日乾之落宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L016",
      "original_quote": "亦吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L017",
      "original_quote": "若歲干來剋年命日乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L018",
      "original_quote": "再入空亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L019",
      "original_quote": "墓廢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L020",
      "original_quote": "並休門不得奇儀吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ChaoJinYinJian_L021",
      "original_quote": "不利",
      "tag": []
    }
  ],
