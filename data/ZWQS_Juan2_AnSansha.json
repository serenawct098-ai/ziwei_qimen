      "line_id": "ZWQS_Juan2_AnSansha_L000",
      "original_quote": "安飛天三殺訣即奏書、將軍、直符",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_AnSansha_L001",
      "original_quote": "寅午戍年飛入亥卯未宮。申子辰年飛入巳酉丑宮。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_AnSansha_L002",
      "original_quote": "亥卯未年飛入申子辰宮。巳酉丑年飛入寅午戌宮。",
      "tag": []
    },
    {
      "line_id": "ZWQS_Juan2_AnSansha_L003",
      "original_quote": "奏書口舌禍來侵，將軍飛入悔心驚，直符官災終不免，此是流年三殺星。",
      "tag": []
    }
