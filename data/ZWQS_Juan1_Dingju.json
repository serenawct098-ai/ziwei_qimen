{
  "text": "紫微斗數全書",
  "juan": "卷一",
  "section": "定局總論",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_定富局_L001",
      "original_quote": "財蔭夾印：相守命武梁來夾是也，田宅宮亦然。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定富局_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定富局_L002",
      "original_quote": "日月夾財：武守命日月來夾是也，財帛宮亦然。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定富局_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定富局_L003",
      "original_quote": "財祿夾馬：馬守命武祿來夾 is 也，逢生旺尤妙。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定富局_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定富局_L004",
      "original_quote": "蔭印拱身：身臨田宅梁相拱沖是也，勿坐空亡。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定富局_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定富局_L005",
      "original_quote": "日月照璧：日月臨田宅宮是也，喜居墓庫。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定富局_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定富局_L006",
      "original_quote": "金燦光輝：太陽單守，命在午宮是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定富局_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L001",
      "original_quote": "日月夾命：不坐空亡遇逢本宮有吉星是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L002",
      "original_quote": "日出扶桑：日在卯守命是也，守官祿宮亦然。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L003",
      "original_quote": "月落亥宫：月在亥守命是也，又名月朗天門。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L004",
      "original_quote": "月生滄海：月在子宮守田宅是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L005",
      "original_quote": "輔弼拱主：紫微守命二星來拱是也，夾之亦然。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L006",
      "original_quote": "君臣慶會：紫微左右同守命是也，更會相武陰妙上。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L007",
      "original_quote": "財印夾祿：祿守命梁相來夾是也，入財亦然。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L008",
      "original_quote": "祿馬佩印：馬前有祿印星同宮是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L009",
      "original_quote": "坐貴向貴：謂魁鉞在命迭相坐拱是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L010",
      "original_quote": "馬頭帶劍：謂馬有刃是也不是居午格。",
      "tag": [
        "_custom",
        "non_classical"
      ],
      "tag_reason": "後世格局命名，非本句原文自稱格局，需於解讀引擎輸出時與原文引述區隔",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L010",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L011",
      "original_quote": "七殺朝斗：見前註解",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L011",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L012",
      "original_quote": "日月並明：見前註解",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L012",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L013",
      "original_quote": "明珠出海：見前註解",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L013",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L014",
      "original_quote": "日月同臨：見前註解",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L014",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L015",
      "original_quote": "刑囚夾印：天刑廉貞同臨身命主武勇之人。",
      "tag": [
        "_custom",
        "non_classical"
      ],
      "tag_reason": "後世格局命名，非本句原文自稱格局，需於解讀引擎輸出時與原文引述區隔",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L015",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L016",
      "original_quote": "科權祿拱：見前註解",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L016",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L017",
      "original_quote": "貪火相逢：謂二星守命同居廟旺是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L017",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L018",
      "original_quote": "武曲守垣：武守命卯宮是也，餘不是。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L018",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L019",
      "original_quote": "府相朝垣：見前註解",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L019",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L020",
      "original_quote": "紫府朝垣：見前註解",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L020",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L021",
      "original_quote": "文星暗拱：見前註解",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L021",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L022",
      "original_quote": "權祿生逢：二星守命廟旺是也，陷不是。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L022",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L023",
      "original_quote": "羊刃入廟：辰戌丑未守命遇吉是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L023",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L024",
      "original_quote": "巨機居卯：見前註解",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L024",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L025",
      "original_quote": "明祿暗祿：見前註解",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L025",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L026",
      "original_quote": "科明暗祿：見前註解",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L026",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貴局_L027",
      "original_quote": "金輿扶駕：紫微守命前後有日月來夾是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貴局_L027",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貧賤局_L001",
      "original_quote": "生不逢時：命坐空亡逢廉貞是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貧賤局_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貧賤局_L002",
      "original_quote": "祿逢兩殺：祿坐空亡又逢空劫殺星是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貧賤局_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貧賤局_L003",
      "original_quote": "馬落空亡：馬既落亡雖祿沖會無用主奔波。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貧賤局_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貧賤局_L004",
      "original_quote": "日月藏輝：日月反背又逢巨暗是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貧賤局_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貧賤局_L005",
      "original_quote": "財與囚仇：武貞同守身命是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貧賤局_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貧賤局_L006",
      "original_quote": "一生孤貧：謂破守命星陷地是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貧賤局_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貧賤局_L007",
      "original_quote": "君子在野：謂四殺守身命而言臨陷地是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貧賤局_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定貧賤局_L008",
      "original_quote": "兩重華蓋：謂祿存化祿坐命遇空劫是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定貧賤局_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定雜局_L001",
      "original_quote": "風雲際會：身命雖弱二限逢祿馬是也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "定局總論",
        "line_id": "ZWQS_Juan1_定雜局_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_定雜局_L002",
