{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan8",
  "section": "占應役",
  "entries": [
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L000",
      "original_quote": "占應役",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L001",
      "original_quote": "以開門為現任之官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L002",
      "original_quote": "以日乾為應役之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L003",
      "original_quote": "若日乾所乘之宮得旺相氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L004",
      "original_quote": "再得奇門吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L005",
      "original_quote": "而開門所乘之宮得奇儀吉格來生日乾者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L006",
      "original_quote": "必得官長重用發達",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L007",
      "original_quote": "若日乾不得旺相奇儀吉格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L008",
      "original_quote": "而被開門生日乾者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L009",
      "original_quote": "主士見喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L010",
      "original_quote": "小吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L011",
      "original_quote": "若日乾開門彼此相衝剋者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan8_ZhanYingYi_L012",
      "original_quote": "不利",
      "tag": []
    }
  ],
