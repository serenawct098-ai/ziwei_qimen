{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan5",
  "section": "傷門剋應",
  "entries": [
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L000",
      "original_quote": "傷門剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L001",
      "original_quote": "傷門不可說",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L002",
      "original_quote": "夫妻主災迍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L003",
      "original_quote": "瘡病行不得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L004",
      "original_quote": "折損血財牲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L005",
      "original_quote": "天穴人枉死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L006",
      "original_quote": "經年有病人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L007",
      "original_quote": "商音信難得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L008",
      "original_quote": "餘事不堪陳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L009",
      "original_quote": "問曰：傷門屬木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L010",
      "original_quote": "正值春分之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L011",
      "original_quote": "嫩甲發生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L012",
      "original_quote": "當以吉看",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L013",
      "original_quote": "反以凶論",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L014",
      "original_quote": "請問其詳?",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L015",
      "original_quote": "衢仙答曰：「傷門之木",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L016",
      "original_quote": "正值春分之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L017",
      "original_quote": "精液自內而發揚於外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L018",
      "original_quote": "以致根本洩之太過",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L019",
      "original_quote": "所謂以外華而內虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L020",
      "original_quote": "而不能勝其勞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L021",
      "original_quote": "況二月中嫩甲不能當霜露之寒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L022",
      "original_quote": "因謂之傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L023",
      "original_quote": "所以凶也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L024",
      "original_quote": "傷門得奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L025",
      "original_quote": "惟宜捕捉逃亡盜賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L026",
      "original_quote": "漁獵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L027",
      "original_quote": "索債",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L028",
      "original_quote": "賭戲等事則吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L029",
      "original_quote": "若上官",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L030",
      "original_quote": "出行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L031",
      "original_quote": "嫁娶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L032",
      "original_quote": "商賈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L033",
      "original_quote": "修造",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L034",
      "original_quote": "埋葬皆不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L035",
      "original_quote": "大凶」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L036",
      "original_quote": "靜應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L037",
      "original_quote": "傷門加傷：主變動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L038",
      "original_quote": "遠行皆折傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L039",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L040",
      "original_quote": "加杜：主變動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L041",
      "original_quote": "失脫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L042",
      "original_quote": "官司",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L043",
      "original_quote": "桎梏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L044",
      "original_quote": "百事凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L045",
      "original_quote": "加景：主文書",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L046",
      "original_quote": "印信",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L047",
      "original_quote": "口舌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L048",
      "original_quote": "動撓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L049",
      "original_quote": "啾喞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L050",
      "original_quote": "加死：主官司",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L051",
      "original_quote": "印信",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L052",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L053",
      "original_quote": "出行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L054",
      "original_quote": "大忌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L055",
      "original_quote": "占病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L056",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L057",
      "original_quote": "加驚：主親人疾病憂懼",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L058",
      "original_quote": "謀伐不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L059",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L060",
      "original_quote": "加開：主貴人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L061",
      "original_quote": "開張有走失變動之事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L062",
      "original_quote": "不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L063",
      "original_quote": "加休：主陽人變動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L064",
      "original_quote": "或托人謀幹財名不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L065",
      "original_quote": "加生：原文缺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L066",
      "original_quote": "加甲戊：主失脫難獲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L067",
      "original_quote": "加乙：主求謀不得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L068",
      "original_quote": "反防盜失財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L069",
      "original_quote": "加丙：主道路損失",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L070",
      "original_quote": "加丁：主音信不的",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L071",
      "original_quote": "加己：主財散人病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L072",
      "original_quote": "加庚：主訟獄被刑杖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L073",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L074",
      "original_quote": "加辛：主夫妻懷私",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L075",
      "original_quote": "恣怨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L076",
      "original_quote": "加壬：主因盜牽連",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L077",
      "original_quote": "加癸：主訟獄被冤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L078",
      "original_quote": "有理難伸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L079",
      "original_quote": "動應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L080",
      "original_quote": "傷門出者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L081",
      "original_quote": "三十里見人爭鬪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L082",
      "original_quote": "見漁人或畜爭鬪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L083",
      "original_quote": "敵宜避之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L084",
      "original_quote": "大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L085",
      "original_quote": "傷門加傷：三里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L086",
      "original_quote": "十三里逢二車塞道爭行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L087",
      "original_quote": "加杜：四里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L088",
      "original_quote": "十四里逢公吏人及木匠伐樹",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L089",
      "original_quote": "並有婦人抱小兒過",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L090",
      "original_quote": "加景：九里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L091",
      "original_quote": "十九里逢色衣人騎騾馬過",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L092",
      "original_quote": "加死：二里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L093",
      "original_quote": "十二里逢埋葬及孝服人哭泣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L094",
      "original_quote": "加驚：七里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L095",
      "original_quote": "十七里逢人鬪打並趕畜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L096",
      "original_quote": "有婦人與少女同行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L097",
      "original_quote": "加開：六里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L098",
      "original_quote": "十六里逢人拆牆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L099",
      "original_quote": "安門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L100",
      "original_quote": "解板",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L101",
      "original_quote": "或二豬相咬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L102",
      "original_quote": "加休：一里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L103",
      "original_quote": "十一里逢老婦與少男同行",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L104",
      "original_quote": "加生：八里",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L105",
      "original_quote": "十八里逢人伐樹或培土",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L106",
      "original_quote": "占身命：水火木命者吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L107",
      "original_quote": "金命者主病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L108",
      "original_quote": "土命者凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L109",
      "original_quote": "官司",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_ShangMenKeYing_L110",
      "original_quote": "刑杖",
      "tag": []
    }
  ],
