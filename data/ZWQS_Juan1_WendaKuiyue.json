  "section": "星垣問答論_Kuiyue",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaKuiyue_L001",
      "original_quote": "問天魁天鉞星所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaKuiyue_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaKuiyue_L002",
      "original_quote": "希夷先生答曰：魁鉞斗中司科之星，入命坐貴向貴，或得左右吉聚無不富貴。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaKuiyue_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaKuiyue_L003",
      "original_quote": "況二星又為上界和合之神，若魁臨命，鉞守身，更迭相守。更遇紫微府、日月、昌曲、左右、權祿相湊，少年必聚美妻。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaKuiyue_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaKuiyue_L004",
      "original_quote": "若遇大難，必得貴人成就扶助，小人不一，亦不為凶。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaKuiyue_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaKuiyue_L005",
      "original_quote": "限步巡逢必主女子添喜，生男則俊雅，入學功名有成。生女則容貌端莊，出眾超群；",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaKuiyue_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaKuiyue_L006",
      "original_quote": "若四十以後逢墓庫，不依此斷。有凶不以為災，居官者賢而威武，聲名遠播。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaKuiyue_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaKuiyue_L007",
      "original_quote": "僧道享福，與人和睦，不為下賤。女人吉多宰輔之妻，命婦之論。若加惡殺亦為富貴，但不免私情淫佚。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaKuiyue_L007",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaKuiyue_L008",
      "original_quote": "歌曰",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaKuiyue_L008",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaKuiyue_L009",
      "original_quote": "天乙貴人眾所欽，命逢金帶福彌深，飛騰名譽人爭慕，博雅皆通古與今，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaKuiyue_L009",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaKuiyue_L010",
      "original_quote": "魁鉞二星限中強，人人遇此廣錢糧，官吏逢之發財福，當年必定見君王。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaKuiyue_L010",
        "base_edition_lock": "羅洪先編本"
      }
    }
  ],
