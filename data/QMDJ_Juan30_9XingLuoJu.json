{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "九星落局法",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L000",
      "original_quote": "九星落局法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L001",
      "original_quote": "冬至後陽遁順行九宮起例一日一宮完",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L002",
      "original_quote": "即至上日甲戌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L003",
      "original_quote": "餘例仿此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L004",
      "original_quote": "甲子為頭起艮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L005",
      "original_quote": "甲戌飛入宮字",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L006",
      "original_quote": "猿猴翻入水晶宮坎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L007",
      "original_quote": "甲馬坤中不動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L008",
      "original_quote": "曾見龍生震地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L009",
      "original_quote": "再看虎嘯生風巽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L010",
      "original_quote": "九星殿上顯奇功",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L011",
      "original_quote": "太乙臨之法用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L012",
      "original_quote": "假如",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L013",
      "original_quote": "甲子日艮上起太乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L014",
      "original_quote": "離上攝提",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L015",
      "original_quote": "坎上軒轅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L016",
      "original_quote": "坤上招搖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L017",
      "original_quote": "震上天符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L018",
      "original_quote": "巽上青龍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L019",
      "original_quote": "中宮咸池",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L020",
      "original_quote": "乾上太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L021",
      "original_quote": "兌上天乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_9XingLuoJu_L022",
      "original_quote": "此九星順行九宮之法也",
      "tag": []
    }
  ],
