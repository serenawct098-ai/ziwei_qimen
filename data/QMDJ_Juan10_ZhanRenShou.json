  "section": "占人壽夭吉凶",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L000",
      "original_quote": "占人壽夭吉凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L001",
      "original_quote": "法以衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L002",
      "original_quote": "柱二星合死門遠近以定之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L003",
      "original_quote": "男以天衝星起順布奇儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L004",
      "original_quote": "女以天柱星起逆布奇儀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L005",
      "original_quote": "看至死門相隔幾宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L006",
      "original_quote": "一宮十年",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L007",
      "original_quote": "起算致死門幾宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L008",
      "original_quote": "作壽幾十年",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L009",
      "original_quote": "餘幾十年外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L010",
      "original_quote": "再以宮一宮為一年",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L011",
      "original_quote": "看零幾年是幾歲",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L012",
      "original_quote": "零數以四正四宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L013",
      "original_quote": "一宮只作一宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L014",
      "original_quote": "惟四維四宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L015",
      "original_quote": "一宮便作二宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanRenShou_L016",
      "original_quote": "因為四維乃八支也",
      "tag": []
    }
  ],
