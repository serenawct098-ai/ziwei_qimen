    {
      "line_id": "QMDJ_Juan25_TianFuShi_L001",
      "original_quote": "《三元經》曰：「天輔之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L002",
      "original_quote": "有罪無虞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L003",
      "original_quote": "斧鑽在前",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L004",
      "original_quote": "天猶赦之」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L005",
      "original_quote": "謂甲己之日時下得己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L006",
      "original_quote": "乙庚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L007",
      "original_quote": "丙辛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L008",
      "original_quote": "丁壬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L009",
      "original_quote": "戊癸之日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L010",
      "original_quote": "時下得甲也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L011",
      "original_quote": "甲己日己巳時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L012",
      "original_quote": "乙庚日甲申時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L013",
      "original_quote": "丙辛日甲午時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L014",
      "original_quote": "丁壬日甲辰時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L015",
      "original_quote": "戊癸日甲寅時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L016",
      "original_quote": "是為天輔之時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_TianFuShi_L017",
      "original_quote": "此時有罪自釋",
      "tag": []
    }
