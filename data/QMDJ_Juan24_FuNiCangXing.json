    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L000",
      "original_quote": "伏匿藏行法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L001",
      "original_quote": "伍子胥曰：「若欲伏匿藏形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L002",
      "original_quote": "當乘青龍六甲也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L003",
      "original_quote": "歷蓬星六乙也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L004",
      "original_quote": "過明堂六丙也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L005",
      "original_quote": "伏太陰六丁也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L006",
      "original_quote": "出天門六戊也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L007",
      "original_quote": "入地戶六己也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L008",
      "original_quote": "伐天刑六庚也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L009",
      "original_quote": "判天庭六辛也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L010",
      "original_quote": "羈天牢六壬也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L011",
      "original_quote": "取草折半障人中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L012",
      "original_quote": "半入天藏六癸也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L013",
      "original_quote": "從天藏下進去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L014",
      "original_quote": "走月厭方",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L015",
      "original_quote": "正月戌逆數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L016",
      "original_quote": "許藏身與天喜同」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L017",
      "original_quote": "假如六甲日甲子時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L018",
      "original_quote": "欲伏藏者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L019",
      "original_quote": "初起甲子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L020",
      "original_quote": "歷丑過寅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L021",
      "original_quote": "伏卯出辰入巳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L022",
      "original_quote": "取草折半障人中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L023",
      "original_quote": "置卯地入酉地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L024",
      "original_quote": "而出入無見者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L025",
      "original_quote": "過太陰時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L026",
      "original_quote": "咒曰：「天翻地覆",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L027",
      "original_quote": "九道皆塞",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L028",
      "original_quote": "有來迫我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L029",
      "original_quote": "至此而極",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L030",
      "original_quote": "視我者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L031",
      "original_quote": "追我者亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L032",
      "original_quote": "吾奉九天玄女道母元君律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L033",
      "original_quote": "咒畢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L034",
      "original_quote": "徑入天藏",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L035",
      "original_quote": "慎勿反顧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L036",
      "original_quote": "庚為天獄",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L037",
      "original_quote": "辛為天庭",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L038",
      "original_quote": "壬為天牢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L039",
      "original_quote": "俱宜避之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L040",
      "original_quote": "切勿抵向",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan24_FuNiCangXing_L041",
      "original_quote": "致被擒縛",
      "tag": []
    }
  ],
