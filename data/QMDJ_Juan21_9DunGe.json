  "entries": [
    {
      "line_id": "QMDJ_Juan21_9DunGe_L000",
      "original_quote": "九遁歌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L001",
      "original_quote": "奇門九遁少人知",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L002",
      "original_quote": "秘在仙經甚奧微",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L003",
      "original_quote": "丙合生門居丁上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L004",
      "original_quote": "便為天遁月光輝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L005",
      "original_quote": "乙合開門臨六己",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L006",
      "original_quote": "地遁日精能蔽之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L007",
      "original_quote": "丁共休門合太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L008",
      "original_quote": "人遁星精藉照臨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L009",
      "original_quote": "丙合生門合九天",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L010",
      "original_quote": "神靈所蔽有威權",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L011",
      "original_quote": "丁合休門臨九地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L012",
      "original_quote": "伏兵鬼遁能潛避",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L013",
      "original_quote": "乙合休門臨坎水",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L014",
      "original_quote": "即是蛟龍得雲雨",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L015",
      "original_quote": "辛儀合生臨艮出",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L016",
      "original_quote": "猛虎神威淨八蠻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L017",
      "original_quote": "虎狂位遇丁景制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L018",
      "original_quote": "叱吒生風上將壇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L019",
      "original_quote": "龍逃亦藉丁和景",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_9DunGe_L020",
      "original_quote": "一躍雷門震羽輪",
      "tag": []
    }
  ],
