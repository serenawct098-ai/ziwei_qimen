  "section": "格局論",
  "entries": [
    {
      "line_id": "ZWQS_Juan1_Geju_對面朝斗格_L001",
      "original_quote": "論對面朝斗格（子午宮逢祿存是也）",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_對面朝斗格_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_對面朝斗格_L002",
      "original_quote": "詩曰：祿有對面在遷移，子午逢之利祿宜，德合吉壤人敬重，雙全富貴福稀奇。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_對面朝斗格_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_科權祿主格_L001",
      "original_quote": "論科權祿主格",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_科權祿主格_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_科權祿主格_L002",
      "original_quote": "詩曰：祿權周勃命中逢，入相王朝贊聖功，迎合權星兼吉曜，巍巍富貴列三公。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_科權祿主格_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_左右朝垣格_L001",
      "original_quote": "論左右朝垣格",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_左右朝垣格_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_左右朝垣格_L002",
      "original_quote": "詩曰：天星左右最高明，若在三方祿位興，武職高登應顯佐，文人名譽列公卿。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_左右朝垣格_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_兼文武格_L001",
      "original_quote": "論兼文武格（文曲武曲在身命是也）",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_兼文武格_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_兼文武格_L002",
      "original_quote": "詩曰：格名文武少人知，遇此須教百事通，更值命宮無殺破，滔滔榮顯是英雄。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_兼文武格_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_文星朝命格_L001",
      "original_quote": "論文星朝命格",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_文星朝命格_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_文星朝命格_L002",
      "original_quote": "詩曰：文昌文曲最榮華，值此須生富貴家，更得三方祥曜拱，卻如錦上又添花。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_文星朝命格_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_石中隱玉格_L001",
      "original_quote": "論石中隱玉格（命在子午逢巨門是也）",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_石中隱玉格_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_石中隱玉格_L002",
      "original_quote": "詩曰：巨門子午二宮逢，身命逢之必貴榮，更得三方科祿照，石中隱玉是豐隆。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_石中隱玉格_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_貪狼遇火格_L001",
      "original_quote": "論貪狼遇火名為火貴格（三合照身命是也）",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_貪狼遇火格_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_貪狼遇火格_L002",
      "original_quote": "詩曰：火遇貪狼照命宮，封侯食祿是英雄，三方倘若無凶殺，到老應知福壽隆。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_貪狼遇火格_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論商賈之命_L001",
      "original_quote": "論人有無商賈之命",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論商賈之命_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論商賈之命_L002",
      "original_quote": "如人命有巨日紫府守照，為人安分，有仁德耿直之心，作事無私，不行邪僻，不肯妄求，為士為官主有廉潔；如值月貪同殺忌，心多機關，貪財無厭，暮夜求利之輩。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論商賈之命_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論商賈之命_L003",
      "original_quote": "詩曰：貪月同殺會機梁，因財計利作經商，須知暮夜無眠睡，潮海營營自去忙。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論商賈之命_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論商賈之命_L004",
      "original_quote": "又曰：經商紫府遇擎羊，武曲遷移利市場，殺破廉貞同左右，羊鈴火宿遠傳揚。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論商賈之命_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論藝術之命_L001",
      "original_quote": "論人命有無藝術者",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論藝術之命_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論藝術之命_L002",
      "original_quote": "寅申巳亥安命或丑未辰戌遇有貪狼武曲在命化忌、加殺，必作細巧藝術之人也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論藝術之命_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論藝術之命_L003",
      "original_quote": "詩曰：閑宮貪狼何生業，不是屠人須打鐵，諸般巧藝更能精，性好遊畋並捕獵。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論藝術之命_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論藝術之命_L004",
      "original_quote": "又曰：破武未宮多巧藝，巳亥安命正相宜，破軍廉貞居卯西，細巧之人定藝奇。是作奇工。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論藝術之命_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論藝術之命_L005",
      "original_quote": "又曰：天機天相命身中，帝令財星入墓中，天府若居遷動位，平生定是作奇工。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論藝術之命_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論僧道之命_L001",
      "original_quote": "論出家僧道之命",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論僧道之命_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論僧道之命_L002",
      "original_quote": "紫微居卯西遇劫空者，看命無正曜又兼羊火劫空化忌者，更看父母妻子三宮有殺者方可斷。及寅年申月巳日亥時四正殺湊化忌，男僧道，女尼姑。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論僧道之命_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論僧道之命_L003",
      "original_quote": "詩曰：極居卯西遇劫空，十人之命九人僧，道釋岩泉皆有分，清閑幽靜度平生。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論僧道之命_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論僧道之命_L004",
      "original_quote": "又曰：命坐空鄉定出家，文星相會實堪誇，若還文曲臨身命，受蔭清閑福可嘉。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論僧道之命_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論僧道之命_L005",
      "original_quote": "又曰：天機七殺破梁同，羽客僧流命所逢，更若太陽兼帝座，伶仃孤剋命方終。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論僧道之命_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論孤剋之命_L001",
      "original_quote": "論人命內犯孤剋者",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論孤剋之命_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論孤剋之命_L002",
      "original_quote": "如剋妻剋子剋父母內犯一二不為僧道亦作貧賤之人，第一看父母在廟旺地有無吉凶星辰，如在陷地加殺化忌必主刑剋，第二又看妻妾宮，三看子女宮廟陷之地，有無吉凶星辰，如在陷加殺化忌必鰥寡孤獨論斷。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論孤剋之命_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論壽夭淫蕩_L001",
      "original_quote": "論壽夭淫蕩",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論壽夭淫蕩_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論壽夭淫蕩_L002",
      "original_quote": "詩曰：貪狼入廟最高強，南極星同壽命長，北斗帝星無惡殺，綿綿老耋衍禎祥。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論壽夭淫蕩_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論壽夭淫蕩_L003",
      "original_quote": "詩曰：七殺臨身終是天，貪狼入廟定為娼，前示三合相臨照，也學韓君去竊香。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論壽夭淫蕩_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論壽夭淫蕩_L004",
      "original_quote": "詩曰：身命兩宮俱有殺，貪花戀酒禍猶深，平生二限來符會，得意之中卻又沈。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論壽夭淫蕩_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論殘疾_L001",
      "original_quote": "論定人殘疾",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論殘疾_L001",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論殘疾_L002",
      "original_quote": "先看命宮星落陷，加羊陀火鈴劫空忌宿，又看疾厄宮星廟陷吉凶而斷可也。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "格局論",
        "line_id": "ZWQS_Juan1_Geju_論殘疾_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_Geju_論殘疾_L003",
      "original_quote": "詩曰：命中羊陀殺守身，火鈴坐照禍非輕，平生若不常年臥，也作陀腰曲背人。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
