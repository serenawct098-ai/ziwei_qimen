{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan 13",
  "section": "出行占",
  "entries": [
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L000",
      "original_quote": "出行占",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L001",
      "original_quote": "論干支",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L002",
      "original_quote": "日元為人時元地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L003",
      "original_quote": "人元剋地去向利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L004",
      "original_quote": "時元如若剋人元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L005",
      "original_quote": "所往之方多不濟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L006",
      "original_quote": "時納所藏是中途",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L007",
      "original_quote": "不傷人元堪策驥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L008",
      "original_quote": "若得再來生日元",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L009",
      "original_quote": "未到地頭先稱意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L010",
      "original_quote": "最忌截空與刑害",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L011",
      "original_quote": "進退趦趄方另議",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L012",
      "original_quote": "論值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L013",
      "original_quote": "出行道行宜生旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L014",
      "original_quote": "六合所主同伴當",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L015",
      "original_quote": "勾陳白虎依程途",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L016",
      "original_quote": "朱蛇文信口舌項",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L017",
      "original_quote": "元武所主盜與奸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L018",
      "original_quote": "前後俱忌相利創",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L019",
      "original_quote": "地陰剋制路多岐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L020",
      "original_quote": "九天生合宜去向",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L021",
      "original_quote": "論值使",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L022",
      "original_quote": "出行直使最為重",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L023",
      "original_quote": "加臨無傷始堪用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L024",
      "original_quote": "本門起自何卦中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L025",
      "original_quote": "飛臨生合人趨奉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L026",
      "original_quote": "其間用空與落空",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L027",
      "original_quote": "反伏迫格及刑衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L028",
      "original_quote": "起程不得去無向",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L029",
      "original_quote": "勸君另自卜門從",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L030",
      "original_quote": "論十干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L031",
      "original_quote": "奇儀所主六親神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L032",
      "original_quote": "旅舍風塵亦同因",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L033",
      "original_quote": "圖謀宜入財宮位",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L034",
      "original_quote": "投托須臨父舍恩",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L035",
      "original_quote": "忌入官鄉與刑格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L036",
      "original_quote": "再據地方車折輪",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L037",
      "original_quote": "論吉凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L038",
      "original_quote": "吉格事事俱吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L039",
      "original_quote": "凶格事事俱凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L040",
      "original_quote": "夭矯防口舌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L041",
      "original_quote": "投江莫長驅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L042",
      "original_quote": "伏乾飛幹途中前後有變",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L043",
      "original_quote": "伏宮飛宮早晚旅宿多殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L044",
      "original_quote": "大隔小隔舟車宜有防",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L045",
      "original_quote": "刑格悖格盜劫鬥傷",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L046",
      "original_quote": "熒入白而火盜留意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L047",
      "original_quote": "白入熒而輜重提防",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L048",
      "original_quote": "不遇何勞遠去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L049",
      "original_quote": "擊刑莫求行裝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L050",
      "original_quote": "入墓羅網切莫輕身險地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L051",
      "original_quote": "反伏門迫進退受困",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L052",
      "original_quote": "奔必求符便協吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan 13_ChuXingZhan_L053",
      "original_quote": "助元無礙起行",
      "tag": []
    }
  ],
