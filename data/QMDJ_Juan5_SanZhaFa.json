    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L000",
      "original_quote": "三詐法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L001",
      "original_quote": "凡事宜開",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L002",
      "original_quote": "休",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L003",
      "original_quote": "生三吉門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L004",
      "original_quote": "即不得乙丙丁三奇亦吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L005",
      "original_quote": "又取陰神相助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L006",
      "original_quote": "謂之三詐",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L007",
      "original_quote": "有地盤九地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L008",
      "original_quote": "太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L009",
      "original_quote": "六合三神助奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L010",
      "original_quote": "謂之「陽門得助」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L011",
      "original_quote": "再得地盤吉門相助者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L012",
      "original_quote": "全吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L013",
      "original_quote": "若開",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L014",
      "original_quote": "休",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L015",
      "original_quote": "生三吉門合乙丙丁三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L016",
      "original_quote": "無地盤太陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L017",
      "original_quote": "六合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L018",
      "original_quote": "九地者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L019",
      "original_quote": "謂之有門無遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L020",
      "original_quote": "陽有奇無陰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L021",
      "original_quote": "凡事有七分之利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L022",
      "original_quote": "開休生三吉門合三奇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L023",
      "original_quote": "下臨地盤太陰之宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L024",
      "original_quote": "再得吉門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L025",
      "original_quote": "此吉門當作吉星相助",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L026",
      "original_quote": "謂之「真詐」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan5_SanZhaFa_L027",
