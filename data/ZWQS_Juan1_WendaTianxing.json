      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxing_L004",
      "original_quote": "天刑未必是凶星，入廟名為天喜神，昌曲吉星來湊合，定然獻策到王庭，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxing_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxing_L005",
      "original_quote": "刑居寅上并西戌，更臨卯位自光明，必遇文星成大業，掌握邊疆百萬兵，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianxing_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianxing_L006",
      "original_quote": "三不子兮號天刑，為僧為道是孤身，天哭二星皆同到，終是難逃有疾人。",
      "tag": [],
      "tag_reason": "",
