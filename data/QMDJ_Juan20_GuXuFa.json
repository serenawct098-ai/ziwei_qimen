{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan20",
  "section": "孤虛法",
  "entries": [
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L000",
      "original_quote": "孤虛法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L001",
      "original_quote": "黃石公曰：「背孤擊虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L002",
      "original_quote": "一女可敵十人」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L003",
      "original_quote": "古法十人用時孤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L004",
      "original_quote": "百人用日孤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L005",
      "original_quote": "千人用月孤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L006",
      "original_quote": "萬人用年孤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L007",
      "original_quote": "惟有時孤最驗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L008",
      "original_quote": "甲子旬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L009",
      "original_quote": "孤在戌亥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L010",
      "original_quote": "虛在辰巳",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L011",
      "original_quote": "甲戌旬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L012",
      "original_quote": "孤在申酉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L013",
      "original_quote": "虛在寅卯之類",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L014",
      "original_quote": "餘仿此",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L015",
      "original_quote": "旺氣十倍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L016",
      "original_quote": "相氣五倍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L017",
      "original_quote": "休氣如數",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L018",
      "original_quote": "囚氣減少",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan20_GuXuFa_L019",
      "original_quote": "死氣減半也",
      "tag": []
    }
  ],
