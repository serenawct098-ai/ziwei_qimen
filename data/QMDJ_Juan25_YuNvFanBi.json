    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L272",
      "original_quote": "以南為北",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L273",
      "original_quote": "有知我者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L274",
      "original_quote": "使汝迷不得見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L275",
      "original_quote": "急急如律令」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L276",
      "original_quote": "以莫閉戶老去",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L277",
      "original_quote": "皆一心虔誠",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L278",
      "original_quote": "三呵玉女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L279",
      "original_quote": "乘玉女咒曰：「玉女玉女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L280",
      "original_quote": "天神至靈",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L281",
      "original_quote": "護我保我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L282",
      "original_quote": "與我傳我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L283",
      "original_quote": "行到某處",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L284",
      "original_quote": "窈窈冥冥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L285",
      "original_quote": "莫睹其形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L286",
      "original_quote": "人不得聞其人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L287",
      "original_quote": "鬼不得聞其精",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L288",
      "original_quote": "善我者福",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L289",
      "original_quote": "惡我者殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L290",
      "original_quote": "百邪鬼賊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L291",
      "original_quote": "當我者死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L292",
      "original_quote": "值我者亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L293",
      "original_quote": "千萬人中",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L294",
      "original_quote": "見我者喜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L295",
      "original_quote": "急急如律令奉行」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L296",
      "original_quote": "以刀畫地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L297",
      "original_quote": "撮禁諸惡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L298",
      "original_quote": "念咒先叩齒七通",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L299",
      "original_quote": "以應北斗天罡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L300",
      "original_quote": "右手持刀畫地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L301",
      "original_quote": "咒曰：「四縱五橫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L302",
      "original_quote": "萬惡潛形",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L303",
      "original_quote": "吾去千里者回",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L304",
      "original_quote": "萬里者歸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L305",
      "original_quote": "呵我者死",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L306",
      "original_quote": "叱我者亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L307",
      "original_quote": "自受其殃",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_YuNvFanBi_L308",
      "original_quote": "急急如律令」",
      "tag": []
    }
  ],
