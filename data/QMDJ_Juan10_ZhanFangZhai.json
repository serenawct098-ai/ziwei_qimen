{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan10",
  "section": "占放債",
  "entries": [
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L000",
      "original_quote": "占放債",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L001",
      "original_quote": "以六甲值符為放債之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L002",
      "original_quote": "值符下臨之星為天乙",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L003",
      "original_quote": "即借債之人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L004",
      "original_quote": "若地盤之星乘旺相之氣生天盤之星者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L005",
      "original_quote": "借債必還",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L006",
      "original_quote": "乘凶格剋天盤之星者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L007",
      "original_quote": "必不還",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L008",
      "original_quote": "落空亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L009",
      "original_quote": "主死亡負債",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L010",
      "original_quote": "乘墓絕之宮者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L011",
      "original_quote": "主混賴不還",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan10_ZhanFangZhai_L012",
      "original_quote": "此句言地盤之星所帶之幹儀也",
      "tag": []
    }
  ],
