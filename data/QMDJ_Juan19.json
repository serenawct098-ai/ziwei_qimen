      }
    },
    {
      "line_id": "QMDJ_Juan19_L095",
      "original_quote": "逐月出行吉方",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
