      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落47"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L048",
      "original_quote": "乙庚年四月壬申日、九月乙巳日。",
