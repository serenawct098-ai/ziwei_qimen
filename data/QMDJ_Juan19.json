        "line_ref": "標題"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L001",
      "original_quote": "斗柄所指",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落1"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L002",
      "original_quote": "天罡指巳天地門以月將加時，尋天罡至巳為天地初開，出軍行師任徘徊用兵大勝開地千里，指午坐帳宜彈琴指午為天地縱橫，不宜出軍，坐帳彈琴吉，指未小通亦可裁天地小通出軍亦吉，指申迫爭君須忌天地爭史之時，用兵須忌，指酉人馬受驚骸天地閉塞之時，車傷馬死，戰主大凶，返來戌上指乖隔出軍主士卒乖隔傷和，加亥天窄不稱懐用軍主損傷驚恐，指子半路魂魄散行至半路，魂魄不安，指醜途宿待明來為小通，出軍三十里待來朝任意而行，必獲大勝，臨寅有喜戰獲勝行者有喜，戰必大捷，到卯閉塞宜埋葬為天地閉塞，宜藏匿避之，凡事不宜，複臨辰地關梁塞關梁閉塞，只可安營下寨，不可妄動，掌上兵機仔細排。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落2"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L003",
      "original_quote": "占迷路法",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落3"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L004",
      "original_quote": "三路迷失時，天罡隨於孟仲，兩歧感應日辰，左右以規謀，路逢三叉不知何道吉，以正時占，天罡加孟左道通，加季右道通，加仲中道通，此下出軍大捷，所求必遂。若逢兩歧路，日乾吉者左道通，辰支爻吉者右道通也。如七月申時占，以巳將加地盤申上起順數，辰時天罡在地盤未上，未為季左道通，餘仿此。子午卯酉四仲，寅申巳亥為四孟，辰戌丑未為四季。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落4"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L005",
      "original_quote": "密訪",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落5"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L006",
      "original_quote": "欲得賊消息，天目聽之吉天目日大吉、小吉方也。欲訪機密事，地耳不須疑地耳，太衝、從魁方也。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落6"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L007",
      "original_quote": "渡河",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落7"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L008",
      "original_quote": "天有三河壬子癸，地有三井卯酉辰，月將加時看三河，一河臨井必覆舟。又曰：「太衝加日辰，主風雨；神後加季，急渡則吉」。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落8"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L009",
      "original_quote": "劫糧覓水",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落9"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L010",
      "original_quote": "我軍欲劫糧，大小吉下訪，我軍欲求水，小吉太衝訪。小吉、太衝為井泉之神，地下見之可得。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落10"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L011",
      "original_quote": "敵使虛實",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落11"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L012",
      "original_quote": "敵有使來看日辰，日上為客辰主人辰實時也，日乾上神辰剋辰上日剋時，其言虛謬不可聞，若是辰上剋日上，彼必畏我言詞真，朱空太陰日辰上乘日上主彼詐，乘辰上主我詐。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落12"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L013",
      "original_quote": "突圍",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落13"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L014",
      "original_quote": "或被兵圍不要忙，加時出路是天罡太公曰：「兵圍千里，鬥道必通」。鬥者，天罡也。以月將加時尋天罡，其下一實可出。若天罡方無路可出，當尋三官時，三官時，亥子醜也。，若值絳官申酉地以月將加時，若亥臨子午卯酉為絳官，宜向天盤申酉下出。，明堂時往太衝方子臨子午卯酉為明堂，宜向天盤卯方出。，玉堂宜突天魁下醜臨子午卯酉為玉堂，宜向戌方出。，利若鋒芒八極張逢豪強之賊，勢不可當，向天罡可出，此為八極張也。，日辰上將相生吉傷不傷視陰陽，若日辰與上將相生者吉。，相剋如今有損傷日辰與上將相剋，又制日辰者，必有損傷，用兵者，宜審之。。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落14"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L015",
      "original_quote": "察賊所在",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落15"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L016",
      "original_quote": "聞賊未知賊所在，加時春乙夏居丁乙干寄辰，丁幹寄未。，秋辛冬癸名天目辛乾寄戌，癸乾寄丑。，賊當在下伏其形以月將加時，視天目之方，賊在其下。天目者，春辰、夏未、秋戌、冬醜。春占尋辰，餘仿此。。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落16"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L017",
      "original_quote": "抽軍避寇",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落17"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L018",
      "original_quote": "賊勢平凌我未強途逢兵賊，他強我弱。，抽軍回避看天罡以月將加時，看天罡落在何宮，以避其強猛。，系孟直須從右隱辰為天罡，如加寅申巳亥之孟神，從右道而避之。，仲季還宜向左藏子午卯酉為四仲，辰戌丑未為四季，天罡如此向左藏之，無咎。，從魁小吉太衝地酉為從魁，未為小吉，卯為太衝，此三神為天三門，再得除危開定，是天門地戶庇佑。，天上加臨為好方以月將加時，看天盤卯酉未落在何宮，可以避難。如遇旺方不可往，春不東去，餘仿此。，大吉、神后、紫房、華蓋，能藏萬物，即行無害大吉為紫房，神後為華蓋，凡有急難，避藏之下，人不能掩藏也。。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落18"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L019",
      "original_quote": "排山掌",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落19"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L020",
      "original_quote": "乾六兌七艮八離九",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落20"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L021",
      "original_quote": "中五",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落21"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L022",
      "original_quote": "巽四震三坤二坎一",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落22"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L023",
      "original_quote": "但從震宮起甲子，紅嘴朱雀丈二長，眼似銅鈴火耀光，等閒無事傷人命，千里飛來會過江，巽宮乙丑順行裝，行到中宮莫歸火，乾宮一位莫安床，兌上占之莫修井，艮宮莫作僧道房，離宮大門君莫犯，坎宮水溝大難當，坤宮嫁娶損宅長，震宮修廚新婦亡，巽宮一位管山野，十人犯著九人殃。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落23"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L024",
      "original_quote": "如甲子震宮數起，乙丑日至巽，忌山野。丙寅日數至中，忌遷宅。丁卯日數至乾，忌安床。戊辰日數至兌，忌修井。餘仿此類推。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落24"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L025",
      "original_quote": "鬼谷子九仙數",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落25"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L026",
      "original_quote": "河圖甲己子午九，乙庚丑未八當頭，丙辛寅申七數真，丁壬卯酉六相親，戊癸辰戌五為坎，巳亥原來數當四，其法日則干支並用，時則止用支不用干。如甲子日未時，干支相配合得二十六數，乃是大吉仙，餘仿此數，甲九數子亦九數，未得八數。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落26"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L027",
      "original_quote": "吉遷凶神合數",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落27"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L028",
      "original_quote": "十三數日光仙，吉；十四數日天仙，吉《協紀》為大禍神，凶。；十五數月光仙，吉；十六數金玉仙，吉；十七數滅門仙，凶；十八數天德仙，吉；十九數天凶神，凶；二十數地凶神，凶；二十一數祭國仙，凶；二十二數地藏仙，吉；二十三數喪門神，凶；二十四數逆神仙，吉《協紀》為送福神，吉。；二十五數大善仙，吉；二十六數大吉仙，吉；二十七數吊客神，凶。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落28"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L029",
      "original_quote": "右吉神宜上官、出行、移居、起屋、修營，所作百事大吉。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落29"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L030",
      "original_quote": "月支寅卯辰巳午未申酉戌亥子丑",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落30"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L031",
      "original_quote": "天德合壬巳丁丙寅己戊亥辛庚申乙",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落31"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L032",
      "original_quote": "月德合辛己丁乙辛己丁乙辛己丁乙",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落32"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L033",
      "original_quote": "天成日未酉亥丑卯巳未酉亥丑卯巳",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落33"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L034",
      "original_quote": "天喜日戌亥子丑寅卯辰巳午未申酉",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落34"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L035",
      "original_quote": "天富日辰巳午未申酉戌亥子丑寅卯",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落35"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L036",
      "original_quote": "紅沙日巳酉丑巳酉丑巳酉丑巳酉丑",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落36"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L037",
      "original_quote": "黃沙日午寅子午寅子午寅子午寅子",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落37"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L038",
      "original_quote": "往亡日寅巳申亥卯午酉子辰未戌丑",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
