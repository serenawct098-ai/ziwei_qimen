      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落81"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L082",
      "original_quote": "天陽日，所求得財，婚姻和合，萬事稱心，大吉。",
