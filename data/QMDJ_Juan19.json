      "original_quote": "天倉日，所求得財，出官見喜，大吉。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落84"
      }
    },
