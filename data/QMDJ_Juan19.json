      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落89"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L090",
      "original_quote": "元武日，出行主口舌，凡事不遂，不可用。",
      "tag": [],
