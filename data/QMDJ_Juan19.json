      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷19",
        "section": "卷19",
        "line_ref": "段落71"
      }
    },
    {
      "line_id": "QMDJ_Juan19_L072",
      "original_quote": "金堂日，出行吉利通，詞訟有理，求財稱意，大吉。",
