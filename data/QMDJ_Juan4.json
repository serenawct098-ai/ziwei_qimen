      "original_quote": "加丙：貴人印綬。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷4",
        "section": "卷4",
        "line_ref": "段落54"
      }
    },
