      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷4",
        "section": "卷4",
        "line_ref": "段落135"
      }
    },
    {
      "line_id": "QMDJ_Juan4_L136",
      "original_quote": "加休；一里、十一里逢皂衣及扛錢人。",
