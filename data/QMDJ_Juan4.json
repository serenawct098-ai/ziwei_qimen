        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷4",
        "section": "卷4",
        "line_ref": "段落57"
      }
    },
    {
      "line_id": "QMDJ_Juan4_L058",
      "original_quote": "加辛：陰人道路。",
      "tag": [],
      "paragraph_index": 0,
      "_source": {
        "text": "奇門遁甲秘笈大全",
        "juan": "上卷·卷4",
        "section": "卷4",
        "line_ref": "段落58"
      }
    },
    {
      "line_id": "QMDJ_Juan4_L059",
      "original_quote": "加壬：遠行有失。",
