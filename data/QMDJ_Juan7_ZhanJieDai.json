  "entries": [
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L000",
      "original_quote": "占借貸",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L001",
      "original_quote": "占求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L002",
      "original_quote": "當分休囚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L003",
      "original_quote": "以生門所落之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L004",
      "original_quote": "為休生開上所乘之星為用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L005",
      "original_quote": "用生休吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L006",
      "original_quote": "休生咎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L007",
      "original_quote": "則不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L008",
      "original_quote": "囚旺休衰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L009",
      "original_quote": "休雖剋囚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L010",
      "original_quote": "不為大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L011",
      "original_quote": "休旺衰囚",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L012",
      "original_quote": "雖剋休亦無大害",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L013",
      "original_quote": "大抵看門所落宮分",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L014",
      "original_quote": "再看上下三盤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L015",
      "original_quote": "格局吉凶何如?吉信吉星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L016",
      "original_quote": "所求如意",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L017",
      "original_quote": "一有不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L018",
      "original_quote": "所求僅半",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L019",
      "original_quote": "休囚不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan7_ZhanJieDai_L020",
      "original_quote": "所求全無",
      "tag": []
    }
  ],
