{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan9",
  "section": "占墳墓",
  "entries": [
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L000",
      "original_quote": "占墳墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L001",
      "original_quote": "凡墳墓之地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L002",
      "original_quote": "死者居之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L003",
      "original_quote": "吉則招福",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L004",
      "original_quote": "凶則招禍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L005",
      "original_quote": "蓋祖先之靈魂守黃泉之下",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L006",
      "original_quote": "安則子孫興旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L007",
      "original_quote": "不安則子孫敗亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L008",
      "original_quote": "若未葬之先占之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L009",
      "original_quote": "其法專責死門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L010",
      "original_quote": "並天地二盤之星決之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L011",
      "original_quote": "以死門落宮地盤之星為死者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L012",
      "original_quote": "死門天盤之星為主人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L013",
      "original_quote": "死門落宮乘三奇而與地盤之星相生",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L014",
      "original_quote": "相合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L015",
      "original_quote": "不相剋制者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L016",
      "original_quote": "主死者安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L017",
      "original_quote": "地盤之星生天盤之星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L018",
      "original_quote": "天盤之星得三奇者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L019",
      "original_quote": "主存亡俱安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L020",
      "original_quote": "吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L021",
      "original_quote": "後主興旺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L022",
      "original_quote": "若死門落宮與地盤之星相剋者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L023",
      "original_quote": "主存亡不安",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L024",
      "original_quote": "地盤之星剋天盤之星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L025",
      "original_quote": "不得奇門護持者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L026",
      "original_quote": "主存亡俱凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L027",
      "original_quote": "死門反吟者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L028",
      "original_quote": "遷之斯吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L029",
      "original_quote": "死門落空亡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L030",
      "original_quote": "主無地氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L031",
      "original_quote": "家敗人亡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L032",
      "original_quote": "再以何干",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L033",
      "original_quote": "何神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L034",
      "original_quote": "何格推之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L035",
      "original_quote": "吉星吉干生旺者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L036",
      "original_quote": "吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L037",
      "original_quote": "凶神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L038",
      "original_quote": "凶格",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L039",
      "original_quote": "凶干剋制者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L040",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L041",
      "original_quote": "此天盤之星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L042",
      "original_quote": "疑上下二盤之星而言",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanFenMu_L043",
      "original_quote": "應俟高明者訪焉",
      "tag": []
    }
  ],
  "_source": {
