  "entries": [
    {
      "line_id": "ZWQS_Juan1_WendaTianyao_L001",
      "original_quote": "問天姚星所主若何？",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
