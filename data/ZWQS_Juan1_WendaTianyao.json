        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianyao_L002",
      "original_quote": "希夷先生答曰：天姚守身命，心性陰毒，多疑恐、善顏色、風流多婢、主淫。入廟旺主富貴多奴，居亥有學識。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianyao_L002",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianyao_L003",
      "original_quote": "會惡星破家敗產，因色犯刑。六合重逢，少年夭折。若臨限不用媒妁，招手成婚。或紫微吉星加，剛柔相濟，主風騷，加紅鸞愈淫，加刑刃主夭。",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianyao_L003",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianyao_L004",
      "original_quote": "歌曰",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianyao_L004",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianyao_L005",
      "original_quote": "天姚居戌卯西遊，更入雙魚一併求，福厚生成耽酒色，無災無禍度春秋，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianyao_L005",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianyao_L006",
      "original_quote": "天姚星與敗星同，號曰人間掃氣囂，辛苦平生過一世，不曾安跡在客中，",
      "tag": [],
      "tag_reason": "",
      "_source": {
        "text": "紫微斗數全書",
        "juan": "卷一",
        "section": "星垣問答論",
        "line_id": "ZWQS_Juan1_WendaTianyao_L006",
        "base_edition_lock": "羅洪先編本"
      }
    },
    {
      "line_id": "ZWQS_Juan1_WendaTianyao_L007",
      "original_quote": "人身偶爾值天姚，戀色貪花性帚凶，此曜若居生旺地，位登極品亦風騷。",
      "tag": [],
      "tag_reason": "",
