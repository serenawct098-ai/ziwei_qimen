{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "起休門訣",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L000",
      "original_quote": "起休門訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L001",
      "original_quote": "如冬至後陽遁順起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L002",
      "original_quote": "甲戊壬子坎為休",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L003",
      "original_quote": "是休門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L004",
      "original_quote": "在坎一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L005",
      "original_quote": "生門在艮八",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L006",
      "original_quote": "數至開門在乾六",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L007",
      "original_quote": "乙丑日休門還在坎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L008",
      "original_quote": "生門轉乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L009",
      "original_quote": "數至開門在艮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L010",
      "original_quote": "丙寅日休門亦在坎",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L011",
      "original_quote": "生門又轉在艮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L012",
      "original_quote": "開門又在乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L013",
      "original_quote": "此陽順陰逆也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L014",
      "original_quote": "如丁辛乙卯向坤游",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L015",
      "original_quote": "則休門移於坤二矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L016",
      "original_quote": "此三日一換也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L017",
      "original_quote": "餘類推",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L018",
      "original_quote": "夏至後甲戊壬子居離九",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_QiXiuMen_L019",
      "original_quote": "系逆起亦問此義",
      "tag": []
    }
  ],
