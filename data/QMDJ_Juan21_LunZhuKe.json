{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan21",
  "section": "論主客",
  "entries": [
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L000",
      "original_quote": "論主客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L001",
      "original_quote": "太公曰：「凡主客動靜不定",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L002",
      "original_quote": "變化莫測」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L003",
      "original_quote": "故主客不定之象",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L004",
      "original_quote": "或以先動為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L005",
      "original_quote": "後動為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L006",
      "original_quote": "或以動為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L007",
      "original_quote": "靜為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L008",
      "original_quote": "或以先聲為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L009",
      "original_quote": "或以天盤為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L010",
      "original_quote": "地盤為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L011",
      "original_quote": "諸事總有用訣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L012",
      "original_quote": "成敗勝負皆貴乎主賓之緊要也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L013",
      "original_quote": "如出兵動眾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L014",
      "original_quote": "以我為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L015",
      "original_quote": "至彼地為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L016",
      "original_quote": "或賊巢及賊所侵之城郭為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L017",
      "original_quote": "或以陽為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L018",
      "original_quote": "陰為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L019",
      "original_quote": "或反客為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L020",
      "original_quote": "反主為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L021",
      "original_quote": "若選將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L022",
      "original_quote": "求賢",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L023",
      "original_quote": "招兵買馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L024",
      "original_quote": "干謁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L025",
      "original_quote": "訪友之類",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L026",
      "original_quote": "是我為客彼他",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L027",
      "original_quote": "彼人為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L028",
      "original_quote": "如有人來求我",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L029",
      "original_quote": "或通知我而我未知",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L030",
      "original_quote": "是彼為客我為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L031",
      "original_quote": "如在對陣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L032",
      "original_quote": "或不在對敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L033",
      "original_quote": "再分主客也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L034",
      "original_quote": "或此時交鋒若利客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L035",
      "original_quote": "宜先耀武揚威",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L036",
      "original_quote": "放炮吶喊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L037",
      "original_quote": "若利主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L038",
      "original_quote": "惟宜偃旗旗息鼓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L039",
      "original_quote": "禁聲而敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L040",
      "original_quote": "埋伏取勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L041",
      "original_quote": "凡發兵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L042",
      "original_quote": "須看賊巢遠近",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L043",
      "original_quote": "如發兵時交戰",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L044",
      "original_quote": "或不同時交鋒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L045",
      "original_quote": "不可以先動為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L046",
      "original_quote": "待臨敵取主客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L047",
      "original_quote": "到時而用之可也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L048",
      "original_quote": "如此時主客不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L049",
      "original_quote": "只宜固守",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L050",
      "original_quote": "倘若急迫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L051",
      "original_quote": "或被圍困",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L052",
      "original_quote": "宜以計勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L053",
      "original_quote": "或運籌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L054",
      "original_quote": "閉六戊",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L055",
      "original_quote": "或乘天馬",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L056",
      "original_quote": "或書符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L057",
      "original_quote": "念咒等類亦可",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L058",
      "original_quote": "如國事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L059",
      "original_quote": "都省府縣鄉事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L060",
      "original_quote": "家宅",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L061",
      "original_quote": "官訟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L062",
      "original_quote": "墳塋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L063",
      "original_quote": "求謀",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L064",
      "original_quote": "名利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L065",
      "original_quote": "婚姻",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L066",
      "original_quote": "行人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L067",
      "original_quote": "失脫",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L068",
      "original_quote": "逃走",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L069",
      "original_quote": "捕捉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L070",
      "original_quote": "即以地盤為主人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L071",
      "original_quote": "天盤為客人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L072",
      "original_quote": "人事是多",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L073",
      "original_quote": "不能細述",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L074",
      "original_quote": "大天盤諸星生合地盤為上",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L075",
      "original_quote": "地盤生合天盤次之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L076",
      "original_quote": "如客生主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L077",
      "original_quote": "為稱意美滿",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L078",
      "original_quote": "進益多端",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L079",
      "original_quote": "主生客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L080",
      "original_quote": "為耗散遲延",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L081",
      "original_quote": "主客皆和",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L082",
      "original_quote": "行藏皆遂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L083",
      "original_quote": "主剋客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L084",
      "original_quote": "乃半實半虛",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L085",
      "original_quote": "自敗虛花",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L086",
      "original_quote": "事為不果",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L087",
      "original_quote": "客剋主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L088",
      "original_quote": "則戰敗無成",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L089",
      "original_quote": "求吉招凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L090",
      "original_quote": "故善用奇門者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L091",
      "original_quote": "先分主客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L092",
      "original_quote": "然後再明占法",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L093",
      "original_quote": "如此時利主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L094",
      "original_quote": "我即為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L095",
      "original_quote": "此時利客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L096",
      "original_quote": "我即為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L097",
      "original_quote": "或以進為客",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L098",
      "original_quote": "不進為主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L099",
      "original_quote": "在我一心",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L100",
      "original_quote": "不可執一",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan21_LunZhuKe_L101",
      "original_quote": "為客為主任我可也",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan21",
    "section": "論主客",
    "line_id_start": "QMDJ_Juan21_LunZhuKe_L000",
    "line_id_end": "QMDJ_Juan21_LunZhuKe_L101"
  },
  "_extraction_status": "論主客完成"
}