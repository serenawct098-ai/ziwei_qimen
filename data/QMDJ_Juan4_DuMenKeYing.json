  "section": "杜門剋應",
  "entries": [
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L000",
      "original_quote": "杜門剋應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L001",
      "original_quote": "休門最好聚資財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L002",
      "original_quote": "牛馬豬羊自送來",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L003",
      "original_quote": "外日婚姻南方應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L004",
      "original_quote": "遷官進職作京台",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L005",
      "original_quote": "定進羽音人產業",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L006",
      "original_quote": "居家安慶水無災",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L007",
      "original_quote": "問曰：休門屬水",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L008",
      "original_quote": "無物不殺",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L009",
      "original_quote": "霜雪之寒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L010",
      "original_quote": "純陰之氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L011",
      "original_quote": "元武之精",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L012",
      "original_quote": "三光不照",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L013",
      "original_quote": "鬼邪所居之宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L014",
      "original_quote": "何以言吉?",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L015",
      "original_quote": "衢仙答曰：「休門之水",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L016",
      "original_quote": "故為至陰之地",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L017",
      "original_quote": "實系寶瓶宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L018",
      "original_quote": "萬物以水為生氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L019",
      "original_quote": "而發揚於外",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L020",
      "original_quote": "以水為死氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L021",
      "original_quote": "收斂歸根而藏精於內",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L022",
      "original_quote": "子者乃一陽複始之初",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L023",
      "original_quote": "草木值此而萌動",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L024",
      "original_quote": "返本還源之門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L025",
      "original_quote": "所以吉也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L026",
      "original_quote": "休門與丁奇合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L027",
      "original_quote": "下臨太陰為人遁",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L028",
      "original_quote": "得星精所蔽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L029",
      "original_quote": "百事皆吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L030",
      "original_quote": "旺於震宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L031",
      "original_quote": "相於坎宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L032",
      "original_quote": "生於乾",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L033",
      "original_quote": "兌宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L034",
      "original_quote": "皆吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L035",
      "original_quote": "坤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L036",
      "original_quote": "艮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L037",
      "original_quote": "中宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L038",
      "original_quote": "被土剋制",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L039",
      "original_quote": "巽宮入墓",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L040",
      "original_quote": "離宮返吟",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L041",
      "original_quote": "不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L042",
      "original_quote": "宜謁貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L043",
      "original_quote": "取和合",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L044",
      "original_quote": "百事皆吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L045",
      "original_quote": "出行五十里見蛇",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L046",
      "original_quote": "鼠",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L047",
      "original_quote": "水中黑色之物為應」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L048",
      "original_quote": "靜應",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L049",
      "original_quote": "休門加休：求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L050",
      "original_quote": "進人口",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L051",
      "original_quote": "謁貴吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L052",
      "original_quote": "朝見",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L053",
      "original_quote": "上官修",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L054",
      "original_quote": "大利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L055",
      "original_quote": "加生：主得陰人財物並干貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L056",
      "original_quote": "謀望遲應吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L057",
      "original_quote": "加傷：主上官喜慶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L058",
      "original_quote": "求財不得",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L059",
      "original_quote": "有親故分產變動事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L060",
      "original_quote": "不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L061",
      "original_quote": "加杜：主破財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L062",
      "original_quote": "失物難尋",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L063",
      "original_quote": "加景：主求望",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L064",
      "original_quote": "文書印信事不至",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L065",
      "original_quote": "反招口舌",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L066",
      "original_quote": "小凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L067",
      "original_quote": "加死：主求文書印信",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L068",
      "original_quote": "官司事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L069",
      "original_quote": "或僧道遠行事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L070",
      "original_quote": "不吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L071",
      "original_quote": "占病",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L072",
      "original_quote": "凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L073",
      "original_quote": "加驚：主損財招益",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L074",
      "original_quote": "並疾病驚恐事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L075",
      "original_quote": "破財不利",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L076",
      "original_quote": "加開：主開張店肆及見貴",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L077",
      "original_quote": "求財",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L078",
      "original_quote": "喜慶事",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L079",
      "original_quote": "大吉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan4_DuMenKeYing_L080",
      "original_quote": "加甲戊：財物和合",
      "tag": []
    }
