{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan25",
  "section": "三勝宮",
  "entries": [
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L000",
      "original_quote": "三勝宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L001",
      "original_quote": "第一勝天乙宮即值符宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L002",
      "original_quote": "上將居之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L003",
      "original_quote": "用兵而擊其衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L004",
      "original_quote": "百戰百勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L005",
      "original_quote": "只要坐三向五",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L006",
      "original_quote": "不可坐五向三",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L007",
      "original_quote": "三為生氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L008",
      "original_quote": "五為死氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L009",
      "original_quote": "生謂坐生門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L010",
      "original_quote": "死為坐死門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L011",
      "original_quote": "若甲申庚見值符",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L012",
      "original_quote": "則不可引兵居也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L013",
      "original_quote": "第二勝九天宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L014",
      "original_quote": "上將居之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L015",
      "original_quote": "用兵擊其衝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L016",
      "original_quote": "則敵雖大",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L017",
      "original_quote": "不敢當我鋒",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L018",
      "original_quote": "而大勝矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L019",
      "original_quote": "第三勝生門宮合三奇之吉宮",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L020",
      "original_quote": "上將引兵從生門擊死門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan25_3ShengGong_L021",
      "original_quote": "百戰百勝",
      "tag": []
    }
  ],
