{
  "text": "奇門遁甲秘笈大全",
  "juan": "Juan30",
  "section": "諸葛武侯行兵遁甲金函玉鏡圖序",
  "entries": [
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L000",
      "original_quote": "諸葛武侯行兵遁甲金函玉鏡圖序",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L001",
      "original_quote": "諸葛武侯行兵遁甲金函玉鏡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L002",
      "original_quote": "諸葛武侯行兵遁甲金函玉鏡圖序",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L003",
      "original_quote": "金函玉鏡者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L004",
      "original_quote": "蜀時諸葛孔明所著也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L005",
      "original_quote": "當漢末時因黃巾之亂",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L006",
      "original_quote": "天下豪傑並起",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L007",
      "original_quote": "而曹氏父子",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L008",
      "original_quote": "孫權",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L009",
      "original_quote": "周瑜諸將",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L010",
      "original_quote": "皆稱召用兵過於孫吳者也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L011",
      "original_quote": "獨孔明與蜀主往往行兵遇敵",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L012",
      "original_quote": "縱橫吳魏間",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L013",
      "original_quote": "以正維奇兵而獲勝者何?蓋此乃出於金函玉鏡之書",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L014",
      "original_quote": "是書始自上古聖皇軒轅氏破蚩尤不勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L015",
      "original_quote": "齋戒上感九天玄女",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L016",
      "original_quote": "傳授驅役六丁玉女之神",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L017",
      "original_quote": "諸遁甲旬內逐日遁時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L018",
      "original_quote": "書為八門定以吉凶",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L019",
      "original_quote": "分內外勝負集為秘書一編傳於世間",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L020",
      "original_quote": "而孔明得之於龍門山岩穴之間",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L021",
      "original_quote": "孔明行師出陣用以取勝",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L022",
      "original_quote": "魏吳諸將咸稱其神焉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L023",
      "original_quote": "孔明奇其書可以傳世",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L024",
      "original_quote": "厥後自畫圖局六十甲子日",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L025",
      "original_quote": "每日十二時",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L026",
      "original_quote": "全圖局俱載",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L027",
      "original_quote": "九星所值",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L028",
      "original_quote": "各門吉凶成敗",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L029",
      "original_quote": "以備行兵擇選用之者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L030",
      "original_quote": "其應如響",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L031",
      "original_quote": "名之曰金函玉鏡圖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L032",
      "original_quote": "其書指畫詳明",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L033",
      "original_quote": "別為一家",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L034",
      "original_quote": "不與遁甲諸書相似",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L035",
      "original_quote": "所稱神異",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L036",
      "original_quote": "不可測度者也",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L037",
      "original_quote": "孔明有云",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L038",
      "original_quote": "是書在兵興之日則為行軍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L039",
      "original_quote": "其歷代作日用選擇出行必不可無者甚矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L040",
      "original_quote": "流傳於世歷代",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L041",
      "original_quote": "知兵之將帥",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L042",
      "original_quote": "此秘而寶之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L043",
      "original_quote": "其傳者寡矣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L044",
      "original_quote": "余學兵二十年",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L045",
      "original_quote": "凡武經韜略七寶新書",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L046",
      "original_quote": "六旨金鏡",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L047",
      "original_quote": "青囊索書",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L048",
      "original_quote": "諸家兵法悉得觀覽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L049",
      "original_quote": "獨孫氏與是圖",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L050",
      "original_quote": "相為體用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L051",
      "original_quote": "誠國家之書籍",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L052",
      "original_quote": "而無毫髮差誤",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L053",
      "original_quote": "實世之寶焉",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L054",
      "original_quote": "餘雖武人不文獨得是圖之微奧",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L055",
      "original_quote": "不敢擅秘",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L056",
      "original_quote": "以故今出終南山黃岩老人",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L057",
      "original_quote": "夙朝本朝大將狄青家藏本繕圖式",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L058",
      "original_quote": "命史端撫抄錄用",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L059",
      "original_quote": "廣其傳以俟後世",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L060",
      "original_quote": "明哲忠謀之士用兵之際",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L061",
      "original_quote": "得以觀閱闡助武功",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan30_JinHanYuJingXu_L062",
      "original_quote": "以見餘之不秘昔賢之傳也",
      "tag": []
    }
  ],
  "_source": {
    "text": "奇門遁甲秘笈大全",
    "juan": "Juan30",
    "section": "諸葛武侯行兵遁甲金函玉鏡圖序",
