    },
    {
      "line_id": "QMDJ_Juan6_JiuDunBianHua_L163",
      "original_quote": "名為「神遁」",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuDunBianHua_L164",
      "original_quote": "或生門",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuDunBianHua_L165",
      "original_quote": "丙奇合禽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuDunBianHua_L166",
      "original_quote": "心二星",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan6_JiuDunBianHua_L167",
