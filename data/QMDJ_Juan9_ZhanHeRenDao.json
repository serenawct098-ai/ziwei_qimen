  "entries": [
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L000",
      "original_quote": "占何人盜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L001",
      "original_quote": "以蓬元為盜主",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L002",
      "original_quote": "神乘旺相氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L003",
      "original_quote": "又得奇門吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L004",
      "original_quote": "乃是貴人為盜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L005",
      "original_quote": "不乘旺相氣",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L006",
      "original_quote": "不得奇門吉格者",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L007",
      "original_quote": "乃是小人為盜",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L008",
      "original_quote": "仍配卦以決之",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L009",
      "original_quote": "乾為老陽",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L010",
      "original_quote": "震為長",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L011",
      "original_quote": "壯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L012",
      "original_quote": "坎為中男",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L013",
      "original_quote": "始壯",
      "tag": []
    },
    {
      "line_id": "QMDJ_Juan9_ZhanHeRenDao_L014",
