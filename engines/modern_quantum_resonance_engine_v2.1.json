          "primary_interference_source": "string",
          "cross_layer_evidence": [
            "string"
          ]
        }
      ],
      "space_lock": "boolean",
      "compression_ratio": "string",
      "bridge_source_lock": "string"
    },
    "narrative_text": {
      "WHAT_現象核心": "string",
