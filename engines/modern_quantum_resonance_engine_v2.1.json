      "HIDDEN_隱藏氣運": "string",
      "BLIND_反噬盲點": "string",
      "TRIGGER_觸發行動": "string"
    },
    "mitigation_protocol": {
      "avoid_direction": "string",
      "alternate_favorable_time_window": "string",
      "defense_checklist": [
        "string"
      ]
    },
    "next_action": "一個具體的下一步行動"
  },
  "safety_assertions": {
    "A1": "不得自行推導命宮/身宮/五虎遁/五行局/紫微/天府/十四主星/四化/斗君/旬首/三元/局數。",
    "A2": "若 final_qimen_board、current_jieqi_exact_timestamp、zhi_to_qimen_palace_map 或 kun_2_redirect_rule 缺失，立即 HALT。",
    "A3": "不得把 Monte Carlo 視為 LLM 內生能力；未經外部確定性沙盒驗證不得輸出。",
    "A4": "任何 TODO、placeholder、未定義映射或缺依賴，一律 fail-closed。"
  },
