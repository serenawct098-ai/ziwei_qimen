{
  "$schema": "ziwei_qimen_interpretation_engine.modern_quantum_resonance_engine.v2.1",
  "engine_name": "modern_quantum_resonance_engine",
  "version": "2.1.0",
  "archetype": "Systemic Risk & Optimization Analyst",
  "positioning": {
    "core_principle": "精密、冷酷、極致理性的決策科學；去除好運/壞運語言，將命盤視為動態隨機干涉的壓力系統。",
    "scope": "只輸出可被驗證的結構風險、干涉來源、行動窗口與防禦協議；不使用宿命、福報、天意等敘事。",
    "double_engine_role": "與 traditional_mythos_engine 並行運算；本引擎專司壓測、失效機理、盲點偵測與時空鎖死判定。"
  },
  "input_interface": {
    "required_data": [
      "birth_chart",
      "five_layer_transformations",
      "qimen_palace_status"
    ],
    "optional_data": [
      "decade_fortune",
      "annual_fortune",
      "monthly_fortune",
      "daily_fortune",
      "query_context",
      "flow_month_palace_axis",
      "leap_month_rule_mode",
      "zhi_to_qimen_palace_map"
    ],
    "binding_contract": {
      "birth_chart": {
        "required_fields": [
          "minggong_zhi_idx",
          "shengong_zhi_idx",
          "twelve_palace_star_map",
          "principal_stars_14",
          "star_brightness_states",
          "empty_palace_flags",
          "opposite_palace_support_map",
          "principal_star_source_ref",
          "auxiliary_star_source_table_refs",
          "sihua_version_lock"
        ]
      },
      "five_layer_transformations": {
        "required_fields": [
          "natal_sihua",
          "decade_sihua",
          "annual_sihua",
          "monthly_sihua",
          "daily_sihua",
          "energy_density",
          "blind_spot",
          "collision_score",
          "decision_band"
        ]
      },
      "qimen_palace_status": {
        "required_fields": [
          "qimen_dun_type",
          "qimen_ju_number",
          "zhifu_star",
          "zhishi_door",
          "nine_palace_layout",
          "door_element_map",
          "palace_element_map",
          "directional_output",
          "final_qimen_board",
          "kun_2_redirect_rule",
          "current_jieqi_exact_timestamp",
          "qimen_ju_source"
        ]
      }
    }
  },
  "execution_position": {
    "upstream_required_engines": [
      "traditional_core_engine_v2.1.json",
      "full_compute_flow_v1.4.json",
      "interpretation_engine_v1.1.json"
    ],
    "consume_only_verified_core_outputs": true,
    "forbid_direct_formula_inference": true,
    "forbid_freehand_json_fabrication": true,
    "fail_closed": true,
    "no_todo_allowed": true
  },
  "data_resonance_layer": {
    "mathematical_models": {
      "formula": "raw_score = sum(weight_map[T] * L.layer_weight)",
      "layer_weight_table": {
        "natal": 1.0,
        "decade": 0.7,
        "annual": 0.5,
        "monthly": 0.3,
        "daily": 0.1
      },
      "weight_map_reference": {
        "hualu": 8,
        "huaquan": 6,
        "huake": 5,
        "huaji": -12,
        "miao": 12,
        "wang": 8,
        "li": 4,
        "ping": 0,
        "xian": -8,
        "single_sha": -6,
        "double_sha": -12,
        "triple_sha": -18,
        "opposite_palace_support": 6,
        "sanfang_support": 12,
        "empty_palace_penalty": -10
      },
      "energy_density_band": {
        "85_100": "exploit_window",
        "70_84": "prepare_execute",
        "50_69": "monitor_only",
        "30_49": "conserve",
        "0_29": "retreat"
      },
      "monte_carlo_spec": {
        "simulations": 10000,
        "variables": [
          "random_sihua_injection",
          "empty_palace_collapse",
          "sha_star_activation"
        ],
        "distribution_assumptions": {
          "random_sihua_injection": "bernoulli_weighted_by_layer",
          "empty_palace_collapse": "bernoulli_with_opposite_support_modifier",
          "sha_star_activation": "categorical_single_double_triple_sha"
        },
        "outputs": [
          "collapse_frequency_rank",
          "top3_failure_nodes",
          "failure_path_clusters",
          "mitigation_trigger_thresholds"
        ],
        "execution_gate": "external deterministic sandbox only",
        "llm_execution_forbidden": true
      },
      "ti_yong_balance": {
        "_doc": "南體北用分層權重鎖（與 core.layered_interpretation_protocol 同步）",
        "body": 0.5,
        "use": 0.5,
        "conflict_policy": "parallel_annotation（體用並列，不單邊裁決）"
      }
    },
    "blind_spot_modules": [
      "M1_吉處藏凶",
      "M2_不對稱風險",
      "M3_視角缺失_空宮盲點",
      "M4_倖存者偏差過濾器"
    ],
    "module_definitions": {
      "M1_吉處藏凶": {
        "source_rule_ref": "BS001/FH002",
        "logic": "最高表面能量宮位 != 最高可執行共振宮位，或有支持敘事遮蔽實際抑制訊號。",
        "output_label": "decoy_peak"
      },
      "M2_不對稱風險": {
        "source_rule_ref": "AR001/AR002/AR003",
        "logic": "單軸優勢明顯高於其餘宮域，且損失恢復難度大於收益擴張速度。",
        "output_label": "asymmetric_loss_profile"
      },
      "M3_視角缺失_空宮盲點": {
        "source_rule_ref": "konggong + opposite compensation scan",
        "logic": "目標宮無主星時，若使用者仍以該宮表象做判斷，則視為視角缺失。",
        "output_label": "missing_kiji_or_empty_bias"
      },
      "M4_倖存者偏差過濾器": {
        "source_rule_ref": "historical branch compression",
        "logic": "只看成格成功案例，不看化忌、空宮、煞啟動的失敗分支，則視為樣本偏差。",
        "output_label": "survivorship_bias"
      }
    }
  },
  "risk_scoring_layer": {
    "purpose": "把紫微結構、四化壓力、奇門時空條件合併成可執行風險輸出。",
    "serial_scoring_rules": {
      "collision_score_formula": "collision_score = ziwei_palace_score * gate_multiplier * five_element_modifier",
      "bridge_score_formula": "FinalScore = ZiweiStrengthScore + PalaceEnergyWeight + GatePalaceInteractionModifier + TimingModifier",
      "weights": {
        "ziwei": 0.6,
        "qimen": 0.4
      },
      "decision_bands": {
        "3_to_10": "action",
        "0_to_2": "wait_prepare",
        "-10_to_-1": "mitigate"
      },
      "energy_weight_action_map": {
        "2": "extreme_activation",
        "1": "positive_accumulation",
        "0": "observe",
        "-1": "conserve",
        "-2": "mitigate"
      }
    },
    "defensive_trigger_rules": {
      "hard_trigger": "IF (FinalScore <= -2) OR (忌入官財命)",
      "when_triggered": [
        "run_monte_carlo_10000",
        "extract_top3_failure_nodes",
        "emit_mitigation_protocol",
        "check_space_lock"
      ],
      "top3_failure_node_schema": {
        "fields": [
          "node_id",
          "domain",
          "failure_frequency",
          "primary_interference_source",
          "cross_layer_evidence"
        ]
      }
    },
    "asymmetry_rules": {
      "AR001": {
        "condition": "career_score - relationship_score >= 30",
        "severity": "high",
        "label": "single_axis_obsession"
      },
      "AR002": {
        "condition": "wealth_score - mental_score >= 25",
        "severity": "medium",
        "label": "resource_gain_psychic_leak"
      },
      "AR003": {
        "condition": "self_axis_score high and health_score low for 2 windows",
        "severity": "high",
        "label": "performance_health_divergence"
      }
    },
    "bridge_prerequisites": [
      "zhi_to_qimen_palace_map",
      "kun_2_redirect_rule",
      "final_qimen_board"
    ]
  },
  "space_lock_layer": {
    "purpose": "比對物理方位與九宮八門，判定是否存在空間鎖死與能量壓縮。",
    "required_inputs": [
      "target_direction",
      "mapped_qimen_palace",
      "door_element",
      "palace_element",
      "five_element_relation",
      "collision_score",
      "current_jieqi_exact_timestamp"
    ],
    "space_lock_rule": {
      "space_lock_true_when": [
        "collision_score <= 40",
        "five_element_relation in ['control_target','target_generates_other']",
        "mapped_qimen_palace flagged as suppressed or heavily_suppressed"
      ],
      "space_lock_false_when": [
        "collision_score >= 60",
        "five_element_relation in ['same_element','generate_target']",
        "no_suppressed_domain_flag"
      ]
    },
    "compression_ratio_formula": "compression_ratio = N * M_percent",
    "compression_ratio_variables": {
      "N": "number_of_simultaneous_suppressors",
      "M_percent": "mean suppression weight percent across gate/palace/sihua layers"
    },
    "output_contract": {
      "fields": [
        "space_lock",
        "compression_ratio",
        "blocked_direction",
        "alternate_direction",
        "alternate_time_window"
      ]
    }
  },
  "mitigation_protocol_layer": {
    "mitigation_agreement": {
      "light": "delay 1 minor window, adjust direction within same trigram",
      "medium": "shift both timing and direction, reduce stake size by 50%",
      "heavy": "full lockdown, cancel current move, switch to preservation mode"
    },
    "output_template": {
      "required_blocks": [
        "avoid_direction",
        "alternate_favorable_time_window",
        "defense_checklist"
      ],
      "defense_checklist_min_items": 3
    },
    "defense_checklist_library": [
      "降低單次下注/投資/決策曝險比例",
      "拆分執行窗口，不在單一時間點集中觸發",
      "避免朝受抑制宮位方向強行推進",
      "先驗證對宮補償條件是否成立，再決定是否行動",
      "若空宮盲點成立，先補資料再做結論",
      "若化忌同時進入官祿/財帛/命宮，停止擴張，轉入防守模式"
    ]
  },
  "narrative_output_layer": {
    "style_guide": {
      "forbidden_words": [
        "運氣好",
        "事業順",
        "感情佳",
        "近期有喜",
        "諸事順遂",
        "小心即可",
        "天意",
        "福報",
        "命書云",
        "格局高亢",
        "名高責重",
        "多舛波折",
        "恐有傾覆之虞",
        "得貴人引路"
      ],
      "mandatory_structure": [
        "WHAT_現象核心",
        "WHY_結構原因",
        "HIDDEN_隱藏氣運",
        "BLIND_反噬盲點",
        "TRIGGER_觸發行動"
      ],
      "tone": "zero_emotion_filter",
      "must_include": [
        "mechanism",
        "counter_force",
        "blindspot",
        "action_trigger"
      ],
      "must_avoid": [
        "vague encouragement",
        "fortune_good_bad_wording",
        "empty_mysticism"
      ]
    },
    "inversion_hook_questions": [
      "1. 吉星在大限化忌下失效，最先崩潰的宮位是哪個？",
      "2. 當前計劃若失敗，蒙地卡羅掃描的最高頻干擾來自何處？",
      "3. 歷史相似案例中，成功20%與失敗80%的關鍵分叉點是什麼？",
      "4. 您的隱藏氣運是否正被空宮盲點習慣性消耗？"
    ],
    "output_rules": {
      "must_state_uncertainty_first": true,
      "must_separate_layers": [
        "natal",
        "decade",
        "annual",
        "monthly",
        "daily",
        "qimen"
      ],
      "must_end_with": "one concrete next action",
      "forbidden": [
        "unknown presented as known",
        "cross-layer mixing without label",
        "softening collapse scenarios into encouragement"
      ]
    },
    "section_templates": {
      "WHAT_現象核心": "描述當前最顯著的結構現象與受影響宮域。",
      "WHY_結構原因": "列出四化、廟旺、煞星、三方四正、九宮八門造成該現象的機理。",
      "HIDDEN_隱藏氣運": "指出 Missing Kiji、空宮補償失敗、隱性壓力累積點。",
      "BLIND_反噬盲點": "指出使用者最容易誤判的位置與條件。",
      "TRIGGER_觸發行動": "給出可執行的時間、方向、風險控制與停止條件。"
    }
  },
  "execution_pipeline": {
    "pipeline_name": "modern_quantum_resonance_pipeline",
    "serial_order": [
      "Q00_line_by_line_literature_audit",
      "Q00A_json_field_mapping_audit",
      "Q00B_sandbox_enumeration_gate",
      "Q01_validate_verified_inputs",
      "Q02_bind_canonical_snapshot",
      "Q03_apply_five_layer_sihua_weights",
      "Q04_compute_raw_score_and_energy_density",
      "Q05_scan_asymmetry_and_hidden_kiji",
      "Q06_map_ziwei_to_qimen_bridge",
      "Q07_compute_collision_and_final_score",
      "Q08_check_hard_trigger_and_run_monte_carlo",
      "Q09_detect_space_lock_and_compression_ratio",
      "Q10_emit_mitigation_protocol",
      "Q11_compose_zero_emotion_narrative",
      "Q12_enforce_forbidden_phrase_gate"
    ],
    "blocks": {
      "Q01_validate_verified_inputs": {
        "purpose": "只接受已驗證過的核心輸入，缺欄位即 fail closed。"
      },
      "Q02_bind_canonical_snapshot": {
        "purpose": "以單一時間基準綁定本命/大限/流年/月/日與奇門盤。"
      },
      "Q03_apply_five_layer_sihua_weights": {
        "purpose": "本命×1.0 到流日×0.1 疊加四化權重。",
        "formula_reference": "raw_score = sum(weight_map[T] * L.layer_weight)"
      },
      "Q04_compute_raw_score_and_energy_density": {
        "purpose": "把加權結果正規化為 0-100 energy_density 分數帶。"
      },
      "Q05_scan_asymmetry_and_hidden_kiji": {
        "purpose": "掃描吉處藏凶、不對稱風險、空宮盲點與倖存者偏差。"
      },
      "Q06_map_ziwei_to_qimen_bridge": {
        "purpose": "用既有 zhi_to_qimen_palace_map / five-element bridge / kun_2_redirect_rule 對齊行動空間。"
      },
      "Q07_compute_collision_and_final_score": {
        "purpose": "輸出 collision_score、FinalScore、decision_band。"
      },
      "Q08_check_hard_trigger_and_run_monte_carlo": {
        "purpose": "若 FinalScore <= -2 或 忌入官財命，強制執行 10000 次壓測。",
        "outputs": [
          "top3_failure_nodes",
          "failure_path_clusters"
        ]
      },
      "Q09_detect_space_lock_and_compression_ratio": {
        "purpose": "判定 space_lock True/False 與 compression_ratio。"
      },
      "Q10_emit_mitigation_protocol": {
        "purpose": "輸出避開方位、替代時間窗口、防禦清單。"
      },
      "Q11_compose_zero_emotion_narrative": {
        "purpose": "按照 WHAT/WHY/HIDDEN/BLIND/TRIGGER 五段輸出。"
      },
      "Q12_enforce_forbidden_phrase_gate": {},
      "Q00_line_by_line_literature_audit": {
        "purpose": "逐條對照《全書》、古訣、SSOT 鎖定規則。",
        "fail_closed": true
      },
      "Q00A_json_field_mapping_audit": {
        "purpose": "逐條對照 JSON 欄位契約與橋接欄位。",
        "fail_closed": true
      },
      "Q00B_sandbox_enumeration_gate": {
        "purpose": "所有風險輸出必須先通過沙盒枚舉驗證結果。",
        "fail_closed": true
      }
    }
  },
  "output_schema": {
    "structured_findings": {
      "raw_score": "number",
      "energy_density": "0-100 integer",
      "collision_score": "0-100 integer",
      "FinalScore": "integer",
      "decision_band": "action|wait_prepare|mitigate",
      "blindspot_flags": [
        "string"
      ],
      "top3_failure_nodes": [
        {
          "node_id": "string",
