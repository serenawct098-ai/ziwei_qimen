  "execution_pipeline": {
    "pipeline_name": "traditional_mythos_pipeline",
    "serial_order": [
      "P00_line_by_line_literature_audit",
      "P00A_json_field_mapping_audit",
      "P00B_sandbox_enumeration_gate",
      "P01_validate_verified_inputs",
      "P02_load_classical_pattern_tables",
      "P03_scan_ziwei_natal_patterns",
      "P04_scan_sha_break_patterns",
      "P05_translate_energy_density_to_qishu",
      "P06_translate_blindspot_to_classical_risk",
      "P07_apply_sihua_classical_weighting",
      "P08_integrate_decade_annual_flow",
      "P09_translate_qimen_outer_response",
      "P10_compose_classical_sections",
      "P11_enforce_style_forbidden_words",
      "P12_emit_traditional_report"
    ],
    "blocks": {
      "P01_validate_verified_inputs": {
        "purpose": "只接受已由 v2.0 核心引擎驗證過的命盤資料。",
        "checks": [
          "birth_chart.principal_stars_14 must contain 14 stars",
          "birth_chart.mingzhu_star and shenzhu_star must come from static lookup tables",
          "five_layer_transformations.energy_density must be integer 0-100",
          "qimen_palace_status must contain zhifu_star and zhishi_door"
        ],
        "fail_closed": true
      },
      "P02_load_classical_pattern_tables": {
        "purpose": "載入本引擎內建古典格局/煞格對照表，禁止從外部臨時生成。"
      },
      "P03_scan_ziwei_natal_patterns": {
        "purpose": "依本命十四主星、廟旺、三方四正掃描成格。",
        "outputs": [
          "active_grade_A_patterns",
          "active_grade_B_patterns"
        ]
      },
      "P04_scan_sha_break_patterns": {
        "purpose": "掃描煞格、沖破、空借、吉處藏凶。",
        "outputs": [
          "active_sha_patterns",
          "break_conditions"
        ]
      },
      "P05_translate_energy_density_to_qishu": {
        "purpose": "將 energy_density 轉譯為氣數強弱，不直接暴露數值詞。",
        "outputs": [
          "classical_qishu_text",
          "qishu_band"
        ]
      },
      "P06_translate_blindspot_to_classical_risk": {
        "purpose": "將 blind_spot 轉譯為明吉暗凶、吉處藏凶、偏枯失衡等古典表述。",
        "outputs": [
          "classical_hidden_risk_text"
        ]
      },
      "P07_apply_sihua_classical_weighting": {
        "purpose": "以本命/大限/流年四化層級評估吉凶加權。",
        "rules": [
          "本命層為骨",
          "大限層為勢",
          "流年層為應",
          "若化忌入命財官核心位，凶意上升一級",
          "若祿權科連動且得廟旺，吉意上升一級"
        ],
        "outputs": [
          "classical_sihua_summary"
        ]
      },
      "P08_integrate_decade_annual_flow": {
        "purpose": "把大限流年流月編入古典氣運段，不篡改本命格局主軸。",
        "outputs": [
          "fortune_axis_summary"
        ]
      },
      "P09_translate_qimen_outer_response": {
