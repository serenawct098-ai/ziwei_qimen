      ]
    },
    "pattern_definition_table": {
      "紫府同宮格": {
        "source_pattern_id": "zifutonggong",
        "trigger": "紫微與天府同宮",
        "grade": "A",
        "classical_meaning": "主尊貴權柄、財祿豐厚、得位則名高責重。",
        "break_conditions": [
          "煞忌重疊",
          "空劫夾破",
          "四化沖破"
        ]
      },
      "極向離明格": {
        "source_pattern_id": "ji_xiang_liming_custom",
        "trigger": "太陽得令於巳午未等明位，且核心宮位得輔佐",
        "grade": "A",
        "classical_meaning": "光明顯達，名聲外揚，宜仕途、公職、領眾。",
        "break_conditions": [
          "太陽陷弱",
          "忌煞同纏",
          "命官失守"
        ]
      },
      "日出扶桑格": {
        "source_pattern_id": "richu_fusang_custom",
        "trigger": "太陽居卯辰巳等升明位，兼得吉曜扶持",
        "grade": "A",
        "classical_meaning": "主少年奮發、開創揚名、外顯之運易起。",
        "break_conditions": [
          "日月反背",
          "羊陀火鈴交會",
          "命遷失援"
        ]
      },
      "將星得地格": {
        "source_pattern_id": "jiangxing_dedi_custom",
        "trigger": "七殺、破軍、武曲或廉貞等將曜得廟旺守要宮",
        "grade": "A",
        "classical_meaning": "有權柄、有斷力、有統御之象；成則權重，敗則傾危。",
        "break_conditions": [
          "孤克太重",
          "刑忌交攻",
          "福德不載"
        ]
      },
      "機月同梁格": {
        "source_pattern_id": "jiyuetongliang",
        "trigger": "天機、太陰、天梁分布於官祿/財帛/遷移等要宮",
        "grade": "B",
        "classical_meaning": "主名聲、策畫、服務、口碑之福。",
        "break_conditions": [
          "太陰失輝",
          "梁機化忌",
          "煞沖三方"
        ]
      },
      "日月同梁格": {
        "source_pattern_id": "riyuetongliang",
        "trigger": "太陽、太陰、天梁核心宮位互拱且明度足",
        "grade": "B",
        "classical_meaning": "主公眾評價、名譽、清望。",
        "break_conditions": [
          "日月反背",
          "陷地無輔",
          "忌煞夾制"
        ]
      },
      "武曲守財格": {
        "source_pattern_id": "wuqushoucai",
        "trigger": "武曲守財帛且廟旺",
        "grade": "B",
        "classical_meaning": "善守財、精於理財、重實利。",
        "break_conditions": [
          "空劫同臨",
          "化忌入財",
          "陀武相纏"
        ]
      },
      "廉府同宮格": {
        "source_pattern_id": "lianfutonggong",
        "trigger": "廉貞與天府同宮",
        "grade": "B",
        "classical_meaning": "權祿相資，宜仕宜商。",
        "break_conditions": [
          "廉貞化忌",
          "桃花煞過重",
          "刑耗同來"
        ]
      },
      "殺破狼格": {
        "source_pattern_id": "shapolang",
        "trigger": "七殺、破軍、貪狼分佈命財官等關鍵宮位",
        "grade": "B",
        "classical_meaning": "主變動、開創、破舊立新。",
        "break_conditions": [
          "根基太弱",
          "煞重無制",
          "吉曜不扶"
        ]
      },
      "鈴昌陀武": {
        "source_pattern_id": "lingchangtuowu",
        "trigger": "鈴星、文昌、陀羅、武曲聚於三方四正或同會",
        "grade": "SHA",
        "classical_meaning": "主是非、財務波折、文書失誤、刀筆之憂。",
        "break_conditions": []
      },
      "巨火羊": {
        "source_pattern_id": "juhuoqingyang",
        "trigger": "巨門、火星、擎羊同宮或三方會聚",
        "grade": "SHA",
        "classical_meaning": "主口舌、官非、衝突、硬碰硬。",
        "break_conditions": []
      },
      "生不逢時": {
        "source_pattern_id": "shengbufengshi_custom",
        "trigger": "主星陷弱且大限流年同來沖破",
        "grade": "SHA",
        "classical_meaning": "主時位不濟，才有而不得其用。",
        "break_conditions": []
      },
      "馬頭帶劍": {
        "source_pattern_id": "matoudaijian_custom",
        "trigger": "擎羊守午或馬地受煞而帶兵刃性星曜",
        "grade": "SHA",
        "classical_meaning": "主剛決、奔波、血光、險中求成。",
        "break_conditions": []
      },
      "日月反背": {
        "source_pattern_id": "riyuefanbei",
        "trigger": "太陽太陰於核心宮位皆失輝弱陷",
        "grade": "SHA",
        "classical_meaning": "主助力不顯，外緣不足，內心多耗。",
        "break_conditions": []
      },
      "空宮借良": {
        "source_pattern_id": "konggongjieliang",
        "trigger": "目標宮無主星，須借對宮與三方吉曜解讀",
        "grade": "SHA",
        "classical_meaning": "主本宮氣虛，賴外援成局。",
        "break_conditions": []
      }
    },
    "dynamic_interference_translation": {
      "energy_density_85_100": "乘旺得令，氣象萬千，如日中天，宜乘時建功。",
      "energy_density_70_84": "吉曜高照，時位漸成，可謀進取，然仍須守序而行。",
      "energy_density_50_69": "氣象中和，得失參半，宜審局而動，不可妄進。",
      "energy_density_30_49": "氣數受抑，阻滯時見，雖有可為，仍多牽制。",
      "energy_density_0_29": "氣運對沖，群煞交會，四化沖破，宜深居簡出、蓄德避禍。"
    },
    "classical_interference_translation": {
      "bright_surface_hidden_risk": "明吉暗凶，表和內乖。",
      "auspicious_structure_broken_by_sha": "吉格逢煞，格局沖破。",
      "sha_can_be_redeemed": "煞中有救，終賴德行與時位轉圜。",
      "qi_low_but_supported": "本氣雖弱，尚得三方扶持，未至傾覆。"
    },
    "consume_only_verified_core_outputs": true,
    "forbid_recompute": true,
    "source_trace_required": [
      "star_strength_table_ref",
      "principal_star_source_ref",
      "auxiliary_star_source_table_refs",
      "sihua_version_lock"
    ]
  },
  "qimen_outer_response_translation": {
    "purpose": "將奇門九宮、八門、星門五行生剋轉譯為傳統外應文字。",
    "element_relation_rules": {
      "same_element": "氣機相應，外境順手，所求易應。",
      "generate_target": "外應有助，漸得扶持，可徐圖之。",
      "target_generates_other": "自耗其氣，勞而後成，不宜久戰。",
      "control_target": "出路遇阻，驚憂相隨，須防強壓與阻隔。",
      "target_controls_other": "可制其難，但用力過甚亦傷自身。"
    },
    "gate_translation": {
      "休門": "休養、生息、修整、回氣。",
      "生門": "生發、進財、開源、增益。",
      "傷門": "碰撞、受損、口舌、衝突。",
      "杜門": "阻隔、封閉、滯礙、難通。",
      "景門": "名聲、表象、文書、曝光。",
      "死門": "停滯、衰敗、閉塞、暗耗。",
      "驚門": "驚憂、反覆、波動、突發。",
      "開門": "開展、啟動、見官、契約。"
    },
    "classical_response_templates": {
      "metal_controls_wood": "金剋木，主出路遇阻，驚憂相隨，若有吉曜扶助，終得貴人化解。",
      "wood_controls_earth": "木剋土，主根基受擾，宜先疏導後推進。",
      "water_controls_fire": "水剋火，主名勢受抑，宜收斂聲光。",
      "fire_controls_metal": "火剋金，主爭鋒太露，易招折損。",
      "earth_controls_water": "土剋水，主路徑壅塞，消息不通。"
    }
  },
