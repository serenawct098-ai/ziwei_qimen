  "execution_pipeline": {
    "pipeline_name": "traditional_mythos_pipeline",
    "serial_order": [
      "P00_line_by_line_literature_audit",
      "P00A_json_field_mapping_audit",
      "P00B_sandbox_enumeration_gate",
      "P01_validate_verified_inputs",
      "P02_load_classical_pattern_tables",
      "P03_scan_ziwei_natal_patterns",
      "P04_scan_sha_break_patterns",
      "P05_translate_energy_density_to_qishu",
      "P06_translate_blindspot_to_classical_risk",
      "P07_apply_sihua_classical_weighting",
      "P07b_ti_yong_layered_scan",
      "P08_integrate_decade_annual_flow",
