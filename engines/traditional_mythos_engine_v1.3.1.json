{
  "$schema": "ziwei_qimen_interpretation_engine.traditional_mythos_engine.v1.3.1",
  "engine_name": "traditional_mythos_engine",
  "version": "1.3.1",
  "archetype": "Classical Master",
  "positioning": {
    "core_principle": "還原古典命理的宏觀視野與宿命張力，專注於定格、定性、定數。",
    "scope": "只負責純正統、傳統格局、傳統敘事輸出；不輸出現代心理學、產品化行動語言或機率化詞彙。",
    "double_engine_role": "與另一顆對立風格解盤處理器並行運算；本引擎專司古典格局、氣數、宿命張力與德行勸誡。"
  },
  "input_interface": {
    "required_data": [
      "birth_chart",
      "five_layer_transformations",
      "qimen_palace_status"
    ],
    "optional_data": [
      "decade_fortune",
      "annual_fortune",
      "doujun_flow_month",
      "interpretation_context",
      "flow_month_palace_axis",
      "leap_month_rule_mode"
    ],
    "binding_contract": {
      "birth_chart": {
        "required_fields": [
          "minggong_zhi_idx",
          "shengong_zhi_idx",
          "principal_stars_14",
          "auxiliary_star_positions",
          "mingzhu_star",
          "shenzhu_star",
          "wuxing_ju_number",
          "minggong_ganzhi",
          "star_strength_table_ref",
          "principal_star_source_ref",
          "auxiliary_star_source_table_refs",
          "sihua_version_lock"
        ]
      },
      "five_layer_transformations": {
        "required_fields": [
          "natal_sihua",
          "decade_sihua",
          "annual_sihua",
          "energy_density",
          "blind_spot"
        ]
      },
      "qimen_palace_status": {
        "required_fields": [
          "qimen_dun_type",
          "qimen_ju_number",
          "zhifu_star",
          "zhishi_door",
          "tianpan_star_allocation",
          "renpan_door_allocation",
          "shenpan_deity_allocation",
          "final_qimen_board",
          "kun_2_redirect_rule",
          "qimen_ju_source",
          "current_jieqi_exact_timestamp"
        ]
      }
    }
  },
  "execution_position": {
    "upstream_required_engines": [
      "ziwei_qimen_traditional_core_engine_v2.0.json",
      "ziwei_qimen_full_compute_flow_v1.4.json"
    ],
    "consume_only_verified_core_outputs": true,
    "forbid_direct_formula_inference": true,
    "forbid_freehand_json_fabrication": true,
    "fail_closed": true,
    "no_todo_allowed": true
  },
  "translation_layer": {
    "purpose": "把現代橋接層數值欄位轉回古典命理話語，不改動底層真值。",
    "field_translation_rules": {
      "energy_density": {
        "traditional_alias": "氣數/氣象/乘旺得令",
        "bands": {
          "0_29": "氣運對沖，群煞交會，四化沖破，宜深居簡出、蓄德避禍。",
          "30_49": "氣數未穩，進退多阻，吉中藏憂，不宜躁進。",
          "50_69": "氣機平平，得失參半，可守可為，須擇時而動。",
          "70_84": "氣勢漸旺，吉曜可用，若得時位，可謀進取。",
          "85_100": "乘旺得令，氣象萬千，如日中天，宜乘時建功。"
        }
      },
      "blind_spot": {
        "traditional_alias": "凶格/沖破/明吉暗凶/吉處藏凶",
        "mapping_logic": {
          "high_energy_not_best_action_point": "旺處未必可用，恐是虛名之地，宜防明吉暗凶。",
          "false_harmony": "表面和順，內裡刑沖，屬和中藏煞。",
          "suppressed_domain": "該宮受制，氣弱逢剋，屬吉處受困。",
          "asymmetry_accumulation": "偏枯失衡，一宮獨旺，多主他宮受損。"
        }
      }
    },
