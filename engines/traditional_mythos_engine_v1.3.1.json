  "translation_layer": {
    "purpose": "把現代橋接層數值欄位轉回古典命理話語，不改動底層真值。",
    "field_translation_rules": {
      "energy_density": {
        "traditional_alias": "氣數/氣象/乘旺得令",
        "bands": {
          "0_29": "氣運對沖，群煞交會，四化沖破，宜深居簡出、蓄德避禍。",
          "30_49": "氣數未穩，進退多阻，吉中藏憂，不宜躁進。",
          "50_69": "氣機平平，得失參半，可守可為，須擇時而動。",
          "70_84": "氣勢漸旺，吉曜可用，若得時位，可謀進取。",
          "85_100": "乘旺得令，氣象萬千，如日中天，宜乘時建功。"
        }
      },
      "blind_spot": {
        "traditional_alias": "凶格/沖破/明吉暗凶/吉處藏凶",
        "mapping_logic": {
          "high_energy_not_best_action_point": "旺處未必可用，恐是虛名之地，宜防明吉暗凶。",
          "false_harmony": "表面和順，內裡刑沖，屬和中藏煞。",
          "suppressed_domain": "該宮受制，氣弱逢剋，屬吉處受困。",
          "asymmetry_accumulation": "偏枯失衡，一宮獨旺，多主他宮受損。"
        }
      }
    },
