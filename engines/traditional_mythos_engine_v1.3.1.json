  "positioning": {
    "core_principle": "還原古典命理的宏觀視野與宿命張力，專注於定格、定性、定數。",
    "scope": "只負責純正統、傳統格局、傳統敘事輸出；不輸出現代心理學、產品化行動語言或機率化詞彙。",
    "double_engine_role": "與另一顆對立風格解盤處理器並行運算；本引擎專司古典格局、氣數、宿命張力與德行勸誡。"
  },
  "input_interface": {
    "required_data": [
      "birth_chart",
      "five_layer_transformations",
      "qimen_palace_status"
    ],
    "optional_data": [
