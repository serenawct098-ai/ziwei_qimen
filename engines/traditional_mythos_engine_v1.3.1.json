  "pattern_scanning_layer": {
    "classical_framework_library": {
      "grade_A_patterns": [
        "紫府同宮格",
        "極向離明格",
        "日出扶桑格",
        "將星得地格"
      ],
      "grade_B_patterns": [
        "機月同梁格",
