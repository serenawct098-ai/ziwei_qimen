      "priority": ["SSOT_EXACT_MATCH", "THEMATIC_ALIGNMENT", "SEMANTIC_SIMILARITY"],
      "temporal_weight": { "生年": 1.0, "大限": 0.8, "流年": 0.6 }
    }
