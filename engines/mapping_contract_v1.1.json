  "citation_logic": {
    "description": "決定何時回傳 line_id 或標記 _custom。",
    "decision_tree": {
      "if_exact_match_in_data_layer": { "action": "RETURN_LINE_ID", "source_type": "CLASSICAL_SSOT" },
      "if_derived_from_multiple_lines": { "action": "RETURN_SYNTHESIZED_IDS", "tag": "_custom", "reason": "DERIVED_INTERPRETATION" },
      "if_modern_application_only": { "action": "RETURN_TEXT_ONLY", "tag": "_custom", "reason": "MODERN_OVERLAY" },
      "if_no_alignment_found": { "action": "HALT_OR_FALLBACK", "fallback": "GENERAL_PRINCIPLES" }
    }
  },
