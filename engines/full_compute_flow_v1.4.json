{
  "$schema": "ziwei_qimen_full_compute_flow_v1.4",
  "version": "1.4.0",
  "title": "紫微奇門雙引擎完整運算流水線（Opcode版流程規格書）",
  "purpose": "將使用者輸入轉為可執行的拓撲排序運算規格；每一步驟皆明確聲明依賴、輸入、公式引用、輸出與斷言",
  "binding_core_engine": {
    "engine_file": "ziwei_qimen_traditional_core_engine_v2.0.json",
    "engine_version": "2.0.0",
    "rule": "本流程規格不得繞過 v2.0 SSOT；所有靜態表與公式僅可由 v2.0_json_formula_ref 指向"
  },
  "global_execution_contract": {
    "topology_rule": "必須嚴格按 op_sequence 由小到大執行；任何 op_block 不可跳步執行",
    "dependency_rule": "每個 op_block 僅可讀取 user_inputs、system_runtime_context 與 dependencies 中列出的 outputs",
    "mutation_rule": "每個 op_block 只能寫入 declared_outputs，不可回寫上游結果",
    "anti_hallucination_rule": "凡屬定數對照必須查 static_lookup_tables，嚴禁以數學公式推導或以口訣腦補",
    "modulo_rule": "凡涉及逆行或可能負數之位移，必須使用 ((x % 12) + 12) % 12 安全模格式",
    "error_policy": {
      "missing_dependency": "HALT",
      "invalid_lookup_key": "HALT",
      "assertion_failed": "HALT",
      "calendar_conversion_failed": "HALT"
    },
    "verification_order": [
      "literature_line_by_line_comparison",
      "json_field_mapping_comparison",
      "sandbox_enumeration_validation",
      "artifact_generation"
    ],
    "no_todo_allowed": true,
    "fail_closed": true,
    "late_zi_day_rollover_rule": {
      "_doc": "晚子時換日鎖定規則(與core implementation_invariants.late_zi_day_rollover一致)",
      "rule": "IF 出生時=子 AND 真太陽時23:00-23:59(晚子) THEN lunar_day+=1(次日);00:00-00:59(早子)lunar_day不變;HourBranch恆=子(index0)",
      "month_year_rollover": "換日後 IF lunar_day>當月最大日 THEN lunar_day=1,lunar_month+=1; IF lunar_month>12 THEN lunar_month=1,lunar_year+=1(年干支重取)",
      "why": "紫微定盤以lunar_day為輸入,命身宮以lunar_month;晚子不換日將令全盤偏移整宮"
    }
  },
  "user_inputs": {
    "birth_gregorian_datetime": "ISO-8601 datetime string with timezone",
    "birth_timezone": "IANA timezone string",
    "gender": "male | female",
    "current_flow_gregorian_datetime": "ISO-8601 datetime string with timezone",
    "current_flow_timezone": "IANA timezone string",
    "optional_runtime_flags": {
      "calendar_mode": "astronomical_solar_terms_strict",
      "qimen_method": "shijia_qimen_chaibu",
      "ziwei_method": "sanhe_nanfang_xingyao + doujun_liuyue",
      "leap_month_rule_mode": "sanhe_star_school"
    },
    "birth_longitude": "number, east positive, required for true solar time correction",
    "current_flow_longitude": "number, east positive, required for exact jieqi boundary validation"
  },
  "system_runtime_context": {
    "calendar_engine_required": true,
    "solar_longitude_precision_required": true,
    "lunar_calendar_converter_required": true,
    "ganzhi_converter_required": true,
    "notes": [
      "步驟1屬曆法引擎前置計算，其輸出將餵給紫微與奇門雙引擎",
      "步驟2-9使用12支/12宮座標系；步驟10-15使用奇門九宮座標系"
    ]
  },
  "op_sequence": [
    "OP01",
    "OP02",
    "OP03",
    "OP04",
    "OP05",
    "OP06",
    "OP07",
    "OP08",
    "OP09",
    "OP10",
    "OP11",
    "OP12",
    "OP12_5",
    "OP13",
    "OP14",
    "OP15"
  ],
  "op_blocks": [
    {
      "op_id": "OP01",
      "phase": "階段一：底層時空座標初始化",
      "step_name": "天文節氣與干支轉化（四柱八字計算）",
      "dependencies": [],
      "topology_position": 1,
      "reads_from": [
        "user_inputs.birth_gregorian_datetime",
        "user_inputs.birth_timezone",
        "user_inputs.current_flow_gregorian_datetime",
        "user_inputs.current_flow_timezone",
        "user_inputs.birth_longitude",
        "user_inputs.current_flow_longitude"
      ],
      "v2.0_json_formula_ref": [],
      "external_engine_required": [
        "astronomical solar longitude solver",
        "24 jieqi boundary finder",
        "gregorian↔lunar calendar converter",
        "sexagenary ganzhi converter"
      ],
      "authoritative_data_source": {
        "節氣交節時刻": "香港天文台（HKO）二十四節氣日期及時間資料（HKT=UTC+8）為唯一真值源",
        "真太陽時": "經度時差＋均時差（Equation of Time）；均時差與日中天時刻可採香港天文台天文資料／日出日中天日落表（已內含經度時差與均時差）",
        "url": [
          "https://www.hko.gov.hk/tc/gts/astronomy/Solar_Term.htm",
          "https://www.hko.gov.hk/tc/gts/time/"
        ]
      },
      "algorithm": {
        "substeps": [
          "1. 以出生地經度與時區換算真太陽時（經度時差＋均時差，均時差依香港天文台天文資料），計算真實太陽黃經，確定所屬節氣與節令月界。",
          "2. 將出生公曆轉為農曆日期，取得農曆月、農曆日、是否閏月。",
          "3. 依節氣切月法計算出生年干支、月干支、日干支、時干支。",
          "4. 對當前流轉時間重做同樣計算，取得流轉用日干支、時干支、當前節氣、下一節氣與交節精確時刻（交節時刻以香港天文台二十四節氣資料為準）。",
          "5. 將所有天干標準化為0-9，地支標準化為0-11。",
          "6. 若曆法轉換、節氣定位、真太陽時修正或交節時刻求解失敗，立即 HALT。"
        ],
        "assertions": [
          "出生與流轉時間必須可唯一定位於某一節氣區間。",
          "輸出的天干index ∈ [0,9]；地支index ∈ [0,11]。",
          "農曆月必須為1-12，農曆日必須為1-30。",
          "出生與流轉時間必須可唯一定位於某一節氣區間，且須輸出交節精確時刻。",
          "真太陽時修正所需經度不可缺失。"
        ]
      },
      "declared_outputs": {
        "birth_lunar_month": "1-12",
        "birth_lunar_day": "1-30",
        "birth_hour_zhi_idx": "0-11",
        "birth_year_gan": "甲..癸",
        "birth_year_gan_idx": "0-9",
        "birth_year_zhi": "子..亥",
        "birth_year_zhi_idx": "0-11",
        "birth_day_gan": "甲..癸",
        "birth_day_gan_idx": "0-9",
        "birth_day_zhi": "子..亥",
        "birth_day_zhi_idx": "0-11",
        "birth_hour_gan": "甲..癸",
        "birth_hour_gan_idx": "0-9",
        "birth_hour_zhi": "子..亥",
        "current_day_gan": "甲..癸",
        "current_day_gan_idx": "0-9",
        "current_day_zhi": "子..亥",
        "current_day_zhi_idx": "0-11",
        "current_hour_gan": "甲..癸",
        "current_hour_gan_idx": "0-9",
        "current_hour_zhi": "子..亥",
        "current_hour_zhi_idx": "0-11",
        "current_jieqi": "24節氣之一",
        "current_dun_type": "陽遁|陰遁",
        "birth_is_leap_month": "boolean",
        "birth_true_solar_datetime": "ISO-8601 datetime string with timezone",
        "current_true_solar_datetime": "ISO-8601 datetime string with timezone",
        "current_jieqi_exact_timestamp": "ISO-8601 datetime string with timezone",
        "next_jieqi": "24節氣之一",
        "next_jieqi_exact_timestamp": "ISO-8601 datetime string with timezone"
      }
    },
    {
      "op_id": "OP02",
      "phase": "階段二：紫微斗數南派三合引擎",
      "step_name": "定位命宮與身宮",
      "dependencies": [
        "OP01.birth_lunar_month",
        "OP01.birth_hour_zhi_idx"
      ],
      "topology_position": 2,
      "reads_from": [
        "OP01.birth_lunar_month",
        "OP01.birth_hour_zhi_idx"
      ],
      "v2.0_json_formula_ref": [
        "dynamic_mathematical_formulas.01_mingshengong"
      ],
      "algorithm": {
        "normalization": [
          "MonthIndex = birth_lunar_month - 1  （寅月=0, 卯月=1, ..., 丑月=11）",
          "HourIndex = birth_hour_zhi_idx  （子=0, ..., 亥=11）"
        ],
        "formulas": [
          "MingGongFromYin = (MonthIndex - HourIndex + 12) % 12",
          "ShenGongFromYin = (MonthIndex + HourIndex) % 12",
          "MingGongZhiIdx = (MingGongFromYin + 2) % 12",
          "ShenGongZhiIdx = (ShenGongFromYin + 2) % 12"
        ],
        "assertions": [
          "所有結果必須落在0-11。",
          "MingGongZhiIdx 與 ShenGongZhiIdx 僅代表地支位置，尚未映射本命12宮index。"
        ]
      },
      "declared_outputs": {
        "month_index_from_yin": "0-11",
        "hour_index": "0-11",
        "minggong_from_yin": "0-11",
        "shengong_from_yin": "0-11",
        "minggong_zhi_idx": "0-11",
        "shengong_zhi_idx": "0-11"
      }
    },
    {
      "op_id": "OP03",
      "phase": "階段二：紫微斗數南派三合引擎",
      "step_name": "執行五虎遁（佈十二宮天干）",
      "dependencies": [
        "OP01.birth_year_gan_idx",
        "OP02.minggong_from_yin"
      ],
      "topology_position": 3,
      "reads_from": [
        "OP01.birth_year_gan_idx",
        "OP02.minggong_from_yin"
      ],
      "v2.0_json_formula_ref": [
        "dynamic_mathematical_formulas.02_wuhu_dun",
        "global_coordinate_system.stems_by_index",
        "global_coordinate_system.branches_by_index"
      ],
      "algorithm": {
        "formulas": [
          "WuHuYinStemIdx = (YearGanIdx * 2 + 2) % 10",
          "For branch_offset in [0..11]: PalaceStemIdx(branch_offset) = (WuHuYinStemIdx + branch_offset) % 10",
          "For branch_offset in [0..11]: PalaceZhiIdx(branch_offset) = (2 + branch_offset) % 12"
        ],
        "construction_rule": "以寅宮（地支寅=2）為十二宮干支起點，順布十二支，得到寅宮至丑宮共12個干支組合。",
        "assertions": [
          "WuHuYinStemIdx 必須與五虎遁口訣一致。",
          "輸出之 branch_offset=0 必為寅宮干支，branch_offset=11 必為丑宮干支。"
        ]
      },
      "declared_outputs": {
        "wuhu_yin_stem_idx": "0-9",
        "twelve_branch_stem_zhi_sequence": [
          {
            "branch_offset_from_yin": 0,
            "zhi_idx": 2,
            "stem_idx": "computed",
            "ganzhi": "寅宮干支"
          },
          {
            "branch_offset_from_yin": 1,
            "zhi_idx": 3,
            "stem_idx": "computed",
            "ganzhi": "卯宮干支"
          },
          {
            "branch_offset_from_yin": 2,
            "zhi_idx": 4,
            "stem_idx": "computed",
            "ganzhi": "辰宮干支"
          },
          {
            "branch_offset_from_yin": 3,
            "zhi_idx": 5,
            "stem_idx": "computed",
            "ganzhi": "巳宮干支"
          },
          {
            "branch_offset_from_yin": 4,
            "zhi_idx": 6,
            "stem_idx": "computed",
            "ganzhi": "午宮干支"
          },
          {
            "branch_offset_from_yin": 5,
            "zhi_idx": 7,
            "stem_idx": "computed",
            "ganzhi": "未宮干支"
          },
          {
            "branch_offset_from_yin": 6,
            "zhi_idx": 8,
            "stem_idx": "computed",
            "ganzhi": "申宮干支"
          },
          {
            "branch_offset_from_yin": 7,
            "zhi_idx": 9,
            "stem_idx": "computed",
            "ganzhi": "酉宮干支"
          },
          {
            "branch_offset_from_yin": 8,
            "zhi_idx": 10,
            "stem_idx": "computed",
            "ganzhi": "戌宮干支"
          },
          {
            "branch_offset_from_yin": 9,
            "zhi_idx": 11,
            "stem_idx": "computed",
            "ganzhi": "亥宮干支"
          },
          {
            "branch_offset_from_yin": 10,
            "zhi_idx": 0,
            "stem_idx": "computed",
            "ganzhi": "子宮干支"
          },
          {
            "branch_offset_from_yin": 11,
            "zhi_idx": 1,
            "stem_idx": "computed",
            "ganzhi": "丑宮干支"
          }
        ],
        "minggong_ganzhi": "由 minggong_zhi_idx 在上表中定位得到"
      }
    },
    {
      "op_id": "OP04",
      "phase": "階段二：紫微斗數南派三合引擎",
      "step_name": "查納音五行局",
      "dependencies": [
        "OP02.minggong_zhi_idx",
        "OP03.twelve_branch_stem_zhi_sequence",
        "OP03.minggong_ganzhi"
      ],
      "topology_position": 4,
      "reads_from": [
        "OP03.minggong_ganzhi"
      ],
      "v2.0_json_formula_ref": [
        "static_lookup_tables.nayin_60",
        "dynamic_mathematical_formulas.03_wuxing_ju"
      ],
      "algorithm": {
        "lookup_rule": "以命宮完整干支字串作為 key，直接查 static_lookup_tables.nayin_60[key]。",
        "extraction": [
          "讀取 nayin_name",
          "讀取 ju（2|3|4|5|6）"
        ],
        "assertions": [
          "嚴禁以五行文字反推或臨場推導局數。",
          "命宮干支 key 必須存在於 60 甲子靜態表中。",
          "ju 必須屬於 [2,3,4,5,6]。"
        ]
      },
      "declared_outputs": {
        "minggong_nayin_name": "納音名",
        "wuxing_ju_number": "2|3|4|5|6",
        "wuxing_ju_label": "水二局|木三局|金四局|土五局|火六局"
      }
    },
    {
      "op_id": "OP05",
      "phase": "階段二：紫微斗數南派三合引擎",
      "step_name": "十四主星演布（If-Else + 鏡像軸）",
      "dependencies": [
        "OP01.birth_lunar_month",
        "OP01.birth_lunar_day",
        "OP04.wuxing_ju_number"
      ],
      "topology_position": 5,
      "reads_from": [
        "OP01.birth_lunar_day",
        "OP04.wuxing_ju_number"
      ],
      "v2.0_json_formula_ref": [
        "static_lookup_tables.ziwei_position_table",
        "dynamic_mathematical_formulas.04_ziwei_position",
        "dynamic_mathematical_formulas.05_tianfu_mirror",
        "dynamic_mathematical_formulas.06_star_placement_ziwei_system",
        "dynamic_mathematical_formulas.07_star_placement_tianfu_system"
      ],
      "algorithm": {
        "note": "安紫微採【差數法／日數法】（依五行局數與農曆生日，非生月）：q=ceil(生日/N); c=q*N-生日; steps=(q-c if c奇 else q+c); ZiweiZhiIdx=(2+steps-1)%12。v1.4 原『局×月查表法』為錯誤，已改為差數法並對 App 雙盤校驗。",
        "substeps": [
          "1. 依 wuxing_ju_number 組出局名 key（如 土五局(5)）。",
          "2. 以 birth_lunar_day（生日）與局數 N 用差數法算 ZiweiZhiIdx（見 04_ziwei_position）。",
          "3. 計算 TianfuZhiIdx = (4 - ZiweiZhiIdx + 12) % 12（寅申軸）。",
          "4. 以 ZiweiZhiIdx 逆行布紫微系六星（天機-1、太陽-3、武曲-4、天同-5、廉貞-8）。",
          "5. 以 TianfuZhiIdx 順布天府系八星。"
        ],
        "critical_assertions": [
          "天府鏡像公式必為 (4 - ZiweiZhiIdx + 12) % 12（寅申軸）；禁止子午軸 (12-紫微) 或 10-紫微。",
          "14 主星最終皆為 0-11 地支 index。"
        ]
      },
      "declared_outputs": {
        "ziwei_zhi_idx": "0-11",
        "tianfu_zhi_idx": "0-11",
        "principal_stars_14": {
          "紫微": "0-11",
          "天機": "0-11",
          "太陽": "0-11",
          "武曲": "0-11",
          "天同": "0-11",
          "廉貞": "0-11",
          "天府": "0-11",
          "太陰": "0-11",
          "貪狼": "0-11",
          "巨門": "0-11",
          "天相": "0-11",
          "天梁": "0-11",
          "七殺": "0-11",
          "破軍": "0-11"
        }
      }
    },
    {
      "op_id": "OP06",
      "phase": "階段二：紫微斗數南派三合引擎",
      "step_name": "輔星與神煞演布（六吉六煞＋四化矩陣＋雜曜十二神＋天傷天使＋截空旬空＋天馬＋自化）",
      "dependencies": [
        "OP01.birth_year_gan",
        "OP01.birth_year_zhi",
        "OP01.birth_year_zhi_idx",
        "OP01.birth_hour_zhi_idx",
        "OP05.principal_stars_14",
        "OP04.wuxing_ju",
        "OP01.birth_gender_yinyang",
        "OP08.liunian_taisui_zhi_idx"
      ],
      "topology_position": 6,
      "reads_from": [
        "OP01.birth_year_gan",
        "OP01.birth_year_zhi",
        "OP01.birth_year_zhi_idx",
        "OP01.birth_hour_zhi_idx",
        "OP05.principal_stars_14",
        "OP04.wuxing_ju",
        "OP01.birth_gender_yinyang",
        "OP08.liunian_taisui_zhi_idx"
      ],
      "v2.0_json_formula_ref": [
        "dynamic_mathematical_formulas.08_auxiliary_stars",
        "static_lookup_tables.tiankui_tianyue_table",
        "static_lookup_tables.luzun_qingyang_tuoluo_table",
        "static_lookup_tables.huoxing_start_table",
        "static_lookup_tables.lingxing_start_table",
        "static_lookup_tables.sihua_matrix",
        "static_lookup_tables.shenzhu_table",
        "static_lookup_tables.mingzhu_table",
        "dynamic_mathematical_formulas.15_boshi_12shen",
        "dynamic_mathematical_formulas.16_changsheng_12shen",
        "dynamic_mathematical_formulas.17_suiqian_12shen",
        "dynamic_mathematical_formulas.18_jiangqian_12shen",
        "dynamic_mathematical_formulas.19_tianshang_tianshi",
        "dynamic_mathematical_formulas.20_jielu_kongwang_xunkong",
        "dynamic_mathematical_formulas.21_zihua_self_transformation",
        "static_lookup_tables.tianma_table",
        "static_lookup_tables.boshi_12_sequence",
        "static_lookup_tables.changsheng_12_sequence",
        "static_lookup_tables.changsheng_start_by_ju",
        "static_lookup_tables.suiqian_12_sequence",
        "static_lookup_tables.jiangqian_12_sequence"
      ],
      "algorithm": {
        "substeps": [
          "1. 依 HourIndex 計算文昌、文曲、地空、地劫。",
          "2. 依 YearGan 查祿存、擎羊、陀羅、天魁、天鉞。",
          "3. 依 YearZhi 所屬三合組查火星/鈴星起點，再順數 HourIndex。",
          "4. 依 YearGan 查四化矩陣，將化祿/化權/化科/化忌標記到對應主星。",
          "5. 依 YearZhi 查命主與身主。",
          "6. 依年支查 tianma_table 安天馬（三合驛馬）。",
          "7. 自祿存宮起博士十二神（陽男陰女順、陰男陽女逆），布 boshi_12_sequence。",
          "8. 依五行局 changsheng_start_by_ju 起長生十二神（同性別陰陽順逆），布 changsheng_12_sequence。",
