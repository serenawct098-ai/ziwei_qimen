          "natal_sihua",
          "decade_sihua",
          "annual_sihua",
          "monthly_sihua",
          "daily_sihua",
          "energy_density",
          "collision_score",
          "decision_band",
          "blind_spot_flags"
        ]
      },
      "spacetime_physical_coordinates": {
        "required_fields": [
          "current_solar_term",
          "next_solar_term",
          "yuan",
          "ju_number",
          "dun_type",
          "hour_zhi",
          "day_ganzhi",
          "month_ganzhi",
          "target_direction",
          "target_domain",
          "current_jieqi_exact_timestamp",
          "leap_month_rule_mode"
        ]
      },
      "qimen_palace_status": {
        "required_fields": [
          "nine_palace_layout",
          "zhifu_star",
          "zhishi_door",
          "door_element_map",
          "palace_element_map",
          "shenpan_deity_allocation",
          "tianpan_star_allocation",
          "renpan_door_allocation"
        ]
      },
      "shared_bridge_fields": {
        "required_fields": [
          "mapped_qimen_palace",
          "mapped_direction",
          "five_element_relation",
          "gate_multiplier",
          "timing_modifier",
          "zhi_to_qimen_palace_map",
          "kun_2_redirect_rule",
          "bridge_source_lock"
        ]
      }
    },
    "normalization_rules": {
      "R1": "若輸入為生辰，必先完成曆法換算與真太陽時校準，再生成命盤矩陣。",
      "R2": "若輸入已是命盤，不得重算既有靜態 lookup 結果，只補齊缺失欄位。",
      "R3": "所有時間層資料必須綁定同一 canonical snapshot。",
      "R4": "地支、宮位、時空映射一律沿用已驗證核心引擎索引，不得另起一套。",
      "R5": "紫微12地支宮與奇門9宮映射必須由 zhi_to_qimen_palace_map 靜態提供，不得臨時推導。"
    }
  },
  "parallel_processing_pipeline": {
    "architecture_type": "parallel_async_dual_track"
  },
