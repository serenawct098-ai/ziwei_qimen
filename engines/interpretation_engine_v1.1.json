{
  "metadata": {
    "name": "(完整計算步驟)ziwei_qimen_interpretation_engine",
    "version": "1.1",
    "title": "完整計算步驟｜紫微斗數 × 奇門遁甲",
    "scope": "南派三合星曜派 + 奇門遁甲拆補法",
    "ssot_dependency": "ziwei_qimen_traditional_core_engine_v2.0.json",
    "anti_hallucination_protocol": [
      "定數全部硬編碼為靜態 Lookup Table，禁止 AI 公式推導",
      "變數採 0–11 純整數陣列，模運算 (mod 12) 表達順逆規律",
      "天府公式：紫微天府以寅申軸對稱，天府=(4 - ZiweiZhiIdx + 12) % 12（非子午軸 12-紫微）",
      "五行局由 v2.0 核心 03wuxingju 鏈式推導（命宮干支 → nayin60），禁用月干直接映射捷徑",
      "所有索引計算必須使用非負模運算：(x % 12 + 12) % 12",
      "禁止在 JSON 內使用 ...、TODO、如此類推等省略符號"
    ],
    "last_updated": "2026-06-06",
    "calculation_steps_order": [
      "S1_ming_shen_gong",
      "S2_wuxing_ju",
      "S3_ziwei_system",
      "S4_tianfu_system",
      "S5_auxiliary_stars",
      "S6_brightness",
      "S7_sihua",
      "S8_dalian_xiaoxian",
      "S9_doujun_liuyue",
      "S10_qimen_xunshou",
      "S11_qimen_sanyuan",
      "S12_qimen_panbuild"
    ],
    "doctrine_locks": [
      "S9 斗君公式（《全書·安斗君訣》逆生月、順生時）：含 +BirthHourIndex，保留閏月邊界斷言",
      "S11 三元映射：子午卯酉=上元 / 寅申巳亥=中元 / 辰戌丑未=下元",
      "S11 三元輸入源為符頭地支 XunshouZhiIdx（非 DayZhiIdx）",
      "S12 天盤旋轉步驟採明確算法",
      "S8 小限起點表（三合組一致性）；S4 破軍 offset = +10（與核心引擎 07 一致）",
      "S7 四化層級權重標記 MODERN_ENHANCEMENT_LAYER",
      "庚干四化以文墨天機標準為唯一真值：太陰科、天同忌",
      "S5b 雜曜十二神（博士/長生/歲前/將前）＋天傷天使＋截路旬空＋天馬",
      "S7b 自化邏輯（宮干四化回照本宮）"
    ]
  },
  "S1_ming_shen_gong": {
    "step": "S1",
    "name": "安命宮身宮",
    "purpose": "依農曆生月（寅月=0起算）與生時（子=0起算）推算命宮、身宮所在地支索引",
    "coordinate_note": "MonthIndex: 寅=0,卯=1,辰=2,巳=3,午=4,未=5,申=6,酉=7,戌=8,亥=9,子=10,丑=11 | HourIndex: 子=0,丑=1,...,亥=11",
    "dynamic_formulas": {
      "MingGongFromYin": "(MonthIndex - HourIndex + 12) % 12",
      "MingGongZhiIdx": "(MingGongFromYin + 2) % 12",
      "ShenGongFromYin": "(MonthIndex + HourIndex) % 12",
      "ShenGongZhiIdx": "(ShenGongFromYin + 2) % 12"
    },
    "assertion": "0 <= MingGongFromYin <= 11; 0 <= ShenGongFromYin <= 11",
    "verification_cases": [
      {
        "case": "月=0,時=0",
        "MingGong": "(0-0+12)%12=0 → ZhiIdx=(0+2)%12=2(寅)",
        "ShenGong": "(0+0)%12=0 → ZhiIdx=2(寅)"
      },
      {
        "case": "月=1,時=6",
        "MingGong": "(1-6+12)%12=7 → ZhiIdx=9(酉)",
        "ShenGong": "(1+6)%12=7 → ZhiIdx=9(酉)"
      }
    ],
    "late_zi_day_rollover": {
      "_doc": "晚子時換日鎖定規則(與core implementation_invariants.late_zi_day_rollover一致)",
      "rule": "IF 出生時=子 AND 真太陽時23:00-23:59(晚子) THEN lunar_day+=1(次日);00:00-00:59(早子)lunar_day不變;HourBranch恆=子(index0)",
      "month_year_rollover": "換日後 IF lunar_day>當月最大日 THEN lunar_day=1,lunar_month+=1; IF lunar_month>12 THEN lunar_month=1,lunar_year+=1(年干支重取)",
      "why": "紫微定盤以lunar_day為輸入,命身宮以lunar_month;晚子不換日將令全盤偏移整宮"
    }
  },
  "S2_wuxing_ju": {
    "step": "S2",
    "name": "五行局數定局",
    "purpose": "依生年天干五虎遁年起寅月干，推算命宮干支，查 nayin60 得五行局數",
    "ssot_steps": {
      "step1_wuhuyingan": {
        "name": "五虎遁年起寅月干",
        "formula": "WuHuYinStemIdx = (YearGanIdx * 2 + 2) % 10",
        "verification": {
          "YearGanIdx=0(甲)": "(0*2+2)%10=2 → 丙",
          "YearGanIdx=1(乙)": "(1*2+2)%10=4 → 戊",
          "YearGanIdx=2(丙)": "(2*2+2)%10=6 → 庚",
          "YearGanIdx=3(丁)": "(3*2+2)%10=8 → 壬",
          "YearGanIdx=4(戊)": "(4*2+2)%10=0 → 甲",
          "YearGanIdx=5(己)": "(5*2+2)%10=2 → 丙",
          "YearGanIdx=6(庚)": "(6*2+2)%10=4 → 戊",
          "YearGanIdx=7(辛)": "(7*2+2)%10=6 → 庚",
          "YearGanIdx=8(壬)": "(8*2+2)%10=8 → 壬",
          "YearGanIdx=9(癸)": "(9*2+2)%10=0 → 甲"
        }
      },
      "step2_mingong_gan": {
        "name": "命宮天干",
        "formula": "MingGongStemIdx = (WuHuYinStemIdx + MingGongFromYin) % 10"
      },
      "step3_nayin_lookup": {
        "name": "查命宮干支納音得局數",
        "formula": "key = stems[MingGongStemIdx] + branches[MingGongZhiIdx]; N = nayin60[key].ju",
