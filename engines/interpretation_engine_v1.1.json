  "S9_doujun_liuyue": {
    "step": "S9",
    "name": "斗君流月法",
    "purpose": "流年太歲宮位確定後，以生月逆數、生時順數定斗君起點，逐月順數推算流月宮位",
    "dynamic_formulas": {
      "step1_taisui": {
        "name": "流年太歲入命宮偏移",
        "formula": "TaiSuiPalaceIdx = (FlowYearZhiIdx - MingGongZhiIdx + 12) % 12"
      },
      "step2_doujun": {
        "name": "斗君宮位（太歲逆數生月、順數生時）",
        "formula": "DouJunPalaceIdx = (TaiSuiPalaceIdx - BirthMonthIndex + BirthHourIndex + 24) % 12",
        "note": "BirthMonthIndex: 寅月=0,卯=1,...,丑=11（0-based）；BirthHourIndex: 子時=0,丑=1,...,亥=11；《全書·安斗君訣》逆生月（減）、順生時（加）",
        "_formula_lock": "斗君公式含 +BirthHourIndex（逆生月、順生時）"
      },
      "step3_flow_month": {
        "name": "流月宮位（斗君順數）",
        "formula": "FlowMonthPalaceIdx = (DouJunPalaceIdx + FlowMonthIndex) % 12",
        "note": "FlowMonthIndex: 寅月=0"
      }
    },
    "assertion": "0 <= BirthMonthIndex <= 11; 0 <= BirthHourIndex <= 11; 0 <= TaiSuiPalaceIdx <= 11; 0 <= DouJunPalaceIdx <= 11; 0 <= FlowMonthPalaceIdx <= 11",
    "verification_case": {
      "MingGongZhiIdx": 0,
      "BirthMonthIndex": 2,
      "BirthHourIndex": 0,
      "FlowYearZhiIdx": 6,
      "TaiSuiPalaceIdx": "(6-0+12)%12=6",
      "DouJunPalaceIdx": "(6-2+0+24)%12=4",
      "FlowMonth_寅": "(4+0)%12=4",
      "FlowMonth_卯": "(4+1)%12=5"
    },
    "派別鎖定": "《全書·安斗君訣》：於太歲宮起正月逆至生月，再從生月起子順數至生時（逆生月減、順生時加）",
    "leap_month_assertion": {
      "rule": "三合星曜派閏月歸前月（mode_0）",
      "formula": "IF isLeapMonth THEN BirthMonthIndex = regularMonthIndex（閏月前正月index，最大=11）",
      "boundary": "BirthMonthIndex 取值範圍必須為 0-11；閏月時等同前月index，不得為12或13",
      "HALT_condition": "IF BirthMonthIndex > 11 OR BirthMonthIndex < 0 THEN HALT('閏月index越界')"
    },
    "verification_cases": [
      {
        "case": "MingGong=子(0),生辰月(idx=2),生子時(idx=0),流年午(6)",
        "TaiSui": "(6-0+12)%12=6",
        "DouJun": "(6-2+0+24)%12=4",
        "正月流月": "(4+0)%12=4",
        "二月流月": "(4+1)%12=5"
      },
      {
        "case": "可區分加減驗證：MingGong=子(0),生辰月(idx=2),生卯時(idx=3),流年午(6)",
        "TaiSui": "(6-0+12)%12=6",
        "DouJun": "(6-2+3+24)%12=7（順生時加；若誤用減則(6-2-3+24)%12=1，與《全書》不符）",
        "正月流月": "(7+0)%12=7"
      },
      {
        "case": "閏六月（=六月,idx=5）",
        "BirthMonthIndex": "5（歸前月，不得為13）",
        "assertion_check": "5<=11 PASS"
      },
      {
        "case": "MingGong=卯(3),生寅月(idx=0),生午時(idx=6),流年子(0)",
        "TaiSui": "(0-3+12+12)%12=9",
        "DouJun": "(9-0+6+24)%12=3",
        "正月流月": "(3+0)%12=3"
      }
    ]
  },
