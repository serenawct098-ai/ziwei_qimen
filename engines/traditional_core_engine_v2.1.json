  "implementation_invariants": {
    "tianfu_formula": {
      "rule": "天府宮 = (4 - ZiweiIndex + 12) % 12",
      "assertion": "紫微天府以寅申軸對稱；紫微寅↔天府寅、紫微午↔天府戌、紫微戌↔天府午、紫微子↔天府辰"
    },
    "minor_limit_reverse_modulo": {
      "rule": "女命逆行小限以雙重取模保證非負：((S-(Age-1))%12+12)%12",
      "assertion": "Age=1~100 全段恆為 0~11"
    },
    "tianqin_shadow_binding": {
      "rule": "天禽寄宮：tianqin_palace = tianrui_palace 永遠同步（轉盤動態綑綁）"
    },
    "minor_limit_start_lock": {
      "rule": "小限起點採墓庫版（版本A）為預設，數值 [10,4,1,7] 對應 [戌辰丑未]"
    },
    "late_zi_day_rollover": {
      "_doc": "晚子時換日鎖定規則（SSOT唯一鎖定）。子時跨日（23:00-01:00）：23:00-23:59為『晚子時』屬次日之早子，01:00前0:00-00:59為『早子時』屬當日。",
      "rule": "IF 出生時=子 AND 真太陽時時鐘介於 23:00-23:59 THEN 晚子時：lunar_day += 1（進為次日），HourBranch='子'（子時index=0不變）。0:00-00:59為早子時，lunar_day 不變。",
      "rationale": "紫微定盤(04_ziwei_position)以 lunar_day 為輸入；晚子時若不換日，23:00後出生者紫微落宮可偏移整宮，全盤連動偏移。",
      "month_boundary": "IF 換日後 lunar_day > 該農曆月最大日(29或30) THEN lunar_day=1 且 lunar_month+=1（跨月）；命身宮(01)用 lunar_month、紫微(04)用 lunar_day 雙重連動，屬最高風險邊界，必須一致換算後再進主星安星。",
      "assertion": "IF HourBranch=='子' AND clock_hour>=23 THEN day_rollover=1 ELSE day_rollover=0；換月後 IF lunar_month>12 THEN lunar_month=1 AND lunar_year+=1（跨年，年干支同步重取）。",
      "scope": "本命安星層；早晚子時僅影響日數換算，子時 HourIndex 恆為 0。"
    }
  },
  "required_inputs": {
    "_doc": "所有計算的必填輸入參數，缺少任何一項必須拋出錯誤並停止",
    "birth_datetime_iso8601": {
      "type": "string",
      "example": "1982-08-03T03:10:00+08:00",
      "required": true
    },
    "birth_longitude": {
      "type": "number",
      "unit": "decimal_degrees",
      "example": 114.1694,
      "required": true,
      "note": "出生地東經度，用於真太陽時計算；香港≈114.17，北京≈116.39"
    },
    "birth_latitude": {
      "type": "number",
      "unit": "decimal_degrees",
      "example": 22.3193,
      "required": false
    },
    "birth_timezone_iana": {
      "type": "string",
      "example": "Asia/Hong_Kong",
      "required": true
    },
    "flow_year_zhi": {
      "type": "string",
      "example": "午",
      "required": true
    },
    "flow_month_index": {
      "type": "integer",
      "range": "0-11",
      "note": "寅月=0",
      "required": true
    },
    "true_solar_time_formula": {
      "doc": "平太陽時→真太陽時：含經度時差與均時差（Equation of Time）兩項修正",
      "data_source": "香港天文台（HKO）：真太陽時可由 HKO「日出、日中天、日落」表之日中天時刻反推（該表已內含經度時差與均時差）；亦可由天文計算之均時差值代入；節氣交節時刻採 HKO 二十四節氣資料（HKT=UTC+8）",
      "data_source_url": "https://www.hko.gov.hk/tc/gts/astronomy/Solar_Term.htm（節氣時刻）；https://www.hko.gov.hk/tc/gts/time/ （日出日中天日落／時差）",
      "step1": "LongitudeDiff = birth_longitude - StandardMeridian（東八區=120）",
      "step2": "LongitudeTimeDiffMinutes = LongitudeDiff * 4",
      "step3": "EoTMinutes = 均時差（Equation of Time，依出生日期查香港天文台天文資料；範圍約 -14 至 +16 分）",
      "step4": "TrueSolarTime = BirthStandardTime + LongitudeTimeDiffMinutes + EoTMinutes（分鐘）",
      "example_HK": "香港114.17°: 經度時差=(114.17-120)*4=-23.32分；再加當日均時差（如芒種前後約-1至-2分）後得真太陽時",
      "assertion": "IF EoTMinutes IS NULL THEN HALT('均時差缺失，無法精確換算真太陽時，請依香港天文台天文資料補入')",
      "assertion2": "IF abs(LongitudeDiff) > 15 THEN WARN('經度偏差超過1小時，時柱可能跨界')"
    }
  },
