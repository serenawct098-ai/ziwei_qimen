    "san_yuan_lookup": {
      "_doc": "拆補法三元查表：符頭（旬首）地支 XunshouZhiIdx 必為偶數之六甲旬首（0/2/4/6/8/10）；查得上/中/下元。子午卯酉→上元、寅申巳亥→中元、辰戌丑未→下元。非六甲旬首（奇數index）於拆補法無定義，若命中即代表干支組合無效。",
      "0": "上元",
      "2": "中元",
      "4": "下元",
      "6": "上元",
      "8": "中元",
      "10": "下元",
      "ShangYuan_indices": [
        0,
        3,
        6,
        9
      ],
      "ZhongYuan_indices": [
        2,
        5,
        8,
        11
      ],
      "XiaYuan_indices": [
        1,
        4,
        7,
        10
      ],
      "_jieqi_intra_hour_switch_rule": {
        "doc": "拆補法時辰內交節切換斷言（精確到分秒）",
        "rule": "交節時刻精確到分秒；同一時辰中途交節時，交節前使用舊節氣局數，交節後（含交節分鐘起）立即切換新節氣局數",
        "timestamp_required": "jieqiExactTimestamp（ISO-8601含分秒，如香港天文台 2026 芒種=2026-06-05T23:48:00+08:00）必須由OP01強制輸出",
        "data_source": "交節精確時刻採用香港天文台（HKO）二十四節氣日期及時間資料（HKT=UTC+8）為唯一真值源",
        "data_source_url": "https://www.hko.gov.hk/tc/gts/astronomy/Solar_Term.htm",
        "switch_logic": "IF currentTimestamp >= jieqiExactTimestamp THEN use_new_jieqi_ju ELSE use_old_jieqi_ju",
        "assertion": "IF jieqiExactTimestamp IS NULL THEN HALT('OP01未輸出交節精確時刻，拆補法無法精確定局')",
        "note": "拆補法核心優勢：無超神接氣緩衝，節氣時刻到即切換，同一時辰前後可能使用不同局數"
      }
    },
