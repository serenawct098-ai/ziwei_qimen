    "出家僧道之命": {
      "source_files": [
        "ZWQS_Juan3_LunDaXianShiNian.json",
        "ZWQS_Juan3_LunZhuXingTongYuan.json"
      ],
      "entries": [
        {
          "line_id": "ZWQS_Juan3_LunZhuXingTongYuan_L035",
          "original_quote": "天相廉貞擎羊來多招刑杖難逃終身不美招橫禍，只宜僧道。",
          "line_ref": "第274行"
        },
        {
          "line_id": "ZWQS_Juan3_LunZhuXingTongYuan_L058",
          "original_quote": "機梁守命加吉曜富貴慈祥加刑忌僧道。",
          "line_ref": "第303行"
        },
        {
          "line_id": "ZWQS_Juan3_LunZhuXingTongYuan_L059",
          "original_quote": "機梁同照命身空偏宜僧道機同單守命身，又逢空亡。",
          "line_ref": "第304行"
        },
        {
          "line_id": "ZWQS_Juan3_LunZhuXingTongYuan_L228",
          "original_quote": "魁鉞昌曲祿存扶刑殺無沖台輔貴命身妙三方，次見刑殺沖會者平常，只宜僧道。",
          "line_ref": "第507行"
        }
      ]
    }
  }
